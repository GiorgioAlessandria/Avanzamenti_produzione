        (() => {
            const userSelectEl = document.getElementById("select-user-reset-login-code");
            const codeInputEl = document.getElementById("reset-login-code-value");
            const saveBtn = document.getElementById("btn-reset-login-code-save");
            const cancelBtn = document.getElementById("btn-reset-login-code-cancel");
            const feedbackEl = document.getElementById("reset-login-code-feedback");
            const detailEl = document.getElementById("reset-login-code-detail");
            const usersDataEl = document.getElementById("registry-users-data");

            if (!userSelectEl || !codeInputEl || !saveBtn) {
                return;
            }

            let registryUsers = [];

            try {
                registryUsers = JSON.parse(usersDataEl?.textContent || "[]");
            } catch (_) {
                registryUsers = [];
            }

            function escapeHtml(value) {
                return String(value ?? "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            function showFeedback(type, message) {
                if (!feedbackEl) return;

                if (!message) {
                    feedbackEl.innerHTML = "";
                    return;
                }

                const classMap = {
                    success: "alert-success",
                    danger: "alert-danger",
                    warning: "alert-warning",
                    info: "alert-info",
                };

                const alertClass = classMap[type] || "alert-secondary";

                feedbackEl.innerHTML = `
            <div class="alert ${alertClass} mb-0">
                ${escapeHtml(message)}
            </div>
        `;
            }

            function getSelectedUser() {
                const userId = userSelectEl.value || "";
                if (!userId) return null;

                return registryUsers.find(
                    user => String(user.id) === String(userId)
                ) || null;
            }

            function renderDetail() {
                if (!detailEl) return;

                const user = getSelectedUser();

                if (!user) {
                    detailEl.innerHTML = `
                <div class="alert alert-info mb-0">
                    Seleziona un utente e inserisci il nuovo login code.
                </div>
            `;
                    return;
                }

                const ruolo = user.current_role_description
                    || user.current_role_name
                    || "Nessun ruolo";

                detailEl.innerHTML = `
            <div class="mb-3">
                <h4 class="mb-1">${escapeHtml(user.username)}</h4>
                <div class="text-muted">
                    Ruolo attuale:
                    <strong>${escapeHtml(ruolo)}</strong>
                </div>
            </div>

            <div class="alert alert-warning mb-0">
                Il nuovo login code sostituirà quello precedente.
                Non è necessario conoscere il vecchio codice.
            </div>
        `;
            }

            async function resetLoginCode() {
                const user = getSelectedUser();
                const loginCode = String(codeInputEl.value || "").trim();

                if (!user) {
                    showFeedback("warning", "Seleziona prima un utente.");
                    return;
                }

                if (!loginCode) {
                    showFeedback("warning", "Inserisci il nuovo login code.");
                    return;
                }

                const confirmed = window.confirm(
                    `Confermi il reset del login code per "${user.username}"?`
                );

                if (!confirmed) {
                    return;
                }

                saveBtn.disabled = true;
                showFeedback("info", "Salvataggio in corso...");

                try {
                    const resp = await fetch(apiUrl("/api/impostazioni/reset-login-code"), {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "X-Requested-With": "XMLHttpRequest",
                        },
                        credentials: "same-origin",
                        body: JSON.stringify({
                            user_id: Number(user.id),
                            login_code: loginCode,
                        }),
                    });

                    let data = {};
                    try {
                        data = await resp.json();
                    } catch (_) {
                        data = {};
                    }

                    if (!resp.ok || data.ok === false) {
                        showFeedback(
                            "danger",
                            data.error || "Errore durante il reset del login code."
                        );
                        return;
                    }

                    codeInputEl.value = "";
                    showFeedback(
                        "success",
                        data.message || "Login code aggiornato correttamente."
                    );
                    renderDetail();

                } catch (err) {
                    console.error("Errore reset login code:", err);
                    showFeedback("danger", "Errore di comunicazione con il server.");
                } finally {
                    saveBtn.disabled = false;
                }
            }

            userSelectEl.addEventListener("change", () => {
                showFeedback("", "");
                renderDetail();
            });

            saveBtn.addEventListener("click", resetLoginCode);

            cancelBtn?.addEventListener("click", () => {
                userSelectEl.value = "";
                codeInputEl.value = "";
                showFeedback("", "");
                renderDetail();
            });

            renderDetail();
        })();
    </script>
    <script>
        (() => {
            const payload = window.homeConfigSettingsPayload || {};
            const TAB_SESSION = "{{ tab_session|default('', true)|e }}";

            function withTabSession(url) {
                if (!TAB_SESSION) return url;

                const parsed = new URL(url, window.location.origin);
                parsed.searchParams.set("tab_session", TAB_SESSION);

                return parsed.pathname + parsed.search;
            }

            function fetchOptions(extra = {}) {
                const headers = {
                    ...(extra.headers || {}),
                };

                if (TAB_SESSION) {
                    headers["X-Tab-Session"] = TAB_SESSION;
                }

                return {
                    ...extra,
                    headers,
                };
            }

            const section = document.getElementById("home-config-section");
            if (!section) return;

            const alertBox = document.getElementById("home-config-alert");

            function showAlert(type, message) {
                alertBox.className = `alert alert-${type}`;
                alertBox.textContent = message;
                alertBox.classList.remove("d-none");
            }

            function opt(value, label) {
                return `<option value="${String(value ?? "").replaceAll('"', '&quot;')}">${label ?? ""}</option>`;
            }

            function fillSelect(select, rows, valueKey, labelFn, emptyLabel = "") {
                if (!select) return;
                let html = emptyLabel ? opt("", emptyLabel) : "";
                html += (rows || []).map(row => opt(row[valueKey], labelFn(row))).join("");
                select.innerHTML = html;
            }

            function fillOptionsFromObject(select, obj, emptyLabel = "") {
                if (!select) return;
                let html = emptyLabel ? opt("", emptyLabel) : "";
                html += Object.entries(obj || {}).map(([k, v]) => opt(k, v)).join("");
                select.innerHTML = html;
            }

            function formToPayload(form) {
                const out = {};
                for (const el of form.elements) {
                    if (!el.name) continue;
                    if (el.type === "checkbox") out[el.name] = el.checked;
                    else out[el.name] = el.value;
                }
                return out;
            }

            async function postJson(url, body) {
                const resp = await fetch(
                    withTabSession(url),
                    fetchOptions({
                        method: "POST",
                        headers: {"Content-Type": "application/json"},
                        body: JSON.stringify(body),
                    })
                );

                const data = await resp.json().catch(() => ({}));

                if (!resp.ok || data.ok === false) {
                    throw new Error(data.error || `Errore HTTP ${resp.status}`);
                }

                return data;
            }

            async function reloadPayload() {
                const resp = await fetch(
                    withTabSession("{{ url_for('main.api_home_config_data') }}"),
                    fetchOptions()
                );

                const data = await resp.json();

                if (!data.ok) throw new Error(data.error || "Errore caricamento dati.");

                Object.assign(payload, data.data || {});
                renderTables();
                fillFormsOptions();
            }

            const formCfg = document.getElementById("form-home-config");
            const formRule = document.getElementById("form-home-rule");

            function fillFormsOptions() {
                fillSelect(formCfg.elements.reparto_id, payload.reparti, "id", r => `${r.codice} - ${r.descrizione}`);
                fillOptionsFromObject(formCfg.elements.template, payload.template_options);
                fillOptionsFromObject(formCfg.elements.renderer, payload.renderer_options);
                fillOptionsFromObject(formCfg.elements.metodo_documentale_tipo, payload.metodo_options);

                fillSelect(formRule.elements.reparto_id, payload.reparti, "id", r => `${r.codice} - ${r.descrizione}`);
                fillSelect(formRule.elements.role_id, payload.roles, "id", r => `${r.description || r.name}`);
                fillSelect(formRule.elements.user_id, payload.users, "id", u => u.username, "-- Seleziona utente --");
                fillOptionsFromObject(formRule.elements.apply_to, payload.apply_to_options);
                fillOptionsFromObject(formRule.elements.phase_mode, payload.phase_mode_options);
                fillOptionsFromObject(formRule.elements.metodo_documentale_tipo, payload.metodo_options, "Nessun override");
            }

            function setFormValues(form, row) {
                for (const el of form.elements) {
                    if (!el.name) continue;
                    if (el.type === "checkbox") el.checked = Boolean(row[el.name]);
                    else el.value = row[el.name] ?? "";
                }
            }

            function clearConfigForm() {
                formCfg.reset();
                formCfg.elements.id.value = "";
                formCfg.elements.permesso.value = "home";
                formCfg.elements.ordine_menu.value = "100";
                formCfg.elements.attivo.checked = true;
            }

            function clearRuleForm() {
                formRule.reset();
                formRule.elements.id.value = "";
                formRule.elements.scope_type.value = "role";
                formRule.elements.apply_to.value = "macchine";
                formRule.elements.phase_mode.value = "all";
                formRule.elements.attivo.checked = true;
            }

            function renderTables() {
                const tbodyCfg = document.querySelector("#tbl-home-config tbody");
                tbodyCfg.innerHTML = (payload.home_configs || []).map(row => `
            <tr>
                <td>${row.ordine_menu ?? ""}</td>
                <td>${row.reparto_codice ?? ""} - ${row.reparto_descrizione ?? ""}</td>
                <td>${row.label ?? ""}</td>
                <td>${row.tab_code ?? ""}</td>
                <td>${row.template ?? ""}</td>
                <td>${row.renderer ?? ""}</td>
                <td>${row.attivo ? "Sì" : "No"}</td>
                <td>
                    <button class="btn btn-sm btn-outline-primary" data-edit-home-config="${row.id}">
                        Modifica
                    </button>
                </td>
            </tr>
        `).join("");

                const tbodyRules = document.querySelector("#tbl-home-rules tbody");
                tbodyRules.innerHTML = (payload.visibility_rules || []).map(row => {
                    const scope = row.role_id
                        ? `Ruolo: ${row.role_description || row.role_name}`
                        : `Utente: ${row.username}`;
                    return `
                <tr>
                    <td>${row.reparto_codice ?? ""} - ${row.reparto_descrizione ?? ""}</td>
                    <td>${scope}</td>
                    <td>${row.apply_to ?? ""}</td>
                    <td>${row.phase_mode ?? ""}</td>
                    <td>${row.phase_values ?? ""}</td>
                    <td>${row.attivo ? "Sì" : "No"}</td>
                    <td class="d-flex gap-1">
                        <button class="btn btn-sm btn-outline-primary" data-edit-home-rule="${row.id}">
                            Modifica
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" data-toggle-home-rule="${row.id}">
                            ${row.attivo ? "Disattiva" : "Attiva"}
                        </button>
                    </td>
                </tr>
            `;
                }).join("");
            }

            document.addEventListener("click", async (e) => {
                const cfgId = e.target.closest("[data-edit-home-config]")?.dataset.editHomeConfig;
                if (cfgId) {
                    const row = (payload.home_configs || []).find(x => String(x.id) === String(cfgId));
                    if (row) setFormValues(formCfg, row);
                    return;
                }

                const ruleId = e.target.closest("[data-edit-home-rule]")?.dataset.editHomeRule;
                if (ruleId) {
                    const row = (payload.visibility_rules || []).find(x => String(x.id) === String(ruleId));
                    if (row) {
                        setFormValues(formRule, {
                            ...row,
                            scope_type: row.user_id ? "user" : "role",
                        });
                    }
                    return;
                }

                const toggleId = e.target.closest("[data-toggle-home-rule]")?.dataset.toggleHomeRule;
                if (toggleId) {
                    try {
                        await postJson(`/api/impostazioni/home-visibility-rule/${toggleId}/toggle`, {});
                        await reloadPayload();
                        showAlert("success", "Stato regola aggiornato.");
                    } catch (err) {
                        showAlert("danger", err.message);
                    }
                }
            });

            document.getElementById("btn-home-config-new")?.addEventListener("click", clearConfigForm);
            document.getElementById("btn-home-rule-new")?.addEventListener("click", clearRuleForm);

            formCfg.addEventListener("submit", async (e) => {
                e.preventDefault();
                try {
                    await postJson("{{ url_for('main.api_save_home_reparto_config') }}", formToPayload(formCfg));
                    await reloadPayload();
                    clearConfigForm();
                    showAlert("success", "Configurazione reparto salvata.");
                } catch (err) {
                    showAlert("danger", err.message);
                }
            });

            formRule.addEventListener("submit", async (e) => {
                e.preventDefault();
                const body = formToPayload(formRule);

                if (body.scope_type === "role") body.user_id = "";
                if (body.scope_type === "user") body.role_id = "";

                try {
                    await postJson("{{ url_for('main.api_save_home_visibility_rule') }}", body);
                    await reloadPayload();
                    clearRuleForm();
                    showAlert("success", "Regola visibilità salvata.");
                } catch (err) {
                    showAlert("danger", err.message);
                }
            });

            fillFormsOptions();
            renderTables();
        })();
    </script>
{% endblock %}