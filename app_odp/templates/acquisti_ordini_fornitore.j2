{% extends "base.j2" %}

{% block title %}Ordini acquisto{% endblock %}

{% block content %}
<main class="container-fluid py-3" id="purchase-orders-page">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h1 class="h3 mb-0">Ordini acquisto <small class="fs-6 text-muted" id="purchase-count" aria-live="polite"></small></h1>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal"
                    data-bs-target="#purchase-mail-template">Testo email sollecito</button>
            <a class="btn btn-outline-secondary" href="{{ operator_url_for('main.home_acquisti') }}">Torna agli acquisti</a>
            <button class="btn btn-primary js-view" type="button" data-view="list">Elenco</button>
            <button class="btn btn-outline-primary js-view" type="button" data-view="calendar">Calendario</button>
        </div>
    </div>

    {% with messages = get_flashed_messages(with_categories=true) %}
        {% for category, message in messages %}
            <div class="alert alert-{{ category }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Chiudi"></button>
            </div>
        {% endfor %}
    {% endwith %}

    <div class="modal fade" id="purchase-mail-template" tabindex="-1" aria-labelledby="purchase-mail-title" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="purchase-mail-title">Testo email sollecito</h2>
                    <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Chiudi"></button>
                </div>
        <div class="modal-body">
            <form method="post" action="{{ operator_url_for('main.acquisti_testo_sollecito_update') }}">
                <input type="hidden" name="tab_session" value="{{ tab_session|default('') }}">
                <input type="hidden" name="csrf_token" value="{{ mail_template_csrf }}">
                <div class="mb-2">
                    <label class="form-label" for="purchase-mail-subject">Oggetto</label>
                    <input class="form-control" id="purchase-mail-subject" name="subject"
                           maxlength="200" required value="{{ mail_template.subject }}">
                </div>
                <div class="mb-2">
                    <label class="form-label" for="purchase-mail-body">Corpo della mail</label>
                    <textarea class="form-control" id="purchase-mail-body" name="body"
                              rows="8" maxlength="2000" required>{{ mail_template.body }}</textarea>
                </div>
                <p class="small text-muted">Inserisci i campi tra doppie parentesi graffe. Il programma li sostituirà con i dati della riga sollecitata.</p>
                <ul class="list-inline small mb-3">
                    {% for field, label in mail_fields.items() %}
                        <li class="list-inline-item me-3 mb-1"><code>{{ '{{' ~ field ~ '}}' }}</code> · {{ label }}</li>
                    {% endfor %}
                </ul>
                <button class="btn btn-primary btn-sm" type="submit">Salva testo</button>
                <span class="small text-muted ms-2">Salvato per il tuo utente. Il destinatario verrà inserito in Outlook.</span>
            </form>
        </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-2">
        <div class="card-body py-2 purchase-toolbar">
            <div class="d-flex flex-wrap gap-2 small" aria-label="Legenda ordini">
                <span class="text-nowrap"><i class="purchase-swatch purchase-orl"></i> Conto lavoro</span>
                <span class="text-nowrap"><i class="purchase-swatch purchase-ora"></i> Acquisto</span>
                <span class="text-nowrap"><i class="purchase-swatch purchase-overdue"></i> Consegna scaduta o odierna</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <label class="small text-nowrap" for="purchase-year">Anno consegna</label>
                <select id="purchase-year" class="form-select form-select-sm w-auto" aria-describedby="purchase-year-notice"></select>
                <span id="purchase-year-notice" class="small text-warning-emphasis text-nowrap" role="status"></span>
            </div>
            <div class="btn-group flex-shrink-0" role="group" aria-label="Filtra tipologia ordine">
                <button type="button" class="btn btn-sm btn-primary js-purchase-type-filter" data-type="all">Totale</button>
                <button type="button" class="btn btn-sm btn-outline-primary js-purchase-type-filter" data-type="ORL">Conto lavoro</button>
                <button type="button" class="btn btn-sm btn-outline-primary js-purchase-type-filter" data-type="ORA">Acquisto</button>
            </div>
            <input id="purchase-search" class="form-control form-control-sm" aria-label="Cerca negli ordini acquisto"
                   type="search" placeholder="Cerca ordine, fornitore, codice o descrizione">
        </div>
    </div>
    <section id="purchase-list">
        <div class="card shadow-sm">
            <div class="table-responsive purchase-table-scroll">
                <table class="table table-sm table-striped table-hover align-middle mb-0" id="purchase-table">
                    <thead class="sticky-top">
                    <tr>
                        <th>Numero Registrazione</th>
                        <th>Codice Articolo</th>
                        <th>Descrizione</th>
                        <th>Data di consegna</th>
                        <th>UdM</th>
                        <th class="text-end">Ordinato</th>
                        <th class="text-end">Consegnata</th>
                        <th class="text-end">Saldo documento</th>
                        <th>Commento</th>
                        <th>Stato</th>
                        <th style="min-width: 18rem">Note</th>
                        <th>Azioni</th>
                    </tr>
                    </thead>
                    {% for group in groups %}
                    {% set group_loop = loop %}
                    <tbody class="purchase-group" data-gruppo-doc="{{ group.GruppoDoc }}" data-documento="{{ group.IdDocumento }}">
                        <tr class="purchase-group-header {% if group.GruppoDoc == 'ORL' %}purchase-orl{% elif group.GruppoDoc == 'ORA' %}purchase-ora{% endif %}{% if group.ConsegnaCritica %} purchase-overdue{% endif %}">
                            <td colspan="12">
                                <strong>Numero Registrazione {{ group.NumRegistraz }}</strong>
                                <span class="ms-3">{{ group.Fornitore or 'Fornitore non trovato' }} ({{ group.CodFornitore }})</span>
                                <span class="badge text-bg-light ms-2">{{ group.Righe|length }} righe</span>
                            </td>
                        </tr>
                        {% for row in group.Righe %}
                        <tr data-delivery-year="{{ row.DataConsegnaIso[:4] }}"
                            data-mail-order="{{ row.NumRegistraz }}" data-mail-article="{{ row.CodArt }}"
                            data-mail-description="{{ row.DesArt }}" data-mail-delivery="{{ row.DataConsegnaText }}"
                            data-mail-quantity="{{ row.QtaSaldo }}" data-mail-unit="{{ row.UmDoc }}"
                            data-mail-supplier="{{ group.Fornitore or group.CodFornitore }}"
                            data-mail-reminders="{{ row.NumeroSolleciti }}"
                            class="purchase-line {% if row.GruppoDoc == 'ORL' %}purchase-orl{% elif row.GruppoDoc == 'ORA' %}purchase-ora{% endif %}{% if row.ConsegnaCritica %} purchase-overdue{% endif %}">
                            <td>{{ row.NumRegistraz }}</td>
                            <td>{{ row.CodArt }}</td>
                            <td>{{ row.DesArt }}</td>
                            <td>{{ row.DataConsegnaText or 'Non indicata' }}</td>
                            <td>{{ row.UmDoc }}</td>
                            <td class="text-end">{{ row.QtaOrd }}</td>
                            <td class="text-end">{{ row.QtaCons }}</td>
                            <td class="text-end">{{ row.QtaSaldo }}</td>
                            <td>{{ row.CommentoRigaSaldata }}</td>
                            <td>
                                <span class="badge text-bg-{{ 'warning' if row.Sollecitato else 'secondary' }}">
                                    {{ row.Stato }}
                                </span>
                                <small class="js-sollecito-date d-block mt-1{% if not row.SollecitatoAt %} d-none{% endif %}"
                                       data-sollecitato-at="{{ row.SollecitatoAt }}">
                                    Ultimo sollecito il <span></span>
                                </small>
                            </td>
                            <td>
                                <form id="purchase-{{ group_loop.index0 }}-{{ loop.index0 }}" method="post"
                                      action="{{ operator_url_for('main.acquisti_ordine_fornitore_update') }}">
                                    <input type="hidden" name="id_documento" value="{{ row.IdDocumento }}">
                                    <input type="hidden" name="id_riga" value="{{ row.IdRigaDoc }}">
                                    <textarea class="form-control form-control-sm" name="note" maxlength="2000"
                                              rows="2" placeholder="Note acquisti">{{ row.Note }}</textarea>
                                    {% if row.NoteErp %}
                                        <small class="text-muted">Gestionale: {{ row.NoteErp }}</small>
                                    {% endif %}
                                </form>
                            </td>
                            <td>
                                <div class="d-grid gap-1">
                                    <button class="btn btn-sm btn-outline-primary" type="submit" name="action"
                                            value="note" form="purchase-{{ group_loop.index0 }}-{{ loop.index0 }}">Salva</button>
                                    <button class="btn btn-sm btn-warning purchase-reminder-button" type="submit" name="action"
                                            value="sollecita" form="purchase-{{ group_loop.index0 }}-{{ loop.index0 }}"
                                            >Sollecita ({{ row.NumeroSolleciti }})</button>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                    {% endfor %}
                    <tbody id="purchase-empty" class="d-none"><tr><td colspan="12" class="text-center text-muted py-4">Nessun ordine corrisponde ai filtri selezionati.</td></tr></tbody>
                </table>
            </div>
        </div>
    </section>

    <section id="purchase-calendar" class="d-none">
        <div class="card shadow-sm">
            <div class="card-header d-flex align-items-center justify-content-between gap-2">
                <button class="btn btn-sm btn-outline-secondary" type="button" id="calendar-prev">‹</button>
                <h2 class="h5 mb-0" id="calendar-title"></h2>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-primary" type="button" id="calendar-today">Oggi</button>
                    <button class="btn btn-sm btn-outline-secondary" type="button" id="calendar-next">›</button>
                </div>
            </div>
            <div class="card-body p-2">
                <div class="calendar-grid calendar-weekdays text-center fw-semibold">
                    {% for day in ['Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab', 'Dom'] %}<div>{{ day }}</div>{% endfor %}
                </div>
                <div class="calendar-grid" id="calendar-grid"></div>
            </div>
        </div>
    </section>

    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div id="purchase-calendar-toast" class="toast purchase-calendar-toast" role="status"
             aria-live="polite" aria-atomic="true" data-bs-autohide="false">
            <div class="toast-header">
                <strong class="me-auto" id="purchase-toast-title">Dettaglio ordine</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Chiudi"></button>
            </div>
            <div class="toast-body" id="purchase-toast-body"></div>
        </div>
    </div>
</main>

<style>
    body:has(> #purchase-orders-page) { display: flex; flex-direction: column; height: 100vh; height: 100dvh; overflow: hidden; }
    body:has(> #purchase-orders-page) > .app-header,
    body:has(> #purchase-orders-page) > .alert,
    #purchase-orders-page > :not(#purchase-list, #purchase-calendar) { flex: 0 0 auto; }
    #purchase-orders-page,
    #purchase-list, #purchase-calendar,
    #purchase-list > .card, #purchase-calendar > .card { display: flex; flex-direction: column; flex: 1 1 0; min-height: 0; overflow: hidden; }
    #purchase-orders-page .purchase-table-scroll { flex: 1 1 0; min-height: 0; max-height: none; overflow: auto; }
    #purchase-calendar .card-header, #purchase-calendar .calendar-weekdays { flex: 0 0 auto; }
    #purchase-calendar .card-body { display: flex; flex-direction: column; min-height: 0; }
    #purchase-calendar #calendar-grid { flex: 1 1 0; min-height: 0; grid-auto-rows: minmax(0, 1fr); }
    .purchase-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; }
    .purchase-toolbar #purchase-search { flex: 1 1 14rem; max-width: 24rem; min-width: 12rem; margin-left: auto; }
    #purchase-table thead th { background: #f8f9fa !important; color: #212529 !important; }
    #purchase-table .purchase-group-header > * { font-weight: 500; border-top: 2px solid #495057; }
    #purchase-table tr.purchase-orl > *, .purchase-swatch.purchase-orl { background: #ffd39b !important; color: #212529 !important; }
    #purchase-table tr.purchase-ora > *, .purchase-swatch.purchase-ora { background: #b9dcff !important; color: #212529 !important; }
    #purchase-table tr.purchase-line.purchase-overdue > td:first-child,
    .purchase-swatch.purchase-overdue { background: #f5aeb5 !important; color: #212529 !important; }
    .purchase-swatch { display: inline-block; width: 1rem; height: 1rem; border: 1px solid #495057; border-radius: .2rem; vertical-align: -.15rem; }
    .calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
    .calendar-weekdays > div { padding: .5rem; background: var(--bs-info-bg-subtle); }
    .calendar-day { min-height: 0; padding: .4rem; border: 1px solid var(--bs-border-color); overflow: hidden; }
    .calendar-day.today { background: var(--bs-danger-bg-subtle); }
    .calendar-event { display: block; width: 100%; margin-top: .3rem; padding: .25rem .35rem; border: 0; border-radius: .25rem; background: var(--bs-primary-bg-subtle); font-size: .78rem; text-align: left; }
    .calendar-event.sollecitato { background: var(--bs-warning-bg-subtle); }
    .calendar-event.purchase-orl { background: #ffd39b; }
    .calendar-event.purchase-ora { background: #b9dcff; }
    .calendar-event.purchase-overdue { background: #f5aeb5; }
    .purchase-calendar-toast { width: min(60rem, calc(100vw - 2rem)); max-width: none; }
    .purchase-toast-matching > * { background: #fff3cd !important; font-weight: 600; }
    .purchase-reminder-truck { position: fixed; z-index: 1080; margin: 0; overflow: visible; pointer-events: none; animation-name: purchase-van-exit, purchase-van-return; animation-duration: 1.7s, 1.7s; animation-timing-function: ease-in-out; animation-fill-mode: forwards; }
    .purchase-reminder-truck::before { content: ""; position: absolute; left: -.85rem; bottom: 0; width: 1rem; height: 1.15rem; background: #ffc107; border: 1px solid #212529; border-radius: .5rem 0 0 .2rem; }
    .purchase-reminder-truck::after { content: "●    ●"; position: absolute; left: -.55rem; right: .2rem; bottom: -.7rem; color: #212529; font-size: .7rem; letter-spacing: .35rem; white-space: nowrap; }
    @keyframes purchase-van-exit { from { transform: translate(0, 0); } to { transform: translate(var(--trip-exit-x), var(--trip-exit-y)); } }
    @keyframes purchase-van-return { from { transform: translate(var(--trip-enter-x), 0); } to { transform: translate(0, 0); } }
    @media (max-width: 767px) { .calendar-event { font-size: .68rem; } }
</style>
{% endblock %}

{% block extra_js %}
{{ super() }}
<script>
(() => {
    const events = {{ calendar_events|tojson }};
    const mailTemplate = {{ mail_template|tojson }};
    const list = document.getElementById("purchase-list");
    const calendar = document.getElementById("purchase-calendar");
    const title = document.getElementById("calendar-title");
    const grid = document.getElementById("calendar-grid");
    const toastElement = document.getElementById("purchase-calendar-toast");
    const toastTitle = document.getElementById("purchase-toast-title");
    const toastBody = document.getElementById("purchase-toast-body");
    let shown = new Date();
    const yearSelect = document.getElementById("purchase-year");
    const purchaseGroups = Array.from(document.querySelectorAll("#purchase-table tbody.purchase-group"));
    const deliveryYears = Array.from(document.querySelectorAll("#purchase-table .purchase-line"))
        .map(row => row.dataset.deliveryYear);
    const years = Array.from(new Set(deliveryYears.filter(Boolean))).sort().reverse();
    years.forEach(year => yearSelect.add(new Option(year, year)));
    if (deliveryYears.includes("")) yearSelect.add(new Option("Senza data", ""));
    const currentYear = String(shown.getFullYear());
    yearSelect.value = years.includes(currentYear) ? currentYear : years[0] || "";
    yearSelect.disabled = !deliveryYears.length;
    document.getElementById("purchase-year-notice").textContent = years.length > 1
        ? `${years.length} anni presenti` : "";
    if (yearSelect.value) shown = new Date(Number(yearSelect.value), shown.getMonth(), 1);
    let visibleDocuments = new Set();

    function escapeHtml(value) {
        const el = document.createElement("div");
        el.textContent = value ?? "";
        return el.innerHTML;
    }

    function formatReminderDate(value) {
        const date = new Date(value);
        return Number.isNaN(date.getTime()) ? value.replace("T", " ") : date.toLocaleString("it-IT", {dateStyle: "short", timeStyle: "short"});
    }

    document.querySelectorAll(".js-sollecito-date").forEach(element => {
        element.querySelector("span").textContent = formatReminderDate(element.dataset.sollecitatoAt);
    });

    function renderCalendar() {
        const year = shown.getFullYear();
        const month = shown.getMonth();
        const first = new Date(year, month, 1);
        const days = new Date(year, month + 1, 0).getDate();
        const offset = (first.getDay() + 6) % 7;
        const today = new Date();
        title.textContent = first.toLocaleDateString("it-IT", {month: "long", year: "numeric"});
        grid.innerHTML = "";
        for (let i = 0; i < offset; i += 1) grid.insertAdjacentHTML("beforeend", '<div class="calendar-day"></div>');
        for (let day = 1; day <= days; day += 1) {
            const key = `${year}-${String(month + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
            const isToday = today.getFullYear() === year && today.getMonth() === month && today.getDate() === day;
            const dayEvents = events.map((event, index) => ({event, index}))
                .filter(item => item.event.date === key && item.event.date.slice(0, 4) === yearSelect.value
                    && visibleDocuments.has(item.event.id_documento));
            const html = dayEvents.map(({event, index}) => {
                const typeClass = event.gruppo_doc === "ORL" ? "purchase-orl" : "purchase-ora";
                return `<button type="button" class="calendar-event ${typeClass} ${event.sollecitato ? "sollecitato" : ""}" data-event-index="${index}">${escapeHtml(event.title)}</button>`;
            }).join("");
            grid.insertAdjacentHTML("beforeend", `<div class="calendar-day ${isToday ? "today" : ""}"><strong>${day}</strong>${html}</div>`);
        }
        document.getElementById("calendar-prev").disabled = month === 0 || !yearSelect.value;
        document.getElementById("calendar-next").disabled = month === 11 || !yearSelect.value;
        document.getElementById("calendar-today").disabled = !years.includes(currentYear);
    }

    document.querySelectorAll(".js-view").forEach(button => button.addEventListener("click", () => {
        const showCalendar = button.dataset.view === "calendar";
        list.classList.toggle("d-none", showCalendar);
        calendar.classList.toggle("d-none", !showCalendar);
        document.querySelectorAll(".js-view").forEach(item => {
            const active = item === button;
            item.classList.toggle("btn-primary", active);
            item.classList.toggle("btn-outline-primary", !active);
        });
        if (showCalendar) renderCalendar();
    }));
    document.getElementById("calendar-prev").addEventListener("click", () => { shown = new Date(shown.getFullYear(), shown.getMonth() - 1, 1); renderCalendar(); });
    document.getElementById("calendar-next").addEventListener("click", () => { shown = new Date(shown.getFullYear(), shown.getMonth() + 1, 1); renderCalendar(); });
    document.getElementById("calendar-today").addEventListener("click", () => {
        yearSelect.value = currentYear;
        shown = new Date();
        applyListFilters();
    });
    grid.addEventListener("click", event => {
        const button = event.target.closest("[data-event-index]");
        if (!button) return;
        const order = events[Number(button.dataset.eventIndex)];
        if (!order) return;
        const columns = [
            ["numero_registrazione", "Numero Registrazione"],
            ["codice_articolo", "Codice Articolo"],
            ["descrizione", "Descrizione"],
            ["data_consegna", "Data di consegna"],
            ["udm", "UdM"],
            ["ordinato", "Ordinato"],
            ["consegnata", "Consegnata"],
            ["saldo_documento", "Saldo documento"],
            ["commento", "Commento"],
        ];
        toastTitle.textContent = `Numero Registrazione ${order.rows[0]?.numero_registrazione || ""} · ${order.date_text}`;
        const yearRows = order.rows.filter(row => row.data_consegna.endsWith("/" + yearSelect.value));
        toastBody.innerHTML = `<div class="table-responsive"><table class="table table-sm mb-0"><thead><tr>${columns.map(column => `<th>${column[1]}</th>`).join("")}</tr></thead><tbody>${yearRows.map(row => `<tr class="${row.evidenziata ? "purchase-toast-matching" : ""}">${columns.map(column => `<td>${escapeHtml(row[column[0]])}</td>`).join("")}</tr>`).join("")}</tbody></table></div>`;
        bootstrap.Toast.getOrCreateInstance(toastElement).show();
    });
    let groupFilter = "all";
    let searchNeedle = "";
    function applyListFilters() {
        let rowCount = 0;
        visibleDocuments = new Set();
        purchaseGroups.forEach(group => {
            const header = group.querySelector(".purchase-group-header");
            const yearRows = Array.from(group.querySelectorAll(".purchase-line")).filter(row => {
                const matchesYear = row.dataset.deliveryYear === yearSelect.value;
                row.classList.toggle("d-none", !matchesYear);
                return matchesYear;
            });
            const matchesType = groupFilter === "all" || group.dataset.gruppoDoc === groupFilter;
            const matchesSearch = !searchNeedle || header.textContent.toLocaleLowerCase("it").includes(searchNeedle)
                || yearRows.some(row => row.textContent.toLocaleLowerCase("it").includes(searchNeedle));
            const visible = yearRows.length > 0 && matchesType && matchesSearch;
            group.classList.toggle("d-none", !visible);
            header.querySelector(".badge").textContent = `${yearRows.length} righe`;
            const overdue = yearRows.some(row => row.classList.contains("purchase-overdue"));
            header.classList.toggle("purchase-overdue", overdue);
            header.classList.toggle("purchase-orl", group.dataset.gruppoDoc === "ORL");
            header.classList.toggle("purchase-ora", group.dataset.gruppoDoc === "ORA");
            if (visible) {
                visibleDocuments.add(group.dataset.documento);
                rowCount += yearRows.length;
            }
        });
        document.getElementById("purchase-count").textContent = `${visibleDocuments.size} ordini · ${rowCount} righe aperte`;
        document.getElementById("purchase-empty").classList.toggle("d-none", rowCount > 0);
        if (toastElement) window.bootstrap?.Toast.getInstance(toastElement)?.hide();
        if (!calendar.classList.contains("d-none")) renderCalendar();
    }
    yearSelect.addEventListener("change", () => {
        shown = new Date(Number(yearSelect.value) || Number(currentYear), shown.getMonth(), 1);
        applyListFilters();
    });
    document.getElementById("purchase-search").addEventListener("input", event => {
        searchNeedle = event.target.value.trim().toLocaleLowerCase("it");
        applyListFilters();
    });
    document.querySelectorAll(".js-purchase-type-filter").forEach(button => button.addEventListener("click", () => {
        groupFilter = button.dataset.type;
        document.querySelectorAll(".js-purchase-type-filter").forEach(item => {
            const active = item === button;
            item.classList.toggle("btn-primary", active);
            item.classList.toggle("btn-outline-primary", !active);
        });
        applyListFilters();
    }));
    applyListFilters();
    function reminderMailto(row) {
        const order = row.dataset;
        const fields = {
            numero_ordine: order.mailOrder,
            fornitore: order.mailSupplier,
            codice_articolo: order.mailArticle,
            descrizione_articolo: order.mailDescription,
            data_consegna: order.mailDelivery,
            quantita_residua: order.mailQuantity,
            unita_misura: order.mailUnit,
            numero_solleciti: order.mailReminders,
        };
        const replaceFields = text => text.replace(/\{\{\s*([a-z_]+)\s*\}\}/g, (_, field) => fields[field] ?? "");
        const subject = replaceFields(mailTemplate.subject);
        const body = replaceFields(mailTemplate.body).replace(/\r?\n/g, "\r\n");
        return `mailto:?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    }

    function runReminderTraffic(button, count, onComplete) {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            onComplete();
            return;
        }
        const rect = button.getBoundingClientRect();
        const left = -(rect.right + 80);
        const right = window.innerWidth - rect.left + 80;
        const up = -(rect.bottom + 80);
        const down = window.innerHeight - rect.top + 80;
        button.style.visibility = "hidden";
        let finished = 0;
        const returnStart = (count - 1) * 260 + 1700;
        for (let index = 0; index < count; index += 1) {
            const randomX = Math.random() * window.innerWidth - rect.left;
            const randomY = Math.random() * window.innerHeight - rect.top;
            const [exitX, exitY] = [
                [left, randomY], [right, randomY], [randomX, up], [randomX, down],
            ][index % 4];
            const truck = button.cloneNode(true);
            truck.classList.add("purchase-reminder-truck");
            truck.style.visibility = "visible";
            truck.removeAttribute("form");
            truck.disabled = true;
            truck.style.left = `${rect.left}px`;
            truck.style.top = `${rect.top}px`;
            truck.style.width = `${rect.width}px`;
            truck.style.height = `${rect.height}px`;
            truck.style.setProperty("--trip-exit-x", `${exitX}px`);
            truck.style.setProperty("--trip-exit-y", `${exitY}px`);
            truck.style.setProperty("--trip-enter-x", `${left}px`);
            truck.style.animationDelay = `${index * 260}ms, ${returnStart + index * 260}ms`;
            truck.addEventListener("animationend", event => {
                if (event.animationName !== "purchase-van-return") return;
                truck.remove();
                finished += 1;
                if (finished === count) {
                    button.style.visibility = "";
                    onComplete();
                }
            });
            document.body.appendChild(truck);
        }
    }
    document.querySelectorAll("#purchase-table form").forEach(form => form.addEventListener("submit", async event => {
        event.preventDefault();
        const button = event.submitter;
        if (!button) return;
        const originalLabel = button.textContent;
        button.disabled = true;
        const body = new FormData(form);
        body.set("action", button.value);
        try {
            const response = await (window.avpFetch || window.fetch)(form.getAttribute("action"), {
                method: "POST",
                headers: {"X-Requested-With": "XMLHttpRequest", "Accept": "application/json"},
                credentials: "same-origin",
                body,
            });
            if (response.redirected) {
                window.location.assign(response.url);
                return;
            }
            const contentType = response.headers.get("Content-Type") || "";
            if (!contentType.includes("application/json")) {
                throw new Error(`Risposta non valida dal server (${response.status}).`);
            }
            const data = await response.json();
            if (!response.ok || data.ok === false) throw new Error(data.error || "Salvataggio non riuscito.");
            const row = form.closest("tr");
            if (button.value === "sollecita") {
                const badge = row.querySelector(".badge");
                badge.textContent = data.stato;
                badge.classList.toggle("text-bg-warning", data.sollecitato);
                badge.classList.toggle("text-bg-secondary", !data.sollecitato);
                const date = row.querySelector(".js-sollecito-date");
                date.classList.toggle("d-none", !data.sollecitato);
                date.querySelector("span").textContent = data.sollecitato ? formatReminderDate(data.sollecitato_at) : "";
                events.filter(item => item.id_documento === data.id_documento).forEach(item => {
                    item.sollecitato = data.sollecitato;
                    item.numero_solleciti = data.numero_solleciti;
                });
                button.textContent = `Sollecita (${data.numero_solleciti})`;
                row.dataset.mailReminders = String(data.numero_solleciti);
                const mailto = reminderMailto(row);
                runReminderTraffic(button, data.numero_solleciti, () => {
                    window.location.href = mailto;
                });
                button.disabled = false;
            } else {
                button.textContent = "Salvato";
                window.setTimeout(() => { button.textContent = originalLabel; }, 1200);
            }
        } catch (error) {
            alert(error.message || "Errore durante il salvataggio.");
            button.disabled = false;
        } finally {
            button.disabled = false;
        }
    }));
})();
</script>
{% endblock %}
