{% extends "base.j2" %}

{% block title %}Ordini acquisto{% endblock %}

{% block content %}
<main class="container-fluid py-3">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1">Ordini acquisto</h1>
            <div class="text-muted">Ordini fornitore e conto lavoro aperti dal gestionale</div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="{{ url_for('main.home_acquisti') }}">Torna agli acquisti</a>
            <button class="btn btn-primary js-view" type="button" data-view="list">Elenco</button>
            <button class="btn btn-outline-primary js-view" type="button" data-view="calendar">Calendario</button>
        </div>
    </div>

    {% with messages = get_flashed_messages(with_categories=true) %}
        {% for category, message in messages %}
            <div class="alert alert-{{ category }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Chiudi"></button>
            </div>
        {% endfor %}
    {% endwith %}

    <section id="purchase-list">
        <div class="card shadow-sm">
            <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                <strong>{{ rows|length }} righe aperte</strong>
                <input id="purchase-search" class="form-control" style="max-width: 28rem"
                       type="search" placeholder="Cerca ordine, fornitore, codice o descrizione">
            </div>
            <div class="table-responsive" style="max-height: calc(100vh - 230px)">
                <table class="table table-sm table-striped table-hover align-middle mb-0" id="purchase-table">
                    <thead class="table-info sticky-top">
                    <tr>
                        <th>Ordine</th>
                        <th>Fornitore</th>
                        <th>Codice</th>
                        <th>Descrizione</th>
                        <th>Arrivo previsto</th>
                        <th class="text-end">Quantità</th>
                        <th>Stato</th>
                        <th style="min-width: 18rem">Note</th>
                        <th>Azioni</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for row in rows %}
                        <tr class="{% if row.ArrivaOggi %}table-danger{% endif %}">
                            <td>{{ row.Ordine }}</td>
                            <td>
                                <div>{{ row.Fornitore or 'Fornitore non trovato' }}</div>
                                <small class="text-muted">{{ row.CodFornitore }}</small>
                            </td>
                            <td>{{ row.CodArt }}</td>
                            <td>{{ row.DesArt }}</td>
                            <td>{{ row.DataConsegnaText or 'Non indicata' }}</td>
                            <td class="text-end text-nowrap">{{ row.Quantita }} {{ row.UmDoc }}</td>
                            <td>
                                <span class="badge text-bg-{{ 'warning' if row.Sollecitato else 'secondary' }}">
                                    {{ row.Stato }}
                                </span>
                            </td>
                            <td>
                                <form id="purchase-{{ loop.index }}" method="post"
                                      action="{{ url_for('main.acquisti_ordine_fornitore_update') }}">
                                    <input type="hidden" name="id_documento" value="{{ row.IdDocumento }}">
                                    <input type="hidden" name="id_riga" value="{{ row.IdRigaDoc }}">
                                    <textarea class="form-control form-control-sm" name="note" maxlength="2000"
                                              rows="2" placeholder="Note acquisti">{{ row.Note }}</textarea>
                                    {% if row.NoteErp %}
                                        <small class="text-muted">Gestionale: {{ row.NoteErp }}</small>
                                    {% endif %}
                                </form>
                            </td>
                            <td>
                                <div class="d-grid gap-1">
                                    <button class="btn btn-sm btn-outline-primary" type="submit" name="action"
                                            value="note" form="purchase-{{ loop.index }}">Salva</button>
                                    <button class="btn btn-sm btn-warning" type="submit" name="action"
                                            value="sollecita" form="purchase-{{ loop.index }}"
                                            {% if row.Sollecitato %}disabled{% endif %}>Sollecita</button>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="9" class="text-center text-muted py-4">Nessun ordine aperto.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section id="purchase-calendar" class="d-none">
        <div class="card shadow-sm">
            <div class="card-header d-flex align-items-center justify-content-between">
                <button class="btn btn-sm btn-outline-secondary" type="button" id="calendar-prev">‹</button>
                <h2 class="h5 mb-0" id="calendar-title"></h2>
                <button class="btn btn-sm btn-outline-secondary" type="button" id="calendar-next">›</button>
            </div>
            <div class="card-body p-2">
                <div class="calendar-grid calendar-weekdays text-center fw-semibold">
                    {% for day in ['Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab', 'Dom'] %}<div>{{ day }}</div>{% endfor %}
                </div>
                <div class="calendar-grid" id="calendar-grid"></div>
            </div>
        </div>
    </section>
</main>

<style>
    .calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
    .calendar-weekdays > div { padding: .5rem; background: var(--bs-info-bg-subtle); }
    .calendar-day { min-height: 8rem; padding: .4rem; border: 1px solid var(--bs-border-color); overflow: hidden; }
    .calendar-day.today { background: var(--bs-danger-bg-subtle); }
    .calendar-event { margin-top: .3rem; padding: .25rem .35rem; border-radius: .25rem; background: var(--bs-primary-bg-subtle); font-size: .78rem; }
    .calendar-event.sollecitato { background: var(--bs-warning-bg-subtle); }
    @media (max-width: 767px) { .calendar-day { min-height: 5rem; } .calendar-event { font-size: .68rem; } }
</style>
{% endblock %}

{% block extra_js %}
{{ super() }}
<script>
(() => {
    const events = {{ calendar_events|tojson }};
    const list = document.getElementById("purchase-list");
    const calendar = document.getElementById("purchase-calendar");
    const title = document.getElementById("calendar-title");
    const grid = document.getElementById("calendar-grid");
    let shown = new Date();

    function escapeHtml(value) {
        const el = document.createElement("div");
        el.textContent = value ?? "";
        return el.innerHTML;
    }

    function renderCalendar() {
        const year = shown.getFullYear();
        const month = shown.getMonth();
        const first = new Date(year, month, 1);
        const days = new Date(year, month + 1, 0).getDate();
        const offset = (first.getDay() + 6) % 7;
        const today = new Date();
        title.textContent = first.toLocaleDateString("it-IT", {month: "long", year: "numeric"});
        grid.innerHTML = "";
        for (let i = 0; i < offset; i += 1) grid.insertAdjacentHTML("beforeend", '<div class="calendar-day"></div>');
        for (let day = 1; day <= days; day += 1) {
            const key = `${year}-${String(month + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
            const isToday = today.getFullYear() === year && today.getMonth() === month && today.getDate() === day;
            const dayEvents = events.filter(event => event.date === key);
            const html = dayEvents.map(event =>
                `<div class="calendar-event ${event.sollecitato ? "sollecitato" : ""}">${escapeHtml(event.title)}</div>`
            ).join("");
            grid.insertAdjacentHTML("beforeend", `<div class="calendar-day ${isToday ? "today" : ""}"><strong>${day}</strong>${html}</div>`);
        }
    }

    document.querySelectorAll(".js-view").forEach(button => button.addEventListener("click", () => {
        const showCalendar = button.dataset.view === "calendar";
        list.classList.toggle("d-none", showCalendar);
        calendar.classList.toggle("d-none", !showCalendar);
        document.querySelectorAll(".js-view").forEach(item => {
            const active = item === button;
            item.classList.toggle("btn-primary", active);
            item.classList.toggle("btn-outline-primary", !active);
        });
        if (showCalendar) renderCalendar();
    }));
    document.getElementById("calendar-prev").addEventListener("click", () => { shown = new Date(shown.getFullYear(), shown.getMonth() - 1, 1); renderCalendar(); });
    document.getElementById("calendar-next").addEventListener("click", () => { shown = new Date(shown.getFullYear(), shown.getMonth() + 1, 1); renderCalendar(); });
    document.getElementById("purchase-search").addEventListener("input", event => {
        const needle = event.target.value.trim().toLocaleLowerCase("it");
        document.querySelectorAll("#purchase-table tbody tr").forEach(row => {
            row.classList.toggle("d-none", needle && !row.textContent.toLocaleLowerCase("it").includes(needle));
        });
    });
})();
</script>
{% endblock %}
