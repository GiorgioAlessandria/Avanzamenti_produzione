                        data-src="{{ operator_url_for('main.metodo_utilizzo_pdf') }}"
                        style="width: 100%; height: calc(100vh - 72px); border: 0;"></iframe>
            </div>
        </div>
    </div>
</div>
<div class="modal fade"
     id="modalEtichettaGenerata"
     tabindex="-1"
     aria-labelledby="modalEtichettaGenerataLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title"
                    id="modalEtichettaGenerataLabel">
                    Etichetta generata
                </h5>

                <button id="btn-stampa-etichetta-generata"
                        type="button"
                        class="btn btn-primary ms-auto me-2"
                        disabled>
                    Stampa etichetta
                </button>

                <a id="btn-apri-etichetta-nuova-scheda"
                   class="btn btn-outline-secondary me-2"
                   href="#"
                   target="_blank"
                   rel="noopener noreferrer">
                    Apri in una nuova scheda
                </a>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Chiudi"></button>
            </div>

            <div class="modal-body text-center">
                <div id="etichetta-generata-feedback"
                     class="alert d-none text-start"
