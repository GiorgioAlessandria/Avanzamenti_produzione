</div>
<div class="modal fade"
     id="modalRistampaEtichette"
     tabindex="-1"
     aria-labelledby="modalRistampaEtichetteLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"
                    id="modalRistampaEtichetteLabel">
                    Ristampa etichette
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Chiudi"></button>
            </div>

            <div class="modal-body">
                <div class="row g-2 align-items-end mb-3">
                    <div class="col-md-5">
                        <label for="ristampa-etichette-codart"
                               class="form-label">
                            Codice articolo
                        </label>
                        <input type="text"
                               id="ristampa-etichette-codart"
                               class="form-control"
                               autocomplete="off">
                    </div>

                    <div class="col-md-5">
                        <label for="ristampa-etichette-lotto"
                               class="form-label">
                            Lotto
                        </label>
                        <input type="text"
                               id="ristampa-etichette-lotto"
                               class="form-control"
                               autocomplete="off">
                    </div>

                    <div class="col-md-2 d-grid">
                        <button type="button"
                                id="btn-ristampa-etichette-cerca"
                                class="btn btn-primary">
                            Cerca
                        </button>
                    </div>
                </div>

                <div id="ristampa-etichette-feedback"
                     class="alert d-none"
                     role="alert"></div>

                <div class="table-responsive"
                     style="max-height: 55vh; overflow-y: auto;">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                        <tr>
                            <th>Data</th>
                            <th>Codice</th>
                            <th>Descrizione</th>
                            <th>Lotto</th>
                            <th class="text-end">Quantità</th>
                            <th class="text-center">Anteprima</th>
                            <th class="text-center">Stampa</th>
                        </tr>
                        </thead>
                        <tbody id="tbody-ristampa-etichette"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    window.AVP_TAB_SESSION = "{{ tab_session|default('') }}";
    window.AVP_ACTIVE_USERNAME = {{ (operator_user.username if operator_user else (current_user.username if current_user.is_authenticated else ""))|tojson }};
    window.AVP_ACTIVE_OPERATOR_BLOCK_MESSAGE = "Operatore gia impegnato su un altro ordine attivo. Sospendere o chiudere l'ordine prima di aprirne uno nuovo.";

    function avpOrderKeyFromObject(order) {
        if (!order) return "";
        const doc = order.id_documento || order.idDocumento || order.IdDocumento || "";
        const row = order.id_riga || order.idRiga || order.IdRiga || "";
        return doc && row ? `${doc}|${row}` : "";
    }

    function avpJsonBody(options) {
        try {
            return typeof options?.body === "string" ? JSON.parse(options.body) : {};
        } catch (_) {
            return {};
        }
    }

    window.avpHasConflictingActiveActivity = function (allowedOrders) {
        const username = String(window.AVP_ACTIVE_USERNAME || "").trim().toLowerCase();
        if (!username) return false;

        const allowed = new Set((allowedOrders || []).map(avpOrderKeyFromObject).filter(Boolean));
        const blocked = new Set();

        document.querySelectorAll("tr[data-operatore]").forEach((row) => {
            const rowUser = String(row.dataset.operatore || "").trim().toLowerCase();
            if (rowUser !== username) return;

            const stato = String(
                row.dataset.statoordine ||
                row.dataset.stato ||
                row.querySelector('[data-col="stato"]')?.textContent ||
                ""
            ).trim().toLowerCase();
            if (!stato.includes("attiv")) return;

            if (row.dataset.isWorkGroup === "1") {
                blocked.add(`GROUP:${row.dataset.groupUid || row.dataset.rowKey || ""}`);
                return;
            }

            const key = `${row.dataset.iddocumento || ""}|${row.dataset.idriga || ""}`;
            if (key && !allowed.has(key)) {
                blocked.add(key);
            }
        });

        return blocked.size > 0;
    };

    function avpOrdersAllowedForActivation(pathname, payload) {
        if (pathname === "/api/ordini/gruppi/multiplo/apri") {
            return payload.orders || [];
        }
        if (pathname === "/api/ordini/gruppi/misto/apri") {
            return [...(payload.condivisi || payload.orders || []), payload.mascherato || {}];
        }
        if (pathname === "/api/ordini/gruppi/mascherato/apri") {
            return [payload.principale || {}, payload.mascherato || {}];
        }
        return [];
    }

    window.avpActivationBlockMessage = function (urlValue, options) {
        const method = String(options?.method || "GET").toUpperCase();
        if (method !== "POST") return "";

        const pathname = new URL(urlValue, window.location.origin).pathname;
        const activationPaths = new Set([
            "/api/ordini/presa",
            "/api/ordini/riattiva",
            "/api/ordini/montaggio/macchina/riattiva",
            "/api/ordini/gruppi/riattiva"
        ]);
        const isGroupReactivate = pathname.startsWith("/api/ordini/gruppi/") && pathname.endsWith("/riattiva");
        const isGroupOpen = pathname === "/api/ordini/gruppi/multiplo/apri" ||
            pathname === "/api/ordini/gruppi/misto/apri" ||
            pathname === "/api/ordini/gruppi/mascherato/apri";

        if (!activationPaths.has(pathname) && !isGroupReactivate && !isGroupOpen) {
            return "";
        }

        const allowedOrders = isGroupOpen ? avpOrdersAllowedForActivation(pathname, avpJsonBody(options)) : [];
        return window.avpHasConflictingActiveActivity(allowedOrders)
            ? window.AVP_ACTIVE_OPERATOR_BLOCK_MESSAGE
            : "";
    };


    window.avpAddTabSessionToUrl = function (urlValue) {
        const token = window.AVP_TAB_SESSION || "";
        if (!token) {
            return urlValue;
        }

        const url = new URL(urlValue, window.location.origin);
        url.searchParams.set("tab_session", token);
        return url.toString();
    };

    window.avpFetch = function (urlValue, options) {
        options = options || {};
        options.headers = options.headers || {};

        const blockMessage = window.avpActivationBlockMessage?.(urlValue, options);
        if (blockMessage) {
            return Promise.resolve(new Response(
                JSON.stringify({ok: false, changed: false, error: blockMessage, message: blockMessage}),
                {status: 409, headers: {"Content-Type": "application/json"}}
            ));
        }

        const token = window.AVP_TAB_SESSION || "";

        if (token) {
            options.headers["X-Tab-Session"] = token;
            urlValue = window.avpAddTabSessionToUrl(urlValue);
        }

        return fetch(urlValue, options);
    };
</script>
