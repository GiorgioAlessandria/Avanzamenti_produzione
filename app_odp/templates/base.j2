{# templates/base.html #}
<!doctype html>
<html lang="it">
{% block head %}
    <meta name="viewport"
          content="width=device-width, initial-scale=1">
    <meta charset="utf-8">
    <title>{% block title %}Avanzamenti produzione{% endblock %}</title>
    {% block styles %}
        <link rel="stylesheet"
              href="{{ url_for('static', filename='assets/bootstrap/css/bootstrap.min.css') }}">
        <link rel="icon"
              href="{{ url_for('static', filename='assets/img/logo.ico') }}">
        <link rel="stylesheet"
              href="{{ url_for('static', filename='assets/css/table.css') }}">
        <link rel="stylesheet"
              href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <style>
            .ricerca-articolo-image-card-body {
                min-height: 180px;
                max-height: 240px;
                overflow: hidden;
            }

            .ricerca-articolo-image {
                max-height: 180px;
                max-width: 100%;
                object-fit: contain;
                cursor: zoom-in;
            }

            .ricerca-articolo-modal-body {
                max-height: 85vh;
                overflow: hidden;
            }

            .ricerca-articolo-results {
                display: flex;
                flex-direction: column;
                min-height: 0;
            }

            .ricerca-articolo-table-wrap {
                max-height: 320px;
                overflow-y: auto;
                min-height: 0;
            }

            .ricerca-articolo-table-wrap thead th {
                position: sticky;
                top: 0;
                z-index: 1;
                background: var(--bs-table-bg, #fff);
            }

            /* Offcanvas sempre sopra al backdrop */
            .offcanvas {
                z-index: 1055 !important;
            }

            .offcanvas-backdrop {
                z-index: 1050 !important;
            }
        </style>
    {% endblock %}
{% endblock head %}


<body>
{% macro cambia_pagina_dropdown(area_switch_items, home_switch_items) %}
    {% set has_area_items = area_switch_items|default([], true)|length > 0 %}
    {% set has_home_items = home_switch_items|default([], true)|length > 0 %}

    {% if has_area_items or has_home_items %}
        <div class="dropdown d-inline-flex"
             style="margin: 10px; position: relative;">
            <button class="btn btn-sm bg-white text-dark border dropdown-toggle px-2 py-1"
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                Cambia pagina
            </button>

            <ul class="dropdown-menu">
                {% if has_area_items %}
                    {% for it in area_switch_items %}
                        <li>
                            <a class="dropdown-item"
                               href="{{ it.url }}">
                                {{ it.label }}
                            </a>
                        </li>
                    {% endfor %}
                {% endif %}

                {% if has_area_items and has_home_items %}
                    <li>
                        <hr class="dropdown-divider">
                    </li>
                {% endif %}

                {% if has_home_items %}
                    {% for it in home_switch_items %}
                        <li>
                            <a class="dropdown-item"
                               href="{{ it.url }}">
                                {{ it.label }}
                            </a>
                        </li>
                    {% endfor %}
                {% endif %}
            </ul>
        </div>
    {% endif %}
{% endmacro %}
<header class="text-center w-auto m-auto"
        style="width: auto;height: auto;">
    <div class="container-fluid text-center d-flex w-100 h-100 flex-shrink-0 flex-fill justify-content-center align-items-center"
         style="width: auto;height: auto;">
        <div class="row d-inline-flex w-100 h-100 justify-content-center align-items-center align-self-center ms-0 me-0"
             style="width: auto;height: auto;">
            <div class="col-md-4 d-flex w-auto flex-grow-1 justify-content-start align-items-center pe-0"
                 style="width: auto;height: auto;">
                <button
                        class="btn btn-primary btn-lg text-center bg-light d-flex justify-content-center align-items-center"
                        type="button"
                        data-bs-target="#offcanvas-2"
                        data-bs-toggle="offcanvas">
                    <svg
                            class="icon icon-tabler icon-tabler-menu-2 text-center text-black text-bg-light d-flex justify-content-center align-items-center"
                            xmlns="http://www.w3.org/2000/svg"
                            width="1em"
                            height="1em"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            fill="none"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            style="font-size: 40px;">
                        <path stroke="none"
                              d="M0 0h24v24H0z"
                              fill="none"></path>
                        <path d="M4 6l16 0"></path>
                        <path d="M4 12l16 0"></path>
                        <path d="M4 18l16 0"></path>
                    </svg>
                </button>
            </div>
            <div class="col-md-4 d-flex w-auto flex-grow-1 justify-content-center align-items-center"
                 style="width: auto;height: auto;">
                {% set visible_user = operator_user if operator_user else current_user %}
                {% set visible_policy = operator_policy if operator_policy else policy %}
                {% set can_show_cambia_pagina =
                    visible_user
                    and visible_user.is_authenticated
                    and (
                        visible_user.has_role('responsabile_produzione')
                        or visible_user.has_role('responsabile_acquisti')
                ) %}

                {% if visible_user.genere|default('') == "m" %}
                    {% set genere = 'o' %}
                {% elif visible_user.genere|default('') == "f" %}
                    {% set genere = 'a' %}
                {% else %}
                    {% set genere = 'o/a' %}
                {% endif %}

                {% if operator_user %}
                    <h1 class="mb-0">
                        {% if visible_policy and visible_policy.allowed_reparti_descr %}
                            {{ visible_policy.allowed_reparti_descr[0] }}
                        {% else %}
                            {{ visible_user.RepartoPrinc }}
                        {% endif %}
                        - {{ visible_user.username }}
                    </h1>

                    {% if can_show_cambia_pagina %}
                        {{ cambia_pagina_dropdown(area_switch_items, home_switch_items) }}
                    {% endif %}

                {% elif current_user.is_authenticated and current_user.has_role('responsabile_produzione') %}
                    <h1 class="mb-0">
                        Responsabile di produzione - Benvenut{{ genere }} {{ current_user.username }}
                    </h1>

                    {% if can_show_cambia_pagina %}
                        {{ cambia_pagina_dropdown(area_switch_items, home_switch_items) }}
                    {% endif %}

                {% elif current_user.is_authenticated and current_user.has_role('responsabile_acquisti') %}
                    <h1 class="mb-0">
                        Responsabile acquisti - Benvenut{{ genere }} {{ current_user.username }}
                    </h1>

                    {% if can_show_cambia_pagina %}
                        {{ cambia_pagina_dropdown(area_switch_items, home_switch_items) }}
                    {% endif %}

                {% elif current_user.is_authenticated and current_user.has_permission('home_acquisti') %}
                    <h1 class="mb-0">
                        Acquisti - Benvenut{{ genere }} {{ current_user.username }}
                    </h1>

                    {% if can_show_cambia_pagina %}
                        {{ cambia_pagina_dropdown(area_switch_items, home_switch_items) }}
                    {% endif %}

                {% elif current_user.is_authenticated and current_user.has_role('responsabile_qualita') %}
                    <h1 class="mb-0">
                        {% if policy and policy.allowed_reparti_descr %}
                            {{ policy.allowed_reparti_descr[0] }}
                        {% else %}
                            Qualità
                        {% endif %}
                            - Benvenut{{ genere }} {{ current_user.username }}
                    </h1>

                    {% if can_show_cambia_pagina %}
                        {{ cambia_pagina_dropdown(area_switch_items, home_switch_items) }}
                    {% endif %}

                {% elif current_user.is_authenticated %}
                    <h1 class="mb-0">
                        {% if policy and policy.allowed_reparti_descr %}
                            {{ policy.allowed_reparti_descr[0] }}
                        {% else %}
                            Home
                        {% endif %}
                            - Benvenut{{ genere }} {{ current_user.username }}
                    </h1>

                    {% if can_show_cambia_pagina %}
                        {{ cambia_pagina_dropdown(area_switch_items, home_switch_items) }}
                    {% endif %}
                {% endif %}
            </div>
            <div class="col-md-1 d-flex w-auto flex-grow-1 justify-content-end align-items-center"
                 style="width: auto; height: auto;">
                <div class="d-flex align-items-center gap-2 me-0">
                    <button class="btn btn-outline-secondary d-flex align-items-center gap-2"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#modalMetodoUtilizzo">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="20"
                             height="20"
                             fill="currentColor"
                             viewBox="0 0 16 16"
                             aria-hidden="true">
                            <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zM9.5 1.5V5H13L9.5 1.5z"/>
                            <path d="M4.5 11.5h1.25c.69 0 1.25-.56 1.25-1.25S6.44 9 5.75 9H4.5v2.5zm1.25-1H5.5V10h.25a.25.25 0 0 1 0 .5zM8 9h1.1c.83 0 1.4.55 1.4 1.25S9.93 11.5 9.1 11.5H8V9zm1 1v.5h.1c.28 0 .4-.08.4-.25S9.38 10 9.1 10H9zm2.5-1H14v1h-1.5v.5H14v1h-1.5v1H11.5V9z"/>
                        </svg>
                        <span>Metodo di utilizzo</span>
                    </button>
                    {% if visible_policy and visible_policy.can('home') %}
                        <button class="btn btn-outline-warning d-flex align-items-center gap-2"
                                type="button"
                                data-bs-toggle="modal"
                                data-bs-target="#modalSegnalaScorta">
                            <i class="bi bi-qr-code-scan"></i>
                            <span>Segnala scorta</span>
                        </button>
                    {% endif %}
                    {% if active_tab|default('') == 'montaggio' %}
                        <button class="btn btn-outline-secondary d-flex align-items-center gap-2"
                                type="button"
                                data-bs-toggle="modal"
                                data-bs-target="#modalRistampaEtichette">
                            <i class="bi bi-printer"></i>
                            <span>Ristampa etichette</span>
                        </button>
                    {% endif %}
                    <button class="btn btn-outline-secondary d-flex align-items-center gap-2"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#modalRicercaArticolo">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="20"
                             height="20"
                             fill="currentColor"
                             viewBox="0 0 16 16"
                             aria-hidden="true">
                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.398 1.398h-.001l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.866-3.834zm-5.242.656a5 5 0 1 1 0-10 5 5 0 0 1 0 10z"/>
                        </svg>
                        <span>Ricerca per articolo</span>
                    </button>
                </div>

                <img
                        class="img-fluid justify-content-end align-items-center"
                        width="250"
                        height="89"
                        src="{{ url_for('static', filename='assets/img/logo_completo.jpg') }}"
                        style="text-align: right;"
                        alt="logo_completo"/>
            </div>
        </div>
    </div>
</header>

{% include "partials/_nav_offcanvas.j2" %}
<div class="modal fade"
     id="modalRicercaArticolo"
     tabindex="-1"
     aria-labelledby="modalRicercaArticoloLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"
                    id="modalRicercaArticoloLabel">Ricerca per articolo</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Chiudi"></button>
            </div>
            <div class="modal-body ricerca-articolo-modal-body">
                <div class="row g-1 align-items-end mb-3">
                    <div class="col-md-4">
                        <label for="ricerca-articolo-codart"
                               class="form-label">Codice articolo</label>
                        <input type="text"
                               id="ricerca-articolo-codart"
                               class="form-control"
                               autocomplete="off"
                               required>
                    </div>
                    <div class="col-md-3">
                        <label for="ricerca-articolo-variante"
                               class="form-label">Variante</label>
                        <input type="text"
                               id="ricerca-articolo-variante"
                               class="form-control"
                               autocomplete="off">
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button type="button"
                                class="btn btn-primary w-100"
                                id="btn-ricerca-articolo-cerca">Cerca
                        </button>
                        <button type="button"
                                class="btn btn-outline-secondary w-100"
                                id="btn-ricerca-articolo-reset">Reset
                        </button>
                    </div>
                </div>

                <div id="ricerca-articolo-feedback"
                     class="alert d-none"
                     role="alert"></div>

                <div id="ricerca-articolo-loading"
                     class="d-none mb-3">
                    <div class="d-flex align-items-center gap-1">
                        <div class="spinner-border spinner-border-sm"
                             role="status"
                             aria-hidden="true"></div>
                        <span>Ricerca in corso...</span>
                    </div>
                </div>

                <div id="ricerca-articolo-results"
                     class="d-none ricerca-articolo-results">
                    <div class="row g-3">
                        <div class="col-lg-5">
                            <div class="card h-100">
                                <div class="card-header">Dettaglio componente</div>
                                <div class="card-body">
                                    <table class="table table-sm mb-0">
                                        <tbody>
                                        <tr>
                                            <th style="width: 180px;">CodArt</th>
                                            <td id="ricerca-articolo-out-codart"></td>
                                        </tr>
                                        <tr>
                                            <th>Variante</th>
                                            <td id="ricerca-articolo-out-variante"></td>
                                        </tr>
                                        <tr>
                                            <th>Revisione</th>
                                            <td id="ricerca-articolo-out-revisione"></td>
                                        </tr>
                                        <tr>
                                            <th>Descrizione</th>
                                            <td id="ricerca-articolo-out-descrizione"></td>
                                        </tr>
                                        <tr>
                                            <th>Giacenza totale</th>
                                            <td id="ricerca-articolo-out-giacenza"></td>
                                        </tr>
                                        <tr>
                                            <th>UdM</th>
                                            <td id="ricerca-articolo-out-um"></td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-7">
                            <div class="card h-100">
                                <div class="card-header">Immagine componente</div>
                                <div class="card-body ricerca-articolo-image-card-body d-flex justify-content-center align-items-center">
                                    <div class="w-100 text-center">
                                        <button type="button"
                                                id="ricerca-articolo-image-open"
                                                class="btn p-0 border-0 bg-transparent d-none"
                                                title="Apri immagine a schermo intero"
                                                aria-label="Apri immagine a schermo intero">
                                            <img id="ricerca-articolo-image"
                                                 class="img-fluid ricerca-articolo-image"
                                                 alt="Immagine componente">
                                        </button>

                                        <div id="ricerca-articolo-image-placeholder"
                                             class="border rounded p-5 text-muted">
                                            Immagine non disponibile
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr>

                    <h5 class="mb-3">Ordini in distinta base</h5>

                    <div id="ricerca-articolo-orders-message"
                         class="alert alert-warning d-none"></div>

                    <div class="table-responsive ricerca-articolo-table-wrap">
                        <table class="table table-sm table-striped table-hover align-middle mb-0">
                            <thead class="table-light">
                            <tr>
                                <th>Ordine</th>
                                <th>Codice prodotto finito</th>
                                <th>Variante</th>
                                <th>Revisione</th>
                                <th>Descrizione</th>
                                <th>Stato</th>
                                <th class="text-end">Quantità</th>
                            </tr>
                            </thead>
                            <tbody id="ricerca-articolo-orders-body"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade"
     id="modalRicercaArticoloImageFullscreen"
     tabindex="-1"
     aria-labelledby="modalRicercaArticoloImageFullscreenLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content bg-dark border-0">
            <div class="modal-header bg-dark border-0">
                <h5 class="modal-title text-white"
                    id="modalRicercaArticoloImageFullscreenLabel">
                    Immagine componente
                </h5>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Chiudi"></button>
            </div>

            <div class="modal-body d-flex justify-content-center align-items-center p-3">
                <img id="ricerca-articolo-image-fullscreen"
                     class="img-fluid"
                     alt="Immagine componente a schermo intero"
                     style="max-width: 100%; max-height: 100%; object-fit: contain;">
            </div>
        </div>
    </div>
</div>
<div class="modal fade"
     id="modalMetodoUtilizzo"
     tabindex="-1"
     aria-labelledby="modalMetodoUtilizzoLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"
                    id="modalMetodoUtilizzoLabel">
                    Metodo di utilizzo
                </h5>

                <a class="btn btn-outline-secondary ms-auto me-2"
                   href="{{ operator_url_for('main.metodo_utilizzo_pdf') }}"
                   target="_blank"
                   rel="noopener noreferrer">
                    Apri in una nuova scheda
                </a>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Chiudi"></button>
            </div>

            <div class="modal-body p-0">
                <iframe id="metodo-utilizzo-frame"
                        title="Metodo di utilizzo"
