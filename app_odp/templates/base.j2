{# templates/base.html #}
<!doctype html>
<html lang="it">
{% block head %}
    <meta name="viewport"
          content="width=device-width, initial-scale=1">
    <meta charset="utf-8">
    <title>{% block title %}Avanzamenti produzione{% endblock %}</title>
    {% block styles %}
        <link rel="stylesheet"
              href="{{ url_for('static', filename='assets/bootstrap/css/bootstrap.min.css') }}">
        <link rel="icon"
              href="{{ url_for('static', filename='assets/img/logo.ico') }}">
        <link rel="stylesheet"
              href="{{ url_for('static', filename='assets/css/table.css') }}">
        <link rel="stylesheet"
              href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <style>
            .ricerca-articolo-image-card-body {
                min-height: 180px;
                max-height: 240px;
                overflow: hidden;
            }

            .ricerca-articolo-image {
                max-height: 180px;
                max-width: 100%;
                object-fit: contain;
                cursor: zoom-in;
            }

            .ricerca-articolo-modal-body {
                max-height: 85vh;
                overflow: hidden;
            }

            .ricerca-articolo-results {
                display: flex;
                flex-direction: column;
                min-height: 0;
            }

            .ricerca-articolo-table-wrap {
                max-height: 320px;
                overflow-y: auto;
                min-height: 0;
            }

            .ricerca-articolo-table-wrap thead th {
                position: sticky;
                top: 0;
                z-index: 1;
                background: var(--bs-table-bg, #fff);
            }
        </style>
    {% endblock %}
{% endblock head %}


<body>
{% set visible_user = operator_user if operator_user else current_user %}
{% set visible_policy = operator_policy if operator_policy else policy %}
<header class="text-center w-auto m-auto"
        style="width: auto;height: auto;">
    <div class="container-fluid text-center d-flex w-100 h-100 flex-shrink-0 flex-fill justify-content-center align-items-center"
         style="width: auto;height: auto;">
        <div class="row d-inline-flex w-100 h-100 justify-content-center align-items-center align-self-center ms-0 me-0"
             style="width: auto;height: auto;">
            <div class="col-md-4 d-flex w-auto flex-grow-1 justify-content-start align-items-center pe-0"
                 style="width: auto;height: auto;">
                <button
                        class="btn btn-primary btn-lg text-center bg-light d-flex justify-content-center align-items-center"
                        type="button"
                        data-bs-target="#offcanvas-2"
                        data-bs-toggle="offcanvas">
                    <svg
                            class="icon icon-tabler icon-tabler-menu-2 text-center text-black text-bg-light d-flex justify-content-center align-items-center"
                            xmlns="http://www.w3.org/2000/svg"
                            width="1em"
                            height="1em"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            fill="none"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            style="font-size: 40px;">
                        <path stroke="none"
                              d="M0 0h24v24H0z"
                              fill="none"></path>
                        <path d="M4 6l16 0"></path>
                        <path d="M4 12l16 0"></path>
                        <path d="M4 18l16 0"></path>
                    </svg>
                </button>
            </div>
            <div class="col-md-4 d-flex w-auto flex-grow-1 justify-content-center align-items-center"
                 style="width: auto;height: auto;">
                {% if operator_user %}
                <h1 class="mb-0">
                    {% if visible_policy and visible_policy.allowed_reparti_descr %}
                        {{ visible_policy.allowed_reparti_descr[0] }}
                    {% else %}
                        {{ visible_user.RepartoPrinc }}
                    {% endif %}
                    - {{ visible_user.username }}
                </h1>
                {% elif current_user.is_authenticated and current_user.has_role('responsabile_produzione') %}
                {% if current_user.genere == "m" %}
                    {% set genere = 'o' %}
                {% elif current_user.genere == "f" %}
                    {% set genere = 'a' %}
                {% endif %}
                {% if operator_user %}
                    <h1 class="mb-0">Responsabile di produzione
                                     - Benvenut{{ genere }} {{ current_user.username }}</h1>
                    <div class="btn-group dropup d-flex"
                         style="margin: 10px;">

                        <button class=" dropdown-toggle btn-lg text-center d-flex w-100 h-100 flex-column justify-content-center ms-2
                me-2 mt-4 mb-4"
                                data-bs-toggle="dropdown"
                                type="button">
                            Cambia pagina
                        </button>

                        <ul class="dropdown-menu">
                            {% for it in home_switch_items %}
                                <li><h4><a class="dropdown-item"
                                           href="{{ it.url }}">{{ it.label }}</a></h4></li>
                            {% endfor %}
                        </ul>
                    </div>
                {% elif current_user.is_authenticated and current_user.has_role('responsabile_produzione') %}
                    <h1 class="mb-0">Responsabile acquisti
                                     - Benvenut{{ genere }} {{ current_user.username }}</h1>
                    <div class="btn-group dropup d-flex"
                         style="margin: 10px;">

                        <button class=" dropdown-toggle btn-lg text-center d-flex w-100 h-100 flex-column justify-content-center ms-2
                                    me-2 mt-4 mb-4"
                                data-bs-toggle="dropdown"
                                type="button">
                            Cambia pagina
                        </button>

                        <ul class="dropdown-menu">
                            {% for it in home_switch_items %}
                                <li><h4><a class="dropdown-item"
                                           href="{{ it.url }}">{{ it.label }}</a></h4></li>
                            {% endfor %}
                        </ul>
                    </div>

                {% elif current_user.is_authenticated and current_user.has_permission('home_acquisti') %}
                    <h1 class="mb-0">Acquisti - Benvenut{{ genere }} {{ current_user.username }}</h1>

                {% elif current_user.is_authenticated and current_user.has_role('responsabile_qualita') %}
                    <h1 class="mb-0">{{ policy.allowed_reparti_descr[0] }}
                        - Benvenut{{ genere }} {{ current_user.username }}</h1>

                {% elif current_user.is_authenticated %}
                    <h1 class="mb-0">{{ policy.allowed_reparti_descr[0] }}
                        - Benvenut{{ genere }} {{ current_user.username }}</h1>
                {% endif %}
            </div>
            <div class="col-md-1 d-flex w-auto flex-grow-1 justify-content-end align-items-center"
                 style="width: auto; height: auto;">
                <div class="d-flex align-items-center gap-2 me-0">
                    <button class="btn btn-outline-secondary d-flex align-items-center gap-2"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#modalMetodoUtilizzo">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="20"
                             height="20"
                             fill="currentColor"
                             viewBox="0 0 16 16"
                             aria-hidden="true">
                            <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zM9.5 1.5V5H13L9.5 1.5z"/>
                            <path d="M4.5 11.5h1.25c.69 0 1.25-.56 1.25-1.25S6.44 9 5.75 9H4.5v2.5zm1.25-1H5.5V10h.25a.25.25 0 0 1 0 .5zM8 9h1.1c.83 0 1.4.55 1.4 1.25S9.93 11.5 9.1 11.5H8V9zm1 1v.5h.1c.28 0 .4-.08.4-.25S9.38 10 9.1 10H9zm2.5-1H14v1h-1.5v.5H14v1h-1.5v1H11.5V9z"/>
                        </svg>
                        <span>Metodo di utilizzo</span>
                    </button>
                    {% if active_tab|default('') == 'montaggio' %}
                        <button class="btn btn-outline-secondary d-flex align-items-center gap-2"
                                type="button"
                                data-bs-toggle="modal"
                                data-bs-target="#modalRistampaEtichette">
                            <i class="bi bi-printer"></i>
                            <span>Ristampa etichette</span>
                        </button>
                    {% endif %}
                    <button class="btn btn-outline-secondary d-flex align-items-center gap-2"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#modalRicercaArticolo">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="20"
                             height="20"
                             fill="currentColor"
                             viewBox="0 0 16 16"
                             aria-hidden="true">
                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.398 1.398h-.001l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.866-3.834zm-5.242.656a5 5 0 1 1 0-10 5 5 0 0 1 0 10z"/>
                        </svg>
                        <span>Ricerca per articolo</span>
                    </button>
                </div>

                <img
                        class="img-fluid justify-content-end align-items-center"
                        width="250"
                        height="89"
                        src="{{ url_for('static', filename='assets/img/logo_completo.jpg') }}"
                        style="text-align: right;"
                        alt="logo_completo"/>
            </div>
        </div>
    </div>
</header>

{% include "partials/_nav_offcanvas.j2" %}
<div class="modal fade"
     id="modalRicercaArticolo"
     tabindex="-1"
     aria-labelledby="modalRicercaArticoloLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"
                    id="modalRicercaArticoloLabel">Ricerca per articolo</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Chiudi"></button>
            </div>
            <div class="modal-body ricerca-articolo-modal-body">
                <div class="row g-1 align-items-end mb-3">
                    <div class="col-md-4">
                        <label for="ricerca-articolo-codart"
                               class="form-label">Codice articolo</label>
                        <input type="text"
                               id="ricerca-articolo-codart"
                               class="form-control"
                               autocomplete="off"
                               required>
                    </div>
                    <div class="col-md-3">
                        <label for="ricerca-articolo-variante"
                               class="form-label">Variante</label>
                        <input type="text"
                               id="ricerca-articolo-variante"
                               class="form-control"
                               autocomplete="off">
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button type="button"
                                class="btn btn-primary w-100"
                                id="btn-ricerca-articolo-cerca">Cerca
                        </button>
                        <button type="button"
                                class="btn btn-outline-secondary w-100"
                                id="btn-ricerca-articolo-reset">Reset
                        </button>
                    </div>
                </div>

                <div id="ricerca-articolo-feedback"
                     class="alert d-none"
                     role="alert"></div>

                <div id="ricerca-articolo-loading"
                     class="d-none mb-3">
                    <div class="d-flex align-items-center gap-1">
                        <div class="spinner-border spinner-border-sm"
                             role="status"
                             aria-hidden="true"></div>
                        <span>Ricerca in corso...</span>
                    </div>
                </div>

                <div id="ricerca-articolo-results"
                     class="d-none ricerca-articolo-results">
                    <div class="row g-3">
                        <div class="col-lg-5">
                            <div class="card h-100">
                                <div class="card-header">Dettaglio componente</div>
                                <div class="card-body">
                                    <table class="table table-sm mb-0">
                                        <tbody>
                                        <tr>
                                            <th style="width: 180px;">CodArt</th>
                                            <td id="ricerca-articolo-out-codart"></td>
                                        </tr>
                                        <tr>
                                            <th>Variante</th>
                                            <td id="ricerca-articolo-out-variante"></td>
                                        </tr>
                                        <tr>
                                            <th>Revisione</th>
                                            <td id="ricerca-articolo-out-revisione"></td>
                                        </tr>
                                        <tr>
                                            <th>Descrizione</th>
                                            <td id="ricerca-articolo-out-descrizione"></td>
                                        </tr>
                                        <tr>
                                            <th>Giacenza totale</th>
                                            <td id="ricerca-articolo-out-giacenza"></td>
                                        </tr>
                                        <tr>
                                            <th>UdM</th>
                                            <td id="ricerca-articolo-out-um"></td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-7">
                            <div class="card h-100">
                                <div class="card-header">Immagine componente</div>
                                <div class="card-body ricerca-articolo-image-card-body d-flex justify-content-center align-items-center">
                                    <div class="w-100 text-center">
                                        <button type="button"
                                                id="ricerca-articolo-image-open"
                                                class="btn p-0 border-0 bg-transparent d-none"
                                                title="Apri immagine a schermo intero"
                                                aria-label="Apri immagine a schermo intero">
                                            <img id="ricerca-articolo-image"
                                                 class="img-fluid ricerca-articolo-image"
                                                 alt="Immagine componente">
                                        </button>

                                        <div id="ricerca-articolo-image-placeholder"
                                             class="border rounded p-5 text-muted">
                                            Immagine non disponibile
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr>

                    <h5 class="mb-3">Ordini in distinta base</h5>

                    <div id="ricerca-articolo-orders-message"
                         class="alert alert-warning d-none"></div>

                    <div class="table-responsive ricerca-articolo-table-wrap">
                        <table class="table table-sm table-striped table-hover align-middle mb-0">
                            <thead class="table-light">
                            <tr>
                                <th>Ordine</th>
                                <th>Codice prodotto finito</th>
                                <th>Variante</th>
                                <th>Revisione</th>
                                <th>Descrizione</th>
                                <th>Stato</th>
                                <th class="text-end">Quantità</th>
                            </tr>
                            </thead>
                            <tbody id="ricerca-articolo-orders-body"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade"
     id="modalRicercaArticoloImageFullscreen"
     tabindex="-1"
     aria-labelledby="modalRicercaArticoloImageFullscreenLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content bg-dark border-0">
            <div class="modal-header bg-dark border-0">
                <h5 class="modal-title text-white"
                    id="modalRicercaArticoloImageFullscreenLabel">
                    Immagine componente
                </h5>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Chiudi"></button>
            </div>

            <div class="modal-body d-flex justify-content-center align-items-center p-3">
                <img id="ricerca-articolo-image-fullscreen"
                     class="img-fluid"
                     alt="Immagine componente a schermo intero"
                     style="max-width: 100%; max-height: 100%; object-fit: contain;">
            </div>
        </div>
    </div>
</div>
<div class="modal fade"
     id="modalMetodoUtilizzo"
     tabindex="-1"
     aria-labelledby="modalMetodoUtilizzoLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"
                    id="modalMetodoUtilizzoLabel">
                    Metodo di utilizzo
                </h5>

                <a class="btn btn-outline-secondary ms-auto me-2"
                   href="{{ url_for('main.metodo_utilizzo_pdf') }}"
                   target="_blank"
                   rel="noopener noreferrer">
                    Apri in una nuova scheda
                </a>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Chiudi"></button>
            </div>

            <div class="modal-body p-0">
                <iframe id="metodo-utilizzo-frame"
                        title="Metodo di utilizzo"
                        src="about:blank"
                        data-src="{{ url_for('main.metodo_utilizzo_pdf') }}"
                        style="width: 100%; height: calc(100vh - 72px); border: 0;"></iframe>
            </div>
        </div>
    </div>
</div>
<div class="modal fade"
     id="modalEtichettaGenerata"
     tabindex="-1"
     aria-labelledby="modalEtichettaGenerataLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title"
                    id="modalEtichettaGenerataLabel">
                    Etichetta generata
                </h5>

                <button id="btn-stampa-etichetta-generata"
                        type="button"
                        class="btn btn-primary ms-auto me-2"
                        disabled>
                    Stampa etichetta
                </button>

                <a id="btn-apri-etichetta-nuova-scheda"
                   class="btn btn-outline-secondary me-2"
                   href="#"
                   target="_blank"
                   rel="noopener noreferrer">
                    Apri in una nuova scheda
                </a>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Chiudi"></button>
            </div>

            <div class="modal-body text-center">
                <div id="etichetta-generata-feedback"
                     class="alert d-none text-start"
                     role="alert"></div>

                <img id="img-etichetta-generata"
                     src=""
                     alt="Etichetta generata"
                     class="img-fluid border rounded"
                     style="max-height: 70vh;">
            </div>
        </div>
    </div>
</div>
<div class="modal fade"
     id="modalRistampaEtichette"
     tabindex="-1"
     aria-labelledby="modalRistampaEtichetteLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"
                    id="modalRistampaEtichetteLabel">
                    Ristampa etichette
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Chiudi"></button>
            </div>

            <div class="modal-body">
                <div class="row g-2 align-items-end mb-3">
                    <div class="col-md-5">
                        <label for="ristampa-etichette-codart"
                               class="form-label">
                            Codice articolo
                        </label>
                        <input type="text"
                               id="ristampa-etichette-codart"
                               class="form-control"
                               autocomplete="off">
                    </div>

                    <div class="col-md-5">
                        <label for="ristampa-etichette-lotto"
                               class="form-label">
                            Lotto
                        </label>
                        <input type="text"
                               id="ristampa-etichette-lotto"
                               class="form-control"
                               autocomplete="off">
                    </div>

                    <div class="col-md-2 d-grid">
                        <button type="button"
                                id="btn-ristampa-etichette-cerca"
                                class="btn btn-primary">
                            Cerca
                        </button>
                    </div>
                </div>

                <div id="ristampa-etichette-feedback"
                     class="alert d-none"
                     role="alert"></div>

                <div class="table-responsive"
                     style="max-height: 55vh; overflow-y: auto;">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                        <tr>
                            <th>Data</th>
                            <th>Codice</th>
                            <th>Descrizione</th>
                            <th>Lotto</th>
                            <th class="text-end">Quantità</th>
                            <th class="text-center">Anteprima</th>
                            <th class="text-center">Stampa</th>
                        </tr>
                        </thead>
                        <tbody id="tbody-ristampa-etichette"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% block content %}{% endblock %}
{% block extra_js %}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modalEl = document.getElementById("modalMetodoUtilizzo");
            const frameEl = document.getElementById("metodo-utilizzo-frame");

            if (!modalEl || !frameEl) return;

            modalEl.addEventListener("shown.bs.modal", function () {
                if (frameEl.src === "about:blank") {
                    frameEl.src = frameEl.dataset.src;
                }
            });

            modalEl.addEventListener("hidden.bs.modal", function () {
                frameEl.src = "about:blank";
            });
        });
    </script>
    <script>
        document.addEventListener("click", function (event) {
            const trigger = event.target.closest(
                '[data-use-selected][data-fill-target][data-bs-target][data-bs-toggle="toast"]'
            );
            if (!trigger) return;

            const tableSelector = trigger.getAttribute("data-use-selected");
            if (!tableSelector) return;

            const table = document.querySelector(tableSelector);
            if (!table) return;

            const selectedRow = table.querySelector("tbody tr.row-selected");
            if (selectedRow) return;

            event.preventDefault();
            event.stopPropagation();
            event.stopImmediatePropagation();

            alert("Seleziona prima una riga ordine.");
        }, true);
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modalEl = document.getElementById("modalRicercaArticolo");
            if (!modalEl) return;

            const codArtEl = document.getElementById("ricerca-articolo-codart");
            const varianteEl = document.getElementById("ricerca-articolo-variante");
            const btnCerca = document.getElementById("btn-ricerca-articolo-cerca");
            const btnReset = document.getElementById("btn-ricerca-articolo-reset");

            const feedbackEl = document.getElementById("ricerca-articolo-feedback");
            const loadingEl = document.getElementById("ricerca-articolo-loading");
            const resultsEl = document.getElementById("ricerca-articolo-results");

            const outCodArt = document.getElementById("ricerca-articolo-out-codart");
            const outVariante = document.getElementById("ricerca-articolo-out-variante");
            const outRevisione = document.getElementById("ricerca-articolo-out-revisione");
            const outDescrizione = document.getElementById("ricerca-articolo-out-descrizione");
            const outGiacenza = document.getElementById("ricerca-articolo-out-giacenza");
            const outUm = document.getElementById("ricerca-articolo-out-um");

            const imageEl = document.getElementById("ricerca-articolo-image");
            const imagePlaceholderEl = document.getElementById("ricerca-articolo-image-placeholder");
            const imageOpenEl = document.getElementById("ricerca-articolo-image-open");
            const fullscreenModalEl = document.getElementById("modalRicercaArticoloImageFullscreen");
            const fullscreenImageEl = document.getElementById("ricerca-articolo-image-fullscreen");

            const ordersMessageEl = document.getElementById("ricerca-articolo-orders-message");
            const ordersBodyEl = document.getElementById("ricerca-articolo-orders-body");

            function escapeHtml(value) {
                return String(value || "")
                    .replaceAll("&", "&amp;")
                    .replaceAll("<", "&lt;")
                    .replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;")
                    .replaceAll("'", "&#039;");
            }

            function resetResults() {
                feedbackEl.className = "alert d-none";
                feedbackEl.textContent = "";

                loadingEl.classList.add("d-none");
                resultsEl.classList.add("d-none");

                outCodArt.textContent = "";
                outVariante.textContent = "";
                outRevisione.textContent = "";
                outDescrizione.textContent = "";
                outGiacenza.textContent = "";
                outUm.textContent = "";

                imageEl.src = "";
                imageEl.classList.add("d-none");
                imagePlaceholderEl.classList.remove("d-none");

                if (imageOpenEl) {
                    imageOpenEl.classList.add("d-none");
                }
                if (fullscreenImageEl) {
                    fullscreenImageEl.src = "";
                }

                ordersMessageEl.textContent = "";
                ordersMessageEl.classList.add("d-none");
                ordersBodyEl.innerHTML = "";
            }

            function resetAll() {
                codArtEl.value = "";
                varianteEl.value = "";
                resetResults();
            }

            function showFeedback(message, type = "warning") {
                feedbackEl.className = `alert alert-${type}`;
                feedbackEl.textContent = message || "";
                if (!message) {
                    feedbackEl.classList.add("d-none");
                }
            }

            function renderOrders(rows, message) {
                ordersBodyEl.innerHTML = "";

                if (!rows || !rows.length) {
                    ordersMessageEl.textContent = message || "Non sono presenti ordini per questo componente.";
                    ordersMessageEl.classList.remove("d-none");
                    return;
                }

                ordersMessageEl.textContent = "";
                ordersMessageEl.classList.add("d-none");

                let html = "";
                for (const row of rows) {
                    html += `
                    <tr>
                        <td>${escapeHtml(row.Ordine)}</td>
                        <td>${escapeHtml(row.CodArtProdotto)}</td>
                        <td>${escapeHtml(row.VarianteProdotto)}</td>
                        <td>${escapeHtml(row.IndiceModificaProdotto)}</td>
                        <td>${escapeHtml(row.DescrizioneProdotto)}</td>
                        <td>${escapeHtml(row.Stato)}</td>
                        <td class="text-end">${escapeHtml(row.QuantitaComponente)}</td>
                    </tr>
                `;
                }
                ordersBodyEl.innerHTML = html;
            }

            async function eseguiRicerca() {
                const codArt = (codArtEl.value || "").trim();
                const variante = (varianteEl.value || "").trim();

                resetResults();

                if (!codArt) {
                    showFeedback("Codice articolo obbligatorio.", "warning");
                    codArtEl.focus();
                    return;
                }

                loadingEl.classList.remove("d-none");
                btnCerca.disabled = true;
                btnReset.disabled = true;

                try {
                    const resp = await fetch("/api/materiali/ricerca-articolo", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "X-Requested-With": "XMLHttpRequest"
                        },
                        credentials: "same-origin",
                        body: JSON.stringify({
                            cod_art: codArt,
                            variante_art: variante
                        })
                    });

                    const data = await resp.json();

                    loadingEl.classList.add("d-none");

                    if (!resp.ok || data.ok === false) {
                        showFeedback(data.error || "Errore durante la ricerca.", "danger");
                        return;
                    }

                    if (!data.found_component) {
                        showFeedback(
                            data.message || "Il codice inserito è errato oppure non è presente a gestionale.",
                            "warning"
                        );
                        return;
                    }

                    const component = data.component || {};
                    const image = data.image || {};

                    outCodArt.textContent = component.CodArt || "";
                    outVariante.textContent = component.VarianteArt || "-";
                    outRevisione.textContent = component.IndiceModifica || "-";
                    outDescrizione.textContent = component.DesArt || "";
                    outGiacenza.textContent = component.GiacenzaTotaleText || "0";
                    outUm.textContent = component.TecniciUm || component.MagUM || "-";

                    if (image.found && image.url) {
                        imageEl.src = image.url;
                        imageEl.classList.remove("d-none");
                        imagePlaceholderEl.classList.add("d-none");

                        if (imageOpenEl) {
                            imageOpenEl.classList.remove("d-none");
                        }
                        if (fullscreenImageEl) {
                            fullscreenImageEl.src = image.url;
                        }
                    } else {
                        imageEl.src = "";
                        imageEl.classList.add("d-none");
                        imagePlaceholderEl.classList.remove("d-none");

                        if (imageOpenEl) {
                            imageOpenEl.classList.add("d-none");
                        }
                        if (fullscreenImageEl) {
                            fullscreenImageEl.src = "";
                        }
                    }

                    renderOrders(data.orders || [], data.orders_message || "");
                    resultsEl.classList.remove("d-none");
                } catch (err) {
                    loadingEl.classList.add("d-none");
                    showFeedback("Errore di comunicazione con il server.", "danger");
                    console.error(err);
                } finally {
                    btnCerca.disabled = false;
                    btnReset.disabled = false;
                }
            }

            btnCerca.addEventListener("click", eseguiRicerca);
            btnReset.addEventListener("click", resetAll);
            if (imageOpenEl && fullscreenImageEl) {
                imageOpenEl.addEventListener("click", function () {
                    if (!fullscreenImageEl.src) return;

                    const modalEl = document.getElementById("modalRicercaArticoloImageFullscreen");
                    if (!modalEl || !window.bootstrap || !bootstrap.Modal) return;

                    const fullscreenModal = bootstrap.Modal.getOrCreateInstance(modalEl, {
                        backdrop: true,
                        keyboard: true,
                        focus: true,
                    });

                    fullscreenModal.show();
                });
            }

            modalEl.addEventListener("hidden.bs.modal", function () {
                resetAll();
            });
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const allFilters = document.querySelectorAll(".js-table-filter");

            allFilters.forEach((input) => {
                input.addEventListener("input", () => {
                    const tableId = input.dataset.targetTable;
                    if (tableId) applyFiltersToTable(tableId);
                });
            });

            function applyFiltersToTable(tableId) {
                const table = document.getElementById(tableId);
                if (!table) return;

                const tbody = table.querySelector("tbody");
                if (!tbody) return;

                const rows = tbody.querySelectorAll("tr");

                // Prende TUTTI i filtri che puntano a questa tabella
                const filtersForTable = document.querySelectorAll(
                    `.js-table-filter[data-target-table="${cssEscape(tableId)}"]`
                );

                rows.forEach((row) => {
                    // La riga resta visibile solo se passa TUTTI i filtri valorizzati
                    let visible = true;

                    for (const filterInput of filtersForTable) {
                        const filterValue = (filterInput.value || "").trim().toLowerCase();

                        // Se il filtro è vuoto, non blocca nulla
                        if (!filterValue) continue;

                        const mode = filterInput.dataset.filterMode || "rowtext"; // dataset | column | rowtext
                        const key = filterInput.dataset.filterKey || "";
                        const columnIndex = parseInt(filterInput.dataset.filterColumn ?? "-1", 10);

                        let textToCheck = "";

                        if (mode === "dataset") {
                            textToCheck = (row.dataset[key] || "").toLowerCase();

                        } else if (mode === "column") {
                            const cell = row.cells[columnIndex];
                            textToCheck = (cell ? cell.textContent : "").trim().toLowerCase();

                        } else {
                            textToCheck = row.textContent.toLowerCase();
                        }

                        if (!textToCheck.includes(filterValue)) {
                            visible = false;
                            break;
                        }
                    }

                    row.style.display = visible ? "" : "none";
                });
            }

            // Utility per ID con caratteri speciali (robusto)
            function cssEscape(value) {
                if (window.CSS && typeof window.CSS.escape === "function") {
                    return window.CSS.escape(value);
                }
                return String(value).replace(/"/g, '\\"');
            }
        });
