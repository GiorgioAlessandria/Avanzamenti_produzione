    <script>
        window.selectedRowKeys = window.selectedRowKeys || {};

        function markSelectedRow(row) {
            const table = row.closest("table");
            if (!table) return;

            table.querySelectorAll("tbody tr.row-selected").forEach(tr => {
                tr.classList.remove("row-selected");
            });

            row.classList.add("row-selected");
            window.selectedRowKeys[table.id] = row.dataset.rowKey || "";
        }

        function restoreSelectedRows() {
            document.querySelectorAll("table.table-selectable").forEach(table => {
                const rowKey = window.selectedRowKeys[table.id];
                if (!rowKey) return;

                const row = table.querySelector(
                    `tbody tr[data-row-key="${CSS.escape(rowKey)}"]`
                );
                if (row) {
                    row.classList.add("row-selected");
                }
            });
        }

        window.restoreSelectedRows = restoreSelectedRows;

        document.addEventListener("click", function (event) {
            const row = event.target.closest("table.table-selectable tbody tr[data-row-key]");
            if (!row) return;
            markSelectedRow(row);
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const allTextFilters = document.querySelectorAll(".js-table-filter");
            const allCheckboxFilters = document.querySelectorAll(".js-table-filter-checkbox");

            function cssEscape(value) {
                if (window.CSS && typeof window.CSS.escape === "function") {
                    return window.CSS.escape(value);
                }
                return String(value).replace(/"/g, '\\"');
            }

            function applyFiltersToTable(tableId) {
                const table = document.getElementById(tableId);
                if (!table) return;

                const tbody = table.querySelector("tbody");
                if (!tbody) return;

                const rows = tbody.querySelectorAll("tr");

                const textFiltersForTable = document.querySelectorAll(
                    `.js-table-filter[data-target-table="${cssEscape(tableId)}"]`
                );

                const checkboxFiltersForTable = document.querySelectorAll(
                    `.js-table-filter-checkbox[data-target-table="${cssEscape(tableId)}"]`
                );

                rows.forEach((row) => {
                    let visible = true;

                    for (const filterInput of textFiltersForTable) {
                        const filterValue = (filterInput.value || "").trim().toLowerCase();
                        if (!filterValue) continue;

                        const mode = filterInput.dataset.filterMode || "rowtext";
                        const key = filterInput.dataset.filterKey || "";
                        const columnIndex = parseInt(filterInput.dataset.filterColumn ?? "-1", 10);

                        let textToCheck = "";

                        if (mode === "dataset") {
                            textToCheck = (row.dataset[key] || "").toLowerCase();
                        } else if (mode === "column") {
                            const cell = row.cells[columnIndex];
                            textToCheck = (cell ? cell.textContent : "").trim().toLowerCase();
                        } else {
                            textToCheck = row.textContent.toLowerCase();
                        }

                        if (!textToCheck.includes(filterValue)) {
                            visible = false;
                            break;
                        }
                    }

                    if (visible) {
                        for (const checkInput of checkboxFiltersForTable) {
                            if (!checkInput.checked) continue;

                            const key = checkInput.dataset.filterKey || "";

                            if (key === "negative") {
                                const isNegative = (row.dataset.negative || "") === "1";
                                if (!isNegative) {
                                    visible = false;
                                    break;
                                }
                            }

                            if (key === "understock") {
                                const isUnderstock = (row.dataset.understock || "") === "1";
                                if (!isUnderstock) {
                                    visible = false;
                                    break;
                                }
                            }

                            if (key === "rem-critical") {
                                const isCritical = (row.dataset.remCritical || "") === "1";
                                if (!isCritical) {
                                    visible = false;
                                    break;
                                }
                            }

                            if (key === "rem-understock") {
                                const isRemUnderstock = (row.dataset.remUnderstock || "") === "1";
                                if (!isRemUnderstock) {
                                    visible = false;
                                    break;
                                }
                            }
                        }
                    }

                    row.style.display = visible ? "" : "none";
                });
            }

            allTextFilters.forEach((input) => {
                const eventName = input.tagName === "SELECT" ? "change" : "input";
                input.addEventListener(eventName, () => {
                    const tableId = input.dataset.targetTable;
                    if (tableId) applyFiltersToTable(tableId);
                });
            });

            allCheckboxFilters.forEach((input) => {
                input.addEventListener("change", () => {
                    const tableId = input.dataset.targetTable;
                    if (tableId) applyFiltersToTable(tableId);
                });
            });

            window.applyFiltersToTable = applyFiltersToTable;
        });
    </script>
    <script>
        function escapeHtmlLabel(value) {
            return String(value || "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

        function filenameFromLabelUrl(labelUrl) {
            try {
                const url = new URL(labelUrl, window.location.origin);
                const parts = url.pathname.split("/").filter(Boolean);
                return decodeURIComponent(parts.at(-1) || "");
            } catch (_) {
                return "";
            }
        }

        function setLabelFeedback(element, message, type = "success") {
            if (!element) return;

            if (!message) {
                element.className = "alert d-none";
                element.textContent = "";
                return;
            }

            element.className = `alert alert-${type}`;
            element.textContent = message;
        }

        async function printLabelFilename(filename, feedbackEl = null, buttonEl = null) {
            if (!filename) {
                setLabelFeedback(feedbackEl, "Nome file etichetta mancante.", "warning");
                return false;
            }

            if (buttonEl) buttonEl.disabled = true;

            try {
                const resp = await window.avpFetch("/api/etichette/stampa", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    credentials: "same-origin",
                    body: JSON.stringify({filename})
                });

                const data = await resp.json();

                if (!resp.ok || data.ok === false) {
                    setLabelFeedback(
                        feedbackEl,
                        data.error || "Errore durante la stampa dell'etichetta.",
                        "danger"
                    );
                    return false;
                }

                setLabelFeedback(
                    feedbackEl,
                    data.message || "Etichetta inviata in stampa.",
                    "success"
                );
                return true;

            } catch (err) {
                console.error("Errore stampa etichetta:", err);
                setLabelFeedback(
                    feedbackEl,
                    "Errore di comunicazione durante la stampa dell'etichetta.",
                    "danger"
                );
                return false;

            } finally {
                if (buttonEl) buttonEl.disabled = false;
            }
        }

        window.showGeneratedLabel = function (labelUrl) {
            if (!labelUrl) {
                console.error("URL etichetta mancante.");
                return;
            }

            const modalEl = document.getElementById("modalEtichettaGenerata");
            const imgEl = document.getElementById("img-etichetta-generata");
            const openLinkEl = document.getElementById("btn-apri-etichetta-nuova-scheda");
            const printBtnEl = document.getElementById("btn-stampa-etichetta-generata");
            const feedbackEl = document.getElementById("etichetta-generata-feedback");

            if (!modalEl || !imgEl || !openLinkEl || !printBtnEl) {
                console.error("Modal etichetta non completo", {
                    modalEl,
                    imgEl,
                    openLinkEl,
                    printBtnEl,
                });
                alert("Errore visualizzazione etichetta: modal non completo.");
                return;
            }

            const filename = filenameFromLabelUrl(labelUrl);
            const separator = labelUrl.includes("?") ? "&" : "?";
            const imgUrl = labelUrl.startsWith("data:")
                ? labelUrl
                : `${labelUrl}${separator}_=${Date.now()}`;

            imgEl.classList.add("d-none");
            imgEl.removeAttribute("src");

            imgEl.onload = function () {
                imgEl.classList.remove("d-none");
            };

            imgEl.onerror = function () {
                imgEl.classList.add("d-none");
                setLabelFeedback(
                    feedbackEl,
                    "Impossibile caricare l'anteprima dell'etichetta.",
                    "danger"
                );
                console.error("Errore caricamento anteprima etichetta", imgUrl);
            };

            imgEl.src = imgUrl;
            openLinkEl.href = labelUrl;
            printBtnEl.dataset.filename = filename;
            printBtnEl.disabled = !filename;
            setLabelFeedback(feedbackEl, "");

            bootstrap.Modal.getOrCreateInstance(modalEl).show();
        };

        document.addEventListener("DOMContentLoaded", function () {
            const modalEtichettaEl = document.getElementById("modalEtichettaGenerata");
            const imgEl = document.getElementById("img-etichetta-generata");
            const openLinkEl = document.getElementById("btn-apri-etichetta-nuova-scheda");
            const printBtnEl = document.getElementById("btn-stampa-etichetta-generata");
            const generatedFeedbackEl = document.getElementById("etichetta-generata-feedback");

            printBtnEl?.addEventListener("click", function () {
                printLabelFilename(
                    this.dataset.filename || "",
                    generatedFeedbackEl,
                    this
                );
            });

            modalEtichettaEl?.addEventListener("hidden.bs.modal", function () {
                if (imgEl) imgEl.src = "";
                if (openLinkEl) openLinkEl.href = "#";
                if (printBtnEl) {
                    printBtnEl.dataset.filename = "";
                    printBtnEl.disabled = true;
                }
                setLabelFeedback(generatedFeedbackEl, "");
            });

            const cercaBtn = document.getElementById("btn-ristampa-etichette-cerca");
            const codArtEl = document.getElementById("ristampa-etichette-codart");
            const lottoEl = document.getElementById("ristampa-etichette-lotto");
            const feedbackEl = document.getElementById("ristampa-etichette-feedback");
            const tbodyEl = document.getElementById("tbody-ristampa-etichette");
            const ristampaModalEl = document.getElementById("modalRistampaEtichette");

            function formatDateTimeIt(value) {
                if (!value) return "";
                const d = new Date(value);
                if (Number.isNaN(d.getTime())) return value;

                return d.toLocaleString("it-IT", {
                    day: "2-digit",
                    month: "2-digit",
                    year: "numeric",
                    hour: "2-digit",
                    minute: "2-digit",
                    second: "2-digit",
                });
            }

            function renderRistampaRows(items) {
                if (!tbodyEl) return;

                if (!items || !items.length) {
                    tbodyEl.innerHTML = `
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            Nessuna etichetta trovata.
                        </td>
                    </tr>
                `;
                    return;
                }

                tbodyEl.innerHTML = items.map((row) => {
                    const labelUrl = row.label_url || row.url || row.image_url || row.png_url || "";
                    const filename = row.filename || filenameFromLabelUrl(labelUrl);
                    const fileExists = row.file_exists !== false;
                    const previewDisabled = (!fileExists || !labelUrl) ? "disabled" : "";
                    const printDisabled = (!fileExists || !filename) ? "disabled" : "";

                    return `
                    <tr>
                        <td>${escapeHtmlLabel(formatDateTimeIt(row.closed_at))}</td>
                        <td>${escapeHtmlLabel(row.cod_art)}</td>
                        <td>${escapeHtmlLabel(row.descrizione)}</td>
                        <td>${escapeHtmlLabel(row.lotto)}</td>
                        <td class="text-end">${escapeHtmlLabel(row.quantita)}</td>
                        <td class="text-center">
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary js-preview-etichetta"
                                    data-url="${escapeHtmlLabel(labelUrl)}"
                                    ${previewDisabled}>
                                Anteprima
                            </button>
                        </td>
                        <td class="text-center">
                            <button type="button"
                                    class="btn btn-sm btn-primary js-stampa-etichetta"
                                    data-filename="${escapeHtmlLabel(filename)}"
                                    ${printDisabled}>
                                Stampa
                            </button>
                        </td>
                    </tr>
                `;
                }).join("");
            }

            async function cercaEtichette() {
                const codArt = (codArtEl?.value || "").trim();
                const lotto = (lottoEl?.value || "").trim();

                if (!codArt && !lotto) {
                    setLabelFeedback(
                        feedbackEl,
                        "Inserire almeno il codice articolo oppure il lotto.",
                        "warning"
                    );
                    return;
                }

                if (cercaBtn) cercaBtn.disabled = true;
                setLabelFeedback(feedbackEl, "");

                try {
                    const params = new URLSearchParams({
                        cod_art: codArt,
                        lotto: lotto,
                    });

                    const resp = await window.avpFetch(`/api/etichette/ricerca?${params.toString()}`, {
                        headers: {
                            "X-Requested-With": "XMLHttpRequest"
                        },
                        credentials: "same-origin"
                    });

                    const data = await resp.json();

                    if (!resp.ok || data.ok === false) {
                        setLabelFeedback(
                            feedbackEl,
                            data.error || "Errore durante la ricerca delle etichette.",
                            "danger"
                        );
                        renderRistampaRows([]);
                        return;
                    }

                    renderRistampaRows(data.items || []);

                } catch (err) {
                    console.error("Errore ricerca etichette:", err);
                    setLabelFeedback(
                        feedbackEl,
                        "Errore di comunicazione durante la ricerca delle etichette.",
                        "danger"
                    );
                    renderRistampaRows([]);

                } finally {
                    if (cercaBtn) cercaBtn.disabled = false;
                }
            }

            cercaBtn?.addEventListener("click", cercaEtichette);

            [codArtEl, lottoEl].forEach((inputEl) => {
                inputEl?.addEventListener("keydown", function (event) {
                    if (event.key === "Enter") {
                        event.preventDefault();
                        cercaEtichette();
                    }
                });
            });

            tbodyEl?.addEventListener("click", async function (event) {
                const previewBtn = event.target.closest(".js-preview-etichetta");
                if (previewBtn) {
                    event.preventDefault();
                    event.stopPropagation();

                    if (previewBtn.disabled) return;

                    const url = previewBtn.dataset.url || "";
                    if (!url) {
                        setLabelFeedback(
                            feedbackEl,
                            "URL anteprima etichetta mancante.",
                            "warning"
                        );
                        console.warn("Riga etichetta senza data-url", previewBtn.closest("tr"));
                        return;
                    }

                    if (ristampaModalEl) {
                        bootstrap.Modal.getOrCreateInstance(ristampaModalEl).hide();
                    }

                    setTimeout(() => {
                        window.showGeneratedLabel(url);
                    }, 150);

                    return;
                }

                const printBtn = event.target.closest(".js-stampa-etichetta");
                if (printBtn) {
                    event.preventDefault();
                    event.stopPropagation();

                    if (printBtn.disabled) return;

                    await printLabelFilename(
                        printBtn.dataset.filename || "",
                        feedbackEl,
                        printBtn
                    );
                }
            });

            ristampaModalEl?.addEventListener("hidden.bs.modal", function () {
                if (codArtEl) codArtEl.value = "";
                if (lottoEl) lottoEl.value = "";
                if (tbodyEl) tbodyEl.innerHTML = "";
                setLabelFeedback(feedbackEl, "");
            });
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const modalEl = document.getElementById("modalSegnalaScorta");
            const inputEl = document.getElementById("scorta-qrcode-input");
            const feedbackEl = document.getElementById("scorta-feedback");
            const confirmBtn = document.getElementById("btn-conferma-scorta");
            const canScortaSegnalazioneLibera = {{ (can_scorta_segnalazione_libera)|tojson }};

            if (!modalEl || !inputEl || !feedbackEl || !confirmBtn) return;

            function setFeedback(message, type = "success") {
                feedbackEl.className = message ? `alert alert-${type}` : "alert d-none";
                feedbackEl.textContent = message || "";
            }

            modalEl.addEventListener("shown.bs.modal", () => {
                inputEl.focus();
            });

            modalEl.addEventListener("hidden.bs.modal", () => {
                inputEl.value = "";
                setFeedback("");
                confirmBtn.disabled = false;
            });

            inputEl.addEventListener("keydown", (event) => {
                if (event.key === "Enter" && !event.shiftKey) {
                    event.preventDefault();
                    confirmBtn.click();
                }
            });

            confirmBtn.addEventListener("click", async () => {
                const qrcode = inputEl.value.trim();

                if (!qrcode) {
                    setFeedback(
                        canScortaSegnalazioneLibera
                            ? "Inserire un QR code o una descrizione prima di confermare."
                            : "Scansionare un QR code prima di confermare.",
                        "warning"
                    );
                    inputEl.focus();
                    return;
                }

                const isQrCode = qrcode.includes("|");

                if (!isQrCode && !canScortaSegnalazioneLibera) {
                    setFeedback(
                        "Inserimento manuale non abilitato. Usare il formato codice|variante|revisione.",
                        "warning"
                    );
                    inputEl.focus();
                    return;
                }

                if (!isQrCode && qrcode.length < 3) {
                    setFeedback("Descrizione materiale troppo breve.", "warning");
                    inputEl.focus();
                    return;
                }

                if (!isQrCode && qrcode.length > 300) {
                    setFeedback("Descrizione materiale troppo lunga.", "warning");
                    inputEl.focus();
                    return;
                }

                confirmBtn.disabled = true;
                setFeedback("");

                try {
                    const response = await window.avpFetch("/api/scorte/segnala", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "X-Requested-With": "XMLHttpRequest"
                        },
                        credentials: "same-origin",
                        body: JSON.stringify({qrcode})
                    });

                    const data = await response.json();

                    if (!response.ok || data.ok === false) {
                        setFeedback(data.error || "Errore durante la segnalazione della scorta.", "danger");
                        return;
                    }

                    const item = data.item || {};
                    const msg = [
                        data.message || "Scorta segnalata.",
                        item.cod_art ? `Codice: ${item.cod_art}` : "",
                        item.descrizione ? `Descrizione: ${item.descrizione}` : "",
                        item.lookup_trovato === false ? "Attenzione: articolo non trovato nel lookup acquisti." : "",
                    ].filter(Boolean).join(" - ");

                    setFeedback(msg, data.duplicate ? "warning" : "success");
                    inputEl.value = "";

                    const scortaEvent = {
                        type: "scorta-segnalata",
                        at: Date.now(),
                        created: Boolean(data.created),
                        duplicate: Boolean(data.duplicate),
                        item: data.item || {}
                    };

                    /*
                     * Caso 1: stessa macchina / stesso browser.
                     * Avvisa subito eventuali schede acquisti aperte.
                     */
                    try {
                        if (window.BroadcastChannel) {
                            const channel = new BroadcastChannel("avp_acquisti_events");
                            channel.postMessage(scortaEvent);
                            channel.close();
                        }

                        localStorage.setItem(
                            "avp_acquisti_scorte_changed",
                            JSON.stringify(scortaEvent)
                        );

                        localStorage.removeItem("avp_acquisti_scorte_changed");

                    } catch (err) {
                        console.warn("Notifica locale scorta non inviata:", err);
                    }

                    /*
                     * Caso 2: se per qualche motivo siamo già nella pagina acquisti,
                     * aggiorna direttamente.
                     */
                    if (window.refreshAcquistiTables) {
                        window.refreshAcquistiTables({force: true});
                    }

                } catch (err) {
                    console.error("Errore segnalazione scorta:", err);
                    setFeedback("Errore di comunicazione con il server.", "danger");

                } finally {
                    confirmBtn.disabled = false;
                    inputEl.focus();
                }
            });
        });
    </script>
    <script>
        (() => {
            if (window.__avpWorkgroupStatusActionsInit) return;
            window.__avpWorkgroupStatusActionsInit = true;

            const ACTIONS = {
                "btn-conferma-sospensione-sl": {
                    action: "sospendi",
                    idSelectors: ["#toast2-iddocumento", "#toast-sosp-iddocumento"],
                    causaleSelectors: ["#causale_attivita_sl", "#causale_attivita"],
                    tempoSelectors: ["#toast-sosp-sl-tempo-fermo-macchina"],
                    toastSelector: "#toast-2"
                },
                "btn-conferma-riattivazione-sl": {
                    action: "riattiva",
                    idSelectors: ["#toast-riatt-sl-iddocumento"],
                    toastSelector: "#toast-3"
                },
                "btn-conferma-sospensione-m": {
                    action: "sospendi",
                    idSelectors: ["#toast-sosp-m-iddocumento"],
                    causaleSelectors: ["#causale_attivita_m"],
                    toastSelector: "#toast-5"
                },
                "btn-conferma-riattivazione-m": {
                    action: "riattiva",
                    idSelectors: ["#toast-riatt-m-iddocumento"],
                    toastSelector: "#toast-6"
                }
            };

            function firstValue(selectors) {
                for (const selector of selectors || []) {
                    const el = document.querySelector(selector);
                    if (el && String(el.value || "").trim()) {
                        return String(el.value || "").trim();
                    }
                }
                return "";
            }

            function resetActionButtons() {
                [
                    "sospensione_ordine",
                    "riattivazione_ordine",
                    "sospensione_ordine_sl",
                    "riattivazione_ordine_sl",
                    "sospensione_ordine_m",
                    "riattivazione_ordine_m"
                ].forEach(id => {
                    const btn = document.getElementById(id);
                    if (btn) btn.disabled = true;
                });
            }

            async function handleGroupAction(button, cfg, groupUid) {
                button.disabled = true;

                try {
                    const payload = {group_uid: groupUid};
                    if (cfg.action === "sospendi") {
                        payload.causale = firstValue(cfg.causaleSelectors);
                        payload.tempo_non_funzionamento_minuti = firstValue(cfg.tempoSelectors) || "0";
                    }

                    const resp = await window.avpFetch(
                        `/api/ordini/gruppi/${cfg.action}`,
                        {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "X-Requested-With": "XMLHttpRequest"
                            },
                            credentials: "same-origin",
                            body: JSON.stringify(payload)
                        }
                    );

                    let data = {};
                    try {
                        data = await resp.json();
                    } catch (_) {
                        data = {};
                    }

                    if (!resp.ok || data.ok === false) {
                        alert(data.error || "Errore durante l'operazione sul gruppo ordini.");
                        return;
                    }

                    const toastEl = document.querySelector(cfg.toastSelector);
                    if (toastEl) {
                        bootstrap.Toast.getOrCreateInstance(toastEl).hide();
                    }

                    if (data.fragments && window.applyHomeFragments) {
                        window.applyHomeFragments(data.fragments);
                    }

                    resetActionButtons();
                } catch (err) {
                    console.error("Errore operazione gruppo ordini:", err);
                    alert("Errore di comunicazione con il server.");
                } finally {
                    button.disabled = false;
                }
            }

            document.addEventListener("click", function (event) {
                const button = event.target.closest(Object.keys(ACTIONS).map(id => `#${id}`).join(","));
                if (!button) return;

                const cfg = ACTIONS[button.id];
                const idDocumento = firstValue(cfg.idSelectors);
                if (!idDocumento.startsWith("GROUP:")) return;

                event.preventDefault();
                event.stopPropagation();
                event.stopImmediatePropagation();

                const groupUid = idDocumento.slice("GROUP:".length).trim();
                if (!groupUid) {
                    alert("Gruppo ordini non valido.");
                    return;
                }

                handleGroupAction(button, cfg, groupUid);
            }, true);
        })();
    </script>
    <script>
        (() => {
            if (window.__avpWorkgroupOpenInit) return;
            window.__avpWorkgroupOpenInit = true;

            let currentMode = "";
            let currentOrders = [];

            function esc(value) {
                const div = document.createElement("div");
                div.textContent = value == null ? "" : String(value);
                return div.innerHTML;
            }

            function ensureModal() {
                let modal = document.getElementById("modalWorkgroupOpen");
                if (modal) return modal;

                document.body.insertAdjacentHTML("beforeend", `
<div class="modal fade" id="modalWorkgroupOpen" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalWorkgroupOpenTitle">Gruppo ordini</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
      </div>
      <div class="modal-body">
        <div id="modal-workgroup-feedback" class="alert alert-warning d-none"></div>
        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle mb-0">
            <thead id="modal-workgroup-head"></thead>
            <tbody id="modal-workgroup-body"></tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
        <button type="button" class="btn btn-primary" id="btn-workgroup-confirm">Apri gruppo</button>
      </div>
    </div>
  </div>
</div>`);

                document.getElementById("btn-workgroup-confirm")
                    .addEventListener("click", submitWorkgroup);

                return document.getElementById("modalWorkgroupOpen");
            }

            function showFeedback(message) {
                const el = document.getElementById("modal-workgroup-feedback");
                if (!el) return;
                el.textContent = message || "";
                el.classList.toggle("d-none", !message);
            }

            function orderFromRow(row) {
                const statoCell = row.querySelector('td[data-col="stato"]');
                return {
                    id_documento: row.dataset.iddocumento || "",
                    id_riga: row.dataset.idriga || "",
                    ordine: row.dataset.ordine || row.dataset.rowKey || "",
                    cod_art: row.dataset.codice || "",
                    descrizione: row.dataset.descrizione || "",
                    fase: row.dataset.fase || "",
                    stato: row.dataset.statoordine || row.dataset.stato || statoCell?.textContent?.trim() || ""
                };
            }

            function ordersFromTable(table) {
                return Array.from(table.querySelectorAll("tbody tr[data-iddocumento][data-idriga]"))
                    .filter(row => row.offsetParent !== null)
                    .filter(row => row.dataset.isWorkGroup !== "1")
                    .map(orderFromRow)
                    .filter(order => order.id_documento && order.id_riga);
            }

            function relatedWorkgroupTables(tableSelector) {
                const map = {
                    "#ordini_da_eseguire": ["#ordini_da_eseguire", "#ordini_in_corso"],
                    "#ordini_da_eseguire_sl": ["#ordini_da_eseguire_sl", "#ordini_in_corso_sl"],
                    "#ordini_da_eseguire_m": ["#ordini_da_eseguire_m", "#ordini_in_corso_m"]
                };
                return (map[tableSelector] || [tableSelector])
                    .map(selector => document.querySelector(selector))
                    .filter(Boolean);
            }

            function ordersFromRelatedTables(tableSelector, fallbackTable) {
                const seen = new Set();
                return (tableSelector ? relatedWorkgroupTables(tableSelector) : [fallbackTable])
                    .filter(Boolean)
                    .flatMap(ordersFromTable)
                    .filter(order => {
                        const key = `${order.id_documento}|${order.id_riga}`;
                        if (seen.has(key)) return false;
                        seen.add(key);
                        return true;
                    });
            }

            function renderModal(mode, table, tableSelector) {
                currentMode = mode;
                currentOrders = ordersFromRelatedTables(tableSelector, table);

                if (!currentOrders.length) {
                    alert("Nessun ordine disponibile nella tabella corrente.");
                    return false;
                }

                const title = document.getElementById("modalWorkgroupOpenTitle");
                const head = document.getElementById("modal-workgroup-head");
                const body = document.getElementById("modal-workgroup-body");
                const confirm = document.getElementById("btn-workgroup-confirm");

                showFeedback("");

                if (mode === "multiplo") {
                    title.textContent = "Ordini multipli";
                    confirm.textContent = "Apri ordini multipli";
                    head.innerHTML = `
                    <tr>
                      <th></th><th>Ordine</th><th>Codice</th><th>Descrizione</th><th>Fase</th><th>Stato</th>
                    </tr>`;
                    body.innerHTML = currentOrders.map((order, index) => `
                    <tr>
                      <td><input class="form-check-input" type="checkbox" value="${index}"></td>
                      <td>${esc(order.ordine)}</td>
                      <td>${esc(order.cod_art)}</td>
                      <td class="text-start">${esc(order.descrizione)}</td>
                      <td>${esc(order.fase)}</td>
                      <td>${esc(order.stato)}</td>
                    </tr>`).join("");
                    return true;
                }

                if (mode === "misto") {
                    if (currentOrders.length < 3) {
                        alert("Servono almeno 3 ordini disponibili per un gruppo misto.");
                        return false;
                    }
                    title.textContent = "Multiplo + mascherato";
                    confirm.textContent = "Apri gruppo misto";
                    head.innerHTML = `
                    <tr>
                      <th>Tempo condiviso</th><th>Mascherato</th><th>Ordine</th><th>Codice</th><th>Descrizione</th><th>Fase</th><th>Stato</th>
                    </tr>`;
                    body.innerHTML = currentOrders.map((order, index) => `
                    <tr>
                      <td><input class="form-check-input" type="checkbox" data-role="wg-shared" value="${index}"></td>
                      <td><input class="form-check-input" type="radio" name="wg-mixed-mask" value="${index}"></td>
                      <td>${esc(order.ordine)}</td>
                      <td>${esc(order.cod_art)}</td>
                      <td class="text-start">${esc(order.descrizione)}</td>
                      <td>${esc(order.fase)}</td>
                      <td>${esc(order.stato)}</td>
                    </tr>`).join("");
                    return true;
                }

                title.textContent = "Ordine mascherato";
                confirm.textContent = "Apri ordine mascherato";
                head.innerHTML = `
                <tr>
                  <th>Principale</th><th>Mascherato</th><th>Ordine</th><th>Codice</th><th>Descrizione</th><th>Fase</th><th>Stato</th>
                </tr>`;
                body.innerHTML = currentOrders.map((order, index) => `
                <tr>
                  <td><input class="form-check-input" type="radio" name="wg-main" value="${index}"></td>
                  <td><input class="form-check-input" type="radio" name="wg-mask" value="${index}"></td>
                  <td>${esc(order.ordine)}</td>
                  <td>${esc(order.cod_art)}</td>
                  <td class="text-start">${esc(order.descrizione)}</td>
                  <td>${esc(order.fase)}</td>
                  <td>${esc(order.stato)}</td>
                </tr>`).join("");
                return true;
            }

            function orderKey(order) {
                return {
                    id_documento: order.id_documento,
                    id_riga: order.id_riga
                };
            }

            async function submitWorkgroup() {
                let endpoint = "";
                let payload = {};

                if (currentMode === "multiplo") {
                    const selected = Array.from(
                        document.querySelectorAll("#modal-workgroup-body input[type='checkbox']:checked")
                    ).map(input => currentOrders[Number(input.value)]).filter(Boolean);

                    if (selected.length < 2 || selected.length > 3) {
                        showFeedback("Seleziona da 2 a 3 ordini.");
                        return;
                    }

                    endpoint = "/api/ordini/gruppi/multiplo/apri";
                    payload = {orders: selected.map(orderKey)};
                } else if (currentMode === "misto") {
                    const sharedIndexes = Array.from(
                        document.querySelectorAll("#modal-workgroup-body input[data-role='wg-shared']:checked")
                    ).map(input => Number(input.value));
                    const maskIndex = Number(document.querySelector("input[name='wg-mixed-mask']:checked")?.value);

                    if (sharedIndexes.length !== 2) {
                        showFeedback("Seleziona esattamente 2 ordini con tempo condiviso.");
                        return;
                    }
                    if (!Number.isInteger(maskIndex)) {
                        showFeedback("Seleziona l'ordine mascherato.");
                        return;
                    }
                    if (sharedIndexes.includes(maskIndex)) {
                        showFeedback("L'ordine mascherato non può essere anche a tempo condiviso.");
                        return;
                    }

                    const shared = sharedIndexes.map(index => currentOrders[index]).filter(Boolean);
                    if (shared.length !== 2 || !currentOrders[maskIndex]) {
                        showFeedback("Selezione gruppo misto non valida.");
                        return;
                    }

                    endpoint = "/api/ordini/gruppi/misto/apri";
                    payload = {
                        condivisi: shared.map(orderKey),
                        mascherato: orderKey(currentOrders[maskIndex])
                    };
                } else {
                    const mainIndex = Number(document.querySelector("input[name='wg-main']:checked")?.value);
                    const maskIndex = Number(document.querySelector("input[name='wg-mask']:checked")?.value);

                    if (!Number.isInteger(mainIndex) || !Number.isInteger(maskIndex)) {
                        showFeedback("Seleziona un ordine principale e un ordine mascherato.");
                        return;
                    }
                    if (mainIndex === maskIndex) {
                        showFeedback("Ordine principale e mascherato non possono coincidere.");
                        return;
                    }

                    endpoint = "/api/ordini/gruppi/mascherato/apri";
                    payload = {
                        principale: orderKey(currentOrders[mainIndex]),
                        mascherato: orderKey(currentOrders[maskIndex])
                    };
                }

                const resp = await window.avpFetch(endpoint, {
                    method: "POST",
                    headers: {"Content-Type": "application/json", "X-Requested-With": "XMLHttpRequest"},
                    credentials: "same-origin",
                    body: JSON.stringify(payload)
                });

                const data = await resp.json().catch(() => ({}));

                if (!resp.ok || data.ok === false) {
                    showFeedback(data.error || "Errore apertura gruppo ordini.");
                    return;
                }

                if (data.fragments && window.applyHomeFragments) {
                    window.applyHomeFragments(data.fragments);
                }

                bootstrap.Modal.getOrCreateInstance(document.getElementById("modalWorkgroupOpen")).hide();
                alert(data.message || "Gruppo aperto correttamente.");
            }

            document.addEventListener("click", function (event) {
                const button = event.target.closest(".js-open-gruppo-multiplo, .js-open-gruppo-mascherato, .js-open-gruppo-misto");
                if (!button) return;

                event.preventDefault();
                const tableSelector = button.getAttribute("data-workgroup-table");
                const table = tableSelector ? document.querySelector(tableSelector) : null;

                if (!table) {
                    alert("Tabella ordini non trovata.");
                    return;
                }

                const mode = button.classList.contains("js-open-gruppo-multiplo")
                    ? "multiplo"
                    : (button.classList.contains("js-open-gruppo-misto") ? "misto" : "mascherato");
                const modal = ensureModal();

                if (renderModal(mode, table, tableSelector)) {
                    bootstrap.Modal.getOrCreateInstance(modal).show();
                }
            });
        })();
    </script>
    <script>
        (() => {
            if (window.__avpWorkgroupDetailInit) return;
            window.__avpWorkgroupDetailInit = true;

            function esc(value) {
                const div = document.createElement("div");
                div.textContent = value == null ? "" : String(value);
                return div.innerHTML;
            }

            function labelRole(role) {
                if (role === "MAIN") return "Principale";
                if (role === "MASKED") return "Mascherato";
                return "Membro";
            }

            function labelShare(mode) {
                if (mode === "FULL") return "Tempo pieno";
                if (mode === "ZERO") return "Nessun tempo";
                return "Tempo diviso";
            }

            function parseDetail(raw) {
                try {
                    const parsed = JSON.parse(raw || "[]");
                    return Array.isArray(parsed) ? parsed : [];
                } catch (_) {
                    return [];
                }
            }

            function memberLabel(row) {
                return [
                    labelRole(row.ruolo || row.role || row.Role),
                    row.ordine || row.Ordine || "",
                    row.cod_art || row.CodArt || ""
                ].filter(Boolean).join(" - ");
            }

            function showDetailFeedback(message) {
                const el = document.getElementById("modal-workgroup-detail-feedback");
                if (!el) return;
                el.textContent = message || "";
                el.classList.toggle("d-none", !message);
            }

            function ensureModal() {
                let modal = document.getElementById("modalWorkgroupDetail");
                if (modal) return modal;

                document.body.insertAdjacentHTML("beforeend", `
            <div class="modal fade" id="modalWorkgroupDetail" tabindex="-1" aria-hidden="true">
              <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                  <div class="modal-header">
                    <div>
                      <h5 class="modal-title" id="modal-workgroup-detail-title">Dettaglio gruppo</h5>
                      <div class="small text-muted" id="modal-workgroup-detail-subtitle"></div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
                  </div>
                  <div class="modal-body">
                    <div id="modal-workgroup-detail-feedback" class="alert alert-danger d-none"></div>
                    <div class="table-responsive">
                      <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="table-light">
                          <tr>
                            <th>Ruolo</th><th>Ordine</th><th>Quantità</th><th>Matricola</th><th>Codice</th><th>Var.</th>
                            <th>Rev.</th><th>Descrizione</th><th>Fase</th><th>Gestione tempo</th>
                          </tr>
                        </thead>
                        <tbody id="modal-workgroup-detail-body"></tbody>
                      </table>
                    </div>
                  </div>
                  <div class="modal-footer justify-content-between gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                      <label class="form-label mb-0" for="modal-workgroup-dissolve-member">Lascia attivo</label>
                      <select class="form-select form-select-sm w-auto" id="modal-workgroup-dissolve-member"></select>
                      <button type="button" class="btn btn-outline-danger btn-sm" id="btn-workgroup-dissolve">
                        Sciogli gruppo
                      </button>
                    </div>
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Chiudi</button>
                  </div>
                </div>
              </div>
            </div>`);

                return document.getElementById("modalWorkgroupDetail");
            }

            document.addEventListener("click", function (event) {
                const btn = event.target.closest(".js-open-workgroup-detail-modal");
                if (!btn) return;

                event.preventDefault();
                event.stopPropagation();

                const detail = parseDetail(btn.dataset.groupDetail);
                const modal = ensureModal();
                const groupUid = btn.dataset.groupUid || "";

                showDetailFeedback("");
                document.getElementById("modal-workgroup-detail-title").textContent =
                    `Dettaglio gruppo ${btn.dataset.groupType || ""}`;

                document.getElementById("modal-workgroup-detail-subtitle").textContent =
                    [btn.dataset.groupLabel, groupUid].filter(Boolean).join(" - ");

                document.getElementById("modal-workgroup-detail-body").innerHTML =
                    detail.length
                        ? detail.map(row => `
                    <tr>
                      <td>${esc(labelRole(row.ruolo || row.role || row.Role))}</td>
                      <td>${esc(row.ordine || row.Ordine || "")}</td>
                      <td class="text-end">${esc(row.quantita || row.QtyDaLavorare || row.Quantita || "")}</td>
                      <td>${esc(row.matricola || row.CodMatricola || "")}</td>
                      <td>${esc(row.cod_art || row.CodArt || "")}</td>
                      <td>${esc(row.variante || row.VarianteArt || "")}</td>
                      <td>${esc(row.revisione || row.IndiceModifica || "")}</td>
                      <td class="text-start">${esc(row.descrizione || row.DesArt || "")}</td>
                      <td>${esc(row.fase || row.Fase || "")}</td>
                      <td>${esc(labelShare(row.time_share_mode || row.TimeShareMode))}</td>
                    </tr>`).join("")
                        : `<tr><td colspan="10" class="text-center text-muted">Nessun dettaglio disponibile.</td></tr>`;

                const select = document.getElementById("modal-workgroup-dissolve-member");
                const dissolveBtn = document.getElementById("btn-workgroup-dissolve");
                const members = detail.filter(row => row.id_documento && row.id_riga);
                if (select) {
                    select.innerHTML = members.map((row, idx) => `
                        <option value="${idx}"
                                data-id-documento="${esc(row.id_documento)}"
                                data-id-riga="${esc(row.id_riga)}">
                            ${esc(memberLabel(row))}
                        </option>`).join("");
                }
                if (dissolveBtn) {
                    dissolveBtn.dataset.groupUid = groupUid;
                    dissolveBtn.disabled = !groupUid || members.length === 0;
                }

                bootstrap.Modal.getOrCreateInstance(modal).show();
            }, true);

            document.addEventListener("click", async function (event) {
                const btn = event.target.closest("#btn-workgroup-dissolve");
                if (!btn) return;

                event.preventDefault();
                showDetailFeedback("");

                const groupUid = btn.dataset.groupUid || "";
                const select = document.getElementById("modal-workgroup-dissolve-member");
                const option = select?.selectedOptions?.[0];
                const idDocumento = option?.dataset?.idDocumento || "";
                const idRiga = option?.dataset?.idRiga || "";

                if (!groupUid || !idDocumento || !idRiga) {
                    showDetailFeedback("Selezione gruppo non valida.");
                    return;
                }

                if (!confirm("Sciogliere il gruppo lasciando attivo l'ordine selezionato e sospendendo gli altri?")) {
                    return;
                }

                btn.disabled = true;
                try {
                    const resp = await window.avpFetch(
                        "/api/ordini/gruppi/sciogli-membro",
                        {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "X-Requested-With": "XMLHttpRequest"
                            },
                            credentials: "same-origin",
                            body: JSON.stringify({
                                group_uid: groupUid,
                                id_documento: idDocumento,
                                id_riga: idRiga
                            })
                        }
                    );

                    let data = {};
                    try {
                        data = await resp.json();
                    } catch (_) {
                        data = {};
                    }

                    if (!resp.ok || data.ok === false) {
                        showDetailFeedback(data.error || "Errore durante lo scioglimento del gruppo.");
                        return;
                    }

                    const modal = document.getElementById("modalWorkgroupDetail");
                    if (modal) bootstrap.Modal.getOrCreateInstance(modal).hide();

                    if (data.fragments && window.applyHomeFragments) {
                        window.applyHomeFragments(data.fragments);
                    }
                } catch (err) {
                    console.error("Errore scioglimento gruppo:", err);
                    showDetailFeedback("Errore di comunicazione con il server.");
                } finally {
                    btn.disabled = false;
                }
            });
        })();
    </script>
{% endblock %}
<script src="{{ url_for('static', filename='assets/js/jquery.min.js') }}"></script>
<script src="{{ url_for('static', filename='assets/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
<script src="{{ url_for('static', filename='assets/js/bs-init.js') }}"></script>
