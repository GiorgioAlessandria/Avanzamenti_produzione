{% extends "base.j2" %}
{% block title %}Modifica priorità{% endblock %}
{% block content %}
<style>
    #priorita-page .priorita-main-row { height: calc(100vh - 180px); min-height: 0; }
    #priorita-page .priorita-column { height: 100%; min-height: 0; display: flex; flex-direction: column; gap: 1rem; }
    #priorita-page .priorita-card { min-height: 0; overflow: hidden; display: flex; flex: 1 1 auto; flex-direction: column; }
    #priorita-page .priorita-table-scroll { min-height: 0; overflow: auto; }
    #priorita-page thead th { position: sticky; top: 0; z-index: 5; background: var(--bs-light); }
    #priorita-page tbody td { vertical-align: middle; }
    #priorita-page .priorita-numero { width: 4rem; text-align: center; font-weight: 700; }
</style>
<main class="container-fluid mt-3" id="priorita-page">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Modifica priorità</h2>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-danger" type="button" id="btn-priorita-reset">Azzera priorità</button>
            <button class="btn btn-primary" type="button" id="btn-priorita-salva">Conferma priorità</button>
        </div>
    </div>
    <div id="priorita-alert" class="alert d-none" role="alert"></div>
    <div class="row g-3 priorita-main-row">
        <div class="col-5 priorita-column">
            <div class="card shadow-sm"><div class="card-body">
                <label for="priorita-operatore-select" class="form-label fw-semibold">Operatore</label>
                <select id="priorita-operatore-select" class="form-select"><option value="">Seleziona operatore...</option></select>
            </div></div>
            <div class="card shadow-sm priorita-card">
                <div class="card-header fw-semibold">Ordini non prioritizzati</div>
                <div class="card-body py-2"><div class="row g-2">
                    <div class="col-4"><label for="priorita-filter-ordine" class="form-label mb-1 small fw-semibold">Filtra ordine</label><input id="priorita-filter-ordine" class="form-control form-control-sm" autocomplete="off" placeholder="Ordine..."></div>
                    <div class="col-4"><label for="priorita-filter-codice" class="form-label mb-1 small fw-semibold">Filtra codice</label><input id="priorita-filter-codice" class="form-control form-control-sm" autocomplete="off" placeholder="Codice..."></div>
                    <div class="col-4"><label for="priorita-filter-matricola" class="form-label mb-1 small fw-semibold">Filtra matricola</label><input id="priorita-filter-matricola" class="form-control form-control-sm" autocomplete="off" placeholder="Matricola..."></div>
                </div></div>
                <div class="priorita-table-scroll"><table class="table table-sm table-hover mb-0">
                    <thead><tr><th>#</th><th>Ordine</th><th>Codice</th><th>Descrizione</th><th>Matricola</th><th>Stato</th><th>Fase</th><th>Risorsa</th></tr></thead>
                    <tbody id="priorita-available-body" class="js-priorita-list"></tbody>
                </table></div>
            </div>
        </div>
        <div class="col-7 priorita-column"><div class="card shadow-sm priorita-card">
            <div class="card-header bg-warning-subtle fw-semibold">Coda priorità 1…N</div>
            <div class="priorita-table-scroll"><table class="table table-sm table-hover mb-0">
                <thead><tr><th>#</th><th>Ordine</th><th>Codice</th><th>Descrizione</th><th>Matricola</th><th>Stato</th><th>Fase</th><th>Risorsa</th></tr></thead>
                <tbody id="priorita-queue-body" class="js-priorita-list"></tbody>
            </table></div>
        </div></div>
    </div>
</main>
<script src="{{ url_for('static', filename='vendor/Sortable.min.js') }}"></script>
<script>
    const selectOperatore = document.getElementById("priorita-operatore-select");
    const alertBox = document.getElementById("priorita-alert");
    const filterOrdine = document.getElementById("priorita-filter-ordine");
    const filterCodice = document.getElementById("priorita-filter-codice");
    const filterMatricola = document.getElementById("priorita-filter-matricola");
    const bodies = {available: document.getElementById("priorita-available-body"), prioritized: document.getElementById("priorita-queue-body")};

    function showAlert(type, message) { alertBox.className = `alert alert-${type}`; alertBox.textContent = message; alertBox.classList.remove("d-none"); }
    function clearAlert() { alertBox.classList.add("d-none"); alertBox.textContent = ""; }
    function escapeHtml(value) { return String(value ?? "").replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#039;"); }

    function makeRow(item) {
        const row = document.createElement("tr");
        Object.assign(row.dataset, {idDocumento: item.id_documento, idRiga: item.id_riga, fase: item.fase, ordine: item.ordine || "", codice: item.codice || "", matricola: item.matricola || ""});
        row.style.cursor = "grab";
        row.innerHTML = `<td class="priorita-numero"></td><td>${escapeHtml(item.ordine)}</td><td>${escapeHtml(item.codice)}</td><td>${escapeHtml(item.descrizione)}</td><td>${escapeHtml(item.matricola)}</td><td>${escapeHtml(item.stato)}</td><td>${escapeHtml(window.phaseLabel(item.fase))}</td><td>${escapeHtml(item.risorsa)}</td>`;
        return row;
    }
    function renderRows(body, rows) { body.innerHTML = ""; for (const item of rows || []) body.appendChild(makeRow(item)); }
    function updatePriorityNumbers() {
        const rows = Array.from(bodies.prioritized.children);
        rows.forEach((row, index) => {
            row.querySelector(".priorita-numero").textContent = index + 1;
            row.style.setProperty("--bs-table-bg", window.priorityGradientColor(index + 1, rows.length));
        });
        Array.from(bodies.available.children).forEach((row) => {
            row.querySelector(".priorita-numero").textContent = "–";
            row.style.removeProperty("--bs-table-bg");
        });
    }
    function applyAvailableFilters() {
        const ordine = filterOrdine.value.trim().toLowerCase(), codice = filterCodice.value.trim().toLowerCase(), matricola = filterMatricola.value.trim().toLowerCase();
        Array.from(bodies.available.children).forEach((row) => row.style.display = ((!ordine || row.dataset.ordine.toLowerCase().includes(ordine)) && (!codice || row.dataset.codice.toLowerCase().includes(codice)) && (!matricola || row.dataset.matricola.toLowerCase().includes(matricola))) ? "" : "none");
    }
    function setupSortable() {
        if (typeof Sortable === "undefined") return showAlert("danger", "Drag & drop non disponibile: Sortable non caricato.");
        document.querySelectorAll(".js-priorita-list").forEach((element) => Sortable.create(element, {group: "priorita-ordini", animation: 150, ghostClass: "table-active", onEnd: updatePriorityNumbers}));
    }
    async function loadOperatori() {
        const response = await window.avpFetch("{{ url_for('main.api_priorita_operatori') }}"), data = await response.json();
        if (!response.ok) throw new Error(data.error || "Errore caricamento operatori.");
        for (const operatore of data.operatori || []) { const option = document.createElement("option"); option.value = operatore.id; option.textContent = operatore.username; selectOperatore.appendChild(option); }
    }
    async function loadOrdiniOperatore() {
        clearAlert(); renderRows(bodies.available, []); renderRows(bodies.prioritized, []);
        if (!selectOperatore.value) return;
        const response = await window.avpFetch(`/api/priorita/operatori/${encodeURIComponent(selectOperatore.value)}/ordini`), data = await response.json();
        if (!response.ok) return showAlert("danger", data.error || "Errore caricamento priorità.");
        renderRows(bodies.available, data.available || []); renderRows(bodies.prioritized, data.prioritized || []); updatePriorityNumbers(); applyAvailableFilters();
    }
    async function salvaPriorita() {
        clearAlert(); if (!selectOperatore.value) return showAlert("warning", "Seleziona un operatore.");
        const items = Array.from(bodies.prioritized.children).map((row, index) => ({id_documento: row.dataset.idDocumento, id_riga: row.dataset.idRiga, fase: row.dataset.fase, priorita: index + 1, posizione: index + 1}));
        const response = await window.avpFetch(`/api/priorita/operatori/${encodeURIComponent(selectOperatore.value)}/salva`, {method: "POST", headers: {"Content-Type": "application/json"}, body: JSON.stringify({items})}), data = await response.json();
        if (!response.ok || !data.ok) return showAlert("danger", data.error || "Errore salvataggio priorità.");
        showAlert("success", "Priorità salvata correttamente."); await loadOrdiniOperatore();
    }
    async function resetPriorita() {
        clearAlert(); if (!selectOperatore.value) return showAlert("warning", "Seleziona un operatore.");
        if (!window.confirm("Confermi l'azzeramento di tutte le priorità dell'operatore selezionato?")) return;
        const response = await window.avpFetch(`/api/priorita/operatori/${encodeURIComponent(selectOperatore.value)}/reset`, {method: "POST"}), data = await response.json();
        if (!response.ok || !data.ok) return showAlert("danger", data.error || "Errore azzeramento priorità.");
        showAlert("success", "Priorità azzerate correttamente."); await loadOrdiniOperatore();
    }
    selectOperatore.addEventListener("change", loadOrdiniOperatore);
    filterOrdine.addEventListener("input", applyAvailableFilters); filterCodice.addEventListener("input", applyAvailableFilters); filterMatricola.addEventListener("input", applyAvailableFilters);
    document.getElementById("btn-priorita-salva").addEventListener("click", salvaPriorita); document.getElementById("btn-priorita-reset").addEventListener("click", resetPriorita);
    loadOperatori().then(() => { if (selectOperatore.options.length > 1) { selectOperatore.selectedIndex = 1; return loadOrdiniOperatore(); } }).then(setupSortable).catch((error) => showAlert("danger", error.message || "Errore caricamento priorità."));
</script>
{% endblock %}
