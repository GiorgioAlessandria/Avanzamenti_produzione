{% extends "base.j2" %}
{% block title %}Visualizzazione priorità{% endblock %}
{% block content %}
<style>
    #priorita-page .priorita-card { height: calc(100vh - 180px); min-height: 0; display: flex; flex-direction: column; }
    #priorita-page .priorita-scroll { flex: 1 1 auto; min-height: 0; overflow: auto; }
    #priorita-page thead th { position: sticky; top: 0; z-index: 5; background: var(--bs-light); }
    #priorita-page .priorita-numero { width: 5rem; text-align: center; font-weight: 700; }
</style>
<main class="container-fluid mt-3" id="priorita-page" data-operatore-id="{{ current_operator_id }}">
    <div id="priorita-alert" class="alert d-none" role="alert"></div>
    <div class="card shadow-sm priorita-card">
        <div class="card-header bg-warning-subtle fw-semibold">Coda priorità 1…N</div>
        <div class="priorita-scroll"><table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>#</th><th>Ordine</th><th>Codice</th><th>Descrizione</th><th>Matricola</th><th>Stato</th><th>Fase</th><th>Risorsa</th></tr></thead>
            <tbody id="priorita-body"></tbody>
        </table></div>
    </div>
</main>
<script>
    const page = document.getElementById("priorita-page"), alertBox = document.getElementById("priorita-alert"), body = document.getElementById("priorita-body");
    function escapeHtml(value) { return String(value ?? "").replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#039;"); }
    async function loadOrdiniOperatore() {
        alertBox.classList.add("d-none"); body.innerHTML = "";
        const response = await window.avpFetch(`/api/priorita/operatori/${encodeURIComponent(page.dataset.operatoreId)}/ordini`), data = await response.json();
        if (!response.ok) { alertBox.className = "alert alert-danger"; alertBox.textContent = data.error || "Errore caricamento priorità."; return; }
        for (const item of data.prioritized || []) { const row = document.createElement("tr"); row.innerHTML = `<td class="priorita-numero">${escapeHtml(item.priorita)}</td><td>${escapeHtml(item.ordine)}</td><td>${escapeHtml(item.codice)}</td><td>${escapeHtml(item.descrizione)}</td><td>${escapeHtml(item.matricola)}</td><td>${escapeHtml(item.stato)}</td><td>${escapeHtml(window.phaseLabel(item.fase))}</td><td>${escapeHtml(item.risorsa)}</td>`; body.appendChild(row); }
    }
    loadOrdiniOperatore().catch(() => { alertBox.className = "alert alert-danger"; alertBox.textContent = "Errore caricamento priorità."; });
    setInterval(loadOrdiniOperatore, 30000);
</script>
{% endblock %}
