{% extends "base.j2" %}

{% block title %}Visualizzazione priorità{% endblock %}

{% block content %}
    <main class="container-fluid mt-3"
          id="priorita-page"
          data-can-edit="0"
          data-max-p2="{{ priorita_2_max }}">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="mb-0">Visualizzazione priorità</h2>

            {% if policy and policy.can("priorita_edit") %}
                <a class="btn btn-primary"
                   href="{{ url_for('main.priorita_edit') }}">
                    Modifica priorità
                </a>
            {% endif %}
        </div>

        <div id="priorita-alert"
             class="alert d-none"
             role="alert"></div>

        <div class="row g-3">
            <div class="col-3 d-flex flex-column"
                 style="height: calc(100vh - 180px); min-height: 0;">

                <div class="card shadow-sm">
                    <div class="card-body">
                        <label for="priorita-operatore-select"
                               class="form-label fw-semibold">
                            Operatore
                        </label>
                        <select id="priorita-operatore-select"
                                class="form-select">
                            <option value="">Seleziona operatore...</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="col-9 d-flex flex-column gap-3"
                 style="height: calc(100vh - 180px); min-height: 0;">

                <div class="card shadow-sm"
                     style="height: 25%;">
                    <div class="card-header bg-danger-subtle fw-semibold">
                        Priorità 1
                    </div>
                    <div class="card-body p-0"
                         style="overflow: auto;">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light sticky-top">
                            <tr>
                                <th>Ordine</th>
                                <th>Codice</th>
                                <th>Descrizione</th>
                                <th>Fase</th>
                                <th>Risorsa</th>
                            </tr>
                            </thead>
                            <tbody id="priorita-p1-body"></tbody>
                        </table>
                    </div>
                </div>

                <div class="card shadow-sm"
                     style="height: 35%;">
                    <div class="card-header bg-warning-subtle fw-semibold">
                        Priorità 2
                    </div>
                    <div class="card-body p-0"
                         style="overflow: auto;">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light sticky-top">
                            <tr>
                                <th>Ordine</th>
                                <th>Codice</th>
                                <th>Fase</th>
                                <th>Risorsa</th>
                            </tr>
                            </thead>
                            <tbody id="priorita-p2-body"></tbody>
                        </table>
                    </div>
                </div>

                <div class="card shadow-sm flex-grow-1"
                     style="min-height: 0;">
                    <div class="card-header bg-success-subtle fw-semibold">
                        Priorità 3
                    </div>
                    <div class="card-body p-0"
                         style="overflow: auto;">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light sticky-top">
                            <tr>
                                <th>Ordine</th>
                                <th>Codice</th>
                                <th>Fase</th>
                                <th>Risorsa</th>
                            </tr>
                            </thead>
                            <tbody id="priorita-p3-body"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        (() => {
            const selectOperatore = document.getElementById("priorita-operatore-select");
            const alertBox = document.getElementById("priorita-alert");

            const bodies = {
                p1: document.getElementById("priorita-p1-body"),
                p2: document.getElementById("priorita-p2-body"),
                p3: document.getElementById("priorita-p3-body"),
            };

            function showAlert(type, message) {
                alertBox.className = `alert alert-${type}`;
                alertBox.textContent = message;
                alertBox.classList.remove("d-none");
            }

            function clearAlert() {
                alertBox.classList.add("d-none");
                alertBox.textContent = "";
            }

            function escapeHtml(value) {
                return String(value ?? "")
                    .replaceAll("&", "&amp;")
                    .replaceAll("<", "&lt;")
                    .replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;")
                    .replaceAll("'", "&#039;");
            }

            function makeRow(item) {
                const tr = document.createElement("tr");

                tr.innerHTML = `
                                <td>${escapeHtml(item.ordine)}</td>
                                <td>${escapeHtml(item.codice)}</td>
                                <td>${escapeHtml(item.descrizione)}</td>
                                <td>${escapeHtml(item.fase)}</td>
                                <td>${escapeHtml(item.risorsa)}</td>
                            `;

                return tr;
            }

            function renderRows(tbody, rows) {
                tbody.innerHTML = "";

                for (const item of rows || []) {
                    tbody.appendChild(makeRow(item));
                }
            }

            async function loadOperatori() {
                const response = await fetch("{{ url_for('main.api_priorita_operatori') }}");
                const data = await response.json();

                for (const op of data.operatori || []) {
                    const option = document.createElement("option");
                    option.value = op.id;
                    option.textContent = op.username;
                    selectOperatore.appendChild(option);
                }
            }

            async function loadOrdiniOperatore() {
                clearAlert();

                const operatoreId = selectOperatore.value;

                renderRows(bodies.p1, []);
                renderRows(bodies.p2, []);
                renderRows(bodies.p3, []);

                if (!operatoreId) {
                    return;
                }

                const url = `/api/priorita/operatori/${encodeURIComponent(operatoreId)}/ordini`;
                const response = await fetch(url);
                const data = await response.json();

                if (!response.ok) {
                    showAlert("danger", data.error || "Errore caricamento priorità.");
                    return;
                }

                renderRows(bodies.p1, data.p1 || []);
                renderRows(bodies.p2, data.p2 || []);
                renderRows(bodies.p3, data.p3 || []);
            }

            selectOperatore.addEventListener("change", loadOrdiniOperatore);

            loadOperatori()
                .catch(() => showAlert("danger", "Errore caricamento operatori."));

            setInterval(() => {
                if (!selectOperatore.value) return;
                loadOrdiniOperatore();
            }, 30000);
        })();
    </script>
{% endblock %}