{% extends "base.j2" %}

{% block styles %}
    {{ super() }}

    <style>
        .evento-intervento-richiesto > * {
            background-color: #7f1d1d !important;
            color: #ffffff !important;
        }

        .evento-intervento-richiesto .text-muted {
            color: #fecaca !important;
        }
    </style>
{% endblock %}

{% block title %}
    Manutenzioni - {{ macchinario.codice }}
{% endblock %}

{% block content %}
    <main class="container-fluid py-3"
          id="manutenzioni-macchinario-page"
          data-macchinario-id="{{ macchinario.id }}"
          data-piani-url="{{ url_for(
          'main.api_manutenzioni_piani_list',
          macchinario_id=macchinario.id
      ) }}"
          data-piano-base-url="/api/manutenzioni/piani"
          data-eventi-url="{{ url_for(
          'main.api_manutenzioni_eventi_list',
          macchinario_id=macchinario.id
      ) }}"
          data-genera-eventi-url="{{ url_for(
          'main.api_manutenzioni_eventi_generate',
          macchinario_id=macchinario.id
      ) }}"
          data-evento-base-url="/api/manutenzioni/eventi"
          data-straordinarie-url="{{ url_for(
              'main.api_manutenzioni_straordinarie_list',
              macchinario_id=macchinario.id
          ) }}"
          data-straordinaria-base-url="/api/manutenzioni/straordinarie"
          data-selected-view="{{ selected_view }}"
          data-oggi="{{ oggi }}"
          data-adesso="{{ adesso }}">

        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <a href="{{ operator_url_for(
                        'main.manutenzioni_home',
                        view='macchinari'
                    ) }}"
                       class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i>
                    </a>

                    <h1 class="h4 mb-0">
                        {{ macchinario.codice }}
                        - {{ macchinario.descrizione }}
                    </h1>
                </div>

                <div class="text-muted small">
                    Reparto {{ macchinario.reparto_codice }}
                    {% if macchinario.reparto_descrizione %}
                    - {{ macchinario.reparto_descrizione }}
                    {% endif %}
                </div>
            </div>

            {% if can_manage_plans and selected_view == "programmate" %}
                <div class="d-flex flex-wrap gap-2">
                    <button type="button"
                            class="btn btn-outline-primary"
                            id="btn-genera-eventi">
                        <i class="bi bi-arrow-repeat"></i>
                        Aggiorna calendario
                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            id="btn-nuovo-piano">
                        <i class="bi bi-plus-lg"></i>
                        Nuova serie ricorrente
                    </button>
                </div>
            {% endif %}
        </div>
        <div class="card shadow-sm mb-3">
            <div class="card-header fw-semibold">
                Dati macchinario
            </div>

            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <div class="text-muted small">
                            Matricola
                        </div>
                        <div>
                            {{ macchinario.matricola or "-" }}
                        </div>
                    </div>

                    <div class="col-6 col-md-3">
                        <div class="text-muted small">
                            Costruttore
                        </div>
                        <div>
                            {{ macchinario.costruttore or "-" }}
                        </div>
                    </div>

                    <div class="col-6 col-md-3">
                        <div class="text-muted small">
                            Modello
                        </div>
                        <div>
                            {{ macchinario.modello or "-" }}
                        </div>
                    </div>

                    <div class="col-6 col-md-3">
                        <div class="text-muted small">
                            Ubicazione
                        </div>
                        <div>
                            {{ macchinario.ubicazione or "-" }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {% if request.args.get("operatori_salvati") == "1" %}
            <div class="alert alert-success" role="alert">
                Operatori assegnati correttamente.
            </div>
        {% elif request.args.get("operatori_errore") %}
            <div class="alert alert-danger" role="alert">
                {{ request.args.get("operatori_errore") }}
            </div>
        {% endif %}

        <div class="card shadow-sm mb-3">
            <div class="card-header fw-semibold">
                Operatori assegnati
            </div>
            <div class="card-body">
                {% set assegnati_ids = macchinario.operatori_assegnati
                    | map(attribute="public_id") | list %}

                {% if can_manage_machine %}
                    <form method="post"
                          action="{{ operator_url_for(
                              'main.manutenzioni_macchinario_operatori_update',
                              macchinario_id=macchinario.id
                          ) }}">
                        <input type="hidden"
                               name="view"
                               value="{{ selected_view }}">

                        {% if operatori_disponibili %}
                            <div class="row g-2 mb-3">
                                {% for operatore in operatori_disponibili %}
                                    <div class="col-12 col-md-6 col-xl-4">
                                        <div class="form-check border rounded p-2 ps-5 h-100">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="operator_public_ids"
                                                   value="{{ operatore.public_id }}"
                                                   id="operatore-{{ loop.index }}"
                                                   {% if operatore.public_id in assegnati_ids %}checked{% endif %}>
                                            <label class="form-check-label w-100"
                                                   for="operatore-{{ loop.index }}">
                                                {{ operatore.username }}
                                            </label>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <p class="text-muted mb-3">
                                Nessun operatore attivo disponibile per il reparto
                                {{ macchinario.reparto_codice }}.
                            </p>
                        {% endif %}

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i>
                            Salva assegnazioni
                        </button>
                    </form>
                {% elif macchinario.operatori_assegnati %}
                    <div class="d-flex flex-wrap gap-2">
                        {% for operatore in macchinario.operatori_assegnati %}
                            <span class="badge text-bg-secondary">
                                {{ operatore.username }}
                            </span>
                        {% endfor %}
                    </div>
                {% else %}
                    <span class="text-muted">Nessun operatore assegnato.</span>
                {% endif %}
            </div>
        </div>

        <ul class="nav nav-tabs mb-3"
            id="macchinario-manutenzioni-tabs"
            role="tablist">

            <li class="nav-item"
                role="presentation">
                <a class="nav-link {% if selected_view == 'programmate' %}active{% endif %}"
                   id="programmate-tab"
                   role="tab"
                   aria-controls="programmate-pane"
                   aria-selected="{{ 'true' if selected_view == 'programmate' else 'false' }}"
                   href="{{ operator_url_for(
                       'main.manutenzioni_macchinario_detail',
                       macchinario_id=macchinario.id,
                       view='programmate'
                   ) }}">
                    <i class="bi bi-calendar-check"></i>
                    Manutenzioni programmate
                </a>
            </li>

            <li class="nav-item"
                role="presentation">
                <a class="nav-link {% if selected_view == 'straordinarie' %}active{% endif %}"
                   id="straordinarie-tab"
                   role="tab"
                   aria-controls="straordinarie-pane"
                   aria-selected="{{ 'true' if selected_view == 'straordinarie' else 'false' }}"
                   href="{{ operator_url_for(
                       'main.manutenzioni_macchinario_detail',
                       macchinario_id=macchinario.id,
                       view='straordinarie'
                   ) }}">
                    <i class="bi bi-tools"></i>
                    Interventi straordinari
                    <span class="badge text-bg-secondary ms-1">
                        {{ straordinarie|length }}
                    </span>
                </a>
            </li>
        </ul>

        <div class="tab-content"
             id="macchinario-manutenzioni-content">

            {% if selected_view == "programmate" %}
                <div class="tab-pane fade {% if selected_view == 'programmate' %}show active{% endif %}"
                     id="programmate-pane"
                     role="tabpanel"
                     aria-labelledby="programmate-tab">
                <div class="card shadow-sm mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-semibold">
            Eventi di manutenzione
        </span>

                        <span class="badge text-bg-secondary">
            {{ eventi|length }}
        </span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead>
                            <tr>
                                <th>Data programmata</th>
                                <th>Codice piano</th>
                                <th>Manutenzione</th>
                                <th>Stato</th>
                                <th>Data esecuzione</th>
                                <th>Operatore</th>
                                <th>Esito</th>
                                {% if can_execute_events %}
                                    <th class="text-end">
                                        Azioni
                                    </th>
                                {% endif %}
                            </tr>
                            </thead>

                            <tbody>
                            {% for evento in eventi %}
                                <tr class="{% if evento.esito == 'INTERVENTO_RICHIESTO' %}evento-intervento-richiesto{% endif %}">
                                    <td class="fw-semibold">
                                        {{ evento.data_programmata }}

                                        {% if evento.data_spostata %}
                                            <div class="small text-muted fw-normal">
                                                Prevista originariamente:
                                                {{ evento.data_teorica }}

                                                {% if evento.motivo_spostamento %}
                                                — {{ evento.motivo_spostamento }}
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {{ evento.piano_codice or "-" }}
                                    </td>
                                    <td>
                                        <div>{{ evento.titolo }}</div>

                                        {% if evento.descrizione %}
                                            <div class="small text-muted">
                                                {{ evento.descrizione }}
                                            </div>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if evento.stato_visuale == "SCADUTA" %}
                                            <span class="badge text-bg-danger">
                                    Scaduta
                                </span>
                                        {% elif evento.stato_visuale == "IN_SCADENZA" %}
                                            <span class="badge text-bg-warning">
                                    In scadenza
                                </span>
                                        {% elif evento.stato_visuale == "PROGRAMMATA" %}
                                            <span class="badge text-bg-primary">
                                    Programmata
                                </span>
                                        {% elif evento.stato_visuale == "COMPLETATA" %}
                                            <span class="badge text-bg-success">
                                    Completata
                                </span>
                                        {% elif evento.stato_visuale == "SALTATA" %}
                                            <span class="badge text-bg-secondary">
                                    Saltata
                                </span>
                                        {% elif evento.stato_visuale == "ANNULLATA" %}
                                            <span class="badge text-bg-dark">
                                    Annullata
                                </span>
                                        {% else %}
                                            <span class="badge text-bg-secondary">
                                    {{ evento.stato_visuale }}
                                </span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {{ evento.data_esecuzione or "-" }}
                                    </td>
                                    <td>
                                        {{ evento.eseguito_da_username
                                        or evento.registrato_da_username
                                        or "-" }}
                                    </td>
                                    <td>
                                        {{ evento.esito or "-" }}
                                    </td>
                                    {% if can_execute_events %}
                                <td class="text-end">
                                    {% if evento.straordinaria_id %}
                                        <a href="{{ operator_url_for(
                                                'main.manutenzioni_macchinario_detail',
                                                macchinario_id=macchinario.id,
                                                view='straordinarie',
                                                intervento_id=evento.straordinaria_id
                                            ) }}"
                                           class="btn btn-sm btn-warning">
                                            <i class="bi bi-tools"></i>
                                            Apri intervento
                                        </a>
                                    {% elif evento.stato == "PROGRAMMATA" %}
                                        <button type="button"
                                                        class="btn btn-sm btn-primary btn-gestisci-evento"
                                                        data-evento-id="{{ evento.id }}">
                                                    <i class="bi bi-check2-square"></i>
                                                    Registra
                                                </button>
                                            {% else %}
                                                <span class="text-muted">
                                        -
                                        </span>
                                            {% endif %}
                                        </td>
                                    {% endif %}
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="{{ 8 if can_execute_events else 7 }}"
                                        class="text-center text-muted py-4">
                                        Nessun evento generato.
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-semibold">
                Serie ricorrenti
            </span>

                    <span class="badge text-bg-secondary">
                {{ piani|length }}
            </span>
                </div>

                <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                <thead>
                <tr>
                <th>Codice</th>
                <th>Manutenzione</th>
                <th>Frequenza</th>
                <th>Data iniziale</th>
                <th>Preavviso</th>
                <th>Stato</th>

            {% endif %}

            {% if selected_view == "straordinarie" %}
                <div class="tab-pane fade {% if selected_view == 'straordinarie' %}show active{% endif %}"
                     id="straordinarie-pane"
                     role="tabpanel"
                     aria-labelledby="straordinarie-tab">

                    <div class="card shadow-sm">
                        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div>
                                <div class="fw-semibold">
                                    Interventi straordinari
                                </div>
                                <div class="small text-muted">
                                    Guasti, anomalie e interventi non generati
                                    da una manutenzione ricorrente.
                                </div>
                            </div>

                            {% if can_manage_straordinarie %}
                                <button type="button"
                                        class="btn btn-sm btn-warning"
                                        id="btn-nuova-straordinaria-tab">
                                    <i class="bi bi-plus-lg"></i>
                                    Registra intervento
                                </button>
                            {% endif %}
                        </div>

                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle mb-0">
                                <thead>
                                <tr>
                                    <th>Data e ora</th>
                                    <th>Intervento</th>
                                    <th>Problema</th>
                                    <th>Esito</th>
                                    <th>Esecutore</th>
                                    <th>Fermo macchina</th>
                                    <th>Durata</th>
                                    {% if can_manage_straordinarie %}
                                        <th class="text-end">
                                            Azioni
                                        </th>
                                    {% endif %}
                                </tr>
                                </thead>

                                <tbody>
                                {% for intervento in straordinarie %}
                                    <tr>
                                        <td class="fw-semibold">
                                            {{ intervento.data_intervento_visuale }}
                                        </td>

                                        <td>
                                            <div class="fw-semibold">
                                                {{ intervento.titolo }}
                                            </div>

                                            <div class="small text-muted">
                                                {{ intervento.intervento_eseguito }}
                                            </div>
                                        </td>

                                        <td>
                                            <div>
                                                {{ intervento.descrizione_problema }}
                                            </div>

                                            {% if intervento.causa %}
                                                <div class="small text-muted">
                                                    Causa: {{ intervento.causa }}
                                                </div>
                                            {% endif %}
                                        </td>

                                        <td>
                                            {% if intervento.esito == "RISOLTO" %}
                                                <span class="badge text-bg-success">
                                                    Risolto
                                                </span>
                                            {% elif intervento.esito == "PARZIALMENTE_RISOLTO" %}
                                                <span class="badge text-bg-warning">
                                                    Parzialmente risolto
                                                </span>
                                            {% elif intervento.esito == "DA_VERIFICARE" %}
                                                <span class="badge text-bg-info">
                                                    Da verificare
                                                </span>
                                            {% else %}
                                                <span class="badge text-bg-danger">
                                                    Non risolto
                                                </span>
                                            {% endif %}
                                        </td>

                                        <td>
                                            {{ intervento.esecutore }}
                                        </td>

                                        <td>
                                            {% if intervento.fermo_macchina_minuti is not none %}
                                                {{ intervento.fermo_macchina_minuti }} min
                                            {% else %}
                                                                                       -
                                            {% endif %}
                                        </td>

                                        <td>
                                            {% if intervento.durata_intervento_minuti is not none %}
                                                {{ intervento.durata_intervento_minuti }} min
                                            {% else %}
                                                                                          -
                                            {% endif %}
                                        </td>

                                        {% if can_manage_straordinarie %}
                                            <td class="text-end">
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-primary btn-modifica-straordinaria"
                                                        data-intervento-id="{{ intervento.id }}">
                                                    <i class="bi bi-pencil"></i>
                                                    Modifica
                                                </button>
                                            </td>
                                        {% endif %}
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="{{ 8 if can_manage_straordinarie else 7 }}"
                                            class="text-center text-muted py-4">
                                            Nessun intervento straordinario registrato.
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% endif %}

            {% if selected_view == "programmate" %}
                {% if can_manage_plans %}
                    <th class="text-end">
                        Azioni
                    </th>
                {% endif %}
                </tr>
                </thead>

                <tbody>
                {% for piano in piani %}
                    <tr>
                        <td>
                            {{ piano.codice or "-" }}
                        </td>

                        <td>
                            <div class="fw-semibold">
                                {{ piano.titolo }}
                            </div>

                            {% if piano.descrizione %}
                                <div class="small text-muted">
                                    {{ piano.descrizione }}
                                </div>
                            {% endif %}
                        </td>

                        <td>
                            {{ piano.descrizione_frequenza }}
                        </td>

                        <td>
                            {{ piano.data_inizio }}
                        </td>

                        <td>
                            {{ piano.preavviso_giorni }}
                            giorni
                        </td>

                        <td>
                            {% if piano.attiva %}
                                <span class="badge text-bg-success">
                                        Attiva
                                    </span>
                            {% else %}
                                <span class="badge text-bg-secondary">
                                        Inattiva
                                    </span>
                            {% endif %}
                        </td>

                        {% if can_manage_plans %}
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary btn-modifica-piano"
                                            data-piano-id="{{ piano.id }}">
                                        <i class="bi bi-pencil"></i>
                                        Modifica
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm {% if piano.attiva %}btn-outline-danger{% else %}btn-outline-success{% endif %} btn-stato-piano"
                                            data-piano-id="{{ piano.id }}"
                                            data-piano-attiva="{{ '1' if piano.attiva else '0' }}"
                                            data-piano-titolo="{{ piano.titolo }}">
                                        {% if piano.attiva %}
                                            Disattiva
                                        {% else %}
                                            Attiva
                                        {% endif %}
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-danger btn-elimina-piano"
                                            data-piano-id="{{ piano.id }}"
                                            data-piano-titolo="{{ piano.titolo }}">
                                        <i class="bi bi-trash"></i>
                                        Elimina
                                    </button>
                                </div>
                            </td>
                        {% endif %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="{{ 7 if can_manage_plans else 6 }}"
                            class="text-center text-muted py-4">
                            Nessuna manutenzione ricorrente configurata.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
                </table>
                </div>
                </div>
                </div>
            {% endif %}
        </div>

        {% if can_manage_plans %}
            <div class="modal fade"
                 id="modalPianoManutenzione"
                 tabindex="-1"
                 aria-hidden="true">

                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content">

                        <form id="form-piano-manutenzione"
                              novalidate>

                            <div class="modal-header">
                                <h5 class="modal-title"
                                    id="modalPianoManutenzioneLabel">
                                    Nuova manutenzione ricorrente
                                </h5>

                                <button type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal"
                                        aria-label="Chiudi">
                                </button>
                            </div>

                            <div class="modal-body">
                                <input type="hidden"
                                       id="piano-id">

                                <div id="piano-feedback"
                                     class="alert d-none">
                                </div>

                                <div id="piano-loading"
                                     class="d-none mb-3">
                                    <div class="spinner-border spinner-border-sm">
                                    </div>
                                    Caricamento...
                                </div>

                                <div class="row g-3"
                                     id="piano-fields">

                                    <div class="col-md-4">
                                        <label class="form-label"
                                               for="piano-codice">
                                            Codice
                                        </label>

                                        <input type="text"
                                               class="form-control"
                                               id="piano-codice">
                                    </div>

                                    <div class="col-md-8">
                                        <label class="form-label"
                                               for="piano-titolo">
                                            Titolo
                                        </label>

                                        <input type="text"
                                               class="form-control"
                                               id="piano-titolo"
                                               required>
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label"
                                               for="piano-descrizione">
                                            Descrizione e istruzioni
                                        </label>

                                        <textarea class="form-control"
                                                  id="piano-descrizione"
                                                  rows="3"></textarea>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label"
                                               for="piano-frequenza-unita">
                                            Unità
                                        </label>

                                        <select class="form-select"
                                                id="piano-frequenza-unita"
                                                required>
                                            <option value="giorni">
                                                Giorni
                                            </option>
                                            <option value="settimane">
                                                Settimane
                                            </option>
                                            <option value="mesi">
                                                Mesi
                                            </option>
                                            <option value="anni">
                                                Anni
                                            </option>
                                        </select>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label"
                                               for="piano-frequenza-intervallo">
                                            Ogni
                                        </label>

                                        <input type="number"
                                               class="form-control"
                                               id="piano-frequenza-intervallo"
                                               min="1"
                                               value="1"
                                               required>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label"
                                               for="piano-preavviso">
                                            Preavviso giorni
                                        </label>

                                        <input type="number"
                                               class="form-control"
                                               id="piano-preavviso"
                                               min="0"
                                               value="7"
                                               required>
                                    </div>

                                    <div class="col-12 d-none"
                                         id="piano-giorni-wrapper">

                                        <label class="form-label">
                                            Giorni della settimana
                                        </label>

                                        <div class="d-flex flex-wrap gap-3">
                                            {% for codice in ["MO", "TU", "WE", "TH", "FR"] %}
