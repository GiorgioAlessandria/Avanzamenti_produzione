{% block extra_js %}
    {{ super() }}
    <script>
        window.manutenzioniReadJson = async function (response) {
            try {
                return await response.json();
            } catch (_) {
                return {
                    ok: false,
                    error: "Risposta non valida dal server."
                };
            }
        };
    </script>


    {% if can_manage_plans %}
        <script>
            "use strict";

            document.addEventListener(
                "DOMContentLoaded",
                () => {
                    const page = document.getElementById(
                        "manutenzioni-macchinario-page"
                    );

                    const modalElement = document.getElementById(
                        "modalPianoManutenzione"
                    );

                    const form = document.getElementById(
                        "form-piano-manutenzione"
                    );

                    if (!page || !modalElement || !form) {
                        return;
                    }

                    const pianiUrl = page.dataset.pianiUrl;
                    const pianoBaseUrl = (
                        page.dataset.pianoBaseUrl
                    ).replace(/\/+$/, "");
                    const generateEventsButton = document.getElementById(
                        "btn-genera-eventi"
                    );

                    const generateEventsUrl = String(
                        page.dataset.generaEventiUrl || ""
                    ).trim();

                    const modal = (
                        bootstrap.Modal.getOrCreateInstance(
                            modalElement
                        )
                    );

                    const fields = {
                        id: document.getElementById("piano-id"),
                        codice: document.getElementById("piano-codice"),
                        titolo: document.getElementById("piano-titolo"),
                        descrizione: document.getElementById("piano-descrizione"),
                        unita: document.getElementById("piano-frequenza-unita"),
                        intervallo: document.getElementById(
                            "piano-frequenza-intervallo"
                        ),
                        preavviso: document.getElementById("piano-preavviso"),
                        dataInizio: document.getElementById("piano-data-inizio"),
                        attiva: document.getElementById("piano-attiva")
                    };

                    const titoloModal = document.getElementById(
                        "modalPianoManutenzioneLabel"
                    );

                    const feedback = document.getElementById(
                        "piano-feedback"
                    );

                    const loading = document.getElementById(
                        "piano-loading"
                    );

                    const fieldsContainer = document.getElementById(
                        "piano-fields"
                    );

                    const giorniWrapper = document.getElementById(
                        "piano-giorni-wrapper"
                    );

                    const saveButton = document.getElementById(
                        "btn-salva-piano"
                    );

                    function pianoUrl(id) {
                        return `${pianoBaseUrl}/${encodeURIComponent(id)}`;
                    }

                    function showFeedback(message, type = "danger") {
                        feedback.textContent = message || "";
                        feedback.className = message
                            ? `alert alert-${type}`
                            : "alert d-none";
                    }

                    function setLoading(value) {
                        loading.classList.toggle("d-none", !value);
                        fieldsContainer.classList.toggle("d-none", value);
                        saveButton.disabled = value;
                    }

                    function updateWeekdaysVisibility() {
                        const visible = fields.unita.value === "settimane";

                        giorniWrapper.classList.toggle(
                            "d-none",
                            !visible
                        );

                        if (!visible) {
                            document
                                .querySelectorAll(".piano-giorno")
                                .forEach(input => {
                                    input.checked = false;
                                });
                        }
                    }

                    function resetForm() {
                        form.reset();
                        form.classList.remove("was-validated");

                        fields.id.value = "";
                        fields.intervallo.value = "1";
                        fields.preavviso.value = "7";
                        fields.attiva.checked = true;

                        document
                            .querySelectorAll(".piano-giorno")
                            .forEach(input => {
                                input.checked = false;
                            });

                        fieldsContainer.classList.remove("d-none");
                        showFeedback("");
                        setLoading(false);
                        updateWeekdaysVisibility();
                    }

                    function selectedWeekdays() {
                        return Array.from(
                            document.querySelectorAll(
                                ".piano-giorno:checked"
                            )
                        ).map(input => input.value);
                    }

                    function buildPayload() {
                        return {
                            codice: fields.codice.value.trim(),
                            titolo: fields.titolo.value.trim(),
                            descrizione: (
                                fields.descrizione.value.trim()
                            ),
                            frequenza_unita: fields.unita.value,
                            frequenza_intervallo: Number(
                                fields.intervallo.value
                            ),
                            giorni_settimana: selectedWeekdays(),
                            data_inizio: fields.dataInizio.value,
                            preavviso_giorni: Number(
                                fields.preavviso.value
                            ),
                            attiva: fields.attiva.checked
                        };
                    }

                    function populateForm(item) {
                        fields.id.value = item.id || "";
                        fields.codice.value = item.codice || "";
                        fields.titolo.value = item.titolo || "";
                        fields.descrizione.value = (
                            item.descrizione || ""
                        );
                        fields.unita.value = (
                            item.frequenza_unita || "giorni"
                        );
                        fields.intervallo.value = (
                            item.frequenza_intervallo || 1
                        );
                        fields.preavviso.value = (
                            item.preavviso_giorni ?? 7
                        );
                        fields.dataInizio.value = (
                            item.data_inizio || ""
                        );
                        fields.attiva.checked = Boolean(item.attiva);

                        const selected = new Set(
                            item.giorni_settimana || []
                        );

                        document
                            .querySelectorAll(".piano-giorno")
                            .forEach(input => {
                                input.checked = selected.has(
                                    input.value
                                );
                            });

                        updateWeekdaysVisibility();
                    }

                    async function parseResponse(response) {
                        return window.manutenzioniReadJson(response);
                    }

                    async function generateEvents() {
                        if (!generateEventsButton || !generateEventsUrl) {
                            return;
                        }

                        const originalHtml = generateEventsButton.innerHTML;

                        generateEventsButton.disabled = true;

                        generateEventsButton.innerHTML = `
                                <span class="spinner-border spinner-border-sm"
                                      aria-hidden="true"></span>
                                Aggiornamento...
                            `;

                        try {
                            const response = await window.avpFetch(
                                generateEventsUrl,
                                {
                                    method: "POST",
                                    headers: {
                                        "Accept": "application/json",
                                        "X-Requested-With": "XMLHttpRequest"
                                    },
                                    credentials: "same-origin"
                                }
                            );

                            const data = await parseResponse(response);

                            if (!response.ok || data.ok === false) {
                                throw new Error(
                                    data.error
                                    || "Errore durante la generazione."
                                );
                            }

                            window.location.reload();

                        } catch (error) {
                            generateEventsButton.disabled = false;
                            generateEventsButton.innerHTML = originalHtml;

                            window.alert(
                                error.message
                                || "Errore durante la generazione."
                            );
                        }
                    }

                    function openCreateModal() {
                        resetForm();

                        titoloModal.textContent = (
                            "Nuova manutenzione ricorrente"
                        );

                        modal.show();

                        modalElement.addEventListener(
                            "shown.bs.modal",
                            () => fields.titolo.focus(),
                            {once: true}
                        );
                    }

                    async function openEditModal(pianoId) {
                        resetForm();
                        setLoading(true);

                        titoloModal.textContent = (
                            "Modifica manutenzione ricorrente"
                        );

                        modal.show();

                        try {
                            const response = await window.avpFetch(
                                pianoUrl(pianoId),
                                {
                                    method: "GET",
                                    headers: {
                                        "Accept": "application/json",
                                        "X-Requested-With": "XMLHttpRequest"
                                    },
                                    credentials: "same-origin"
                                }
                            );

                            const data = await parseResponse(response);

                            if (!response.ok || data.ok === false) {
                                throw new Error(
                                    data.error
                                    || "Errore durante il caricamento."
                                );
                            }

                            populateForm(data.item || {});
                            setLoading(false);

                        } catch (error) {
                            setLoading(false);
                            fieldsContainer.classList.add("d-none");
                            saveButton.disabled = true;

                            showFeedback(
                                error.message
                                || "Errore durante il caricamento."
                            );
                        }
                    }

                    async function savePiano(event) {
                        event.preventDefault();

                        form.classList.add("was-validated");

                        if (!form.checkValidity()) {
                            return;
                        }
                        if (
                            fields.unita.value === "settimane"
                            && selectedWeekdays().length === 0
                        ) {
                            showFeedback(
                                "Selezionare almeno un giorno lavorativo "
                                + "per la frequenza settimanale."
                            );

                            giorniWrapper.scrollIntoView({
                                behavior: "smooth",
                                block: "center"
                            });

                            return;
                        }

                        const pianoId = fields.id.value.trim();
                        const editing = Boolean(pianoId);

                        saveButton.disabled = true;
                        showFeedback("");

                        try {
                            const response = await window.avpFetch(
                                editing
                                    ? pianoUrl(pianoId)
                                    : pianiUrl,
                                {
                                    method: editing
                                        ? "PATCH"
                                        : "POST",
                                    headers: {
                                        "Content-Type": "application/json",
                                        "Accept": "application/json",
                                        "X-Requested-With": "XMLHttpRequest"
                                    },
                                    credentials: "same-origin",
                                    body: JSON.stringify(
                                        buildPayload()
                                    )
                                }
                            );

                            const data = await parseResponse(response);

                            if (!response.ok || data.ok === false) {
                                throw new Error(
                                    data.error
                                    || "Errore durante il salvataggio."
                                );
                            }

                            showFeedback(
                                data.message,
                                "success"
                            );

                            window.setTimeout(
                                () => window.location.reload(),
                                400
                            );

                        } catch (error) {
                            saveButton.disabled = false;

                            showFeedback(
                                error.message
                                || "Errore durante il salvataggio."
                            );
                        }
                    }

                    async function changeStatus(button) {
                        const pianoId = button.dataset.pianoId;
                        const active = (
                            button.dataset.pianoAttiva === "1"
                        );
                        const newActive = !active;

                        const confirmed = window.confirm(
                            `Confermi di voler ${
                                newActive
                                    ? "attivare"
                                    : "disattivare"
                            } il piano "${button.dataset.pianoTitolo}"?`
                        );

                        if (!confirmed) {
                            return;
                        }

                        button.disabled = true;

                        try {
                            const response = await window.avpFetch(
                                `${pianoUrl(pianoId)}/stato`,
                                {
                                    method: "PATCH",
                                    headers: {
                                        "Content-Type": "application/json",
                                        "Accept": "application/json",
                                        "X-Requested-With": "XMLHttpRequest"
                                    },
                                    credentials: "same-origin",
                                    body: JSON.stringify({
                                        attiva: newActive
                                    })
                                }
                            );

                            const data = await parseResponse(response);

                            if (!response.ok || data.ok === false) {
                                throw new Error(
                                    data.error
                                    || "Errore durante l'aggiornamento."
                                );
                            }

                            window.location.reload();

                        } catch (error) {
                            button.disabled = false;
                            window.alert(error.message);
                        }
                    }

                    async function deletePiano(button) {
                        const confirmed = window.confirm(
                            `Eliminare la serie "${
                                button.dataset.pianoTitolo
                            }" e tutti i suoi eventi programmati? `
                            + "Gli eventi già chiusi resteranno nello storico."
                        );

                        if (!confirmed) {
                            return;
                        }

                        button.disabled = true;

                        try {
                            const response = await window.avpFetch(
                                pianoUrl(button.dataset.pianoId),
                                {
                                    method: "DELETE",
                                    headers: {
                                        "Accept": "application/json",
                                        "X-Requested-With": "XMLHttpRequest"
                                    },
                                    credentials: "same-origin"
                                }
                            );
                            const data = await parseResponse(response);

                            if (!response.ok || data.ok === false) {
                                throw new Error(
                                    data.error
                                    || "Errore durante l'eliminazione."
                                );
                            }

                            window.location.reload();

                        } catch (error) {
                            button.disabled = false;
                            window.alert(error.message);
                        }
                    }

                    fields.unita.addEventListener(
                        "change",
                        updateWeekdaysVisibility
                    );

                    document
                        .getElementById("btn-nuovo-piano")
                        ?.addEventListener(
                            "click",
                            openCreateModal
                        );
                    generateEventsButton?.addEventListener(
                        "click",
                        generateEvents
                    );

                    document.addEventListener(
                        "click",
                        event => {
                            const editButton = event.target.closest(
                                ".btn-modifica-piano"
                            );

                            if (editButton) {
                                openEditModal(
                                    editButton.dataset.pianoId
                                );
                                return;
                            }

                            const stateButton = event.target.closest(
                                ".btn-stato-piano"
                            );

                            if (stateButton) {
                                changeStatus(stateButton);
                                return;
                            }

                            const deleteButton = event.target.closest(
                                ".btn-elimina-piano"
                            );

                            if (deleteButton) {
                                deletePiano(deleteButton);
                            }
                        }
                    );

                    form.addEventListener(
                        "submit",
                        savePiano
                    );

                    modalElement.addEventListener(
                        "hidden.bs.modal",
                        resetForm
                    );

                    updateWeekdaysVisibility();
                }
            );
        </script>
    {% endif %}
    {% if can_execute_events %}
        <script>
            "use strict";

            document.addEventListener("DOMContentLoaded", () => {
                const page = document.getElementById(
                    "manutenzioni-macchinario-page"
                );

                const modalElement = document.getElementById(
                    "modalEventoManutenzione"
                );

                const form = document.getElementById(
                    "form-evento-manutenzione"
                );

                if (!page || !modalElement || !form) {
                    return;
                }

                const eventoBaseUrl = String(
                    page.dataset.eventoBaseUrl || ""
                ).replace(/\/+$/, "");

                const today = String(
                    page.dataset.oggi || ""
                );

                const modal = bootstrap.Modal.getOrCreateInstance(
                    modalElement
                );

                const fields = {
                    id: document.getElementById("evento-id"),
                    titolo: document.getElementById("evento-titolo"),
                    dataProgrammata: document.getElementById(
                        "evento-data-programmata"
                    ),
                    action: document.getElementById("evento-action"),
                    dataEsecuzione: document.getElementById(
                        "evento-data-esecuzione"
                    ),
                    esito: document.getElementById("evento-esito"),
                    durata: document.getElementById("evento-durata"),
                    descrizione: document.getElementById(
                        "evento-descrizione-intervento"
                    ),
                    note: document.getElementById("evento-note")
                };

                const feedback = document.getElementById(
                    "evento-feedback"
                );

                const loading = document.getElementById(
                    "evento-loading"
                );

                const fieldsContainer = document.getElementById(
                    "evento-fields"
                );

                const completionFields = document.getElementById(
                    "evento-completamento-fields"
                );

                const noteLabel = document.getElementById(
                    "evento-note-label"
                );

                const noteHelp = document.getElementById(
                    "evento-note-help"
                );

                const saveButton = document.getElementById(
                    "btn-salva-evento"
                );

                function eventoUrl(eventoId) {
                    return (
                        `${eventoBaseUrl}/`
                        + encodeURIComponent(eventoId)
                    );
                }

                function eventoActionUrl(eventoId) {
                    return `${eventoUrl(eventoId)}/azione`;
                }

                async function parseResponse(response) {
                    return window.manutenzioniReadJson(response);
                }

                function showFeedback(
                    message,
                    type = "danger"
                ) {
                    feedback.textContent = message || "";

                    feedback.className = message
                        ? `alert alert-${type}`
                        : "alert d-none";
                }

                function setLoading(value) {
                    loading.classList.toggle("d-none", !value);
                    fieldsContainer.classList.toggle("d-none", value);
                    saveButton.disabled = value;
                }

                function updateActionFields() {
                    const isComplete = (
                        fields.action.value === "completa"
                    );

                    completionFields.classList.toggle(
                        "d-none",
                        !isComplete
                    );

                    fields.dataEsecuzione.required = isComplete;
                    fields.esito.required = isComplete;
                    fields.note.required = !isComplete;

                    if (isComplete) {
                        noteLabel.textContent = "Note";
                        noteHelp.textContent = "Campo facoltativo.";
                        saveButton.textContent = "Completa manutenzione";
                    } else {
                        noteLabel.textContent = (
                            fields.action.value === "salta"
                                ? "Motivo del salto"
                                : "Motivo dell'annullamento"
                        );

                        noteHelp.textContent = "Campo obbligatorio.";
                        saveButton.textContent = (
                            fields.action.value === "salta"
                                ? "Salta scadenza"
                                : "Annulla scadenza"
                        );
                    }
                }

                function resetForm() {
                    form.reset();
                    form.classList.remove("was-validated");

                    fields.id.value = "";
                    fields.action.value = "completa";
                    fields.dataEsecuzione.value = today;

                    fieldsContainer.classList.remove("d-none");

                    showFeedback("");
                    setLoading(false);
                    updateActionFields();
                }

                function buildPayload() {
                    return {
                        action: fields.action.value,
                        data_esecuzione: (
                            fields.dataEsecuzione.value || null
                        ),
                        esito: fields.esito.value,
                        durata_minuti: fields.durata.value
                            ? Number(fields.durata.value)
                            : null,
                        descrizione_intervento: (
                            fields.descrizione.value.trim()
                        ),
                        note: fields.note.value.trim()
                    };
                }

                async function openEventModal(eventoId) {
                    resetForm();
                    setLoading(true);
                    modal.show();

                    try {
                        const response = await window.avpFetch(
                            eventoUrl(eventoId),
                            {
                                method: "GET",
                                headers: {
                                    "Accept": "application/json",
                                    "X-Requested-With": "XMLHttpRequest"
                                },
                                credentials: "same-origin"
                            }
                        );

                        const data = await parseResponse(response);

                        if (!response.ok || data.ok === false) {
                            throw new Error(
                                data.error
                                || "Errore durante il caricamento."
                            );
                        }

                        const item = data.item || {};

                        fields.id.value = item.id || "";
                        fields.titolo.textContent = (
                            item.titolo || "Manutenzione"
                        );
                        fields.dataProgrammata.textContent = (
                            `Data programmata: ${
                                item.data_programmata || "-"
                            }`
                        );

                        setLoading(false);

                    } catch (error) {
                        setLoading(false);
                        fieldsContainer.classList.add("d-none");
                        saveButton.disabled = true;

                        showFeedback(
                            error.message
                            || "Errore durante il caricamento."
                        );
                    }
                }

                async function saveEvent(event) {
                    event.preventDefault();

                    form.classList.add("was-validated");

                    if (!form.checkValidity()) {
                        return;
                    }

                    if (
                        fields.action.value === "completa"
                        && fields.esito.value === "INTERVENTO_RICHIESTO"
                        && !fields.descrizione.value.trim()
                    ) {
                        showFeedback(
                            "Descrivere l'intervento richiesto "
                        );

                        fields.descrizione.focus();
                        return;
                    }

                    const eventoId = fields.id.value;

                    saveButton.disabled = true;
                    showFeedback("");

                    try {
                        const response = await window.avpFetch(
                            eventoActionUrl(eventoId),
                            {
                                method: "PATCH",
                                headers: {
                                    "Content-Type": "application/json",
                                    "Accept": "application/json",
                                    "X-Requested-With": "XMLHttpRequest"
                                },
                                credentials: "same-origin",
                                body: JSON.stringify(
                                    buildPayload()
                                )
                            }
                        );

                        const data = await parseResponse(response);

                        if (!response.ok || data.ok === false) {
                            throw new Error(
                                data.error
                                || "Errore durante il salvataggio."
                            );
                        }

                        showFeedback(
                            data.message,
                            "success"
                        );

                        const straordinariaId = (
                            data.item?.straordinaria_id
                        );

                        window.setTimeout(
                            () => {
                                if (straordinariaId) {
                                    const url = new URL(window.location.href);
                                    url.searchParams.set("view", "straordinarie");
                                    url.searchParams.set(
                                        "intervento_id",
                                        straordinariaId
                                    );
                                    window.location.href = url;
                                    return;
                                }

                                window.location.reload();
                            },
                            400
                        );

                    } catch (error) {
                        saveButton.disabled = false;

                        showFeedback(
                            error.message
                            || "Errore durante il salvataggio."
                        );
                    }
                }

                fields.action.addEventListener(
                    "change",
                    updateActionFields
                );

                document.addEventListener(
                    "click",
                    event => {
                        const button = event.target.closest(
                            ".btn-gestisci-evento"
                        );

                        if (!button) {
                            return;
                        }

                        openEventModal(
                            button.dataset.eventoId
                        );
                    }
                );

                form.addEventListener(
                    "submit",
                    saveEvent
                );

                modalElement.addEventListener(
                    "hidden.bs.modal",
                    resetForm
                );

                updateActionFields();
            });
        </script>
    {% endif %}

    {% if can_manage_straordinarie %}
        <script>
            "use strict";

            document.addEventListener(
                "DOMContentLoaded",
                () => {
                    const page = document.getElementById(
                        "manutenzioni-macchinario-page"
                    );

                    const modalElement = document.getElementById(
                        "modalManutenzioneStraordinaria"
                    );

                    const form = document.getElementById(
                        "form-manutenzione-straordinaria"
                    );

                    if (!page || !modalElement || !form) {
                        return;
                    }

                    const listUrl = String(
                        page.dataset.straordinarieUrl || ""
                    ).replace(/\/+$/, "");

                    const baseUrl = String(
                        page.dataset.straordinariaBaseUrl || ""
                    ).replace(/\/+$/, "");

                    const nowValue = String(
                        page.dataset.adesso || ""
                    );

                    const modal = (
                        bootstrap.Modal.getOrCreateInstance(
                            modalElement
                        )
                    );

                    const modalTitle = document.getElementById(
                        "modalManutenzioneStraordinariaLabel"
                    );

                    const feedback = document.getElementById(
                        "straordinaria-feedback"
                    );

                    const loading = document.getElementById(
                        "straordinaria-loading"
                    );

                    const fieldsContainer = document.getElementById(
                        "straordinaria-fields"
                    );

                    const saveButton = document.getElementById(
                        "btn-salva-straordinaria"
                    );

                    const fields = {
                        id: document.getElementById(
                            "straordinaria-id"
                        ),
                        data: document.getElementById(
                            "straordinaria-data"
                        ),
                        titolo: document.getElementById(
                            "straordinaria-titolo"
                        ),
                        problema: document.getElementById(
                            "straordinaria-problema"
                        ),
                        causa: document.getElementById(
                            "straordinaria-causa"
                        ),
                        intervento: document.getElementById(
                            "straordinaria-intervento"
                        ),
                        esito: document.getElementById(
                            "straordinaria-esito"
                        ),
                        fermo: document.getElementById(
                            "straordinaria-fermo"
                        ),
                        durata: document.getElementById(
                            "straordinaria-durata"
                        ),
                        esterno: document.getElementById(
                            "straordinaria-esterno"
                        ),
                        note: document.getElementById(
                            "straordinaria-note"
                        )
                    };

                    function itemUrl(interventoId) {
                        return (
                            `${baseUrl}/`
                            + encodeURIComponent(interventoId)
                        );
                    }

                    async function parseResponse(response) {
                        return window.manutenzioniReadJson(response);
                    }

                    function showFeedback(
                        message,
                        type = "danger"
                    ) {
                        feedback.textContent = String(
                            message || ""
                        );

                        feedback.className = message
                            ? `alert alert-${type}`
                            : "alert d-none";
                    }

                    function setLoading(value) {
                        loading.classList.toggle(
                            "d-none",
                            !value
                        );

                        fieldsContainer.classList.toggle(
                            "d-none",
                            value
                        );

                        saveButton.disabled = value;
                    }

                    function resetForm() {
                        form.reset();
                        form.classList.remove(
                            "was-validated"
                        );

                        fields.id.value = "";
                        fields.data.value = nowValue;
                        fields.esito.value = "RISOLTO";

                        fieldsContainer.classList.remove(
                            "d-none"
                        );

                        showFeedback("");
                        setLoading(false);
                    }

                    function populateForm(item) {
                        fields.id.value = item.id || "";
                        fields.data.value = (
                            item.data_intervento || ""
                        );
                        fields.titolo.value = (
                            item.titolo || ""
                        );
                        fields.problema.value = (
                            item.descrizione_problema || ""
                        );
                        fields.causa.value = (
                            item.causa || ""
                        );
                        fields.intervento.value = (
                            item.intervento_eseguito || ""
                        );
                        fields.esito.value = (
                            item.esito || "DA_VERIFICARE"
                        );
                        fields.fermo.value = (
                            item.fermo_macchina_minuti
                            ?? ""
                        );
                        fields.durata.value = (
                            item.durata_intervento_minuti
                            ?? ""
                        );
                        fields.esterno.value = (
                            item.eseguito_da_esterno || ""
                        );
                        fields.note.value = (
                            item.note || ""
                        );
                    }

                    function buildPayload() {
                        return {
                            data_intervento: fields.data.value,
                            titolo: fields.titolo.value.trim(),
                            descrizione_problema: (
                                fields.problema.value.trim()
                            ),
                            causa: fields.causa.value.trim(),
                            intervento_eseguito: (
                                fields.intervento.value.trim()
                            ),
                            esito: fields.esito.value,
                            fermo_macchina_minuti: (
                                fields.fermo.value === ""
                                    ? null
                                    : Number(fields.fermo.value)
                            ),
                            durata_intervento_minuti: (
                                fields.durata.value === ""
                                    ? null
                                    : Number(fields.durata.value)
                            ),
                            eseguito_da_esterno: (
                                fields.esterno.value.trim()
                            ),
                            note: fields.note.value.trim()
                        };
                    }

                    function openCreateModal() {
                        resetForm();

                        modalTitle.textContent = (
                            "Nuovo intervento straordinario"
                        );

                        modal.show();

                        modalElement.addEventListener(
                            "shown.bs.modal",
                            () => fields.titolo.focus(),
                            {once: true}
                        );
                    }

                    async function openEditModal(
                        interventoId
                    ) {
                        resetForm();
                        setLoading(true);

                        modalTitle.textContent = (
                            "Modifica intervento straordinario"
                        );

                        modal.show();

                        try {
                            const response = await window.avpFetch(
                                itemUrl(interventoId),
                                {
                                    method: "GET",
                                    headers: {
                                        "Accept": "application/json",
                                        "X-Requested-With": (
                                            "XMLHttpRequest"
                                        )
                                    },
                                    credentials: "same-origin"
                                }
                            );

                            const data = await parseResponse(
                                response
                            );

                            if (
                                !response.ok
                                || data.ok === false
                            ) {
                                throw new Error(
                                    data.error
                                    || (
                                        "Errore durante "
                                        + "il caricamento."
                                    )
                                );
                            }

                            const item = data.item || {};

                            modalTitle.textContent = item.da_completare
                                ? "Completa intervento straordinario"
                                : "Modifica intervento straordinario";

                            if (item.da_completare) {
                                item.intervento_eseguito = "";
                            }

                            populateForm(item);
                            setLoading(false);

                        } catch (error) {
                            setLoading(false);
                            fieldsContainer.classList.add(
                                "d-none"
                            );
                            saveButton.disabled = true;

                            showFeedback(
                                error.message
                                || (
                                    "Errore durante "
                                    + "il caricamento."
                                )
                            );
                        }
                    }

                    async function saveItem(event) {
                        event.preventDefault();

                        form.classList.add(
                            "was-validated"
                        );

                        if (!form.checkValidity()) {
                            return;
                        }

                        const interventoId = String(
                            fields.id.value || ""
                        ).trim();

                        const editing = Boolean(
                            interventoId
                        );

                        saveButton.disabled = true;
                        showFeedback("");

                        try {
                            const response = await window.avpFetch(
                                editing
                                    ? itemUrl(interventoId)
                                    : listUrl,
                                {
                                    method: editing
                                        ? "PATCH"
                                        : "POST",
                                    headers: {
                                        "Content-Type": (
                                            "application/json"
                                        ),
                                        "Accept": "application/json",
                                        "X-Requested-With": (
                                            "XMLHttpRequest"
                                        )
                                    },
                                    credentials: "same-origin",
                                    body: JSON.stringify(
                                        buildPayload()
                                    )
                                }
                            );

                            const data = await parseResponse(
                                response
                            );

                            if (
                                !response.ok
                                || data.ok === false
                            ) {
                                throw new Error(
                                    data.error
                                    || (
                                        "Errore durante "
                                        + "il salvataggio."
                                    )
                                );
                            }

                            showFeedback(
                                data.message
                                || "Intervento salvato.",
                                "success"
                            );

                            window.setTimeout(
                                () => {
                                    const url = new URL(
                                        window.location.href
                                    );

                                    url.searchParams.set(
                                        "view",
                                        "straordinarie"
                                    );

                                    window.location.href = url;
                                },
                                400
                            );

                        } catch (error) {
                            saveButton.disabled = false;

                            showFeedback(
                                error.message
                                || (
                                    "Errore durante "
                                    + "il salvataggio."
                                )
                            );
                        }
                    }

                    document
                        .getElementById(
                            "btn-nuova-straordinaria-tab"
                        )
                        ?.addEventListener(
                            "click",
                            openCreateModal
                        );

                    document.addEventListener(
                        "click",
                        event => {
                            const button = event.target.closest(
                                ".btn-modifica-straordinaria"
                            );

                            if (!button) {
                                return;
                            }

                            openEditModal(
                                button.dataset.interventoId
                            );
                        }
                    );

                    const requestedInterventoId = (
                        new URL(window.location.href)
                        .searchParams.get("intervento_id")
                    );

                    if (requestedInterventoId) {
                        openEditModal(requestedInterventoId);
                    }

                    form.addEventListener(
                        "submit",
                        saveItem
                    );

                    modalElement.addEventListener(
                        "hidden.bs.modal",
                        resetForm
                    );
                }
            );
        </script>
    {% endif %}

{% endblock %}
