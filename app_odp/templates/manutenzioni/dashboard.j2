{% extends "base.j2" %}

{% block title %}Manutenzioni macchinari{% endblock %}

{% block content %}
    <style>
        .maintenance-calendar-shell {
            overflow-x: auto;
        }

        .maintenance-calendar {
            min-width: 980px;
        }

        .maintenance-calendar-weekdays,
        .maintenance-calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, minmax(0, 1fr));
        }

        .maintenance-calendar-weekday {
            padding: .55rem .65rem;
            border: 1px solid var(--bs-border-color);
            border-bottom: 0;
            background: var(--bs-tertiary-bg);
            font-size: .78rem;
            font-weight: 600;
            text-align: center;
            text-transform: uppercase;
        }

        .maintenance-calendar-day {
            min-height: 145px;
            padding: .4rem;
            border: 1px solid var(--bs-border-color);
            background: var(--bs-body-bg);
        }

        .maintenance-calendar-day.is-outside {
            background: var(--bs-secondary-bg);
            color: var(--bs-secondary-color);
        }

        .maintenance-calendar-day.is-weekend {
            background: color-mix(
                    in srgb,
                    var(--bs-secondary-bg) 70%,
                    var(--bs-body-bg)
            );
        }

        .maintenance-calendar-day.is-holiday {
            box-shadow: inset 0 3px 0 var(--bs-danger-border-subtle);
        }

        .maintenance-calendar-day.is-today {
            outline: 2px solid var(--bs-primary);
            outline-offset: -2px;
        }

        .maintenance-calendar-day-header {
            display: flex;
            justify-content: space-between;
            gap: .35rem;
            margin-bottom: .35rem;
        }

        .maintenance-calendar-day-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 1.7rem;
            height: 1.7rem;
            border-radius: 50%;
            font-size: .85rem;
            font-weight: 600;
        }

        .maintenance-calendar-day.is-today
        .maintenance-calendar-day-number {
            background: var(--bs-primary);
            color: var(--bs-white);
        }

        .maintenance-calendar-holiday {
            margin-bottom: .3rem;
            padding: .15rem .3rem;
            border-radius: .25rem;
            background: var(--bs-danger-bg-subtle);
            color: var(--bs-danger-text-emphasis);
            font-size: .68rem;
            line-height: 1.2;
        }

        .maintenance-calendar-events {
            display: flex;
            flex-direction: column;
            gap: .25rem;
        }

        .maintenance-calendar-event {
            width: 100%;
            padding: .28rem .38rem;
            border: 0;
            border-left: 4px solid currentColor;
            border-radius: .25rem;
            background: var(--bs-secondary-bg);
            color: var(--bs-body-color);
            font-size: .72rem;
            line-height: 1.2;
            text-align: left;
        }

        .maintenance-calendar-event:hover {
            filter: brightness(.96);
        }

        .maintenance-calendar-event.status-SCADUTA {
            background: var(--bs-danger-bg-subtle);
            color: var(--bs-danger-text-emphasis);
        }

        .maintenance-calendar-event.status-INTERVENTO_RICHIESTO {
            background: #7f1d1d;
            color: #ffffff;
            border-left-color: #450a0a;
        }

        .maintenance-calendar-event.status-IN_SCADENZA {
            background: var(--bs-warning-bg-subtle);
            color: var(--bs-warning-text-emphasis);
        }

        .maintenance-calendar-event.status-PROGRAMMATA {
            background: var(--bs-primary-bg-subtle);
            color: var(--bs-primary-text-emphasis);
        }

        .maintenance-calendar-event.status-COMPLETATA {
            background: var(--bs-success-bg-subtle);
            color: var(--bs-success-text-emphasis);
        }

        .maintenance-calendar-event.status-SALTATA,
        .maintenance-calendar-event.status-ANNULLATA {
            background: var(--bs-secondary-bg);
            color: var(--bs-secondary-color);
        }

        .maintenance-calendar-event-title {
            display: block;
            overflow: hidden;
            font-weight: 600;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .maintenance-calendar-event-meta {
            display: block;
            margin-top: .1rem;
            overflow: hidden;
            opacity: .8;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .maintenance-calendar-legend {
            display: flex;
            flex-wrap: wrap;
            gap: .65rem;
            font-size: .75rem;
        }

        .maintenance-calendar-legend-item::before {
            display: inline-block;
            width: .65rem;
            height: .65rem;
            margin-right: .25rem;
            border-radius: 50%;
            content: "";
        }

        .legend-overdue::before {
            background: var(--bs-danger);
        }

        .legend-due::before {
            background: var(--bs-warning);
        }

        .legend-planned::before {
            background: var(--bs-primary);
        }

        .legend-completed::before {
            background: var(--bs-success);
        }
    </style>

    <main class="container-fluid py-3"
          id="manutenzioni-page"
          data-machines-url="{{ url_for('main.api_manutenzioni_macchinari_list') }}"
          data-calendar-url="{{ url_for('main.api_manutenzioni_calendario') }}"
          data-global-calendar-sync-url="{{ url_for('main.api_manutenzioni_calendario_aggiorna') }}"
          data-non-working-days-url="{{ url_for('main.api_manutenzioni_giorni_non_lavorativi_list') }}"
          data-event-base-url="/api/manutenzioni/eventi"
          data-can-execute-events="{{ '1' if can_execute_events else '0' }}"
          data-oggi="{{ oggi }}"
          data-selected-view="{{ selected_view }}">

        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
            <div>
                <h1 class="h4 mb-1">
                    Manutenzioni macchinari
                </h1>

                <div class="text-muted small">
                    Anagrafica dei macchinari e gestione delle manutenzioni
                </div>
            </div>

            <div class="d-flex gap-2">
                {% if can_view_register %}
                    <a href="{{ operator_url_for(
                'main.manutenzioni_scadenziario'
            ) }}"
                       class="btn btn-outline-primary">
                        <i class="bi bi-calendar3"></i>
                        Scadenziario
                    </a>
                {% endif %}

                {% if can_manage_calendar %}
                    <button type="button"
                            class="btn btn-outline-primary"
                            id="btn-aggiorna-calendario-globale">
                        <i class="bi bi-arrow-repeat"></i>
                        Aggiorna calendario
                    </button>
                {% endif %}

                {% if can_manage %}
                    <button type="button"
                            class="btn btn-primary"
                            id="btn-nuovo-macchinario">
                        <i class="bi bi-plus-lg"></i>
                        Nuovo macchinario
                    </button>
                {% endif %}
            </div>
        </div>

        <div id="manutenzioni-global-feedback"
             class="alert d-none mb-3"
             role="alert">
        </div>

        <ul class="nav nav-tabs mb-3"
            id="manutenzioni-view-tabs"
            role="tablist">

            <li class="nav-item"
                role="presentation">
                <button class="nav-link {% if selected_view == 'calendario' %}active{% endif %}"
                        id="manutenzioni-calendario-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#manutenzioni-calendario-pane"
                        data-view-name="calendario"
                        type="button"
                        role="tab">
                    <i class="bi bi-calendar3"></i>
                    Calendario
                </button>
            </li>

            <li class="nav-item"
                role="presentation">
                <button class="nav-link {% if selected_view == 'macchinari' %}active{% endif %}"
                        id="manutenzioni-macchinari-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#manutenzioni-macchinari-pane"
                        data-view-name="macchinari"
                        type="button"
                        role="tab">
                    <i class="bi bi-list-ul"></i>
                    Elenco macchinari
                </button>
            </li>

            {% if can_manage_calendar %}
                <li class="nav-item"
                    role="presentation">
                    <button class="nav-link {% if selected_view == 'chiusure' %}active{% endif %}"
                            id="manutenzioni-chiusure-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#manutenzioni-chiusure-pane"
                            data-view-name="chiusure"
                            type="button"
                            role="tab">
                        <i class="bi bi-calendar-x"></i>
                        Giorni non lavorativi
                    </button>
                </li>
            {% endif %}
        </ul>

        <form method="get"
              action="{{ operator_url_for('main.manutenzioni_home') }}"
              class="card shadow-sm mb-3"
              id="manutenzioni-filter-form">
            {% if tab_session %}
                <input type="hidden"
                       name="tab_session"
                       value="{{ tab_session }}">
            {% endif %}


            <input type="hidden"
                   id="manutenzioni-view-field"
                   name="view"
                   value="{{ selected_view }}">

            <div class="card-body">
                <div class="row g-2 align-items-end">

                    <div class="col-12 col-xl-3">
                        <label for="manutenzioni-search"
                               class="form-label">
                            Ricerca
                        </label>

                        <input type="search"
                               class="form-control"
                               id="manutenzioni-search"
                               name="search"
                               value="{{ search }}"
                               placeholder="Macchinario, piano, manutenzione...">
                    </div>

                    <div class="col-12 col-md-4 col-xl-3">
                        <label for="manutenzioni-reparto"
                               class="form-label">
                            Reparto
                        </label>

                        <select class="form-select"
                                id="manutenzioni-reparto"
                                name="reparto_codice">

                            <option value="">
                                Tutti i reparti visibili
                            </option>

                            {% for reparto in reparti %}
                                <option value="{{ reparto.codice }}"
                                        {% if selected_reparto == reparto.codice %}
                                        selected
                                        {% endif %}>
                                    {{ reparto.codice }}
                                    {% if reparto.descrizione %}
                                        - {{ reparto.descrizione }}
                                    {% endif %}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-12 col-md-4 col-xl-2">
                        <label for="manutenzioni-stato"
                               class="form-label">
                            Stato evento
                        </label>

                        <select class="form-select"
                                id="manutenzioni-stato"
                                name="stato">
                            <option value="">
                                Tutti
                            </option>
                            <option value="SCADUTA"
                                    {% if selected_stato == "SCADUTA" %}selected{% endif %}>
                                Scadute
                            </option>
                            <option value="IN_SCADENZA"
                                    {% if selected_stato == "IN_SCADENZA" %}selected{% endif %}>
                                In scadenza
                            </option>
                            <option value="PROGRAMMATA"
                                    {% if selected_stato == "PROGRAMMATA" %}selected{% endif %}>
                                Programmate
                            </option>
                            <option value="COMPLETATA"
                                    {% if selected_stato == "COMPLETATA" %}selected{% endif %}>
                                Completate
                            </option>
                            <option value="SALTATA"
                                    {% if selected_stato == "SALTATA" %}selected{% endif %}>
                                Saltate
                            </option>
                            <option value="ANNULLATA"
                                    {% if selected_stato == "ANNULLATA" %}selected{% endif %}>
                                Annullate
                            </option>
                        </select>
                    </div>

                    <div class="col-12 col-md-4 col-xl-2">
                        <div class="form-check mb-2">
                            <input type="checkbox"
                                   class="form-check-input"
                                   id="manutenzioni-inattivi"
                                   name="include_inactive"
                                   value="1"
                                    {% if include_inactive %}
                                   checked
                                    {% endif %}>

                            <label class="form-check-label"
                                   for="manutenzioni-inattivi">
                                Inattivi nell'elenco
                            </label>

                            <input type="hidden"
                                   name="include_inactive"
                                   value="0">
                        </div>
                    </div>

                    <div class="col-12 col-xl-2">
                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary flex-grow-1">
                                Filtra
                            </button>

                            <a href="{{ operator_url_for('main.manutenzioni_home') }}"
                               class="btn btn-outline-secondary">
                                Pulisci
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </form>

        <div class="tab-content"
             id="manutenzioni-view-content">

            <div class="tab-pane fade {% if selected_view == 'calendario' %}show active{% endif %}"
                 id="manutenzioni-calendario-pane"
                 role="tabpanel"
                 aria-labelledby="manutenzioni-calendario-tab">

                <div class="card shadow-sm mb-3">
                    <div class="card-header">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="btn-group btn-group-sm"
                                     role="group"
                                     aria-label="Navigazione calendario">
                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            id="calendar-prev-month"
                                            title="Mese precedente">
                                        <i class="bi bi-chevron-left"></i>
                                    </button>

                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            id="calendar-today">
                                        Oggi
                                    </button>

                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            id="calendar-next-month"
                                            title="Mese successivo">
                                        <i class="bi bi-chevron-right"></i>
                                    </button>
                                </div>

                                <h2 class="h5 mb-0 text-capitalize"
                                    id="maintenance-calendar-title">
                                </h2>
                            </div>

                            {% if can_view_all_machines %}
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        id="calendar-only-assigned"
                                        aria-pressed="false">
                                    <i class="bi bi-person-check"></i>
                                    Solo assegnate a me
                                </button>
                            {% endif %}

                            <div class="maintenance-calendar-legend">
                                <span class="maintenance-calendar-legend-item legend-overdue">
                                    Scaduta
                                </span>
                                <span class="maintenance-calendar-legend-item legend-due">
                                    In scadenza
                                </span>
                                <span class="maintenance-calendar-legend-item legend-planned">
                                    Programmata
                                </span>
                                <span class="maintenance-calendar-legend-item legend-completed">
                                    Completata
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-0">
                        <div id="maintenance-calendar-feedback"
                             class="alert alert-danger m-3 d-none"
                             role="alert">
                        </div>

                        <div id="maintenance-calendar-loading"
                             class="d-none p-4 text-center">
                            <div class="spinner-border"
                                 role="status">
                                <span class="visually-hidden">
                                    Caricamento...
                                </span>
                            </div>
                        </div>

                        <div class="maintenance-calendar-shell">
                            <div class="maintenance-calendar">
                                <div class="maintenance-calendar-weekdays">
                                    {% for giorno in ["Lun", "Mar", "Mer", "Gio", "Ven", "Sab", "Dom"] %}
                                        <div class="maintenance-calendar-weekday">
                                            {{ giorno }}
                                        </div>
                                    {% endfor %}
                                </div>

                                <div class="maintenance-calendar-grid"
                                     id="maintenance-calendar-grid">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade {% if selected_view == 'macchinari' %}show active{% endif %}"
                 id="manutenzioni-macchinari-pane"
                 role="tabpanel"
                 aria-labelledby="manutenzioni-macchinari-tab">
                <div class="card shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-semibold">
                Macchinari
            </span>

                        <span class="badge text-bg-secondary">
                {{ macchinari_rows|length }}
            </span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-hover table-sortable align-middle mb-0">
                            <thead>
                            <tr>
                                <th data-sort="text">Codice</th>
                                <th data-sort="text">Descrizione</th>
                                <th data-sort="text">Matricola</th>
                                <th data-sort="text">Reparto</th>
                                <th data-sort="text">Costruttore</th>
                                <th data-sort="text">Modello</th>
                                <th data-sort="text">Ubicazione</th>
                                <th data-sort="text">Stato</th>
                                <th class="text-end">
                                    Azioni
                                </th>
                            </tr>
                            </thead>

                            <tbody>
                            {% for macchinario in macchinari_rows %}
                                <tr>
                                    <td class="fw-semibold">
                                        {{ macchinario.codice }}
                                    </td>

                                    <td>
                                        {{ macchinario.descrizione }}
                                    </td>

                                    <td>
                                        {{ macchinario.matricola or "-" }}
                                    </td>

                                    <td>
                                        {{ macchinario.reparto_codice }}

                                        {% if macchinario.reparto_descrizione %}
                                            <div class="small text-muted">
                                                {{ macchinario.reparto_descrizione }}
                                            </div>
                                        {% endif %}
                                    </td>

                                    <td>
                                        {{ macchinario.costruttore or "-" }}
                                    </td>

                                    <td>
                                        {{ macchinario.modello or "-" }}
                                    </td>

                                    <td>
                                        {{ macchinario.ubicazione or "-" }}
                                    </td>

                                    <td>
                                        {% if macchinario.attivo %}
                                            <span class="badge text-bg-success">
                                        Attivo
                                    </span>
                                        {% else %}
                                            <span class="badge text-bg-secondary">
                                        Inattivo
                                    </span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1">
                                            <a href="{{ operator_url_for(
                                            'main.manutenzioni_macchinario_detail',
                                            macchinario_id=macchinario.id
                                            ) }}"
                                               class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-calendar-check"></i>
                                                Manutenzioni
                                            </a>

                                            {% if can_manage %}
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-primary btn-modifica-macchinario"
                                                        data-macchinario-id="{{ macchinario.id }}">
                                                    <i class="bi bi-pencil"></i>
                                                    Modifica
                                                </button>

                                                <button type="button"
                                                        class="btn btn-sm {% if macchinario.attivo %}btn-outline-danger{% else %}btn-outline-success{% endif %} btn-stato-macchinario"
                                                        data-macchinario-id="{{ macchinario.id }}"
                                                        data-macchinario-attivo="{{ '1' if macchinario.attivo else '0' }}"
                                                        data-macchinario-codice="{{ macchinario.codice }}">
                                                    {% if macchinario.attivo %}
                                                        <i class="bi bi-pause-circle"></i>
                                                        Disattiva
                                                    {% else %}
                                                        <i class="bi bi-play-circle"></i>
                                                        Attiva
                                                    {% endif %}
                                                </button>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="9"
                                        class="text-center text-muted py-4">
                                        Nessun macchinario trovato.
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            {% if can_manage_calendar %}
                <div class="tab-pane fade {% if selected_view == 'chiusure' %}show active{% endif %}"
                     id="manutenzioni-chiusure-pane"
                     role="tabpanel"
                     aria-labelledby="manutenzioni-chiusure-tab">

                    <div class="alert alert-info">
                        Le festività nazionali italiane e il
                        Lunedì dell'Angelo sono calcolati
                        automaticamente. Qui vanno inseriti
                        soltanto patroni locali, ponti e chiusure
                        aziendali.
                    </div>

                    <div class="card shadow-sm">
                        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div>
                                <div class="fw-semibold">
                                    Chiusure personalizzate
                                </div>
                                <div class="small text-muted">
                                    Ogni modifica riallinea le
                                    scadenze future ancora programmate.
                                </div>
                            </div>

                            <button type="button"
                                    class="btn btn-primary"
                                    id="btn-nuovo-giorno-non-lavorativo">
                                <i class="bi bi-plus-lg"></i>
                                Nuovo giorno non lavorativo
                            </button>
                        </div>

                        <div id="giorni-non-lavorativi-feedback"
                             class="alert alert-danger m-3 d-none"
                             role="alert">
                        </div>

                        <div id="giorni-non-lavorativi-loading"
                             class="d-none p-4 text-center">
                            <div class="spinner-border"
                                 role="status">
                                <span class="visually-hidden">
                                    Caricamento...
                                </span>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle mb-0">
                                <thead>
                                <tr>
                                    <th>Data</th>
                                    <th>Descrizione</th>
                                    <th>Tipo</th>
                                    <th>Ricorrenza</th>
                                    <th>Stato</th>
                                    <th class="text-end">
                                        Azioni
                                    </th>
                                </tr>
                                </thead>

                                <tbody id="giorni-non-lavorativi-body">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>


    </main>
    {% if can_manage %}
        <div class="modal fade"
             id="modalMacchinario"
             tabindex="-1"
             aria-labelledby="modalMacchinarioLabel"
             aria-hidden="true">

            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">

                    <form id="form-macchinario"
                          novalidate>

                        <div class="modal-header">
                            <h5 class="modal-title"
                                id="modalMacchinarioLabel">
                                Nuovo macchinario
                            </h5>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Chiudi">
                            </button>
                        </div>

                        <div class="modal-body">
                            <input type="hidden"
                                   id="macchinario-id">

                            <div id="macchinario-feedback"
                                 class="alert d-none"
                                 role="alert">
                            </div>

                            <div id="macchinario-loading"
                                 class="d-none mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="spinner-border spinner-border-sm"
                                         role="status"
                                         aria-hidden="true">
                                    </div>

                                    <span>Caricamento in corso...</span>
                                </div>
                            </div>

                            <div class="row g-3"
                                 id="macchinario-form-fields">

                                <div class="col-12 col-md-4">
                                    <label for="macchinario-codice"
                                           class="form-label">
                                        Codice
                                    </label>

                                    <input type="text"
                                           class="form-control"
                                           id="macchinario-codice"
                                           maxlength="100"
                                           autocomplete="off"
                                           required>

                                    <div class="invalid-feedback">
                                        Inserire il codice del macchinario.
                                    </div>
                                </div>

                                <div class="col-12 col-md-8">
                                    <label for="macchinario-descrizione"
                                           class="form-label">
                                        Descrizione
                                    </label>

