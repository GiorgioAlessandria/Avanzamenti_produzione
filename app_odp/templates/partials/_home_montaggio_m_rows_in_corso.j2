{% for singolo_odp in odp %}
    {% if singolo_odp.IsWorkGroup|default(false) and singolo_odp.GestioneMatricola == 'si' and singolo_odp.StatoOrdine != "Pianificata" and singolo_odp.StatoOrdine != "Chiusa" %}
        {% set group_type_display = singolo_odp.WorkGroupDisplayType|default(singolo_odp.WorkGroupType) %}
        {% set group_type_label = singolo_odp.WorkGroupTypeLabel|default("Multiplo" if singolo_odp.WorkGroupType == "MULTIPLO" else "Mascherato") %}
        {% set group_badge_class = "bg-info text-dark" if group_type_display == "MISTO" else ("bg-primary" if singolo_odp.WorkGroupType == "MULTIPLO" else "bg-dark") %}
        {% set pr = singolo_odp.PrioritaNumero|default('') %}
        <tr class="workgroup-row table-info border-start border-4"
            data-row-key="GROUP|{{ singolo_odp.WorkGroupUid }}"
            data-is-work-group="1"
            data-group-uid="{{ singolo_odp.WorkGroupUid }}"
            data-group-type="{{ group_type_display }}"
            data-group-label="{{ singolo_odp.OrdineVisuale|e }}"
            data-group-detail="{{ singolo_odp.DettaglioGruppoVisuale|tojson|forceescape }}"
            data-statoordine="{{ singolo_odp.WorkGroupStatus }}"
            data-stato="{{ singolo_odp.WorkGroupStatus }}"
            data-priorita="{{ pr or '' }}"
            data-tipodocumento="{{ singolo_odp.CodTipoDoc|default('') }}"
            data-iddocumento="GROUP:{{ singolo_odp.WorkGroupUid }}"
            data-idriga="GROUP"
            data-numprogrriga=""
            data-variante=""
            data-ordine="{{ singolo_odp.OrdineVisuale }}"
            data-codice="{{ singolo_odp.CodiciVisuale }}"
            data-descrizione="{{ singolo_odp.DesArt }}"
            data-matricola="Gruppo"
            data-datacons="{{ singolo_odp.DataFineSched }}"
            data-fase="{{ singolo_odp.FaseAttiva|default('') }}"
            data-operatore="{{ singolo_odp.OperatoreUsername|default('') }}">
            <td class="pr-cell fw-bold text-center">{{ pr or '' }}</td>
            <td class="text-start">
                <button type="button"
                        class="btn btn-sm btn-outline-dark me-1 js-open-workgroup-detail-modal"
                        data-group-uid="{{ singolo_odp.WorkGroupUid }}"
                        data-group-type="{{ group_type_display }}"
                        data-group-label="{{ singolo_odp.OrdineVisuale|e }}"
                        data-group-detail="{{ singolo_odp.DettaglioGruppoVisuale|tojson|forceescape }}"
                        title="Apri dettaglio gruppo">
                    Dettaglio
                </button>
                <span class="badge {{ group_badge_class }} me-1">{{ group_type_label }}</span>
                <strong>{{ singolo_odp.OrdineVisuale }}</strong>
                <div class="small text-muted">{{ singolo_odp.WorkGroupUid }}</div>
            </td>
            <td>{{ singolo_odp.CodiciVisuale }}</td>
            <td class="text-start">
                <strong>{{ singolo_odp.DesArt }}</strong>
                <div class="small text-muted">{{ singolo_odp.WorkGroupMembers|default([])|length }} ordini nel gruppo</div>
            </td>
            <td><span class="text-muted">Gruppo</span></td>
            <td>{{ singolo_odp.DataFineSched | db_date("%Y-%m-%d %H:%M:%S","%d/%m/%Y") }}</td>
            <td>{{ singolo_odp.FaseAttiva|default('') }}</td>
            <td data-col="stato">{{ singolo_odp.WorkGroupStatus }}</td>
            <td><span class="text-muted">-</span></td>
            <td>{{ singolo_odp.OperatoreUsername|default('-') or '-' }}</td>
        </tr>
    {% elif singolo_odp.GestioneMatricola == 'si' and singolo_odp.StatoOrdine != "Pianificata" and singolo_odp.StatoOrdine != "Chiusa" %}
        {% set operatore = singolo_odp.runtime_row.Utente_operazione if singolo_odp.runtime_row else "" %}
        {% set runtime = singolo_odp.runtime_row %}
        {% set pr_visible = runtime and runtime.PrioritaOperatoreIdInCarico|string == current_user.id|string %}
        {% set pr = runtime.PrioritaInCarico if pr_visible else none %}
        {% set pr_class =
                        'table-danger' if pr == 1 else
                        'table-warning' if pr == 2 else'table-success' if pr == 3 else'' %}
        {% set stato_norm = singolo_odp.StatoOrdine|string|lower %}
        {% set stato_class =
                            'table-success' if 'attiv' in stato_norm else
                            'table-warning' if 'sospes' in stato_norm else'' %}
        {% set rev = singolo_odp.IndiceModifica %}
        {% set rev_pdf = rev|string|trim if rev is not none else "" %}
        {% set rev_pdf = "" if rev_pdf == "-" or rev_pdf|upper == "X" else rev_pdf %}
        {% set ordine_display = ordine_ref_display(singolo_odp) %}
        {% set componenti_mancanti = singolo_odp.DistintaMancante|default([], true) %}

        <tr class="{{ stato_class }}"
            data-row-key="{{ singolo_odp.IdDocumento }}|{{ singolo_odp.NumProgrRiga }}"
            data-priorita="{{ pr or '' }}"
            data-tipodocumento="{{ singolo_odp.CodTipoDoc }}"
            data-iddocumento="{{ singolo_odp.IdDocumento }}"
            data-variante="{{ singolo_odp.VarianteArt }}"
            data-numprogrriga="{{ singolo_odp.NumProgrRiga }}"
            data-idriga="{{ singolo_odp.IdRiga }}"
            data-ordine="{{ ordine_display }}"
            data-codice="{{ singolo_odp.CodArt }}"
            data-indicemodifica="{{ singolo_odp.IndiceModifica }}"
            data-descrizione="{{ singolo_odp.DesArt }}"
            data-matricola="{{ singolo_odp.CodMatricola }}"
            data-datacons="{{ singolo_odp.DataFineSched }}"
            data-fase="{{ singolo_odp.FaseAttiva }}"
            data-stato="{{ singolo_odp.StatoOrdine }}"
            data-ha-componenti-mancanti="{{ 1 if componenti_mancanti else 0 }}"
            data-componenti-mancanti="{{ componenti_mancanti|tojson|forceescape }}"
            data-operatore="{{ operatore }}">
            <td class="pr-cell {{ pr_class }} fw-bold text-center">{{ pr or "" }}</td>
            <td>
                <button
                        type="button"
                        class="btn btn-link p-0 text-decoration-none open-materiali-modal"
                        data-codart="{{ singolo_odp.CodArt|e }}"
                        data-variante="{{ singolo_odp.VarianteArt|e }}"
                        data-fase-attiva="{{ singolo_odp.FaseAttiva }}"
                        data-distinta='{{ singolo_odp.DistintaMateriale|tojson }}'>
                    {{ ordine_display }}
                </button>
            </td>
            {% set rev = singolo_odp.IndiceModifica %}
            {% set rev_pdf = rev|string|trim if rev is not none else "" %}
            {% set rev_pdf = "" if rev_pdf == "-" or rev_pdf|upper == "X" else rev_pdf %}
            {% set metodo_prefisso = metodo_documentale_prefisso|default('', true) %}
            {% set metodo_key = metodo_prefisso ~ singolo_odp.CodArt ~ ('.' ~ rev_pdf if rev_pdf else '') %}
            {% set metodo_doc = metodo_lookup.get(metodo_key) if metodo_lookup is defined and metodo_key else none %}

            <td>
                {% if metodo_doc and metodo_doc.found %}
                    <button type="button"
                            class="btn btn-link p-0 text-decoration-none"
                            data-bs-toggle="modal"
                            data-bs-target="#modalMetodoMontaggio"
                            data-codart="{{ singolo_odp.CodArt|e }}"
                            data-pdf-url="{{ metodo_doc.url }}">
                        {{ singolo_odp.CodArt }}
                    </button>
                {% else %}
                    <span class="text-danger">{{ singolo_odp.CodArt }}</span>
                {% endif %}
            </td>
            <td>{{ singolo_odp.DesArt }}</td>
            <td>{{ singolo_odp.CodMatricola }}</td>
            <td>{{ singolo_odp.DataFineSched | db_date("%Y-%m-%d %H:%M:%S","%d/%m/%Y") }}</td>
            <td>{{ singolo_odp.FaseAttiva }}</td>
            <td data-col="stato">{{ singolo_odp.StatoOrdine }}</td>
            <td data-col="componenti-mancanti" data-sort-value="{{ componenti_mancanti|length }}">
                {% if componenti_mancanti %}
                    <span class="badge bg-danger"
                          title="{{ componenti_mancanti|map(attribute='CodArt')|join(', ') }}">
                        {{ componenti_mancanti|length }} mancanti
                    </span>
                {% else %}
                    <span class="text-muted">-</span>
                {% endif %}
            </td>
            <td>{{ operatore or "-" }}</td>
        </tr>
    {% endif %}
{% endfor %}