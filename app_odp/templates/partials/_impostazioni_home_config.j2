{% if show_home_config_section %}
    <section class="card mt-4"
             id="home-config-section">
        <div class="card-header">
            <h3 class="mb-0">Configurazione home reparti</h3>
        </div>

        <div class="card-body">
            <div id="home-config-alert"
                 class="alert d-none"
                 role="alert"></div>

            <h4>Reparti home</h4>

            <div class="table-responsive mb-3">
                <table class="table table-sm table-bordered align-middle"
                       id="tbl-home-config">
                    <thead class="table-light">
                    <tr>
                        <th>Ordine</th>
                        <th>Reparto</th>
                        <th>Label</th>
                        <th>Tab code</th>
                        <th>Template</th>
                        <th>Renderer</th>
                        <th>Attivo</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <form id="form-home-config"
                  class="border rounded p-3 mb-4">
                <input type="hidden"
                       name="id">

                <div class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label">Reparto</label>
                        <select class="form-select"
                                name="reparto_id"
                                required></select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Label menu</label>
                        <input class="form-control"
                               name="label"
                               required>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Tab code</label>
                        <input class="form-control"
                               name="tab_code"
                               required>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Ordine menu</label>
                        <input class="form-control"
                               name="ordine_menu"
                               type="number"
                               value="100">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Template</label>
                        <select class="form-select"
                                name="template"
                                required></select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Renderer</label>
                        <select class="form-select"
                                name="renderer"
                                required></select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Permesso</label>
                        <input class="form-control"
                               name="permesso"
                               value="home">
                    </div>

                    <div class="col-md-3 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="attivo"
                                   checked>
                            <label class="form-check-label">Attivo</label>
                        </div>
                    </div>
                </div>

                <hr>

                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label">Titolo macchine da eseguire</label>
                        <input class="form-control"
                               name="titolo_macchine_da_eseguire">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Titolo macchine attive</label>
                        <input class="form-control"
                               name="titolo_macchine_attive">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Titolo semilavorati da eseguire</label>
                        <input class="form-control"
                               name="titolo_semilavorati_da_eseguire">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Titolo semilavorati attivi</label>
                        <input class="form-control"
                               name="titolo_semilavorati_attivi">
                    </div>
                </div>

                <hr>

                <div class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label">Testo presa macchina</label>
                        <input class="form-control"
                               name="testo_presa_macchina">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Testo sospendi macchina</label>
                        <input class="form-control"
                               name="testo_sospendi_macchina">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Testo riattiva macchina</label>
                        <input class="form-control"
                               name="testo_riattiva_macchina">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Testo chiudi macchina</label>
                        <input class="form-control"
                               name="testo_chiudi_macchina">
                    </div>
                </div>

                <hr>

                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label">Metodo documentale</label>
                        <select class="form-select"
                                name="metodo_documentale_tipo"></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Prefisso metodo</label>
                        <input class="form-control"
                               name="metodo_documentale_prefisso">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Path key metodo</label>
                        <input class="form-control"
                               name="metodo_documentale_path_key">
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">Salva reparto home
                    </button>
                    <button type="button"
                            class="btn btn-outline-secondary"
                            id="btn-home-config-new">Nuovo
                    </button>
                </div>
            </form>

            <hr>

            <h4>Regole visibilità home</h4>

            <div class="table-responsive mb-3">
                <table class="table table-sm table-bordered align-middle"
                       id="tbl-home-rules">
                    <thead class="table-light">
                    <tr>
                        <th>Reparto</th>
                        <th>Scope</th>
                        <th>Applica a</th>
                        <th>Fase</th>
                        <th>Valori</th>
                        <th>Attiva</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <form id="form-home-rule"
                  class="border rounded p-3">
                <input type="hidden"
                       name="id">

                <div class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label">Reparto</label>
                        <select class="form-select"
                                name="reparto_id"
                                required></select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Tipo</label>
                        <select class="form-select"
                                name="scope_type">
                            <option value="role">Ruolo</option>
                            <option value="user">Utente</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Ruolo</label>
                        <select class="form-select"
                                name="role_id"></select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Utente</label>
                        <select class="form-select"
                                name="user_id"></select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Applica a</label>
                        <select class="form-select"
                                name="apply_to"></select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Fase</label>
                        <select class="form-select"
                                name="phase_mode"></select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Numeri fase (codici)</label>
                        <input class="form-control"
                               name="phase_values"
                               placeholder="Esempio: 2 oppure 2,3">
                        <div class="form-text">Le regole usano i numeri originali, non i nomi personali.</div>
                    </div>

                    <div class="col-md-3 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="attivo"
                                   checked>
                            <label class="form-check-label">Attiva</label>
                        </div>
                    </div>
                </div>

                <hr>

                <div class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label">Titolo macchine da eseguire</label>
                        <input class="form-control"
                               name="titolo_macchine_da_eseguire">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Titolo macchine attive</label>
                        <input class="form-control"
                               name="titolo_macchine_attive">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Testo presa macchina</label>
                        <input class="form-control"
                               name="testo_presa_macchina">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Testo chiudi macchina</label>
                        <input class="form-control"
                               name="testo_chiudi_macchina">
                    </div>
                </div>

                <div class="row g-2 mt-1">
                    <div class="col-md-3">
                        <label class="form-label">Metodo documentale</label>
                        <select class="form-select"
                                name="metodo_documentale_tipo">
                            <option value="">Nessun override</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Prefisso metodo</label>
                        <input class="form-control"
                               name="metodo_documentale_prefisso"
                               placeholder="COLLAUDO_">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Path key metodo</label>
                        <input class="form-control"
                               name="metodo_documentale_path_key"
                               placeholder="COLLAUDO_PDF_DIR">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Testo sospendi/riattiva</label>
                        <input class="form-control mb-1"
                               name="testo_sospendi_macchina"
                               placeholder="Sospendi collaudo">
                        <input class="form-control"
                               name="testo_riattiva_macchina"
                               placeholder="Riattiva collaudo">
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">Salva regola
                    </button>
                    <button type="button"
                            class="btn btn-outline-secondary"
                            id="btn-home-rule-new">Nuova
                    </button>
                </div>
            </form>
        </div>
    </section>

    <script>
        window.homeConfigSettingsPayload = {{ home_config_payload|tojson }};
    </script>
{% endif %}