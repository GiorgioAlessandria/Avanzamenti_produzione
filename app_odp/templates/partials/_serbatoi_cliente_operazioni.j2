<details class="border rounded p-3 mb-3" id="serbatoi-cliente-materiali">
 <summary class="fw-semibold">2. Materiali di origine e tracciabilità</summary>
 {% if gestione_cliente.lavorato %}<p class="small text-body-secondary">Materiali di origine consolidati: sezione in sola lettura perché l'ordine è già lavorato.</p>{% endif %}
 {% for produzione in gestione_cliente.produzioni %}
 <div class="border-bottom pb-2 mb-3">
  <h3 class="h6">ODP {{ produzione.riferimento }}</h3>
  {% if produzione.anomalia %}<div class="alert alert-warning">{{ produzione.anomalia }}</div>{% endif %}
  {% include 'partials/_serbatoi_spezzoni_odp.j2' %}
 </div>
 {% endfor %}
 <h3 class="h6">DDT di origine barre e spezzoni</h3>{{ tabella_provenienza_ddt(provenienza_ddt) }}
</details>
{% if gestione_cliente.lavorato %}
<details class="border rounded p-3 mb-3" open id="serbatoi-cliente-ddt">
 <summary class="fw-semibold">3. DDT Gaser e spedizioni cliente</summary>
 <p class="small text-body-secondary">Scegli il lotto e registra il passaggio disponibile. Le quantità parziali restano tracciate sullo stesso ordine cliente.</p>
 {% for riga in gestione_cliente.lotti %}{% set lotto = riga.lotto %}{% set passaggio = riga.passaggio %}
 <article class="border rounded p-3 mb-2" id="serbatoi-lotto-{{ lotto.id }}">
  <h3 class="h6">{{ lotto.riferimento }}</h3>
  <p class="mb-2"><strong>{{ lotto.quantita }} pezzi</strong> · {{ lotto.stato }} / {{ lotto.ubicazione }}</p>
  {% if passaggio and not riga.origine_completa %}<div class="alert alert-warning small">Provenienza incompleta: verifica e assegna i materiali di origine dell'ODP prima di proseguire.</div>{% endif %}
  {% if can_produzione and passaggio %}
  <details id="serbatoi-avanzamento-{{ lotto.id }}"><summary class="fw-semibold">{{ passaggio[1] }} · quantità e DDT</summary>
   <form class="row g-2 mt-1" method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">
    {{ hidden('avanza') }}<input type="hidden" name="lotto_id" value="{{ lotto.id }}"><input type="hidden" name="passaggio" value="{{ passaggio[0] }}">
    {{ field('quantita','Pezzi rientrati' if passaggio[0] == 'rientro' else 'Quantità conforme','number') }}
    {% if passaggio[0] == 'rientro' %}<p class="col-12 small mb-0">I pezzi rientrati saranno disponibili per il controllo qualità. I KO si registrano in quella schermata.</p>
    {% else %}{{ field('scarti','Scarti','number','0','0') }}{% endif %}
    {{ field('ddt',passaggio[2]) }}
    <div class="col-12"><button class="btn btn-primary">{{ passaggio[1] }}</button></div>
   </form>
  </details>
  {% elif riga.controllo and riga.in_controllo %}
   <a class="btn btn-outline-primary btn-sm" href="{{ operator_url_for('main.serbatoi_qualita', id=riga.controllo.id) }}">Apri controllo qualità</a>
  {% elif lotto.stato == 'Spedito' %}<p class="small text-body-secondary mb-0">Spedizione registrata. Consulta i documenti qui sotto.</p>
  {% else %}<p class="small text-body-secondary mb-0">Il prossimo passaggio sarà disponibile al completamento della lavorazione o del controllo qualità.</p>{% endif %}
 </article>
 {% else %}<p class="small text-body-secondary">Nessun lotto disponibile. Collega un ODP o assegna materiale di magazzino.</p>{% endfor %}
 <details class="mt-3"><summary class="fw-semibold">Movimenti e documenti dell'ordine</summary>
  <div class="table-responsive"><table class="table table-sm align-middle">
   <thead><tr><th>Data / operatore</th><th>Operazione</th><th>Quantità</th><th>DDT</th></tr></thead>
   <tbody>{% for m in gestione_cliente.documenti %}<tr><td>{{ m.data[:16]|replace('T',' ') }}<br>{{ m.operatore }}</td><td>{{ m.tipo|replace('_',' ') }}</td><td>{{ m.quantita }}</td><td>{{ m.ddt or '—' }}</td></tr>
   {% else %}<tr><td colspan="4">Nessun movimento registrato.</td></tr>{% endfor %}</tbody>
  </table></div>
 </details>
</details>
{% endif %}

