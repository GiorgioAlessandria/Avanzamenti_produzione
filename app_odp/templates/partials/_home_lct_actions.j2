{% autoescape true %}
<td>
    <div class="lct-actions">
        {% if not lct_preview|default(false) %}
            {% set fase = singolo_odp.FaseAttiva|int %}
            {% set state = singolo_odp.StatoOrdine %}
            {% set owner = singolo_odp.runtime_row.Utente_operazione if singolo_odp.runtime_row else '' %}
            {% set mine = not owner or owner == policy.user.username %}
            {% if state == 'Pianificata' %}
                {% set actions = [(1, 'Prendi in carico fresa' if fase == 1 else 'Prendi in carico buratto', 'primary')] %}
            {% elif state == 'Attivo' and mine %}
                {% set actions = [(2, 'Sospendi', 'outline-warning'), (4, 'Termine fresa' if fase == 1 else 'Termine ordine', 'primary')] %}
            {% elif state == 'In Sospeso' %}
                {% set actions = [(3, 'Riprendi', 'outline-success')] %}
            {% else %}
                {% set actions = [] %}
                <span class="text-muted small">In uso da {{ owner }}</span>
            {% endif %}
            {% for toast, label, color in actions %}
                <button type="button" class="btn btn-sm btn-{{ color }}"
                        {% if fase == 1 and toast in [1, 3] and lct_fresa_busy|default(false) %}
                            disabled title="Sospendi o termina la fresatura attiva prima di avviarne un'altra"
                        {% endif %}
                        aria-label="{{ label }} · {{ ordine_display }}"
                        data-use-selected="#lct_{{ lct_key }}" data-fill-target="#toast-{{ toast }}"
                        data-bs-target="#toast-{{ toast }}" data-bs-toggle="toast">{{ label }}</button>
            {% endfor %}
        {% endif %}
    </div>
</td>
{% endautoescape %}
