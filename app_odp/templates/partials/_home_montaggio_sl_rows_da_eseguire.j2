{% for singolo_odp in odp %}
    {% if singolo_odp.GestioneMatricola == "no" and singolo_odp.StatoOrdine == "Pianificata" %}
        {% set pr = singolo_odp.PrioritaNumero if singolo_odp.PrioritaNumero is defined else none %}
        {% set pr_class =
                        'table-danger' if pr == 1 else
                        'table-warning' if pr == 2 else
                        'table-success' if pr == 3 else
                '' %}
        {% set rev = singolo_odp.IndiceModifica %}
        {% set rev_norm = '' if rev is none or (rev|string|trim|upper) in ['X', '-', 'NONE', 'NULL'] else (rev|string|trim) %}
        {% set distinta_raw = singolo_odp.DistintaMateriale|string|trim if singolo_odp.DistintaMateriale is not none else "" %}
        {% set distinta_missing = not distinta_raw or distinta_raw|lower in ['[]', 'null', 'none', '""'] %}
        {% set ordine_display = ordine_ref_display(singolo_odp) %}
        <tr data-row-key="{{ singolo_odp.IdDocumento }}|{{ singolo_odp.NumProgrRiga }}"
            class="{{ pr_class if pr_class else ('table-danger' if distinta_missing else '') }}"
            data-tipodocumento="{{ singolo_odp.CodTipoDoc }}"
            data-iddocumento="{{ singolo_odp.IdDocumento }}"
            data-variante="{{ singolo_odp.VarianteArt }}"
            data-numprogrriga="{{ singolo_odp.NumProgrRiga }}"
            data-idriga="{{ singolo_odp.IdRiga }}"
            data-ordine="{{ ordine_display }}"
            data-codice="{{ singolo_odp.CodArt }}"
            data-indicemodifica="{{ rev_norm }}"
            data-descrizione="{{ singolo_odp.DesArt }}"
            data-quantita="{{ singolo_odp.QtyDaLavorare or singolo_odp.Quantita }}"
            data-quantita-totale="{{ singolo_odp.Quantita }}"
            data-fase="{{ singolo_odp.FaseAttiva }}"
            data-datacons="{{ singolo_odp.DataFineSched }}"
            data-risorsaprod="{{ singolo_odp.RisorsaAttiva }}"
            data-distinta='{{ singolo_odp.DistintaMateriale|tojson }}'
            data-distinta-missing="{{ '1' if distinta_missing else '0' }}">
            <td>{{ pr or '' }}</td>
            <td>
                {% if distinta_missing %}
                    <span class="text-danger fw-bold">
                        {{ ordine_display }}
                    </span>
                    <i class="bi bi-exclamation-triangle-fill text-danger ms-1"
                       title="Distinta materiale assente"></i>
                {% else %}
                    {{ ordine_display }}
                {% endif %}
            </td>
            <td>{{ singolo_odp.CodArt }}</td>
            <td>{{ singolo_odp.VarianteArt }}</td>
            <td>{{ "-" if not rev_norm else rev_norm }}</td>
            <td>{{ singolo_odp.DesArt }}</td>
            <td>{{ singolo_odp.QtyDaLavorare or singolo_odp.Quantita }}</td>
            <td>{{ singolo_odp.DataFineSched | db_date("%Y-%m-%d %H:%M:%S","%d/%m/%Y") }}</td>
            <td>{{ singolo_odp.RisorsaAttiva }}</td>
        </tr>
    {% endif %}
{% endfor %}