{% macro torna_produzione() %}
    <div class="row d-flex w-100 h-100 justify-content-start align-items-center ms-0 me-0 mb-0"
         style="width: auto;height: auto;font-size: 25px;">
        <div class="col-md-12 text-start d-flex justify-content-start align-items-center ps-0 pe-0"
             style="width: auto;height: auto;font-size: 25px;">
            <svg xmlns="http://www.w3.org/2000/svg"
                 width="1em"
                 height="1em"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 style="font-size: 25px;">
                <path d="M15 18l-6-6l6-6"></path>
            </svg>
            <a href="{{ operator_url_for('main.home') }}"
               style="color: rgb(0,0,0);font-size: 25px;">
                <span style="color: rgb(33, 37, 41);">
                    Torna alla produzione
                </span>
            </a>
        </div>
    </div>
{% endmacro %}

<div class="offcanvas offcanvas-start h-100"
     tabindex="-1"
     id="offcanvas-2">
    <div class="offcanvas-header ps-4">
        <h5 class="offcanvas-title"
            style="font-size: 30px;">Schede utente</h5>
        <button class="btn-close"
                type="button"
                aria-label="Close"
                data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body d-flex flex-row justify-content-start align-items-start ps-4">
        <section class="d-flex justify-content-end align-items-end"></section>
        <div class="container ms-2 ps-3 me-0"
             style="width: auto;height: auto;">
            {% set nav_policy = operator_policy if operator_policy else policy %}
            {% set nav_user = operator_user if operator_user else current_user %}
            {% set can_return_produzione = nav_policy and nav_policy.can('home') %}
            {% set is_impostazioni = request.endpoint == 'main.impostazioni' %}
            {% set is_dash_reparto = request.endpoint == 'main.dash_reparto' %}
            {% set is_home_acquisti = request.endpoint == 'main.home_acquisti' %}
            {% set is_priorita_view = request.endpoint == 'main.priorita_view' %}
            {% set is_manutenzioni = (
                request.endpoint
                and (
                    request.endpoint == 'main.manutenzioni_home'
                    or request.endpoint == 'main.manutenzioni_macchinario_detail'
                    or request.endpoint == 'main.manutenzioni_scadenziario'
                )
            ) %}
            {% set is_priorita_edit = request.endpoint == 'main.priorita_edit' %}
            {% set is_tarature = request.endpoint == 'main.tarature_home' %}
            {% set is_priorita = is_priorita_view or is_priorita_edit %}
            {% set is_storico_ordini = request.endpoint == 'main.storico_ordini_page' %}
            {% set is_logistica = request.endpoint == 'main.logistica_page' %}
            {% set is_rifiuti = request.endpoint in [
                'main.rifiuti_page',
                'main.rifiuti_codici_cer'
            ] %}


            {% if nav_policy and nav_policy.can('priorita_view') and (not is_priorita or can_return_produzione) %}
                <div class="row d-flex w-100 h-100 justify-content-start align-items-center ms-0 me-0 mb-0"
                     style="width: auto;height: auto;font-size: 25px;">
                    <div class="col-md-12 text-start d-flex justify-content-start align-items-center ps-0 pe-0"
                         style="width: auto;height: auto;font-size: 25px;">
                        {% if is_priorita %}
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="1em"
                                 height="1em"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 style="font-size: 25px;">
                                <path d="M15 18l-6-6l6-6"></path>
                            </svg>
                            <a href="{{ operator_url_for('main.home') }}"
                               style="color: rgb(0,0,0);font-size: 25px;">
                                <span style="color: rgb(33, 37, 41);">Torna alla produzione</span>
                            </a>
                        {% else %}
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="1em"
                                 height="1em"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 style="font-size: 25px;">
                                <path d="M4 6h16"></path>
                                <path d="M4 12h10"></path>
                                <path d="M4 18h7"></path>
                                <path d="M18 14v6"></path>
                                <path d="M15 17h6"></path>
                            </svg>

                            {% if nav_policy.can('priorita_edit') %}
                                <a href="{{ operator_url_for('main.priorita_edit') }}"
                                   style="color: rgb(0,0,0);font-size: 25px;">
                                    <span style="color: rgb(33, 37, 41);">Modifica priorità</span>
                                </a>
                            {% else %}
                                <a href="{{ operator_url_for('main.priorita_view') }}"
                                   style="color: rgb(0,0,0);font-size: 25px;">
                                    <span style="color: rgb(33, 37, 41);">Visualizza priorità</span>
                                </a>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            {% if nav_policy and nav_policy.can('home_acquisti') %}
                {% if is_home_acquisti %}
                    {{ torna_produzione() }}
                {% else %}
                    <div class="row d-flex w-100 h-100 justify-content-start align-items-center ms-0 me-0 mb-0"
                         style="width: auto;height: auto;font-size: 25px;">
                        <div class="col-md-12 text-start d-flex justify-content-start align-items-center ps-0 pe-0"
                             style="width: auto;height: auto;font-size: 25px;">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="1em"
                                 height="1em"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 style="font-size: 25px;">
                                <path d="M3 7h18"></path>
                                <path d="M6 11h12"></path>
                                <path d="M10 15h4"></path>
                                <path d="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"></path>
                            </svg>
                            <a href="{{ operator_url_for('main.home_acquisti') }}"
                               style="color: rgb(0,0,0);font-size: 25px;">
                                <span style="color: rgb(33, 37, 41);">Acquisti</span>
                            </a>
                        </div>
                    </div>
                {% endif %}
            {% endif %}
            {% if nav_policy and (
                nav_policy.can('manutenzioni_visualizza')
                or nav_policy.can('manutenzioni_amministrazione')
            ) %}
                {% if is_manutenzioni %}
                    {{ torna_produzione() }}
                {% else %}
                    <div class="row d-flex w-100 h-100 justify-content-start align-items-center ms-0 me-0 mb-0"
                         style="width: auto;height: auto;font-size: 25px;">

                        <div class="col-md-12 text-start d-flex justify-content-start align-items-center ps-0 pe-0"
                             style="width: auto;height: auto;font-size: 25px;">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="1em"
                                 height="1em"
                                 fill="currentColor"
                                 viewBox="0 0 16 16"
                                 class="bi bi-tools"
                                 style="font-size: 25px;">

                                <path d="M1 0 0 1l2.2 3.081a1 1 0 0 0 .815.419h.07a1 1 0 0 1 .708.293l2.675 2.675-2.617 2.617a3 3 0 0 0-1.64 5.19l.177.177a3 3 0 0 0 5.19-1.64l2.617-2.617 2.675 2.675a1 1 0 0 1 .293.708v.07a1 1 0 0 0 .419.815L15 16l1-1-2.2-3.081a1 1 0 0 0-.815-.419h-.07a1 1 0 0 1-.708-.293L9.532 8.532l.733-.733a3.5 3.5 0 0 0 4.89-4.89l-2.148 2.148-1.414-1.414 2.148-2.148a3.5 3.5 0 0 0-4.89 4.89l-.733.733L5.443 4.443a1 1 0 0 1-.293-.708v-.07a1 1 0 0 0-.419-.815L1 0zM5.057 11.057a2 2 0 1 1 2.828 2.828 2 2 0 0 1-2.828-2.828z">
                                </path>
                            </svg>

                            <a href="{{ operator_url_for(
                        'main.manutenzioni_home'
                    ) }}"
                               style="color: rgb(0,0,0);font-size: 25px;">

                    <span style="color: rgb(33, 37, 41);">
                        Manutenzioni
                    </span>
                            </a>
                        </div>
                    </div>
                {% endif %}
            {% endif %}
            {% if nav_policy and nav_policy.can('tarature') %}
                {% if is_tarature %}
                    {{ torna_produzione() }}
                {% else %}
                    <div class="row d-flex w-100 h-100 justify-content-start align-items-center ms-0 me-0 mb-0"
                         style="width: auto;height: auto;font-size: 25px;">
                        <div class="col-md-12 text-start d-flex justify-content-start align-items-center ps-0 pe-0 gap-2"
                             style="width: auto;height: auto;font-size: 25px;">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="1em" height="1em" fill="currentColor"
                                 viewBox="0 0 16 16" class="bi bi-speedometer"
                                 style="font-size: 25px;" aria-hidden="true">
                                <path d="M8 2a.5.5 0 0 1 .5.5V4a.5.5 0 0 1-1 0V2.5A.5.5 0 0 1 8 2M3.732 3.732a.5.5 0 0 1 .707 0l.915.914a.5.5 0 1 1-.708.708l-.914-.915a.5.5 0 0 1 0-.707zM2 8a.5.5 0 0 1 .5-.5h1.586a.5.5 0 0 1 0 1H2.5A.5.5 0 0 1 2 8m9.5 0a.5.5 0 0 1 .5-.5h1.5a.5.5 0 0 1 0 1H12a.5.5 0 0 1-.5-.5m.754-4.246a.389.389 0 0 0-.527-.02L7.547 7.31A.91.91 0 1 0 8.85 8.569l3.434-4.297a.389.389 0 0 0-.029-.518z"></path>
                                <path fill-rule="evenodd" d="M6.664 15.889A8 8 0 1 1 9.336.11a8 8 0 0 1-2.672 15.78zm-4.665-4.283A11.945 11.945 0 0 1 8 10c2.186 0 4.236.585 6.001 1.606a7 7 0 1 0-12.002 0z"></path>
                            </svg>
                            <a href="{{ operator_url_for('main.tarature_home') }}"
                               style="color: rgb(0,0,0);font-size: 25px;">
                                <span style="color: rgb(33, 37, 41);">Tarature</span>
                            </a>
                            {% if tarature_alerts and tarature_alerts.totale %}
                                <span class="badge {{ 'bg-danger' if tarature_alerts.scadute else 'bg-warning text-dark' }}"
                                      title="Scadute o in scadenza entro 60 giorni">
                                    {{ tarature_alerts.totale }}
                                </span>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            {% endif %}
            {% if nav_policy and (
                nav_policy.can('carica')
                or nav_policy.can('ricezione')
            ) %}
                {% if is_logistica and can_return_produzione %}
                    {{ torna_produzione() }}
                {% elif not is_logistica %}
                    <div class="row d-flex w-100 h-100 justify-content-start align-items-center ms-0 me-0 mb-0"
                         style="width: auto;height: auto;font-size: 25px;">
                        <div class="col-md-12 text-start d-flex justify-content-start align-items-center ps-0 pe-0 gap-2"
                             style="width: auto;height: auto;font-size: 25px;">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="1em"
                                 height="1em"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M3 6h11v10H3z"></path>
                                <path d="M14 9h4l3 3v4h-7z"></path>
                                <circle cx="7" cy="18" r="2"></circle>
                                <circle cx="18" cy="18" r="2"></circle>
                            </svg>
                            <a href="{{ operator_url_for('main.logistica_page') }}"
                               style="color: rgb(0,0,0);font-size: 25px;">
                                <span style="color: rgb(33, 37, 41);">
                                    Carichi e scarichi
                                </span>
                            </a>
                        </div>
                    </div>
                {% endif %}
            {% endif %}
            {% if nav_policy and (
                nav_policy.can('rifiuti_carica')
                or nav_policy.can('rifiuti_elimina')
            ) %}
                {% if is_rifiuti %}
                    {{ torna_produzione() }}
                {% else %}
                    <div class="row d-flex w-100 h-100 justify-content-start align-items-center ms-0 me-0 mb-0"
                         style="width: auto;height: auto;font-size: 25px;">
                        <div class="col-md-12 text-start d-flex justify-content-start align-items-center ps-0 pe-0"
                             style="width: auto;height: auto;font-size: 25px;">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="1em"
                                 height="1em"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 style="font-size: 25px;"
                                 aria-hidden="true">
                                <path d="M3 6h18"></path>
                                <path d="M8 6V4h8v2"></path>
                                <path d="M19 6l-1 14H6L5 6"></path>
                                <path d="M10 11v5"></path>
                                <path d="M14 11v5"></path>
                            </svg>
                            <a href="{{ operator_url_for('main.rifiuti_page') }}"
                               style="color: rgb(0,0,0);font-size: 25px;">
                                <span style="color: rgb(33, 37, 41);">
                                    Smaltimento rifiuti
                                </span>
                            </a>
                        </div>
                    </div>
                {% endif %}
            {% endif %}
            {% if nav_policy and nav_policy.can('controllo_qualita') %}
                <div class="row d-flex w-100 h-100 justify-content-start align-items-center ms-0 me-0 mb-0"
                     style="font-size: 25px;">
                    <div class="col-md-12 text-start d-flex justify-content-start align-items-center ps-0 pe-0"
                         style="width: auto;height: auto;font-size: 25px;">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="1em"
                             height="1em"
                             viewBox="0 0 24 24"
                             stroke-width="2"
                             stroke="currentColor"
                             fill="none"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="icon icon-tabler icon-tabler-clipboard-list d-flex justify-content-center align-items-center"
                             style="font-size: 25px;">
                            <path stroke="none"
                                  d="M0 0h24v24H0z"
                                  fill="none"></path>
                            <path d="M9 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-12a2 2 0 0 0 -2 -2h-2">
                            </path>
                            <path d="M9 3m0 2a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v0a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2z">
                            </path>
                            <path d="M9 12l.01 0"></path>
                            <path d="M13 12l2 0"></path>
                            <path d="M9 16l.01 0"></path>
                            <path d="M13 16l2 0"></path>
                        </svg>
                        <a href="controllo_qualità.j2"
                           style="color: rgb(0,0,0);font-size: 25px;"><span
                                style="color: rgb(33, 37, 41);">Controllo qualità</span></a></div>
                </div>
            {% endif %}
            {% if nav_policy and (nav_policy.can('impostazioni_utente') or nav_policy.can('impostazioni_reparto')) %}
                {% if is_impostazioni %}
                    <div class="row d-flex w-100 h-100 justify-content-start align-items-center ms-0 me-0 mb-0"
                         style="width: auto;height: auto;font-size: 25px;">
                        <div class="col-md-12 text-start d-flex justify-content-start align-items-center ps-0 pe-0"
                             style="width: auto;height: auto;font-size: 25px;">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="1em"
                                 height="1em"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 style="font-size: 25px;">
                                <path d="M15 18l-6-6l6-6"></path>
                            </svg>
                            <a href="{{ operator_url_for('main.home') }}"
                               style="color: rgb(0,0,0);font-size: 25px;">
                                <span style="color: rgb(33, 37, 41);">Torna alla produzione</span>
                            </a>
                        </div>
                    </div>
                {% else %}
                    <div class="row d-flex w-100 h-100 justify-content-start align-items-center ms-0 me-0 mb-0"
                         style="width: auto;height: auto;font-size: 25px;">
                        <div class="col-md-12 text-start d-flex justify-content-start align-items-center ps-0 pe-0"
                             style="width: auto;height: auto;font-size: 25px;">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="1em"
                                 height="1em"
                                 fill="currentColor"
                                 viewBox="0 0 16 16"
                                 class="bi bi-gear"
                                 style="font-size: 25px;">
                                <path d="M8 4.754a3.246 3.246 0 1 0 0 6.492 3.246 3.246 0 0 0 0-6.492zM5.754 8a2.246 2.246 0 1 1 4.492 0 2.246 2.246 0 0 1-4.492 0z"></path>
                                <path d="M9.796 1.343c-.527-1.79-3.065-1.79-3.592 0l-.094.319a.873.873 0 0 1-1.255.52l-.292-.16c-1.64-.892-3.433.902-2.54 2.541l.159.292a.873.873 0 0 1-.52 1.255l-.319.094c-1.79.527-1.79 3.065 0 3.592l.319.094a.873.873 0 0 1 .52 1.255l-.16.292c-.892 1.64.901 3.434 2.541 2.54l.292-.159a.873.873 0 0 1 1.255.52l.094.319c.527 1.79 3.065 1.79 3.592 0l.094-.319a.873.873 0 0 1 1.255-.52l.292.16c1.64.893 3.434-.902 2.54-2.541l-.159-.292a.873.873 0 0 1 .52-1.255l.319-.094c1.79-.527 1.79-3.065 0-3.592l-.319-.094a.873.873 0 0 1-.52-1.255l.16-.292c.893-1.64-.902-3.433-2.541-2.54l-.292.159a.873.873 0 0 1-1.255-.52l-.094-.319zm-2.633.283c.246-.835 1.428-.835 1.674 0l.094.319a1.873 1.873 0 0 0 2.693 1.115l.291-.16c.764-.415 1.6.42 1.184 1.185l-.159.292a1.873 1.873 0 0 0 1.116 2.692l.318.094c.835.246.835 1.428 0 1.674l-.319.094a1.873 1.873 0 0 0-1.115 2.693l.16.291c.415.764-.42 1.6-1.185 1.184l-.291-.159a1.873 1.873 0 0 0-2.693 1.116l-.094.318c-.246.835-1.428.835-1.674 0l-.094-.319a1.873 1.873 0 0 0-2.692-1.115l-.292.16c-.764.415-1.6-.42-1.184-1.185l.159-.291A1.873 1.873 0 0 0 1.945 8.93l-.319-.094c-.835-.246-.835-1.428 0-1.674l.319-.094A1.873 1.873 0 0 0 3.06 4.377l-.16-.292c-.415-.764.42-1.6 1.185-1.184l.292.159a1.873 1.873 0 0 0 2.692-1.115l.094-.319z"></path>
                            </svg>
                            <a href="{{ operator_url_for('main.impostazioni') }}"
                               style="color: rgb(0,0,0);font-size: 25px;">
                                <span style="color: rgb(33, 37, 41);">Impostazioni</span>
                            </a>
                        </div>
                    </div>
                {% endif %}
            {% endif %}

            {% if nav_policy and nav_policy.can('priorita') %}
                <div class="row d-flex w-100 h-100 justify-content-start align-items-center ms-0 me-0 mb-0"
                     style="width: auto;height: auto;font-size: 25px;">
                    <div class="col-md-12 text-start d-flex justify-content-start align-items-center ps-0 pe-0"
                         style="width: auto;height: auto;font-size: 25px;">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="1em"
                             height="1em"
                             viewBox="0 0 24 24"
                             fill="none"
                             style="font-size: 25px;">
                            <path
                                    d="M16.2427 5.24264L14.8285 6.65685L13 4.82839L13.0001 9.24268H17.0001V11.2427H7.00012V9.24268H11.0001L11 4.82846L9.17161 6.65685L7.75739 5.24264L12 1L16.2427 5.24264Z"
                                    fill="currentColor"></path>
                            <path
                                    d="M7 15.2527V13.2527H17V15.2527H13.0001L13 19.6669L14.8284 17.8385L16.2426 19.2527L12 23.4954L7.75732 19.2527L9.17154 17.8385L11 19.667V15.2527L7 15.2527Z"
                                    fill="currentColor"></path>
                        </svg>
                        <a href="priorità.j2"
                           style="color: rgb(0,0,0);font-size: 25px;">Imposta priorità</a>
                    </div>
                </div>
            {% endif %}

            {% if nav_policy and nav_policy.can('dash_reparto') %}
                {% if is_dash_reparto %}
                    <div class="row d-flex w-100 h-100 justify-content-start align-items-center ms-0 me-0 mb-0"
                         style="width: auto;height: auto;font-size: 25px;">
                        <div class="col-md-12 text-start d-flex justify-content-start align-items-center ps-0 pe-0"
                             style="width: auto;height: auto;font-size: 25px;">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="1em"
                                 height="1em"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 style="font-size: 25px;">
                                <path d="M15 18l-6-6l6-6"></path>
                            </svg>
                            <a href="{{ operator_url_for('main.home') }}"
                               style="color: rgb(0,0,0);font-size: 25px;">
                                <span style="color: rgb(33, 37, 41);">Torna alla produzione</span>
                            </a>
                        </div>
                    </div>
                {% else %}
                    <div class="row d-flex w-100 h-100 justify-content-start align-items-center ms-0 me-0 mb-0"
                         style="width: auto;height: auto;font-size: 25px;">
                        <div class="col-md-12 text-start d-flex justify-content-start align-items-center ps-0 pe-0"
                             style="width: auto;height: auto;font-size: 25px;">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="1em"
                                 height="1em"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 style="font-size: 25px;">
                                <!-- persona davanti -->
                                <circle cx="12"
                                        cy="10"
                                        r="3"></circle>
                                <path d="M7 20a5 5 0 0 1 11 0"></path>

                                <!-- persona dietro a sinistra -->
                                <circle cx="6.5"
                                        cy="8.5"
