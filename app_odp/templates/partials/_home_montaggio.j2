<!-- IIFE: Lotti + Chiusura MACCHINA (toast_7)                     -->
<!-- ============================================================ -->
<script id="toast_7">
    (() => {
        let _lottiData = [];
        let _hasRequiredLotti = false;
        let _hasSelectableLotti = false;
        let _rowCounter = 0;

        const toastEl = document.getElementById("toast-7");
        const section = document.getElementById("lotti-section-m");
        const loading = document.getElementById("lotti-loading-m");
        const alertEl = document.getElementById("lotti-alert-m");
        const tbody = document.getElementById("tbody-lotti-m");
        const riepilogo = document.getElementById("lotti-riepilogo-m");
        const inpDataRegistrazione = document.getElementById("toast-chiudi-m-data-registrazione");
        const chkIncludeTimeLine = document.getElementById("toast-chiudi-m-include-time-line");
        if (!toastEl || !section || !tbody) return;

        function escHtml(s) {
            return String(s)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function todayIsoLocal() {
            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            return now.toISOString().slice(0, 10);
        }

        function resetRegistrationDateInput() {
            if (chkIncludeTimeLine) chkIncludeTimeLine.checked = true;
            if (!inpDataRegistrazione) return;
            const today = todayIsoLocal();
            inpDataRegistrazione.max = today;
            inpDataRegistrazione.value = today;
        }

        function showAlert(msg) {
            if (!alertEl) return;
            alertEl.textContent = msg;
            alertEl.style.display = msg ? "" : "none";
        }

        function parseQty(v) {
            let s = String(v ?? "").trim().replace(/\s+/g, "");
            if (!s) return 0;
            if (s.includes(",") && s.includes(".")) s = s.replace(/\./g, "");
            s = s.replace(",", ".");
            const n = Number(s);
            return Number.isFinite(n) ? n : 0;
        }

        function sameQty(a, b) {
            return Math.abs(Number(a || 0) - Number(b || 0)) < 0.000001;

        }


        function buildLottoSelect(lotti, selectedLotto = "") {
            let html = '<select class="form-select form-select-sm lotto-select-m">';
            html += '<option value="">-- Seleziona lotto --</option>';
            for (const l of (lotti || [])) {
                const value = String(l.RifLottoAlfa || "");
                const giacenza = parseQty(l.Giacenza);
                const codMag = String(l.CodMag || "");
                const sel = value === selectedLotto ? " selected" : "";
                html += `
                    <option value="${escHtml(value)}"
                            data-giacenza="${giacenza}"
                            data-codmag="${escHtml(codMag)}"${sel}>
                        ${escHtml(codMag ? `${value} (${codMag})` : value)}
                    </option>`;
            }
            html += "</select>";
            return html;
        }

        function componenteRichiedeLotto(comp) {
            const flag = String(
                comp?.GestioneLotto
                ?? comp?.gestione_lotto
                ?? comp?.gestioneLotto
                ?? ""
            ).trim().toLowerCase();

            if (flag) return flag === "si";
            return Array.isArray(comp?.lotti) && comp.lotti.length > 0;
        }

        function addLottoRow(codArt, desArt, lotti, isInitial) {
            _rowCounter++;
            const tr = document.createElement("tr");
            tr.id = `lotto-m-row-${_rowCounter}`;
            tr.dataset.codart = codArt;
            tr.innerHTML = `
                <td class="fw-semibold" style="font-size:20px;">${escHtml(codArt)}</td>
                <td style="font-size:20px;">${escHtml(desArt || "")}</td>
                <td>${buildLottoSelect(lotti)}</td>
                <td class="text-end giacenza-cell-m" style="font-size:20px;">-</td>
                <td>
                    <input type="number"
                           class="form-control form-control-sm lotto-qty-m text-end"
                           min="0"
                           step="0.0001"
                           value=""
                           placeholder="0"
                           style="width:90px;">
                </td>
                <td class="text-center">
                    <button type="button"
                            class="btn btn-sm btn-outline-primary btn-add-lotto-m me-1"
                            title="Aggiungi riga"
                            data-codart="${escHtml(codArt)}"
                            data-desart="${escHtml(desArt || "")}">
                        +
                    </button>
                    ${isInitial ? "" : '<button type="button" class="btn btn-sm btn-outline-danger btn-rem-lotto-m" title="Rimuovi">−</button>'}
                </td>`;
            tbody.appendChild(tr);
            return tr;
        }

        function updateRiepilogo() {
            if (!riepilogo) return;

            const totals = {};
            tbody.querySelectorAll("tr").forEach(row => {
                const cod = row.dataset.codart || "";
                const comp = _lottiData.find(c => String(c.CodArt || "") === cod) || {};
                const qty = parseQtyForCompOrZero(row.querySelector(".lotto-qty-m")?.value, comp);

                if (!totals[cod]) totals[cod] = 0;
                totals[cod] += qty;
            });

            let html = "<strong>Riepilogo per componente:</strong><br>";
            for (const comp of _lottiData) {
                const codArt = String(comp.CodArt || "");
                const richiesto = formatQtyForComp(parseSystemQty(comp.Quantita), comp);
                const totale = totals[codArt] || 0;
                const ok = sameQty(totale, richiesto);

                html += `
            <span class="${ok ? "text-success" : "text-danger"}">
                ${escHtml(codArt)}: ${totale}/${richiesto}${ok ? " ✓" : " ✗"}
            </span><br>`;
            }

            riepilogo.innerHTML = html;
        }

        async function fetchLottiData(idDocumento, idRiga, numProgrRiga) {
            section.style.display = "none";
            loading.style.display = "";
            tbody.innerHTML = "";
            showAlert("");
            riepilogo.innerHTML = "";
            _lottiData = [];
            _hasRequiredLotti = false;
            _hasSelectableLotti = false;

            try {
                const resp = await window.avpFetch("/api/ordini/lotti-componenti", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    credentials: "same-origin",
                    body: JSON.stringify({
                        id_documento: idDocumento,
                        id_riga: idRiga,
                        modalita: "m",
                        num_progr_riga: numProgrRiga
                    })
                });

                const data = await resp.json();

                if (!resp.ok || !data.ok) {
                    showAlert(data.error || "Errore nel caricamento dei lotti.");
                    return;
                }

                const rawComponenti = Array.isArray(data.componenti) ? data.componenti : [];
                const forceShow = !!data.force_show_section;

                _lottiData = rawComponenti.filter(comp => componenteRichiedeLotto(comp));

                const componentiConLotti = _lottiData.filter(
                    comp => Array.isArray(comp.lotti) && comp.lotti.length > 0
                );
                const componentiSenzaLotti = _lottiData.filter(
                    comp => !Array.isArray(comp.lotti) || comp.lotti.length === 0
                );

                _hasRequiredLotti = _lottiData.length > 0;
                _hasSelectableLotti = componentiConLotti.length > 0;

                if (!_hasRequiredLotti && !forceShow) {
                    section.style.display = "none";
                    return;
                }

                section.style.display = "";

                for (const comp of componentiConLotti) {
                    addLottoRow(comp.CodArt, comp.DesArt, comp.lotti, true);
                }

                if (componentiSenzaLotti.length > 0) {
                    const elenco = componentiSenzaLotti
                        .map(comp => `- ${comp.CodArt}${comp.DesArt ? ` (${comp.DesArt})` : ""}`)
                        .join("\n");

                    showAlert(
                        `Nessun lotto disponibile per i seguenti componenti obbligatori della fase attiva:\n${elenco}`
                    );
                } else {
                    showAlert("");
                }

                updateRiepilogo();
            } catch (err) {
                console.error("Errore fetch lotti macchina:", err);
                showAlert("Errore di comunicazione.");
            } finally {
                loading.style.display = "none";
            }
        }

        function validateLotti() {
            if (!_hasRequiredLotti) return {valid: true, lottiPayload: []};

            const errors = [];
            const perCodice = {};
            const lottiPayload = [];
            const usati = new Set();

            tbody.querySelectorAll("tr").forEach(row => {
                const cod = row.dataset.codart || "";
                const lottoVal = row.querySelector(".lotto-select-m")?.value || "";
                const giacenza = parseQty(row.querySelector(".giacenza-cell-m")?.textContent);
                const comp = _lottiData.find(c => String(c.CodArt || "") === cod) || {};
                const qty = parseQtyForComp(row.querySelector(".lotto-qty-m")?.value, comp);

                if (qty > 0 && !lottoVal) {
                    errors.push(`${cod}: selezionare un lotto.`);
                    return;
                }

                if (!lottoVal) return;


                if (qty > giacenza) {
                    errors.push(`${cod} lotto ${lottoVal}: qtà ${qty} > giacenza ${giacenza}.`);
                }
                const lottoSelect = row.querySelector(".lotto-select-m");
                const selectedOption = lottoSelect?.options?.[lottoSelect.selectedIndex];
                const codMag = selectedOption?.dataset?.codmag || "";
                const key = `${cod}|${lottoVal}|${codMag}`;
                if (usati.has(key)) {
                    errors.push(`${cod}: lotto ${lottoVal} duplicato non consentito.`);
                }
                usati.add(key);

                if (!perCodice[cod]) perCodice[cod] = 0;
                perCodice[cod] += qty;


                lottiPayload.push({
                    CodArt: cod,
                    RifLottoAlfa: lottoVal,
                    CodMag: codMag,
                    Quantita: String(formatQtyForComp(qty, comp)),
                });
            });

            for (const comp of _lottiData) {
                const codArt = String(comp.CodArt || "");
                const richiesto = formatQtyForComp(parseSystemQty(comp.Quantita), comp);
                const totale = perCodice[codArt] || 0;

                if (!sameQty(totale, richiesto)) {
                    errors.push(`${codArt}: somma lotti (${totale}) ≠ richiesta (${richiesto}).`);
                }
            }

            if (errors.length > 0) {
                showAlert(errors.join("\n"));
                return {valid: false, lottiPayload: []};
            }

            showAlert("");
            return {valid: true, lottiPayload};
        }

        tbody.addEventListener("change", function (e) {
            const sel = e.target.closest(".lotto-select-m");
            if (sel) {
                const row = sel.closest("tr");
                const giacCell = row.querySelector(".giacenza-cell-m");
                const qtyInput = row.querySelector(".lotto-qty-m");
                const opt = sel.options[sel.selectedIndex];

                if (opt && opt.value) {
                    const g = parseQty(opt.dataset.giacenza);
                    giacCell.textContent = g;
                    qtyInput.max = String(g);
                } else {
                    giacCell.textContent = "-";
                    qtyInput.max = "";
                }
            }

            if (e.target.closest(".lotto-select-m")) {
                updateRiepilogo();
                validateLotti();
            }
        });

        tbody.addEventListener("input", function (e) {
            if (e.target.classList.contains("lotto-qty-m")) {
                updateRiepilogo();
                validateLotti();
            }
        });

        tbody.addEventListener("click", function (e) {
            const btnAdd = e.target.closest(".btn-add-lotto-m");
            if (btnAdd) {
                const codArt = btnAdd.dataset.codart || "";
                const desArt = btnAdd.dataset.desart || "";
                const comp = _lottiData.find(c => String(c.CodArt || "") === codArt);
                if (comp && Array.isArray(comp.lotti) && comp.lotti.length > 0) {
                    addLottoRow(codArt, desArt, comp.lotti, false);
                    updateRiepilogo();
                    validateLotti();
                }
                return;
            }

            const btnRem = e.target.closest(".btn-rem-lotto-m");
            if (btnRem) {
                btnRem.closest("tr")?.remove();
                updateRiepilogo();
                validateLotti();
            }
        });

        document.addEventListener("click", function (e) {
            const btn = e.target.closest('[data-bs-target="#toast-7"]');
            if (!btn) return;

            requestAnimationFrame(() => {
                resetRegistrationDateInput();

                const idDoc = document.getElementById("toast-chiudi-m-iddocumento")?.value?.trim() || "";
                const idRiga = document.getElementById("toast-chiudi-m-idriga")?.value?.trim() || "";
                const numProgrRiga =
                    document.getElementById("toast-chiudi-m-numprogrriga")?.value?.trim() || "";

                if (idDoc && idRiga) {
                    fetchLottiData(idDoc, idRiga, numProgrRiga);
                } else {
                    section.style.display = "none";
                }
            });
        });

        document.getElementById("btn-conferma-chiusura-m")?.addEventListener("click", async function (event) {
            event.preventDefault();

            const btn = this;
            const idDocumento = document.getElementById("toast-chiudi-m-iddocumento")?.value?.trim() || "";
            const idRiga = document.getElementById("toast-chiudi-m-idriga")?.value?.trim() || "";
            const matricola = document.getElementById("toast-chiudi-m-matricola")?.value?.trim() || "";
            const fase = document.getElementById("toast-chiudi-m-fase")?.value?.trim() || "";
            const note = document.getElementById("toast-chiudi-m-note")?.value?.trim() || "";
            const numProgrRiga =
                document.getElementById("toast-chiudi-m-numprogrriga")?.value?.trim() || "";

            if (!idDocumento || !idRiga) {
                alert("Ordine non valido (IdDocumento/IdRiga mancanti).");
                return;
            }

            let lottiPayload = [];
            if (_hasRequiredLotti) {
                if (!_hasSelectableLotti) {
                    alert("Impossibile chiudere l'ordine macchina: mancano i lotti necessari per i componenti obbligatori.");
                    return;
                }

                const validation = validateLotti();
                if (!validation.valid) return;
                lottiPayload = validation.lottiPayload;
            }

            btn.disabled = true;

            try {
                const resp = await window.avpFetch("/api/ordini/montaggio/macchina/chiudi", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    credentials: "same-origin",
                    body: JSON.stringify({
                        id_documento: idDocumento,
                        id_riga: idRiga,
                        matricola: matricola,
                        fase: fase,
                        note: note,
                        lotti: lottiPayload,
                        data_registrazione: inpDataRegistrazione?.value || "",
                        include_time_line: chkIncludeTimeLine ? chkIncludeTimeLine.checked : true,
                        num_progr_riga: numProgrRiga
                    })
                });

                let data = {};
                try {
                    data = await resp.json();
                } catch (_) {
                    data = {};
                }

                if (!resp.ok || data.ok === false) {
                    alert(data.error || "Errore durante la chiusura dell'ordine macchina.");
                    return;
                }

                const exportResult = await exportAvpTxt({
                    suffix: "montaggio_m",
                    outboxId: data.outbox_id
                });
                if (!exportResult.ok) {
                    alert(exportResult.error || "Ordine chiuso, ma file ERP non generato.");
                }

                bootstrap.Toast.getOrCreateInstance(toastEl).hide();

                if (data.fragments && window.applyHomeFragments) {
                    window.applyHomeFragments(data.fragments);
                }

                const btnSosp = document.getElementById("sospensione_ordine_m");
                const btnRiatt = document.getElementById("riattivazione_ordine_m");
                if (btnSosp) btnSosp.disabled = true;
                if (btnRiatt) btnRiatt.disabled = true;

                section.style.display = "none";
                tbody.innerHTML = "";
                riepilogo.innerHTML = "";
                _lottiData = [];
                _hasRequiredLotti = false;
                _hasSelectableLotti = false;
            } catch (err) {
                console.error("Errore fetch chiusura macchina:", err);
                alert("Errore di comunicazione con il server.");
            } finally {
                btn.disabled = false;
            }
        });
    })();
</script>
<!-- ============================================================ -->
<!-- IIFE: Lotti + Chiusura SL (toast_4)                           -->
<!-- ============================================================ -->
<script id="toast_4">
    (() => {
        let _lottiData = [];
        let _hasRequiredLotti = false;
        let _hasSelectableLotti = false;
        let _rowCounter = 0;

        const toastEl = document.getElementById("toast-4");
        const section = document.getElementById("lotti-section-sl");
        const loading = document.getElementById("lotti-loading-sl");
        const alertEl = document.getElementById("lotti-alert-sl");
        const tbody = document.getElementById("tbody-lotti-sl");
        const riepilogo = document.getElementById("lotti-riepilogo-sl");

        const hidQtyResidua = document.getElementById("toast-chiudi-sl-quantita");
        const hidQtyTotale = document.getElementById("toast-chiudi-sl-quantita-totale");
        const inpConf = document.getElementById("toast-chiudi-sl-quantita-conforme");
        const inpNonConf = document.getElementById("toast-chiudi-sl-quantita-non-conforme");
        const inpNote = document.getElementById("toast-chiudi-sl-note");
        const chkParziale = document.getElementById("toast-chiudi-sl-parziale");
        const chkTotale = document.getElementById("toast-chiudi-sl-totale");
        const inpDataRegistrazione = document.getElementById("toast-chiudi-sl-data-registrazione");
        const chkIncludeTimeLine = document.getElementById("toast-chiudi-sl-include-time-line");

        if (!toastEl || !section || !tbody || !inpConf || !inpNonConf) return;

        function todayIsoLocal() {
            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            return now.toISOString().slice(0, 10);
        }

        function resetRegistrationDateInput() {
            if (!inpDataRegistrazione) return;
            const today = todayIsoLocal();
            inpDataRegistrazione.max = today;
            inpDataRegistrazione.value = today;
        }

        function escHtml(s) {
            return String(s)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function showAlert(msg) {
            if (!alertEl) return;
            alertEl.textContent = msg;
            alertEl.style.display = msg ? "" : "none";
        }

        function parseIntQty(v) {
            let s = String(v ?? "").trim().replace(/\s+/g, "");
            if (!s) return NaN;

            if (s.includes(",") || s.includes(".")) {
                return NaN;
            }

            if (!/^\d+$/.test(s)) {
                return NaN;
            }

            const n = Number(s);
            return Number.isSafeInteger(n) ? n : NaN;
        }

        function parseQtyOrZero(v) {
            const n = parseIntQty(v);
            return Number.isFinite(n) ? n : 0;
        }

        function sameQty(a, b) {
            return Math.abs(Number(a || 0) - Number(b || 0)) < 0.000001;
        }

        function sanitizeIntegerInput(el) {
            if (!el) return;

            el.setAttribute("inputmode", "numeric");
            el.setAttribute("step", "1");
            el.setAttribute("min", "0");
            el.setAttribute("pattern", "\\d*");

            el.addEventListener("input", () => {
                const cleaned = String(el.value ?? "").replace(/[^\d]/g, "");
                if (el.value !== cleaned) {
                    el.value = cleaned;
                }
            });

            el.addEventListener("blur", () => {
                const raw = String(el.value ?? "").trim();
                if (!raw) {
                    el.value = "0";
                    return;
                }
                const n = parseIntQty(raw);
                el.value = Number.isFinite(n) ? String(n) : "0";
            });
        }

        function getQuantitaLavorataCorrente() {
            const qConf = parseQtyOrZero(inpConf?.value);
            const qNonConf = parseQtyOrZero(inpNonConf?.value);
            return qConf + qNonConf;
        }

        function getQuantitaRichiestaComponente(comp) {
            const baseQty = parseSystemQty(comp?.Quantita);          // quantità distinta riferita all’ordine totale
            const qOrdTotale = getQuantitaTotaleOrdine();            // ordine nominale originale
            const qLavorata = getQuantitaLavorataCorrente();         // OK + KO effettivi inseriti nel toast

            if (!Number.isFinite(baseQty) || baseQty <= 0) return 0;
            if (!Number.isFinite(qLavorata) || qLavorata <= 0) return 0;

            // fallback prudente se manca la quantità totale ordine
            if (!Number.isFinite(qOrdTotale) || qOrdTotale <= 0) {
                return formatQtyForComp(baseQty, comp);
            }

            const richiesto = (baseQty * qLavorata) / qOrdTotale;

            if (!Number.isFinite(richiesto)) return 0;

            return formatQtyForComp(richiesto, comp);
        }

        function componenteRichiedeLotto(comp) {
            const flag = String(
                comp?.GestioneLotto
                ?? comp?.gestione_lotto
                ?? comp?.gestioneLotto
                ?? ""
            ).trim().toLowerCase();

            if (flag) return flag === "si";
            return Array.isArray(comp?.lotti) && comp.lotti.length > 0;
        }

        function parseSystemQty(v) {
            let s = String(v ?? "").trim().replace(/\s+/g, "");
            if (!s) return NaN;
            if (s.includes(",") && s.includes(".")) s = s.replace(/\./g, "");
            s = s.replace(",", ".");
            const n = Number(s);
            return Number.isFinite(n) ? n : NaN;
        }
        function getCompUdm(comp) {
            return String(comp?.TecniciUm ?? comp?.UdM ?? comp?.Udm ?? comp?.UM ?? comp?.MagUM ?? comp?.UnitaMisura ?? "").trim();
        }

        function isIntegerQtyComp(comp) {
            const udm = getCompUdm(comp).toUpperCase().replace(/\s+/g, "").replace(/\.+$/g, "");
            return udm === "N" || udm === "PZ";
        }

        function formatQtyForComp(qty, comp) {
            if (!Number.isFinite(qty)) return 0;
            return isIntegerQtyComp(comp) ? Math.round(qty) : Number(qty.toFixed(4));
        }

        function parseQtyForComp(v, comp) {
            return isIntegerQtyComp(comp) ? parseIntQty(v) : parseSystemQty(v);
        }

        function parseQtyForCompOrZero(v, comp) {
            const n = parseQtyForComp(v, comp);
            return Number.isFinite(n) ? n : 0;
        }

        function getQuantitaResiduaCorrente() {
            const n = parseSystemQty(hidQtyResidua?.value);
            return Number.isFinite(n) ? n : 0;
        }

        function getQuantitaTotaleOrdine() {
            const n = parseSystemQty(hidQtyTotale?.value);
            return Number.isFinite(n) ? n : 0;
        }

        function resetQuantitaInputs() {
            if (chkIncludeTimeLine) chkIncludeTimeLine.checked = true;
            resetRegistrationDateInput();
            const qResidua = getQuantitaResiduaCorrente();

            if (Number.isFinite(qResidua) && qResidua > 0) {
                inpConf.value = String(Math.round(qResidua));
            } else {
                inpConf.value = "";
            }

            inpNonConf.value = "0";
            if (inpNote) inpNote.value = "";
            if (chkParziale) chkParziale.checked = false;
            if (chkTotale) chkTotale.checked = false;
        }

        function buildLottoSelect(lotti, selectedLotto = "") {
            let html = '<select class="form-select form-select-sm lotto-select-sl">';
            html += '<option value="">-- Seleziona lotto --</option>';
            for (const l of (lotti || [])) {
                const value = String(l.RifLottoAlfa || "");
                const giacenza = parseQtyOrZero(l.Giacenza);
                const codMag = String(l.CodMag || "");
                const sel = value === selectedLotto ? " selected" : "";
                html += `
                    <option value="${escHtml(value)}"
                            data-giacenza="${giacenza}"
                            data-codmag="${escHtml(codMag)}"${sel}>
                        ${escHtml(value)} (mag: ${escHtml(codMag || "-")})
                    </option>`;
            }
            html += "</select>";
            return html;
        }

        function addLottoRow(codArt, desArt, lotti, isInitial) {
            _rowCounter++;
            const tr = document.createElement("tr");
            tr.id = `lotto-sl-row-${_rowCounter}`;
            tr.dataset.codart = codArt;
            tr.innerHTML = `
                <td class="fw-semibold" style="font-size:20px;">${escHtml(codArt)}</td>
                <td style="font-size:20px;">${escHtml(desArt || "")}</td>
                <td>${buildLottoSelect(lotti)}</td>
                <td class="text-end giacenza-cell-sl" style="font-size:20px;">-</td>
                <td>
                    <input type="number"
                           class="form-control form-control-sm lotto-qty-sl text-end"
                           min="0"
                           step="0.0001"
                           value=""
                           placeholder="0"
                           style="width:90px;">
                </td>
                <td>
                    <select class="form-select form-select-sm lotto-esito-sl" style="width:70px;">
                        <option value="ok">OK</option>
                        <option value="ko">KO</option>
                    </select>
                </td>
                <td class="text-center">
                    <button type="button"
                            class="btn btn-sm btn-outline-primary btn-add-lotto-sl me-1"
                            title="Aggiungi riga"
                            data-codart="${escHtml(codArt)}"
                            data-desart="${escHtml(desArt || "")}">
                        +
                    </button>
                    ${isInitial ? "" : '<button type="button" class="btn btn-sm btn-outline-danger btn-rem-lotto-sl" title="Rimuovi">−</button>'}
                </td>`;
            tbody.appendChild(tr);
            return tr;
        }

        function updateRiepilogo() {
            if (!riepilogo) return;

            const totals = {};
            tbody.querySelectorAll("tr").forEach(row => {
                const cod = row.dataset.codart || "";
                const comp = _lottiData.find(c => String(c.CodArt || "") === cod) || {};
                const qty = parseQtyForCompOrZero(row.querySelector(".lotto-qty-sl")?.value, comp);
                const esito = row.querySelector(".lotto-esito-sl")?.value || "ok";

                if (!totals[cod]) totals[cod] = {ok: 0, ko: 0, totale: 0};
                if (esito === "ok") totals[cod].ok += qty;
                else totals[cod].ko += qty;
                totals[cod].totale += qty;
            });

            let html = "<strong>Riepilogo per componente:</strong><br>";
            for (const comp of _lottiData) {
                const codArt = String(comp.CodArt || "");
                const richiesto = getQuantitaRichiestaComponente(comp);
                const t = totals[codArt] || {ok: 0, ko: 0, totale: 0};
                const ok = sameQty(t.totale, richiesto);

                html += `
            <span class="${ok ? "text-success" : "text-danger"}">
                ${escHtml(codArt)}: ${t.totale}/${richiesto}
                (OK: ${t.ok}, KO: ${t.ko})${ok ? " ✓" : " ✗"}
            </span><br>`;
            }

            riepilogo.innerHTML = html;
        }

        async function fetchLottiData(idDocumento, idRiga, numProgrRiga) {
            section.style.display = "none";
            loading.style.display = "";
            tbody.innerHTML = "";
            showAlert("");
            riepilogo.innerHTML = "";
            _lottiData = [];
            _hasRequiredLotti = false;
            _hasSelectableLotti = false;

            try {
                const resp = await window.avpFetch("/api/ordini/lotti-componenti", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    credentials: "same-origin",
                    body: JSON.stringify({
                        id_documento: idDocumento,
                        id_riga: idRiga,
                        modalita: "sl",
                        num_progr_riga: numProgrRiga
                    })
                });

                const data = await resp.json();

                if (!resp.ok || !data.ok) {
                    showAlert(data.error || "Errore nel caricamento dei lotti.");
                    return;
                }

                if (!data.gestioneLotto) {
                    section.style.display = "none";
                    return;
                }

                const rawComponenti = Array.isArray(data.componenti) ? data.componenti : [];
                const forceShow = !!data.force_show_section;

                _lottiData = rawComponenti.filter(comp => componenteRichiedeLotto(comp));

                const componentiConLotti = _lottiData.filter(
                    comp => Array.isArray(comp.lotti) && comp.lotti.length > 0
                );
                const componentiSenzaLotti = _lottiData.filter(
                    comp => !Array.isArray(comp.lotti) || comp.lotti.length === 0
                );

                _hasRequiredLotti = _lottiData.length > 0;
                _hasSelectableLotti = componentiConLotti.length > 0;

                if (!_hasRequiredLotti && !forceShow) {
                    section.style.display = "none";
                    return;
                }

                section.style.display = "";

                for (const comp of componentiConLotti) {
                    addLottoRow(comp.CodArt, comp.DesArt, comp.lotti, true);
                }

                if (componentiSenzaLotti.length > 0) {
                    const elenco = componentiSenzaLotti
                        .map(comp => `- ${comp.CodArt}${comp.DesArt ? ` (${comp.DesArt})` : ""}`)
                        .join("\n");

                    showAlert(
                        `Nessun lotto disponibile per i seguenti componenti obbligatori della fase attiva:\n${elenco}`
                    );
                } else {
                    showAlert("");
                }

                updateRiepilogo();
            } catch (err) {
                console.error("Errore fetch lotti SL:", err);
                showAlert("Errore di comunicazione.");
            } finally {
                loading.style.display = "none";
            }
        }

        function validateLotti() {
            if (!_hasRequiredLotti) return {valid: true, lottiPayload: []};

            const errors = [];
            const perCodice = {};
            const lottiPayload = [];

            // Raggruppamento per CodArt + Lotto
            const perLotto = {};

            tbody.querySelectorAll("tr").forEach(row => {
                const cod = row.dataset.codart || "";
                const lottoVal = row.querySelector(".lotto-select-sl")?.value || "";
                const giacenza = parseQtyOrZero(row.querySelector(".giacenza-cell-sl")?.textContent);
                const esito = row.querySelector(".lotto-esito-sl")?.value || "ok";
                const qtyRaw = row.querySelector(".lotto-qty-sl")?.value;
                const comp = _lottiData.find(c => String(c.CodArt || "") === cod) || {};
                const qty = parseQtyForComp(qtyRaw, comp);

                if (!Number.isFinite(qty) || qty <= 0) {
                    const tipoQty = isIntegerQtyComp(comp) ? "intera " : "";
                    errors.push(`${cod} lotto ${lottoVal}: inserire una quantità ${tipoQty}> 0.`);
                    return;
                }

                if (qty > 0 && !lottoVal) {
                    errors.push(`${cod}: selezionare un lotto.`);
                    return;
                }

                if (!lottoVal) return;


                if (qty > giacenza) {
                    errors.push(`${cod} lotto ${lottoVal}: qtà ${qty} > giacenza ${giacenza}.`);
                }
                const lottoSelect = row.querySelector(".lotto-select-sl");
                const selectedOption = lottoSelect?.options?.[lottoSelect.selectedIndex];
                const codMag = selectedOption?.dataset?.codmag || "";
                const lottoKey = `${cod}|${lottoVal}|${codMag}`;
                if (!perLotto[lottoKey]) {
                    perLotto[lottoKey] = {
                        cod,
                        lottoVal,
                        giacenza,
                        totale: 0,
                        ok: 0,
                        ko: 0,
                        righe: 0
                    };
                }

                perLotto[lottoKey].totale += qty;
                perLotto[lottoKey].righe += 1;
                if (esito === "ok") {
                    perLotto[lottoKey].ok += qty;
                } else {
                    perLotto[lottoKey].ko += qty;
                }

                if (!perCodice[cod]) perCodice[cod] = {ok: 0, ko: 0, totale: 0};
                if (esito === "ok") perCodice[cod].ok += qty;
                else perCodice[cod].ko += qty;
                perCodice[cod].totale += qty;
                lottiPayload.push({
                    CodArt: cod,
                    RifLottoAlfa: lottoVal,
                    CodMag: codMag,
                    Quantita: String(formatQtyForComp(qty, comp)),
                    Esito: esito
                });
            });

            // Regole duplicati stesso lotto
            for (const key of Object.keys(perLotto)) {
                const info = perLotto[key];

                if (info.righe <= 1) continue;

                // Se tutte le righe del lotto sono OK, il duplicato non è ammesso
                if (info.ko === 0) {
                    errors.push(
                        `${info.cod}: lotto ${info.lottoVal} duplicato non consentito su più righe OK.`
                    );
                    continue;
                }

                // Se esiste almeno una KO, il duplicato è ammesso solo entro la giacenza
                if (info.totale > info.giacenza) {
                    errors.push(
                        `${info.cod}: lotto ${info.lottoVal} duplicato con KO ma somma quantità ${info.totale} > giacenza ${info.giacenza}.`
                    );
                }
            }

            // Controllo totale per componente
            for (const comp of _lottiData) {
                const codArt = String(comp.CodArt || "");
                const richiesto = getQuantitaRichiestaComponente(comp);
                const totale = perCodice[codArt]?.totale || 0;

                if (!sameQty(totale, richiesto)) {
                    errors.push(`${codArt}: somma lotti (${totale}) ≠ richiesta (${richiesto}).`);
                }
            }

            if (errors.length > 0) {
                showAlert(errors.join("\n"));
                return {valid: false, lottiPayload: []};
            }

            showAlert("");
            return {valid: true, lottiPayload};
        }


        // ---- Aggiorna giacenza al cambio lotto ----
        tbody.addEventListener("change", function (e) {
            const sel = e.target.closest(".lotto-select-sl");
            if (sel) {
                const row = sel.closest("tr");
                const giacCell = row.querySelector(".giacenza-cell-sl");
                const qtyInput = row.querySelector(".lotto-qty-sl");
                const opt = sel.options[sel.selectedIndex];

                if (opt && opt.value) {
                    const g = parseSystemQty(opt.dataset.giacenza);
                    giacCell.textContent = Number.isFinite(g) ? g : 0;
                    qtyInput.max = Number.isFinite(g) ? String(g) : "";
                } else {
                    giacCell.textContent = "-";
                    qtyInput.max = "";
                }
            }

            if (
                e.target.closest(".lotto-select-sl") ||
                e.target.closest(".lotto-esito-sl")
            ) {
                updateRiepilogo();
                validateLotti();
            }
        });

        tbody.addEventListener("input", function (e) {
            if (e.target.classList.contains("lotto-qty-sl")) {
                updateRiepilogo();
                validateLotti();
            }
        });

        tbody.addEventListener("click", function (e) {
            const btnAdd = e.target.closest(".btn-add-lotto-sl");
            if (btnAdd) {
                const codArt = btnAdd.dataset.codart || "";
                const desArt = btnAdd.dataset.desart || "";
                const comp = _lottiData.find(c => String(c.CodArt || "") === codArt);
                if (comp && Array.isArray(comp.lotti) && comp.lotti.length > 0) {
                    addLottoRow(codArt, desArt, comp.lotti, false);
                    updateRiepilogo();
                    validateLotti();
                }
                return;
            }

            const btnRem = e.target.closest(".btn-rem-lotto-sl");
            if (btnRem) {
                btnRem.closest("tr")?.remove();
                updateRiepilogo();
                validateLotti();
            }
        });
        sanitizeIntegerInput(inpConf);
        sanitizeIntegerInput(inpNonConf);
        [inpConf, inpNonConf].forEach(el => {
            el?.addEventListener("input", () => {
                if (_hasRequiredLotti) updateRiepilogo();
            });
        });

        chkParziale?.addEventListener("change", () => {
            if (chkParziale.checked && chkTotale) {
                chkTotale.checked = false;
            }
            if (_hasRequiredLotti) updateRiepilogo();
        });

        chkTotale?.addEventListener("change", () => {
            if (chkTotale.checked && chkParziale) {
                chkParziale.checked = false;
            }
            if (_hasRequiredLotti) updateRiepilogo();
        });

        document.addEventListener("click", function (e) {
            const btn = e.target.closest('[data-bs-target="#toast-4"]');
            if (!btn) return;

            requestAnimationFrame(() => {
                resetQuantitaInputs();

                const idDoc = document.getElementById("toast-chiudi-sl-iddocumento")?.value?.trim() || "";
                const idRiga = document.getElementById("toast-chiudi-sl-idriga")?.value?.trim() || "";
                const numProgrRiga = document.getElementById("toast-chiudi-sl-numprogrriga")?.value?.trim() || "";

                if (idDoc && idRiga) {
                    fetchLottiData(idDoc, idRiga, numProgrRiga);
                } else {
                    section.style.display = "none";
                }
            });
        });

        document.getElementById("btn-conferma-chiusura-sl")?.addEventListener("click", async function (event) {
            event.preventDefault();

            const btn = this;
            const idDocumento = document.getElementById("toast-chiudi-sl-iddocumento")?.value?.trim() || "";
            const idRiga = document.getElementById("toast-chiudi-sl-idriga")?.value?.trim() || "";
            const qOrd = document.getElementById("toast-chiudi-sl-quantita")?.value?.trim() || "";
            const qConf = document.getElementById("toast-chiudi-sl-quantita-conforme")?.value?.trim() || "";
            const qNonConf = document.getElementById("toast-chiudi-sl-quantita-non-conforme")?.value?.trim() || "";
            const note = document.getElementById("toast-chiudi-sl-note")?.value?.trim() || "";
            const chiusuraParziale = document.getElementById("toast-chiudi-sl-parziale")?.checked === true;
            const chiusuraTotale = document.getElementById("toast-chiudi-sl-totale")?.checked === true;
            const numProgrRiga =
                document.getElementById("toast-chiudi-sl-numprogrriga")?.value?.trim() || "";

            if (chiusuraParziale === chiusuraTotale) {
                alert("Selezionare una sola modalità di chiusura: parziale oppure totale.");
                return;
            }
            if (!idDocumento || !idRiga) {
                alert("Ordine non valido (IdDocumento/IdRiga mancanti).");
                return;
            }

            // Validazione quantità
            const nConf = parseIntQty(qConf);
            const nNonConf = parseIntQty(qNonConf);

            const qOrdResiduaRaw = document.getElementById("toast-chiudi-sl-quantita")?.value?.trim() || "";
            const nOrdResiduaRaw = parseSystemQty(qOrdResiduaRaw);
            const nOrdResidua = Number.isFinite(nOrdResiduaRaw) ? Math.round(nOrdResiduaRaw) : NaN;
            if (!Number.isInteger(nConf) || nConf < 0) {
                alert("Quantità conforme non valida: inserire un numero intero >= 0.");
                return;
            }
            if (!Number.isInteger(nNonConf) || nNonConf < 0) {
                alert("Quantità KO non valida: inserire un numero intero >= 0.");
                return;
            }

            if (!Number.isFinite(nConf) || nConf < 0) {
                alert("Quantità conforme non valida.");
                return;
            }
            if (!Number.isFinite(nNonConf) || nNonConf < 0) {
                alert("Quantità KO non valida.");
                return;
            }

            const nLavorata = nConf + nNonConf;

            if (nLavorata <= 0) {
                alert("Devi indicare una quantità lavorata > 0.");
                return;
            }

            if (chiusuraParziale) {
                if (!Number.isFinite(nOrdResidua) || nOrdResidua <= 0) {
                    alert("Quantità residua ordine non valida.");
                    return;
                }

                if (nLavorata >= nOrdResidua) {
                    alert("Nella chiusura parziale la quantità lavorata deve essere strettamente minore della quantità residua dell'ordine.");
                    return;
                }
            }


            let lottiPayload = [];
            if (_hasRequiredLotti) {
                if (!_hasSelectableLotti) {
                    alert("Impossibile chiudere l'ordine: mancano i lotti necessari per i componenti obbligatori.");
                    return;
                }

                const validation = validateLotti();
                if (!validation.valid) return;
                lottiPayload = validation.lottiPayload;

                const totKoLotti = lottiPayload
                    .filter(l => String(l.Esito || "").toLowerCase() === "ko")
                    .reduce((s, l) => s + parseQtyOrZero(l.Quantita), 0);

                if (sameQty(qNonConf, 0) && totKoLotti > 0) {
                    alert("Hai lotti marcati KO ma quantità non conforme = 0.");
                    return;
                }

                if (qNonConf > 0 && sameQty(totKoLotti, 0)) {
                    alert("Quantità non conforme > 0 ma nessun lotto è marcato KO.");
                    return;
                }
            }

            btn.disabled = true;

            try {
                const resp = await window.avpFetch("/api/ordini/chiudi", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    credentials: "same-origin",
                    body: JSON.stringify({
                        id_documento: idDocumento,
                        id_riga: idRiga,
                        quantita_conforme: String(nConf),
                        quantita_non_conforme: String(nNonConf),
                        note: note,
                        lotti: lottiPayload,
                        chiusura_parziale: chiusuraParziale,
                        data_registrazione: inpDataRegistrazione?.value || "",
                        include_time_line: chkIncludeTimeLine ? chkIncludeTimeLine.checked : true,
                        num_progr_riga: numProgrRiga
                    })
                });

                let data = {};
                try {
                    data = await resp.json();
                } catch (_) {
                    data = {};
                }

                if (!resp.ok || data.ok === false) {
                    alert(data.error || "Errore durante la chiusura dell'ordine.");
                    return;
                }
                if (data.label_url && window.showGeneratedLabel) {
                    window.showGeneratedLabel(data.label_url);
                }

                const exportResult = await exportAvpTxt({
                    suffix: "montaggio_sl",
                    outboxId: data.outbox_id
                });
                if (!exportResult.ok) {
                    alert(exportResult.error || "Ordine chiuso, ma file ERP non generato.");
                }

                bootstrap.Toast.getOrCreateInstance(toastEl).hide();

                if (data.fragments && window.applyHomeFragments) {
                    window.applyHomeFragments(data.fragments);
                }

                const btnSosp = document.getElementById("sospensione_ordine_sl");
                const btnRiatt = document.getElementById("riattivazione_ordine_sl");
                if (btnSosp) btnSosp.disabled = true;
                if (btnRiatt) btnRiatt.disabled = true;

                section.style.display = "none";
                tbody.innerHTML = "";
                riepilogo.innerHTML = "";
                _lottiData = [];
                _hasRequiredLotti = false;
                _hasSelectableLotti = false;
                resetQuantitaInputs();
            } catch (err) {
                console.error("Errore fetch chiusura SL:", err);
                alert("Errore di comunicazione con il server.");
            } finally {
                btn.disabled = false;
            }
        });
    })();
</script>
<script>
    (() => {
        if (window.__avpWorkgroupCloseInit) return;
        window.__avpWorkgroupCloseInit = true;

        function parseGroupDetail(raw) {
            try {
                const parsed = JSON.parse(raw || "[]");
                return Array.isArray(parsed) ? parsed : [];
            } catch (_) {
                return [];
            }
        }

        document.addEventListener("click", function (event) {
            const trigger = event.target.closest(
                '[data-use-selected][data-fill-target][data-bs-target][data-bs-toggle="toast"]'
            );
            if (!trigger) return;

            const targetSelector = trigger.getAttribute("data-fill-target") || "";
            const isClosureToast = targetSelector === "#toast-4" || targetSelector === "#toast-7";

            if (!isClosureToast) return;

            const tableSelector = trigger.getAttribute("data-use-selected");
            const table = document.querySelector(tableSelector);
            const selectedRow = table?.querySelector("tbody tr.row-selected");

            if (!selectedRow || selectedRow.dataset.isWorkGroup !== "1") return;

            event.preventDefault();
            event.stopPropagation();
            event.stopImmediatePropagation();

            openWorkgroupCloseModal({
                groupUid: selectedRow.dataset.groupUid || "",
                groupType: selectedRow.dataset.groupType || "",
                groupLabel: selectedRow.dataset.groupLabel || selectedRow.dataset.ordine || "",
                detail: parseGroupDetail(selectedRow.dataset.groupDetail),
                sourceTarget: targetSelector
            });
        }, true);

        let workgroupCloseState = {
            groupUid: "",
            sourceTarget: "",
            detail: [],
            lottiByOrder: {},
            lottoUiByOrder: {},
            rowCounter: 0
        };

        function orderKey(row) {
            return `${row.id_documento || ""}|${row.id_riga || ""}`;
        }

        function openWorkgroupCloseModal({groupUid, groupType, groupLabel, detail, sourceTarget}) {
            workgroupCloseState = {
                groupUid,
                sourceTarget: sourceTarget || "",
                detail: detail || [],
                lottiByOrder: {},
                lottoUiByOrder: {},
                rowCounter: 0
            };

            const modal = ensureWorkgroupCloseModal();

            document.getElementById("modal-workgroup-close-title").textContent =
                `Chiusura gruppo ${groupType || ""}`;

            document.getElementById("modal-workgroup-close-subtitle").textContent =
                [groupLabel, groupUid].filter(Boolean).join(" - ");

            renderWorkgroupCloseRows();

            bootstrap.Modal.getOrCreateInstance(modal).show();
        }

        function ensureWorkgroupCloseModal() {
            let modal = document.getElementById("modalWorkgroupClose");
            if (modal) return modal;

            document.body.insertAdjacentHTML("beforeend", `
            <div class="modal fade" id="modalWorkgroupClose" tabindex="-1" aria-hidden="true">
              <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                  <div class="modal-header">
                    <div>
                      <h5 class="modal-title" id="modal-workgroup-close-title">Chiusura gruppo</h5>
                      <div class="small text-muted" id="modal-workgroup-close-subtitle"></div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
                  </div>
                  <div class="modal-body">
                    <div id="modal-workgroup-close-feedback" class="alert alert-danger d-none"></div>
                    <div id="modal-workgroup-close-body"></div>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                    <button type="button" class="btn btn-danger" id="btn-workgroup-close-confirm">
                      Conferma chiusura gruppo
                    </button>
                  </div>
                </div>
              </div>
            </div>`);
            document.getElementById("btn-workgroup-close-confirm")
                .addEventListener("click", submitWorkgroupClose);

            document.getElementById("modal-workgroup-close-body")
                .addEventListener("click", event => {
                    const btn = event.target.closest(".js-workgroup-close-single");
                    if (!btn) return;
                    submitWorkgroupSingleClose(btn.dataset.orderKey || "", btn);
                });

            return document.getElementById("modalWorkgroupClose");
        }

        async function loadLottiForGroupRow(row) {
            const resp = await window.avpFetch("/api/ordini/lotti-componenti", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest"
                },
                credentials: "same-origin",
                body: JSON.stringify({
                    id_documento: row.id_documento,
                    id_riga: row.id_riga,
                    modalita: row.modalita_lotti || "sl",
                    num_progr_riga: row.num_progr_riga || ""
                })
            });

            const data = await resp.json();

            if (!resp.ok || data.ok === false) {
                throw new Error(data.error || "Errore caricamento lotti.");
            }

            return Array.isArray(data.componenti) ? data.componenti : [];
        }

        function escHtml(value) {
            return String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

        function parseIntQty(v) {
            const s = String(v ?? "").trim().replace(/\s+/g, "");
            if (!s || s.includes(",") || s.includes(".") || !/^\d+$/.test(s)) return NaN;
            const n = Number(s);
            return Number.isSafeInteger(n) ? n : NaN;
        }

        function parseQtyOrZero(v) {
            const n = parseIntQty(v);
            return Number.isFinite(n) ? n : 0;
        }

        function parseSystemQty(v) {
            let s = String(v ?? "").trim().replace(/\s+/g, "");
            if (!s) return NaN;
            if (s.includes(",") && s.includes(".")) s = s.replace(/\./g, "");
            s = s.replace(",", ".");
            const n = Number(s);
            return Number.isFinite(n) ? n : NaN;
        }
        function getCompUdm(comp) {
            return String(comp?.TecniciUm ?? comp?.UdM ?? comp?.Udm ?? comp?.UM ?? comp?.MagUM ?? comp?.UnitaMisura ?? "").trim();
        }

        function isIntegerQtyComp(comp) {
            const udm = getCompUdm(comp).toUpperCase().replace(/\s+/g, "").replace(/\.+$/g, "");
            return udm === "N" || udm === "PZ";
        }

        function formatQtyForComp(qty, comp) {
            if (!Number.isFinite(qty)) return 0;
            return isIntegerQtyComp(comp) ? Math.round(qty) : Number(qty.toFixed(4));
        }

        function parseQtyForComp(v, comp) {
            return isIntegerQtyComp(comp) ? parseIntQty(v) : parseSystemQty(v);
        }

        function parseQtyForCompOrZero(v, comp) {
            const n = parseQtyForComp(v, comp);
            return Number.isFinite(n) ? n : 0;
        }

        function sameQty(a, b) {
            return Math.abs(Number(a || 0) - Number(b || 0)) < 0.000001;
        }

        function isGestioneLottoSi(comp) {
            const flag = String(comp?.GestioneLotto ?? comp?.gestione_lotto ?? comp?.gestioneLotto ?? "")
                .trim()
                .toLowerCase();

            return flag ? flag === "si" : Array.isArray(comp?.lotti) && comp.lotti.length > 0;
        }

        function getGroupLottiState(row) {
            const key = orderKey(row);
            if (!workgroupCloseState.lottoUiByOrder[key]) {
                workgroupCloseState.lottoUiByOrder[key] = {
                    data: [],
                    hasLotti: false,
                    hasSelectableLotti: false,
                    loaded: false,
                    loadError: ""
                };
            }
            return workgroupCloseState.lottoUiByOrder[key];
        }

        function getGroupQuantitaLavorata(row) {
            const key = orderKey(row);
            return parseQtyOrZero(getGroupRowValue(key, "quantita_conforme"))
                + parseQtyOrZero(getGroupRowValue(key, "quantita_non_conforme"));
        }

        function getGroupQuantitaRichiestaComponente(row, comp) {
            const baseQty = parseSystemQty(comp?.Quantita);
            const qOrdTotale = parseSystemQty(row.quantita);
            const qLavorata = getGroupQuantitaLavorata(row);

            if (!Number.isFinite(baseQty) || baseQty <= 0) return 0;
            if (!Number.isFinite(qLavorata) || qLavorata <= 0) return 0;
            if (!Number.isFinite(qOrdTotale) || qOrdTotale <= 0) return formatQtyForComp(baseQty, comp);

            return formatQtyForComp((baseQty * qLavorata) / qOrdTotale, comp);
        }

        function setGroupLottiAlert(root, message) {
            const alertEl = root?.querySelector("[data-lotti-alert]");
            if (!alertEl) return;
            alertEl.textContent = message || "";
            alertEl.style.display = message ? "" : "none";
        }

        function groupOrderEl(key) {
            return Array.from(
                document.querySelectorAll("#modal-workgroup-close-body [data-order-key]")
            ).find(el => el.dataset.orderKey === key) || null;
        }

        function getGroupRowValue(key, field) {
            return groupOrderEl(key)?.querySelector(`[data-field="${field}"]`)?.value?.trim() || "";
        }

        function getGroupRowChecked(key, field) {
            return groupOrderEl(key)?.querySelector(`[data-field="${field}"]`)?.checked === true;
        }

        function getGroupRowCheckedDefault(key, field, defaultValue) {
            const el = groupOrderEl(key)?.querySelector(`[data-field="${field}"]`);
            return el ? el.checked === true : defaultValue;
        }

        function showGroupCloseFeedback(message) {
            const el = document.getElementById("modal-workgroup-close-feedback");
            if (!el) return;
            el.textContent = message || "";
            el.classList.toggle("d-none", !message);
        }

        function sanitizeGroupIntegerInput(el) {
            if (!el) return;

            el.addEventListener("beforeinput", event => {
                if (event.data && /\D/.test(event.data)) {
                    event.preventDefault();
                }
            });

            el.addEventListener("input", () => {
                const raw = String(el.value ?? "");
                if (/^\d*$/.test(raw)) return;
                el.value = raw.split(/[,.]/, 1)[0].replace(/\D+/g, "");
            });

            el.addEventListener("blur", () => {
                const n = parseIntQty(el.value);
                el.value = Number.isFinite(n) ? String(n) : "0";
            });
        }

        function isGroupRowMachine(row) {
            return row.is_macchina === true
                || row.gestione_matricola === true
                || row.modalita_lotti === "m";
        }

        function validateGroupSingleTotalQuantity(row) {
            if (isGroupRowMachine(row)) {
                return true;
            }

            const key = orderKey(row);
            const label = row.ordine || row.cod_art || key;
            const qOk = parseIntQty(getGroupRowValue(key, "quantita_conforme"));
            const qKo = parseIntQty(getGroupRowValue(key, "quantita_non_conforme"));
            if (!Number.isFinite(qOk) || qOk < 0) {
                showGroupCloseFeedback(`La quantita OK dell'ordine ${label} deve essere un numero intero positivo.`);
                return false;
            }
            if (!Number.isFinite(qKo) || qKo < 0) {
                showGroupCloseFeedback(`La quantita KO dell'ordine ${label} deve essere un numero intero positivo.`);
                return false;
            }

            const qTot = parseSystemQty(row.quantita);
            if ((qOk + qKo) <= 0) {
                showGroupCloseFeedback(`Inserire almeno una quantita OK o KO per l'ordine ${label}.`);
                return false;
            }
            if (Number.isFinite(qTot) && !sameQty(qOk + qKo, qTot)) {
                showGroupCloseFeedback(`Per chiudere solo l'ordine ${label}, la somma OK + KO deve essere uguale alla quantita dell'ordine.`);
                return false;
            }

            const okInput = groupOrderEl(key)?.querySelector("[data-field='quantita_conforme']");
            const koInput = groupOrderEl(key)?.querySelector("[data-field='quantita_non_conforme']");
            if (okInput) okInput.value = String(qOk);
            if (koInput) koInput.value = String(qKo);
            return true;
        }

        function buildGroupClosePayloadForRow(row, {singleClose = false} = {}) {
            const key = orderKey(row);
            const isMacchina = isGroupRowMachine(row);
            const qConf = isMacchina ? "" : String(parseIntQty(getGroupRowValue(key, "quantita_conforme")));
            const qKo = isMacchina ? "" : String(parseIntQty(getGroupRowValue(key, "quantita_non_conforme")));
            return {
                id_documento: row.id_documento,
                id_riga: row.id_riga,
                num_progr_riga: row.num_progr_riga || "",
                fase: row.fase || row.fase_attiva || "",
                matricola: row.matricola || "",
                modalita_lotti: row.modalita_lotti || (isMacchina ? "m" : "sl"),
                quantita_conforme: qConf,
                quantita_non_conforme: qKo,
                chiusura_parziale: singleClose ? false : (!isMacchina && getGroupRowChecked(key, "chiusura_parziale")),
                data_registrazione: getGroupRowValue(key, "data_registrazione"),
                include_time_line: getGroupRowCheckedDefault(key, "include_time_line", true),
                lotti: workgroupCloseState.lottiByOrder[key] || []
            };
        }

        function validateGroupQuantities() {
            for (const row of workgroupCloseState.detail) {
                const key = orderKey(row);
                const isMacchina = row.is_macchina === true
                    || row.gestione_matricola === true
                    || row.modalita_lotti === "m";
                if (isMacchina) continue;

                const label = row.ordine || row.cod_art || key;
                const qOk = parseIntQty(getGroupRowValue(key, "quantita_conforme"));
                const qKo = parseIntQty(getGroupRowValue(key, "quantita_non_conforme"));

                if (!Number.isInteger(qOk) || qOk < 0) {
                    showGroupCloseFeedback(`${label}: quantità conforme deve essere un intero positivo o zero.`);
                    return false;
                }
                if (!Number.isInteger(qKo) || qKo < 0) {
                    showGroupCloseFeedback(`${label}: quantità KO deve essere un intero positivo o zero.`);
                    return false;
                }
                if (qOk + qKo <= 0) {
                    showGroupCloseFeedback(`${label}: indicare una quantità lavorata > 0.`);
                    return false;
                }

                groupOrderEl(key).querySelector('[data-field="quantita_conforme"]').value = String(qOk);
                groupOrderEl(key).querySelector('[data-field="quantita_non_conforme"]').value = String(qKo);
            }
            return true;
        }

        function renderWorkgroupCloseRows() {
            const body = document.getElementById("modal-workgroup-close-body");
            if (!body) return;

            const rowsHtml = workgroupCloseState.detail.map(row => {
                const key = orderKey(row);
                const qtaRaw = parseSystemQty(row.quantita);
                const qta = Number.isInteger(qtaRaw) && qtaRaw >= 0 ? String(qtaRaw) : "";
                const isMacchina = row.is_macchina === true
                    || row.gestione_matricola === true
                    || row.modalita_lotti === "m";
                const timeZero = String(row.time_share_mode || row.TimeShareMode || "")
                    .toUpperCase() === "ZERO";

                const closeFields = isMacchina ? "" : `
                <div class="row g-2 align-items-end">
                    <div class="col">
                        <label class="form-label mb-1">Quantità conforme</label>
                        <input class="form-control form-control-sm"
                               type="number"
                               inputmode="numeric"
                               min="0"
                               step="1"
                               pattern="[0-9]*"
                               data-field="quantita_conforme"
                               value="${escHtml(qta)}">
                    </div>
                    <div class="col">
                        <label class="form-label mb-1">Quantità non conforme</label>
                        <input class="form-control form-control-sm"
                               type="number"
                               inputmode="numeric"
                               min="0"
                               step="1"
                               pattern="[0-9]*"
                               data-field="quantita_non_conforme"
                               value="0">
                    </div>
                    <div class="col-auto">
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   data-field="chiusura_parziale">
                            <label class="form-check-label">Parziale</label>
                        </div>
                    </div>
                </div>`;

                const registrationFields = `
                <div class="row g-2 align-items-end mt-2">
                    {% if has_modifica_data_chiusura_permission %}
                    <div class="col">
                        <label class="form-label mb-1">Data registrazione</label>
                        <input type="date"
                               class="form-control form-control-sm"
                               data-field="data_registrazione">
                    </div>
                    {% endif %}
                    {% if has_export_senza_tempo_permission %}
                    <div class="col">
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   data-field="include_time_line"
                                   ${timeZero ? "" : "checked"}
                                   ${timeZero ? "disabled" : ""}>
                            <label class="form-check-label">
                                Inserisci tempo nel file ERP
                            </label>
                        </div>
                    </div>
                    {% endif %}
                </div>`;

                return `
            <div class="border rounded p-2 mb-2" data-order-key="${escHtml(key)}">
                <div class="fw-semibold">
                    ${escHtml(row.ordine || "")} - ${escHtml(row.cod_art || "")}
                </div>
                <div class="small text-muted mb-2">
                    ${escHtml(row.descrizione || "")} | Fase ${escHtml(row.fase || "")}
                    ${row.matricola ? ` | Matricola ${escHtml(row.matricola)}` : ""}
                </div>

                ${closeFields}
                ${registrationFields}
                <div class="d-flex justify-content-end mt-2">
                    <button type="button" class="btn btn-outline-danger btn-sm js-workgroup-close-single" data-order-key="${escHtml(key)}">Chiudi solo questo ordine</button>
                </div>

                <div class="mt-2" data-lotti-box></div>
            </div>
        `;
            }).join("");

            body.innerHTML = `
                <div class="mb-3">
                    <label class="form-label mb-1" for="modal-workgroup-close-note">
                        Note chiusura gruppo
                    </label>
                    <textarea class="form-control"
                              id="modal-workgroup-close-note"
                              rows="2"></textarea>
                </div>
                ${rowsHtml}
            `;

            body.querySelectorAll('[data-field="quantita_conforme"], [data-field="quantita_non_conforme"]')
                .forEach(sanitizeGroupIntegerInput);

            workgroupCloseState.detail.forEach(row => {
                if (row.richiede_lotti === true) {
                    loadAndRenderGroupLotti(row);
                }
            });
        }

        async function loadAndRenderGroupLotti(row) {
            const key = orderKey(row);
            const box = groupOrderEl(key)?.querySelector("[data-lotti-box]");
            if (!box) return;

            box.innerHTML = `<div class="text-muted small">Caricamento lotti...</div>`;
            const state = getGroupLottiState(row);
            state.loaded = false;
            state.loadError = "";

            try {
                const componenti = (await loadLottiForGroupRow(row)).filter(isGestioneLottoSi);
                state.data = componenti;
                state.hasLotti = componenti.length > 0;
                state.hasSelectableLotti = componenti.some(comp => Array.isArray(comp.lotti) && comp.lotti.length > 0);
                state.loaded = true;

                if (!componenti.length) {
                    workgroupCloseState.lottiByOrder[key] = [];
                    box.innerHTML = "";
                    return;
                }

                const isMacchinaLotti = isGroupRowMachine(row);

                box.innerHTML = `
                    <div class="fw-semibold mt-2 mb-1">Assegnazione lotti</div>
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Codice</th>
                                <th>Lotto</th>
                                <th>Giacenza</th>
                                <th>Quantità</th>
                                ${isMacchinaLotti ? "" : "<th>Esito</th>"}
                            </tr>
                        </thead>
                        <tbody>
                            ${componenti.map(comp => `
                                <tr data-lotto-codart="${escHtml(comp.CodArt || "")}">
                                    <td>${escHtml(comp.CodArt || "")}</td>
                                    <td>
                                        <select class="form-select form-select-sm" data-field="lotto">
                                            <option value="">-- Seleziona --</option>
                                            ${(comp.lotti || []).map(lotto => `
                                                <option value="${escHtml(lotto.RifLottoAlfa || "")}"
                                                        data-giacenza="${escHtml(lotto.Giacenza || "0")}"
                                                        data-codmag="${escHtml(lotto.CodMag || "")}">
                                                    ${escHtml(lotto.CodMag ? `${lotto.RifLottoAlfa || ""} (${lotto.CodMag})` : (lotto.RifLottoAlfa || ""))}
                                                </option>
                                            `).join("")}
                                        </select>
                                    </td>
                                    <td data-field="giacenza">-</td>
                                    <td>
                                        <input class="form-control form-control-sm"
                                               data-field="lotto_quantita"
                                               value="${escHtml(String(formatQtyForComp((row.modalita_lotti || "sl") === "m" ? parseSystemQty(comp.Quantita) : getGroupQuantitaRichiestaComponente(row, comp), comp) || ""))}">
                                    </td>
                                    ${isMacchinaLotti ? "" : `
                                    <td>
                                        <select class="form-select form-select-sm" data-field="esito">
                                            <option value="ok">OK</option>
                                            <option value="ko">KO</option>
                                        </select>
                                    </td>`}
                                </tr>
                            `).join("")}
                        </tbody>
                    </table>
                `;

                box.querySelectorAll('[data-field="lotto"]').forEach(select => {
                    select.addEventListener("change", () => {
                        const opt = select.options[select.selectedIndex];
                        const tr = select.closest("tr");
                        tr.querySelector('[data-field="giacenza"]').textContent =
                            opt?.dataset?.giacenza || "-";
                    });
                });

            } catch (err) {
                state.loaded = false;
                state.loadError = err?.message || "Errore caricamento lotti.";
                box.innerHTML = `<div class="alert alert-danger mb-0">${escHtml(state.loadError)}</div>`;
            }
        }

        function collectGroupLotti(row) {
            const key = orderKey(row);
            const root = groupOrderEl(key);
            const rows = root ? root.querySelectorAll("[data-lotto-codart]") : [];
            const payload = [];
            const state = getGroupLottiState(row);
            if (rows.length === 0) {
                if (state.loaded && state.hasLotti === false) {
                    workgroupCloseState.lottiByOrder[key] = [];
                    return true;
                }
                showGroupCloseFeedback(state.loadError || `Lotti non caricati per ${row.ordine || row.cod_art || key}.`);
                return false;
            }

            for (const tr of rows) {
                const codArt = tr.dataset.lottoCodart || "";
                const select = tr.querySelector('[data-field="lotto"]');
                const lotto = select?.value || "";
                const opt = select?.options?.[select.selectedIndex];
                const qtyRaw = tr.querySelector('[data-field="lotto_quantita"]')?.value?.trim() || "";
                const comp = state.data.find(c => String(c.CodArt || "") === codArt) || {};
                const qty = parseQtyForComp(qtyRaw, comp);
                const esito = tr.querySelector('[data-field="esito"]')?.value || "ok";

                if (!lotto || !Number.isFinite(qty) || qty <= 0) {
                    const tipoQty = isIntegerQtyComp(comp) ? " intera" : "";
                    showGroupCloseFeedback(`Compilare lotto e quantità${tipoQty} > 0 per ${codArt}.`);
                    return false;
                }

                payload.push({
                    CodArt: codArt,
                    RifLottoAlfa: lotto,
                    CodMag: opt?.dataset?.codmag || "",
                    Quantita: String(formatQtyForComp(qty, comp)),
                    Esito: esito
                });
            }

            workgroupCloseState.lottiByOrder[key] = payload;
            return true;
        }

        async function submitWorkgroupSingleClose(rowKey, button) {
            const row = workgroupCloseState.detail.find(item => orderKey(item) === rowKey);
            if (!row) {
                showGroupCloseFeedback("Ordine del gruppo non trovato.");
                return;
            }

            showGroupCloseFeedback("");
            if (!validateGroupSingleTotalQuantity(row)) return;
            if (row.richiede_lotti === true && !collectGroupLotti(row)) return;
            if (!confirm("Chiudere solo questo ordine del gruppo?")) return;

            const oldText = button?.textContent || "";
            if (button) {
                button.disabled = true;
                button.textContent = "Chiusura...";
            }

            try {
                const groupNote = document.getElementById("modal-workgroup-close-note")?.value?.trim() || "";
                const resp = await window.avpFetch("/api/ordini/gruppi/chiudi-membro", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    credentials: "same-origin",
                    body: JSON.stringify({
                        group_uid: workgroupCloseState.groupUid,
                        note: groupNote,
                        order: buildGroupClosePayloadForRow(row, {singleClose: true})
                    })
                });

                let data = {};
                try {
                    data = await resp.json();
                } catch (_) {
                    data = {};
                }

                if (!resp.ok || data.ok === false) {
                    showGroupCloseFeedback(data.error || data.message || "Errore durante la chiusura dell'ordine.");
                    if (button) {
                        button.disabled = false;
                        button.textContent = oldText;
                    }
                    return;
                }

                const exportErrors = [];
                for (const exportRow of (data.exports || [])) {
                    const exportResult = await exportAvpTxt({
                        suffix: exportRow.suffix || "officina",
                        outboxId: exportRow.outbox_id
                    });
                    if (!exportResult.ok) {
                        exportErrors.push(exportResult.error || `Export non generato per ${exportRow.outbox_id}.`);
                    }
                }

                bootstrap.Modal.getOrCreateInstance(document.getElementById("modalWorkgroupClose")).hide();

                if (data.fragments && window.applyHomeFragments) {
                    window.applyHomeFragments(data.fragments);
                }

                if (exportErrors.length) {
                    alert(exportErrors.join("\n"));
                }
            } catch (err) {
                showGroupCloseFeedback(err?.message || "Errore di comunicazione con il server.");
                if (button) {
                    button.disabled = false;
                    button.textContent = oldText;
                }
            }
        }

        async function submitWorkgroupClose() {
            showGroupCloseFeedback("");

            if (!validateGroupQuantities()) {
                return;
            }

            for (const row of workgroupCloseState.detail) {
                if (row.richiede_lotti === true && !collectGroupLotti(row)) {
                    return;
                }
            }

            const groupNote = document.getElementById("modal-workgroup-close-note")?.value?.trim() || "";
            const orders = workgroupCloseState.detail.map(row => {
                const key = orderKey(row);
                const isMacchina = row.is_macchina === true
                    || row.gestione_matricola === true
                    || row.modalita_lotti === "m";
                const qConf = isMacchina ? "" : String(parseIntQty(getGroupRowValue(key, "quantita_conforme")));
                const qKo = isMacchina ? "" : String(parseIntQty(getGroupRowValue(key, "quantita_non_conforme")));

                return {
                    id_documento: row.id_documento,
                    id_riga: row.id_riga,
                    num_progr_riga: row.num_progr_riga || "",
                    fase: row.fase || row.fase_attiva || "",
                    matricola: row.matricola || "",
                    modalita_lotti: row.modalita_lotti || (isMacchina ? "m" : "sl"),
                    quantita_conforme: qConf,
                    quantita_non_conforme: qKo,
                    chiusura_parziale: !isMacchina && getGroupRowChecked(key, "chiusura_parziale"),
                    data_registrazione: getGroupRowValue(key, "data_registrazione"),
                    include_time_line: getGroupRowCheckedDefault(key, "include_time_line", true),
                    lotti: workgroupCloseState.lottiByOrder[key] || []
                };
            });

            const partialFlags = orders.map(row => row.chiusura_parziale === true);
            if (partialFlags.some(Boolean) && !partialFlags.every(Boolean)) {
                showGroupCloseFeedback("La chiusura parziale del gruppo deve riguardare tutti gli ordini.");
                return;
            }

            const resp = await window.avpFetch("/api/ordini/gruppi/chiudi", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest"
                },
                credentials: "same-origin",
                body: JSON.stringify({group_uid: workgroupCloseState.groupUid, note: groupNote, orders})
            });

            const data = await resp.json();

            if (!resp.ok || data.ok === false) {
                showGroupCloseFeedback(data.error || "Errore durante la chiusura gruppo.");
                return;
            }

            const exportErrors = [];
            for (const row of (data.exports || [])) {
                const exportResult = await exportAvpTxt({
                    suffix: row.suffix || "officina",
                    outboxId: row.outbox_id
                });
                if (!exportResult.ok) {
                    exportErrors.push(exportResult.error || `Export non generato per ${row.outbox_id}.`);
                }
            }

            bootstrap.Modal.getOrCreateInstance(document.getElementById("modalWorkgroupClose")).hide();

            if (data.fragments && window.applyHomeFragments) {
                window.applyHomeFragments(data.fragments);
            }

            if (exportErrors.length) {
                alert(exportErrors.join("\n"));
            }
        }
    })();
</script>
<script>
    async function exportAvpTxt({suffix = "montaggio", outboxId} = {}) {
        if (!outboxId) {
            return {
                ok: false,
                error: "outbox_id mancante per la generazione del file ERP."
            };
        }

        try {
            const resp = await window.avpFetch("/api/erp/export/avp", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest"
                },
                credentials: "same-origin",
                body: JSON.stringify({
                    suffix,
                    outbox_id: outboxId
                })
            });

            let data = {};
            try {
                data = await resp.json();
            } catch (_) {
                data = {};
            }

            if (!resp.ok || data.ok === false) {
                return {
                    ok: false,
                    error: data.error || "Errore durante la generazione del file ERP."
                };
            }

            return {ok: true, data};
        } catch (err) {
            console.error("Errore export AVP:", err);
            return {
                ok: false,
                error: "Errore di comunicazione durante la generazione del file ERP."
            };
        }
    }
</script>