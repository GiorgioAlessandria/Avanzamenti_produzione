<!-- Presa in carico SL + MACCHINA (event delegation) -->
<script>
    function parseDistintaForActivation(raw) {
        if (!String(raw ?? "").trim()) {
            return [];
        }

        let parsed = raw;

        try {
            parsed = JSON.parse(parsed);
        } catch (_) {
            return [];
        }

        if (typeof parsed === "string") {
            try {
                parsed = JSON.parse(parsed);
            } catch (_) {
                return [];
            }
        }

        if (!Array.isArray(parsed)) {
            return [];
        }

        return parsed.filter(item => item && typeof item === "object");
    }

    function setActivationWarning(targetEl, message) {
        if (!targetEl) return;
        targetEl.textContent = message || "";
        targetEl.classList.toggle("d-none", !message);
    }

    function clearActivationWarning(targetEl) {
        if (!targetEl) return;
        targetEl.textContent = "";
        targetEl.classList.add("d-none");
    }

    function buildMissingDistintaMessage({ordine = "", codice = "", matricola = ""} = {}) {
        let msg =
            "Ordine bloccato: Distinta base dell'ordine mancante.\n" +
            "Segnalare il problema al responsabile indicando i riferimenti dell'ordine.";

        if (ordine) {
            msg += `\nOrdine: ${ordine}`;
        }
        if (codice) {
            msg += `\nCodice articolo: ${codice}`;
        }
        if (matricola) {
            msg += `\nMatricola: ${matricola}`;
        }

        return msg;
    }

    function validateActivationDistinta(rawValue, options = {}) {
        const distinta = parseDistintaForActivation(rawValue);

        if (distinta.length > 0) {
            clearActivationWarning(options.warningEl);
            return true;
        }

        const message = buildMissingDistintaMessage(options);
        setActivationWarning(options.warningEl, message);
        alert(message);
        return false;
    }
</script>
