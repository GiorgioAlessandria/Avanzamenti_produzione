{% set has_modifica_data_chiusura_permission = policy and policy.can('modifica_data_chiusura') %}
{% set has_export_senza_tempo_permission = policy and policy.can('export_avp_senza_riga_tempo') %}
{% set home_ui_texts = home_ui_texts|default({}, true) %}
<!--toast nuovo ordine in carico SL -->
<div class="toast lh-lg hide"
     role="alert"
     id="toast-1"
     style="width: max-content;height: max-content;position: fixed; top: 1rem; right: 1rem; z-index: 2000;opacity: 1;filter: blur(0px);">
    <div class="toast-header">
        <strong class="me-auto"
                style="font-size: 25px;">Presa in carico dell'ordine
            <span data-bind-text="ordine"></span></strong>
        <button class="btn-close ms-2 mb-1 close"
                type="button"
                aria-label="Close"
                data-bs-dismiss="toast"
                style="font-size: 25px;"></button>
    </div>
    <div class="toast-body d-flex flex-column justify-content-center align-items-center"
         role="alert"
         style="opacity: 1;width: auto;height: auto;">
        <input type="hidden"
               data-bind="iddocumento"
               id="toast-presa-iddocumento">
        <input type="hidden"
               data-bind="idriga"
               id="toast-presa-idriga">
        <input type="hidden"
               data-bind="ordine"
               id="toast-presa-ordine">
        <input type="hidden"
               data-bind="codice"
               id="toast-presa-codice">
        <input type="hidden"
               data-bind="quantita"
               id="toast-presa-quantita">
        <input type="hidden"
               data-bind="fase"
               id="toast-presa-fase">
        <input type="hidden"
               data-bind="numprogrriga"
               id="toast-presa-numprogrriga">
        <input type="hidden"
               data-bind="distinta"
               id="toast-presa-distinta">
        <div id="toast-presa-warning"
             class="alert alert-danger w-100 mt-3 mb-2 d-none"
             role="alert"
             style="font-size: 18px; white-space: pre-line;">
        </div>

        <button class="btn btn-lg btn-primary"
                type="button"
                id="btn-prendi-ordine"
                style="font-size: 25px;">
            Preso in carico
        </button>
    </div>
</div>

<!--toast presa in carico ordine MACCHINA -->
<div class="toast lh-lg hide"
     role="alert"
     id="toast-1-m"
     style="width: max-content;height: max-content;position: fixed; top: 1rem; right: 1rem; z-index: 2000;opacity: 1;filter: blur(0px);">
    <div class="toast-header">
        <strong class="me-auto"
                style="font-size: 25px;">{{ home_ui_texts.toast_presa_macchina or "Presa in carico ordine macchina" }}
            <span data-bind-text="ordine"></span></strong>
        <button class="btn-close ms-2 mb-1 close"
                type="button"
                aria-label="Close"
                data-bs-dismiss="toast"
                style="font-size: 25px;"></button>
    </div>
    <div class="toast-body d-flex flex-column justify-content-center align-items-center"
         role="alert"
         style="opacity: 1;width: auto;height: auto;">
        <input type="hidden"
               data-bind="iddocumento"
               id="toast-presa-m-iddocumento">
        <input type="hidden"
               data-bind="idriga"
               id="toast-presa-m-idriga">
        <input type="hidden"
               data-bind="ordine"
               id="toast-presa-m-ordine">
        <input type="hidden"
               data-bind="codice"
               id="toast-presa-m-codice">
        <input type="hidden"
               data-bind="matricola"
               id="toast-presa-m-matricola">
        <input type="hidden"
               data-bind="fase"
               id="toast-presa-m-fase">
        <input type="hidden"
               data-bind="numprogrriga"
               id="toast-presa-m-numprogrriga">
        <input type="hidden"
               data-bind="distinta"
               id="toast-presa-m-distinta">

        <table class="table table-sm table-borderless mb-2"
               style="font-size: 18px; max-width: 400px;">
            <tr>
                <td class="fw-semibold">Matricola:</td>
                <td><span data-bind-text="matricola"></span></td>
            </tr>
            <tr>
                <td class="fw-semibold">Fase:</td>
                <td><span data-bind-text="fase"></span></td>
            </tr>
        </table>
        <div id="toast-presa-m-warning"
             class="alert alert-danger w-100 mt-3 mb-2 d-none"
             role="alert"
             style="font-size: 18px; white-space: pre-line;">
        </div>

        <button class="btn btn-lg btn-primary"
                type="button"
                id="btn-prendi-ordine-m"
                style="font-size: 25px;">
            Preso in carico
        </button>
    </div>
</div>

<!--toast sospensione ordine -->
<div class="toast lh-lg hide"
     role="alert"
     id="toast-2"
     style="width: max-content;height: max-content;position: fixed; top: 1rem; right: 1rem; z-index: 2000;opacity: 1;filter: blur(0px);">
    <div class="toast-header">
        <strong class="me-auto"
                style="font-size: 25px;">Sospensione dell'ordine
            <span data-bind-text="ordine"></span></strong>
        <button class="btn-close ms-2 mb-1 close"
                type="button"
                aria-label="Close"
                data-bs-dismiss="toast"
                style="font-size: 25px;"></button>
    </div>
    <div class="toast-body d-flex flex-column justify-content-center align-items-center"
         role="alert"
         style="opacity: 1;width: auto;height: auto;">
        <form method="post">
            <input type="hidden"
                   data-bind="iddocumento"
                   id="toast-sosp-iddocumento">
            <input type="hidden"
                   data-bind="idriga"
                   id="toast-sosp-idriga">
            <input type="hidden"
                   data-bind="ordine"
                   id="toast-sosp-ordine">
            <input type="hidden"
                   data-bind="codice"
                   id="toast-sosp-codice">
            <input type="hidden"
                   data-bind="quantita"
                   id="toast-sosp-quantita">
            <input type="hidden"
                   data-bind="fase"
                   id="toast-sosp-fase">
            <input type="hidden"
                   data-bind="numprogrriga"
                   id="toast-sosp-numprogrriga">
            <label for="causale_attivita"
                   style="font-size: 20px;"> Inserire la causale della sospensione:<br>
                <select id="causale_attivita">
                    {% for causale in causali_attivita %}
                        <option value="{{ causale }}">{{ causale }}</option>
                    {% endfor %}
                </select>
            </label><br>
            <input class="btn btn-lg btn-primary"
                   type="submit"
                   id="btn-conferma-sospensione"
                   value="Conferma"
                   style="font-size: 25px;">
        </form>
    </div>
</div>
