<!--toast chiusura ordine SL -->
<div class="toast  fluid hide"
     role="alert"
     id="toast-4"
     style="width: max-content; max-width: 90vw;padding:8px; height: max-content;max-width: 70vw; position: fixed; top: 1rem; right: 1rem; z-index: 2000; opacity: 10000;">
    <div class="toast-header">
        <strong class="me-auto"
                style="font-size: 25px;">
            Chiusura dell'ordine
            <span data-bind-text="ordine"></span>
        </strong>
        <button class="btn-close ms-2 mb-1"
                type="button"
                aria-label="Close"
                data-bs-dismiss="toast"
                style="font-size: 25px;"></button>
    </div>
    <div class="toast-body d-flex flex-column justify-content-center align-items-center"
         role="alert"
         style="opacity: 1; height: auto; overflow-y: auto;">

        <!-- Hidden fields -->
        <input type="hidden"
               data-bind="iddocumento"
               id="toast-chiudi-sl-iddocumento">
        <input type="hidden"
               data-bind="quantitaTotale"
               id="toast-chiudi-sl-quantita-totale">
        <input type="hidden"
               data-bind="idriga"
               id="toast-chiudi-sl-idriga">
        <input type="hidden"
               data-bind="ordine"
               id="toast-chiudi-sl-ordine">
        <input type="hidden"
               data-bind="codice"
               id="toast-chiudi-sl-codice">
        <input type="hidden"
               data-bind="quantita"
               id="toast-chiudi-sl-quantita">
        <input type="hidden"
               data-bind="fase"
               id="toast-chiudi-sl-fase">
        <input type="hidden"
               data-bind="numprogrriga"
               id="toast-chiudi-sl-numprogrriga">
        <div class="container">
            <!-- Quantità conforme / non conforme -->
            <div class="row">
                <div class="col">
                    <label for="toast-chiudi-sl-quantita-conforme"
                           style="font-size: 20px;">
                        Quantità conforme:<br>
                        <input type="number"
                               id="toast-chiudi-sl-quantita-conforme"
                               min="0"
                               step="1"
                               required>
                    </label>
                </div>
                <div class="col">
                    <label for="toast-chiudi-sl-quantita-non-conforme"
                           style="font-size: 20px;">
                        Quantità KO:<br>
                        <input type="number"
                               id="toast-chiudi-sl-quantita-non-conforme"
                               min="0"
                               step="1"
                               required>
                    </label>
                </div>
            </div>

            <div class="row">
                <div class="col"
                     style="width: max-content">
                    <!-- Note -->
                    <label for="toast-chiudi-sl-note"
                           style="font-size: 20px; width: max-content">
                        Note:<br>
                        <textarea id="toast-chiudi-sl-note"
                                  rows="2"
                                  cols="100"></textarea>
                    </label>
                </div>
            </div>
            {% if has_modifica_data_chiusura_permission or has_export_senza_tempo_permission %}
                <div class="row mt-2 align-items-end">
                    {% if has_modifica_data_chiusura_permission %}
                        <div class="col">
                            <label for="toast-chiudi-sl-data-registrazione"
                                   style="font-size: 20px;">
                                Data registrazione:<br>
                                <input type="date"
                                       id="toast-chiudi-sl-data-registrazione"
                                       class="form-control">
                            </label>
                        </div>
                    {% endif %}

                    {% if has_export_senza_tempo_permission %}
                        <div class="col">
                            <div class="form-check"
                                 style="font-size: 20px;">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="toast-chiudi-sl-include-time-line"
                                       checked>
                                <label class="form-check-label"
                                       for="toast-chiudi-sl-include-time-line">
                                    Inserisci tempo nel file ERP
                                </label>
                            </div>
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        </div>
        <!-- Sezione Lotti (nascosta di default) -->
        <div id="lotti-section-sl"
             style="display: none; width: 100%; padding:10px; font-size: 20px">
            <h5 class="text-center mb-2">Assegnazione Lotti Materiale</h5>

            <div id="lotti-loading-sl"
                 class="text-center my-2"
                 style="display: none;">
                <div class="spinner-border spinner-border-sm"
                     role="status"></div>
                <span class="ms-2">Caricamento lotti...</span>
            </div>

            <div id="lotti-alert-sl"
                 class="alert alert-danger mb-2"
                 style="display: none; font-size: 14px; white-space: pre-line;"></div>

            <div class="table-responsive"
                 style="max-height: 350px; overflow-y: auto;">
                <table class="table table-sm table-bordered align-middle mb-1"
                       id="tbl-lotti-sl"
                       style="font-size: 20px">
                    <thead class="table-light"
                           style="position: sticky; top: 0; z-index: 1;">
                    <tr>
                        <th style="min-width: 140px;">Codice</th>
                        <th style="min-width: 180px;">Descrizione</th>
                        <th style="min-width: 160px;">Lotto</th>
                        <th style="min-width: 80px;"
                            class="text-end">Giacenza
                        </th>
                        <th style="min-width: 100px;"
                            class="text-end">Qtà utilizzata
                        </th>
                        <th style="min-width: 70px;">Ok/Ko</th>
                        <th style="width: 70px;"></th>
                    </tr>
                    </thead>
                    <tbody id="tbody-lotti-sl"
                           style="font-size: 20px"></tbody>
                </table>
            </div>

            <div id="lotti-riepilogo-sl"
                 class="mt-2 mb-2"
                 style="font-size: 20px; padding: 8px; border-radius: 4px;">
            </div>
        </div>
        <div class="container-sm"
             style="padding:15px">
            <div class="row">
                <div class="form-check mt-1 mb-1 col"
                     style="font-size: 20px; border-radius: 4px;">
                    <input class="form-check-input"
                           type="checkbox"
                           id="toast-chiudi-sl-parziale">
                    <label class="form-check-label"
                           for="toast-chiudi-sl-parziale">
                        Chiusura parziale ordine
                    </label>
                </div>
                <div class="form-check mt-1 mb-1 col"
                     style="font-size: 20px; border-radius: 4px;">
                    <input class="form-check-input"
                           type="checkbox"
                           id="toast-chiudi-sl-totale">
                    <label class="form-check-label"
                           for="toast-chiudi-sl-totale">
                        Chiusura totale ordine
                    </label>
                </div>
            </div>
        </div>
        <br>
        <div>
            <button class="btn btn-lg btn-primary mt-2"
                    type="button"
                    id="btn-conferma-chiusura-sl"
                    style="font-size: 22px;">
                Conferma
            </button>
        </div>
    </div>
</div>

