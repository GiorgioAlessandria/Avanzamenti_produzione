<!-- Stato bottoni SL / Macchina -->
<script>
    function getStatoOrdine(row) {
        if (!row) return "";
        if (row.dataset?.stato) return row.dataset.stato.trim();
        const statoCell = row.querySelector('td[data-col="stato"]');
        if (statoCell) return statoCell.textContent.trim();
        return "";
    }

    function aggiornaBottoniOrdine(row, btnSospensioneId, btnRiattivazioneId) {
        const btnSospensione = document.getElementById(btnSospensioneId);
        const btnRiattivazione = document.getElementById(btnRiattivazioneId);
        if (!btnSospensione || !btnRiattivazione) return;

        const stato = getStatoOrdine(row);
        btnSospensione.disabled = true;
        btnRiattivazione.disabled = true;

        if (stato === "Attivo") {
            btnSospensione.disabled = false;
        } else if (stato === "In Sospeso") {
            btnRiattivazione.disabled = false;
        }
    }

    const tabellaSl = document.getElementById("ordini_in_corso_sl");
    if (tabellaSl) {
        tabellaSl.addEventListener("click", function (event) {
            const row = event.target.closest("tbody tr");
            if (!row) return;
            aggiornaBottoniOrdine(row, "sospensione_ordine_sl", "riattivazione_ordine_sl");
        });
    }

    const tabellaM = document.getElementById("ordini_in_corso_m");
    if (tabellaM) {
        tabellaM.addEventListener("click", function (event) {
            const row = event.target.closest("tbody tr");
            if (!row) return;
            aggiornaBottoniOrdine(row, "sospensione_ordine_m", "riattivazione_ordine_m");
        });
    }
</script>
<script>
    (() => {
        const modalEl = document.getElementById("modalMetodoMontaggio");
        if (!modalEl) return;

        const frameEl = modalEl.querySelector("#modal-metodo-montaggio-frame");
        const codArtEl = modalEl.querySelector("#modal-metodo-montaggio-codart");
        const fallbackEl = modalEl.querySelector("#modal-metodo-montaggio-fallback");
        const openEl = modalEl.querySelector("#modal-metodo-montaggio-open");

        if (!modalEl || !frameEl || !codArtEl || !fallbackEl || !openEl) return;

        modalEl.addEventListener("show.bs.modal", function (event) {
            const trigger = event.relatedTarget;
            if (!trigger) return;

            const pdfUrl = trigger.getAttribute("data-pdf-url") || "";
            const codArt = trigger.getAttribute("data-codart") || "";

            codArtEl.textContent = codArt ? `- ${codArt}` : "";
            openEl.href = pdfUrl || "#";
            fallbackEl.classList.add("d-none");

            if (!pdfUrl) {
                frameEl.src = "about:blank";
                fallbackEl.classList.remove("d-none");
                return;
            }

            frameEl.src = pdfUrl;
        });

        frameEl.addEventListener("error", function () {
