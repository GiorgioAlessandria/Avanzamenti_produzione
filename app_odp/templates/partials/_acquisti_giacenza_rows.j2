{% set show_decimal_control = giacenze_rows|selectattr("HasMagazziniDecimaliNonValidi")|list|length %}
{% if giacenze_rows %}
    {% for row in giacenze_rows %}
        {% set mag0 = row.Mag_0 if row.Mag_0 is not none else 0 %}
        {% set punto_riordino = row.PuntoRiordino if row.PuntoRiordino is not none else 0 %}
        {% set is_negative_mag0 = mag0 < 0 %}
        {% set is_understock_mag0 = (not is_negative_mag0) and (mag0 < punto_riordino) %}

        <tr data-row-key="{{ [row.CodArt or '', row.VarianteArt or '', row.IndiceModifica or '']|join('|')|e }}"
            data-codart="{{ row.CodArt or '' }}"
            data-desart="{{ row.DesArt or '' }}"
            data-variante="{{ row.VarianteArt or '' }}"
            data-revisione="{{ row.IndiceModifica or '' }}"

            data-negative="{{ '1' if is_negative_mag0 else '0' }}"
            data-understock="{{ '1' if is_understock_mag0 else '0' }}"
            data-decimal-control="{{ '1' if row.HasMagazziniDecimaliNonValidi else '0' }}">
            <td>{{ row.CodArt or '' }}</td>
            <td>{{ row.VarianteArt or '' }}</td>
            <td>{{ row.IndiceModifica or '' }}</td>
            <td>{{ row.DesArt or '' }}</td>
            <td>{{ row.MagUM or '' }}</td>
            <td class="js-acq-decimal-control-col{% if not show_decimal_control %} d-none{% endif %}{% if row.HasMagazziniDecimaliNonValidi %} text-danger fw-semibold{% endif %}"
                title="{{ row.MagazziniDecimaliNonValidiText or '' }}">
                {{ row.MagazziniDecimaliNonValidiText or '' }}
            </td>
            <td class="{% if row.Mag_6 < 0 %}text-danger fw-bold{% endif %}">
                {{ row.Mag_6 }}
            </td>
            <td class="{% if is_negative_mag0 %}fw-bold{% endif %}">
                {{ row.Mag_0 }}
            </td>
            <td class="{% if row.Mag_10 < 0 %}text-danger fw-bold{% endif %}">
                {{ row.Mag_10 }}
            </td>
            <td class="{% if row.Mag_11 < 0 %}text-danger fw-bold{% endif %}">
                {{ row.Mag_11 }}
            </td>
            <td class="{% if row.Mag_12 < 0 %}text-danger fw-bold{% endif %}">
                {{ row.Mag_12 }}
            </td>

            <td class="{% if row.Mag_13 < 0 %}text-danger fw-bold{% endif %}">
                {{ row.Mag_13 }}
            </td>

            <td>{{ row.PuntoRiordino }}</td>
            <td>{{ row.LottoRiordino }}</td>
            <td>{{ row.PianTempoApprovFisso }}</td>
            <td>{{ row.DataPrevistaApprovvigionamento or '' }}</td>
        </tr>
    {% endfor %}
{% else %}
    <tr data-empty="1">
        <td colspan="{{ 16 if show_decimal_control else 15 }}"
            class="text-center text-muted py-4">
            Nessuna giacenza disponibile.
        </td>
    </tr>
{% endif %}