{% from 'partials/_home_workgroup_links.j2' import order_link, code_link with context %}
{% from 'partials/_table_text.j2' import wrap_plus %}
{% autoescape lct_home|default(false) %}
{% for singolo_odp in odp %}
    {% if singolo_odp.IsWorkGroup|default(false) and singolo_odp.StatoOrdine != "Pianificata" and singolo_odp.StatoOrdine != "Chiusa" %}
        {% set group_type_display = singolo_odp.WorkGroupDisplayType|default(singolo_odp.WorkGroupType) %}
        {% set group_type_label = singolo_odp.WorkGroupTypeLabel|default("Multiplo" if singolo_odp.WorkGroupType == "MULTIPLO" else "Mascherato") %}
        {% set group_badge_class = "bg-info text-dark" if group_type_display == "MISTO" else ("bg-primary" if singolo_odp.WorkGroupType == "MULTIPLO" else "bg-dark") %}
        {% set pr = singolo_odp.PrioritaNumero|default('') %}
        <tr class="workgroup-row table-info border-start border-4"
            data-row-key="GROUP|{{ singolo_odp.WorkGroupUid }}"
            data-is-work-group="1"
            data-group-uid="{{ singolo_odp.WorkGroupUid }}"
            data-group-type="{{ group_type_display }}"
            data-group-label="{{ singolo_odp.OrdineVisuale|e }}"
            data-group-detail="{{ singolo_odp.DettaglioGruppoVisuale|tojson|forceescape }}"
            data-statoordine="{{ singolo_odp.WorkGroupStatus }}"
            data-stato="{{ singolo_odp.WorkGroupStatus }}"
            data-priorita="{{ pr or '' }}"
            data-iddocumento="GROUP:{{ singolo_odp.WorkGroupUid }}"
            data-idriga="GROUP"
            data-numprogrriga=""
            data-variante=""
            data-ordine="{{ singolo_odp.OrdineVisuale }}"
            data-codice="{{ singolo_odp.CodiciVisuale }}"
            data-indicemodifica=""
            data-descrizione="{{ singolo_odp.DesArt }}"
            data-quantita="{{ singolo_odp.Quantita }}"
            data-quantita-totale="{{ singolo_odp.Quantita }}"
            data-fase="{{ singolo_odp.FaseAttiva|default('') }}"
            data-datacons="{{ singolo_odp.DataFineSched }}"
            data-risorsaprod="{{ singolo_odp.CodRisorsaProd }}"
            data-tempoattrezzaggio=""
            data-operatore="{{ singolo_odp.OperatoreUsername|default('') }}">
            <td class="pr-cell fw-bold text-center">{{ wrap_plus(pr or '') }}</td>
            <td class="text-start">
                <button type="button"
                        class="btn btn-sm btn-outline-dark me-1 js-open-workgroup-detail-modal"
                        data-group-uid="{{ singolo_odp.WorkGroupUid }}"
                        data-group-type="{{ group_type_display }}"
                        data-group-label="{{ singolo_odp.OrdineVisuale|e }}"
                        data-group-detail="{{ singolo_odp.DettaglioGruppoVisuale|tojson|forceescape }}"
                        title="Apri dettaglio gruppo">
                    Dettaglio
                </button>
                <span class="badge {{ group_badge_class }} me-1">{{ wrap_plus(group_type_label) }}</span>
                <div class="wg-order-links">
                    {% for member_order in singolo_odp.WorkGroupOrdini %}
                        <div>{{ order_link(member_order) }}</div>
                    {% endfor %}
                </div>
                <div class="small text-muted">{{ wrap_plus(singolo_odp.WorkGroupUid) }}</div>
            </td>
            <td>
                {% for member_order in singolo_odp.WorkGroupOrdini %}
                    <div>{{ code_link(member_order, metodo_montaggio_lookup|default(metodo_lookup|default({})), '' if metodo_montaggio_lookup is defined else metodo_documentale_prefisso|default('', true)) }}</div>
                {% endfor %}
            </td>
            <td></td>
            <td></td>
            <td class="text-start">
                {% include 'partials/_home_workgroup_members.j2' %}
            </td>
            <td><span class="small text-muted">Per ordine</span></td>
            <td>{{ wrap_plus(singolo_odp.DataFineSched | db_date("%Y-%m-%d %H:%M:%S","%d/%m/%Y")) }}</td>
            <td></td>
            <td>{{ wrap_plus(singolo_odp.CodRisorsaProd) }}</td>
            <td data-col="stato">{{ singolo_odp.WorkGroupStatus|e }}</td>
            <td>{{ wrap_plus(singolo_odp.OperatoreUsername|default('-') or '-') }}</td>
        </tr>
    {% elif singolo_odp.StatoOrdine != "Pianificata" and singolo_odp.StatoOrdine != "Chiusa" %}
        {% set operatore = singolo_odp.runtime_row.Utente_operazione if singolo_odp.runtime_row else "" %}
        {% set runtime = singolo_odp.runtime_row %}
        {% set pr_raw = singolo_odp.PrioritaNumero|default(none) %}
        {% set pr_runtime = runtime.PrioritaInCarico if runtime else none %}
        {% set pr_value = pr_raw if pr_raw else pr_runtime %}
        {% set pr = pr_value|int if pr_value else none %}
        {% set stato_norm = singolo_odp.StatoOrdine|string|lower %}
        {% set stato_class = 'table-success'
                if 'attiv' in stato_norm else 'table-warning'
                if 'sospes' in stato_norm else'' %}
        {% set rev = singolo_odp.IndiceModifica %}
        {% set rev_pdf = rev|string|trim if rev is not none else "" %}
        {% set rev_pdf = "" if rev_pdf == "-" or rev_pdf|upper == "X" else rev_pdf %}
        {% set metodo_key = singolo_odp.CodArt ~ ('.' ~ rev_pdf if rev_pdf else '') %}
        {% set metodo_doc = metodo_montaggio_lookup.get(metodo_key) if metodo_montaggio_lookup is defined and metodo_key else none %}
        {% set ordine_display = ordine_ref_display(singolo_odp) %}
        {% set lct_group = singolo_odp.LctGroup|default(none) if lct_home|default(false) else none %}
        <tr class="{{ stato_class }}"
            {% if lct_group %}
                data-is-work-group="1"
                data-group-uid="{{ lct_group.WorkGroupUid }}"
                data-group-type="{{ lct_group.WorkGroupDisplayType }}"
                data-group-label="{{ lct_group.OrdineVisuale }}"
                data-group-detail="{{ lct_group.DettaglioGruppoVisuale|tojson|forceescape }}"
            {% endif %}
            data-row-key="{{ singolo_odp.IdDocumento }}|{{ singolo_odp.NumProgrRiga }}"
            data-priorita="{{ pr or '' }}"
            data-iddocumento="{{ lct_group.IdDocumento if lct_group else singolo_odp.IdDocumento }}"
            data-numprogrriga="{{ singolo_odp.NumProgrRiga }}"
            data-idriga="{{ lct_group.IdRiga if lct_group else singolo_odp.IdRiga }}"
            data-variante="{{ singolo_odp.VarianteArt }}"
            data-ordine="{{ ordine_display }}"
            data-codice="{{ singolo_odp.CodArt }}"
            data-indicemodifica="{{ singolo_odp.IndiceModifica }}"
            data-descrizione="{{ singolo_odp.DesArt }}"
            data-quantita="{{ singolo_odp.QtyDaLavorare or singolo_odp.Quantita }}"
            data-quantita-totale="{{ singolo_odp.Quantita }}"
            data-fase="{{ singolo_odp.FaseAttiva }}"
            data-datacons="{{ singolo_odp.DataFineSched }}"
            data-risorsaprod="{{ singolo_odp.RisorsaAttiva }}"
            data-tempoattrezzaggio="{{ singolo_odp.AttrezzaggioAttivo }}"
            data-statoordine="{{ singolo_odp.StatoOrdine }}"
            data-operatore="{{ operatore }}">
            <td class="pr-cell fw-bold text-center">{{ wrap_plus(pr or "") }}</td>
            <td>
                <button
                        type="button"
                        class="btn btn-link p-0 text-decoration-none open-materiali-modal"
                        data-codart="{{ singolo_odp.CodArt|e }}"
                        data-variante="{{ singolo_odp.VarianteArt|e }}"
                        data-fase-attiva="{{ singolo_odp.FaseAttiva }}"
                        data-distinta='{{ singolo_odp.DistintaMateriale|tojson }}'>
                    {{ wrap_plus(ordine_display) }}
                </button>
            </td>
            {% set rev = singolo_odp.IndiceModifica %}
            {% set rev_pdf = rev|string|trim if rev is not none else "" %}
            {% set rev_pdf = "" if rev_pdf == "-" or rev_pdf|upper == "X" else rev_pdf %}
            {% set metodo_key = singolo_odp.CodArt ~ ('.' ~ rev_pdf if rev_pdf else '') %}
            {% set metodo_doc = metodo_montaggio_lookup.get(metodo_key) if metodo_montaggio_lookup is defined and metodo_key else none %}

            <td>
                {% if metodo_doc and metodo_doc.found %}
                    <button type="button"
                            class="btn btn-link p-0 text-decoration-none"
                            data-bs-toggle="modal"
                            data-bs-target="#modalMetodoMontaggio"
                            data-codart="{{ singolo_odp.CodArt|e }}"
                            data-pdf-url="{{ metodo_doc.url }}">
                        {{ wrap_plus(singolo_odp.CodArt) }}
                    </button>
                {% else %}
                    <span class="text-danger">{{ wrap_plus(singolo_odp.CodArt) }}</span>
                {% endif %}
            </td>
            <td>{{ wrap_plus("-" if rev is none or (rev|string|trim|upper) == "X" else rev) }}</td>
            <td>{{ wrap_plus(singolo_odp.VarianteArt) }}</td>
            <td>{{ wrap_plus(singolo_odp.DesArt) }}</td>
            <td>{{ wrap_plus(singolo_odp.QtyDaLavorare or singolo_odp.Quantita) }}</td>
            <td>{{ wrap_plus(singolo_odp.DataFineSched | db_date("%Y-%m-%d %H:%M:%S","%d/%m/%Y")) }}</td>
            <td>{{ wrap_plus(singolo_odp.AttrezzaggioAttivo) }}</td>
            <td>{{ wrap_plus(singolo_odp.RisorsaAttiva) }}</td>
            <td data-col="stato">{{ wrap_plus(singolo_odp.StatoOrdine) }}
                {% if lct_home|default(false) and singolo_odp.StatoOrdine == 'Attivo' %}
                    <span class="badge text-bg-secondary">{{ singolo_odp.LctMode|default('Principale' if singolo_odp.FaseAttiva|int == 1 else 'Singolo') }}</span>
                {% endif %}
            </td>
            <td>{{ wrap_plus(operatore or "-") }}</td>
            {% if lct_home|default(false) %}{% include 'partials/_home_lct_actions.j2' %}{% endif %}
        </tr>
    {% endif %}
{% endfor %}
{% endautoescape %}
