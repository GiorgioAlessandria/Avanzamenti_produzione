{% extends "base.j2" %}

{% block title %}Vendite{% endblock %}

{% block styles %}
    {{ super() }}
    <style>
        #vendite-page .vendite-model-column {
            min-width: 220px;
        }

        #vendite-page .vendite-note-column {
            min-width: 260px;
            white-space: normal;
        }

        #vendite-page .vendite-summary-table th:not(:first-child),
        #vendite-page .vendite-summary-table td:not(:first-child) {
            text-align: center;
            vertical-align: middle;
        }

        #vendite-page .vendite-summary-table thead tr:first-child th {
            border-bottom-width: 1px;
        }

        #vendite-page .vendite-summary-table .vendite-count {
            min-width: 72px;
            font-size: 1.35rem;
            font-weight: 700;
        }

        #vendite-page .vendite-summary-table .vendite-count-positive {
            color: #fff;
            background-color: #495057 !important;
            box-shadow: inset 0 0 0 9999px #495057 !important;
        }

        #vendite-page .vendite-summary-table .vendite-count-empty {
            color: #adb5bd;
        }
    </style>
{% endblock %}

{% block content %}
    <main class="container-fluid py-3"
          id="vendite-page"
          data-api-url="{{ operator_url_for('main.api_vendite_ordini_macchina') }}"
          data-note-url="{{ operator_url_for('main.api_vendite_macchina_note_produzione') }}"
          data-can-edit-production-notes="{{ 'true' if can_edit_production_notes else 'false' }}">
        <div class="d-flex flex-wrap justify-content-end align-items-center gap-3 mb-3">
            <div class="d-flex flex-wrap gap-2">
                <button type="button"
                        class="btn btn-outline-primary btn-sm"
                        id="vendite-refresh">
                    Aggiorna ora
                </button>
            </div>
        </div>

        <div class="alert alert-danger d-none"
             id="vendite-error"
             role="alert"></div>

        <ul class="nav nav-tabs"
            id="vendite-tabs"
            role="tablist">
            <li class="nav-item"
                role="presentation">
                <a class="nav-link"
                   href="{{ operator_url_for('main.vendite_assegnazioni_page', vista='ordini') }}">
                    Ordini cliente
                </a>
            </li>
            <li class="nav-item"
                role="presentation">
                <a class="nav-link"
                   href="{{ operator_url_for('main.vendite_assegnazioni_page', vista='imballaggio') }}">
                    Note di imballaggio
                </a>
            </li>
            <li class="nav-item"
                role="presentation">
                <button class="nav-link{{ ' active' if request.args.get('vista', 'modello') == 'modello' else '' }}"
                        id="vendite-modelli-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#vendite-modelli-pane"
                        type="button"
                        role="tab"
                        aria-controls="vendite-modelli-pane"
                        aria-selected="{{ 'true' if request.args.get('vista', 'modello') == 'modello' else 'false' }}">
                    Situazione produzione per modello
                </button>
            </li>
            <li class="nav-item"
                role="presentation">
                <button class="nav-link{{ ' active' if request.args.get('vista') == 'matricola' else '' }}"
                        id="vendite-matricole-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#vendite-matricole-pane"
                        type="button"
                        role="tab"
                        aria-controls="vendite-matricole-pane"
                        aria-selected="{{ 'true' if request.args.get('vista') == 'matricola' else 'false' }}">
                    Situazione produzione per matricola
                </button>
            </li>
        </ul>

        <div class="tab-content border border-top-0 rounded-bottom bg-white shadow-sm"
             id="vendite-tab-content">
            <section class="tab-pane fade{{ ' show active' if request.args.get('vista', 'modello') == 'modello' else '' }}"
                     id="vendite-modelli-pane"
                     role="tabpanel"
                     aria-labelledby="vendite-modelli-tab"
                     tabindex="0">
                <div class="p-3 border-bottom">
                    <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2">
                        <h2 class="h6 mb-1">Riepilogo per modello macchina</h2>
                        <div class="d-flex flex-wrap gap-3 small text-muted">
                            <span data-vendite-status role="status" aria-live="polite">Caricamento...</span>
                            <span>Aggiornamento automatico ogni 5 secondi</span>
                        </div>
                    </div>
                    <div class="small text-muted">
                        Numero di macchine per fase e stato di produzione
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0 vendite-summary-table">
                        <thead class="table-light"
                               id="vendite-summary-head"></thead>
                        <tbody id="vendite-summary-body">
                        <tr>
                            <td class="text-center text-muted py-4">Caricamento...</td>
                        </tr>
                        </tbody>
                        <tfoot class="table-light fw-semibold"
                               id="vendite-summary-foot"></tfoot>
                    </table>
                </div>
            </section>

            <section class="tab-pane fade{{ ' show active' if request.args.get('vista') == 'matricola' else '' }}"
                     id="vendite-matricole-pane"
                     role="tabpanel"
                     aria-labelledby="vendite-matricole-tab"
                     tabindex="0">
                <div class="p-3 border-bottom">
                    <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2">
                        <h2 class="h6 mb-1">Dettaglio per matricola</h2>
                        <div class="d-flex flex-wrap gap-3 small text-muted">
                            <span data-vendite-status role="status" aria-live="polite">Caricamento...</span>
                            <span>Aggiornamento automatico ogni 5 secondi</span>
                        </div>
                    </div>
                    <div class="small text-muted">
                        Fase, stato e ultima causale di sospensione per ogni macchina
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-sortable table-state-rowcolor align-middle mb-0">
                        <thead class="table-light">
                        <tr>
                            <th class="vendite-model-column"
                                data-sort="text">Modello</th>
                            <th data-sort="text">Matricola</th>
                            <th data-sort="text">Ordine produzione</th>
                            <th data-sort="text">Ordine cliente</th>
                            <th data-sort="num">Fase</th>
                            <th data-sort="text">Stato</th>
                            <th class="vendite-note-column"
                                data-sort="text">Note / ultima causale di sospensione</th>
                            <th class="vendite-note-column"
                                data-sort="text">Note di produzione</th>
                        </tr>
                        </thead>
                        <tbody id="vendite-machines-body">
                        <tr>
                            <td colspan="8"
                                class="text-center text-muted py-4">Caricamento...</td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>
{% endblock %}

{% block extra_js %}
    {{ super() }}
    <script>
        (function () {
            const page = document.getElementById("vendite-page");
            if (!page) return;

            const POLL_MS = 5000;
            const refreshButton = document.getElementById("vendite-refresh");
            const statusElements = page.querySelectorAll("[data-vendite-status]");
            const canEditNotes = page.dataset.canEditProductionNotes === "true";
            const errorElement = document.getElementById("vendite-error");
            const summaryHead = document.getElementById("vendite-summary-head");
            const summaryBody = document.getElementById("vendite-summary-body");
            const summaryFoot = document.getElementById("vendite-summary-foot");
            const machinesBody = document.getElementById("vendite-machines-body");
            let inFlight = false;
            let savingNote = false;
            let noteRevision = 0;

            function setStatus(message) {
                statusElements.forEach(element => element.textContent = message);
            }

            function hasUnsavedNotes() {
                return Array.from(machinesBody.querySelectorAll("[data-production-note]"))
                    .some(field => field.value !== field.dataset.originalValue);
            }

            function editingNotes() {
                return savingNote || hasUnsavedNotes()
                    || Boolean(document.activeElement?.matches("[data-production-note]"));
            }

            function esc(value) {
                return String(value ?? "").replace(/[&<>"']/g, char => ({
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#39;",
                }[char]));
            }

            function modelLabel(row) {
                const variant = row.variant
                    ? ` <span class="badge text-bg-light border">${esc(row.variant)}</span>`
                    : "";
                const description = row.description
                    ? `<div class="small text-muted">${esc(row.description)}</div>`
                    : "";
                return `<div class="fw-semibold">${esc(row.model_code)}${variant}</div>${description}`;
            }

            function stateBadge(state) {
                const classes = {
                    "Attivo": "text-bg-success",
                    "In Sospeso": "text-bg-warning",
                    "Pianificata": "text-bg-secondary",
                };
                return `<span class="badge ${classes[state] || "text-bg-info"}">${esc(state)}</span>`;
            }

            function countCell(value) {
                const count = Number(value || 0);
                const positiveClass = count > 0
                    ? "vendite-count-positive"
                    : "vendite-count-empty";
                return `<td class="vendite-count ${positiveClass}">${count || "-"}</td>`;
            }

            function renderSummary(data) {
                const columns = Array.isArray(data.columns) ? data.columns : [];
                const models = Array.isArray(data.models) ? data.models : [];

                if (!columns.length) {
                    summaryHead.innerHTML = `
                        <tr>
                            <th class="vendite-model-column">Modello</th>
                            <th>Totale</th>
                        </tr>`;
                    summaryBody.innerHTML = `
                        <tr>
                            <td colspan="2" class="text-center text-muted py-4">
                                Nessun ordine macchina presente.
                            </td>
                        </tr>`;
                    summaryFoot.innerHTML = "";
                    return;
                }

                const phaseGroups = [];
                columns.forEach(column => {
                    const previous = phaseGroups[phaseGroups.length - 1];
                    if (previous && previous.phase === column.phase) {
                        previous.count += 1;
                    } else {
                        phaseGroups.push({phase: column.phase, count: 1});
                    }
                });

                summaryHead.innerHTML = `
                    <tr>
                        <th class="vendite-model-column" rowspan="2">Modello</th>
                        ${phaseGroups.map(group => `
                            <th colspan="${group.count}">Fase ${esc(group.phase)}</th>
                        `).join("")}
                        <th rowspan="2">Totale</th>
                    </tr>
                    <tr>
                        ${columns.map(column => `<th>${esc(column.state)}</th>`).join("")}
                    </tr>`;

                summaryBody.innerHTML = models.map(model => `
                    <tr>
                        <td>${modelLabel(model)}</td>
                        ${(model.counts || []).map(countCell).join("")}
                        ${countCell(model.total)}
                    </tr>
                `).join("");

                const columnTotals = columns.map((_, index) => models.reduce(
                    (total, model) => total + Number((model.counts || [])[index] || 0),
                    0
                ));
                summaryFoot.innerHTML = `
                    <tr>
                        <td>Totale produzione</td>
                        ${columnTotals.map(countCell).join("")}
                        ${countCell(data.total_machines)}
                    </tr>`;
            }

            function productionNoteCell(machine) {
                const note = machine.production_note || "";
                if (!canEditNotes || !machine.has_serial) {
                    return `<div style="white-space: pre-wrap">${esc(note || "—")}</div>`;
                }
                return `
                    <textarea class="form-control form-control-sm" rows="2" maxlength="1000"
                              data-production-note data-original-value="${esc(note)}"
                              data-id-documento="${esc(machine.id_documento)}"
                              data-id-riga="${esc(machine.id_riga)}"
                              data-serial="${esc(machine.serial_number)}"
                              data-version="${esc(machine.production_note_version)}"
                              aria-label="Note di produzione matricola ${esc(machine.serial_number)}">${esc(note)}</textarea>
                    <div class="d-flex gap-2 mt-1">
                        <button type="button" class="btn btn-primary btn-sm" data-save-production-note>Salva</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-cancel-production-note>Annulla</button>
                    </div>`;
            }

            function renderMachines(data) {
                const machines = Array.isArray(data.machines) ? data.machines : [];
                if (!machines.length) {
                    machinesBody.innerHTML = `
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                Nessun ordine macchina presente.
                            </td>
                        </tr>`;
                    return;
                }

                machinesBody.innerHTML = machines.map(machine => `
                    <tr>
                        <td>${modelLabel(machine)}</td>
                        <td class="fw-semibold">${esc(machine.serial_number)}</td>
                        <td>${esc(machine.order)}</td>
                        <td>${esc(machine.customer_order || "—")}</td>
                        <td>${esc(machine.phase)}</td>
                        <td data-col="stato">${stateBadge(machine.state)}</td>
                        <td class="vendite-note-column">${esc(machine.last_suspension_cause || "—")}</td>
                        <td class="vendite-note-column">${productionNoteCell(machine)}</td>
                    </tr>
                `).join("");

                if (typeof window.applyRowColors === "function") {
                    window.applyRowColors();
                }
            }

            function formatUpdateTime(value) {
                const date = new Date(value);
                if (Number.isNaN(date.getTime())) return String(value || "");
                return new Intl.DateTimeFormat("it-IT", {
                    dateStyle: "short",
                    timeStyle: "medium",
                }).format(date);
            }

            function render(data) {
                renderSummary(data);
                renderMachines(data);
                setStatus(`Ultimo aggiornamento: ${formatUpdateTime(data.generated_at)}`);
            }

            async function refresh() {
                if (inFlight || editingNotes()) return;
                const revision = noteRevision;
                inFlight = true;
                refreshButton.disabled = true;
                setStatus("Aggiornamento in corso...");

                try {
                    const response = await window.avpFetch(page.dataset.apiUrl);
                    const payload = await response.json().catch(() => ({}));
                    if (!response.ok || !payload.ok) {
                        throw new Error(payload.error || `Errore server (${response.status})`);
                    }

                    // La richiesta può essere partita prima che l'utente inizi a scrivere.
                    if (editingNotes() || revision !== noteRevision) return;
                    render(payload.data || {});
                    errorElement.classList.add("d-none");
                    errorElement.textContent = "";
                } catch (error) {
                    console.error("Errore aggiornamento vendite:", error);
                    errorElement.textContent = "Impossibile aggiornare i dati vendite. Riprovo automaticamente.";
                    errorElement.classList.remove("d-none");
                    setStatus("Aggiornamento non riuscito");
                } finally {
                    inFlight = false;
                    refreshButton.disabled = false;
                }
            }

            machinesBody.addEventListener("click", async event => {
                const save = event.target.closest("[data-save-production-note]");
                const cancel = event.target.closest("[data-cancel-production-note]");
                if ((!save && !cancel) || savingNote || !canEditNotes) return;
                const cell = (save || cancel).closest("td");
                const field = cell.querySelector("[data-production-note]");
                if (cancel) {
                    field.value = field.dataset.originalValue;
                    await refresh();
                    return;
                }
                savingNote = true;
                noteRevision += 1;
                field.disabled = true;
                save.disabled = true;
                try {
                    const response = await window.avpFetch(page.dataset.noteUrl, {
                        method: "POST",
                        headers: {"Content-Type": "application/json"},
                        body: JSON.stringify({
                            id_documento: field.dataset.idDocumento,
                            id_riga: field.dataset.idRiga,
                            serial_number: field.dataset.serial,
                            version: Number(field.dataset.version),
                            production_note: field.value,
                        }),
                    });
                    const payload = await response.json().catch(() => ({}));
                    if (!response.ok || !payload.ok) {
                        throw new Error(payload.error || `Errore server (${response.status})`);
                    }
                    const saved = (payload.data?.machines || []).find(machine =>
                        machine.serial_number === field.dataset.serial
                    );
                    if (!saved) throw new Error("Nota salvata, ma la matricola non è più nella vista. Ricaricare i dati.");
                    field.value = saved.production_note || "";
                    field.dataset.originalValue = field.value;
                    field.dataset.version = saved.production_note_version;
                    errorElement.classList.add("d-none");
                    setStatus("Note di produzione salvate.");
                } catch (error) {
                    errorElement.textContent = error.message || "Impossibile salvare le note.";
                    errorElement.classList.remove("d-none");
                } finally {
                    savingNote = false;
                    field.disabled = false;
                    save.disabled = false;
                }
            });

            machinesBody.addEventListener("input", event => {
                if (event.target.matches("[data-production-note]")) {
                    setStatus("Modifiche non salvate: salvare o annullare per riprendere l'aggiornamento.");
                }
            });
            window.addEventListener("beforeunload", event => {
                if (savingNote || hasUnsavedNotes()) {
                    event.preventDefault();
                    event.returnValue = "";
                }
            });

            refreshButton.addEventListener("click", () => {
                if (editingNotes()) {
                    setStatus("Salvare o annullare le note prima di aggiornare.");
                } else {
                    refresh();
                }
            });
            document.addEventListener("visibilitychange", () => {
                if (!document.hidden) refresh();
            });
            const pollTimer = window.setInterval(() => {
                if (!document.hidden) refresh();
            }, POLL_MS);
            window.addEventListener("pagehide", () => window.clearInterval(pollTimer), {
                once: true,
            });

            refresh();
        })();
    </script>
{% endblock %}
