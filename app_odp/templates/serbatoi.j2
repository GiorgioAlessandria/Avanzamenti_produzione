 {% else %}
  {% if tab == 'storico' %}<p class="small text-body-secondary">Lotto {{ detail.riferimento }}</p>{% endif %}
  <p class="fw-semibold">{{ detail.codice }} · {{ selected.descrizione }}</p><dl class="serbatoi-lotto-overview"><div><dt>Stato lavoro</dt><dd>{{ detail.stato }}</dd></div><div><dt>Ubicazione</dt><dd>{{ detail.ubicazione }}</dd></div><div><dt>Quantità</dt><dd>{{ detail.quantita }} pezzi</dd></div></dl>
