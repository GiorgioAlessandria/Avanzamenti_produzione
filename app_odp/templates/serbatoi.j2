{% extends 'base.j2' %}
{% block title %}Serbatoi{% endblock %}
{% block styles %}{{ super() }}
<link rel="stylesheet" href="{{ url_for('static', filename='assets/css/serbatoi.css', v='prezzi-barre-4') }}">
{% endblock %}
{% macro hidden(action) %}{% autoescape true %}
<input type="hidden" name="azione" value="{{ action }}"><input type="hidden" name="csrf" value="{{ csrf }}">
<input type="hidden" name="richiesta" value="{{ request_id() }}"><input type="hidden" name="tab" value="{{ tab }}">
<input type="hidden" name="id" value="{{ selected.id if selected else '' }}">
{% for key in ['fase','ubicazione','q'] %}<input type="hidden" name="{{ key }}" value="{{ request.args.get(key,'') }}">{% endfor %}
<input type="hidden" name="fornitore_filtro" value="{{ request.args.get('fornitore','') }}">
{% endautoescape %}{% endmacro %}
{% macro situazione_fasi(quantita) %}{% autoescape true %}
<div class="table-responsive mb-3"><table class="table table-sm serbatoi-phase-table">
 <thead><tr><th scope="col">{{ 'Fase LCT' if tab == 'produzione' else 'Stato lavoro' }}</th>{% if tab != 'produzione' %}<th scope="col">Ubicazione</th>{% endif %}<th scope="col" class="text-end">Pezzi</th></tr></thead>
 <tbody>{% for f in fasi %}<tr class="{{ 'fase-presente' if quantita.get(f.codice,0) else 'text-body-secondary' }}" data-fase="{{ f.codice }}" data-quantita="{{ quantita.get(f.codice,0) }}">
 <td><span class="serbatoi-phase-number" aria-hidden="true">{{ loop.index }}</span>{{ f.stato }}</td>{% if tab != 'produzione' %}<td>{{ 'SCB / cliente' if f.codice == 'spedito' else f.ubicazione }}</td>{% endif %}<td class="text-end">{{ quantita.get(f.codice,0) or '—' }}</td></tr>{% endfor %}</tbody>
</table></div>
{% endautoescape %}{% endmacro %}
{% macro elenco_ordini(ordini, fase) %}{% autoescape true %}
<ul class="serbatoi-phase-orders" aria-label="Ordini nella fase {{ fase }}" {% if ordini %}tabindex="0"{% endif %}>
 {% for o in ordini %}<li data-ordine-id="{{ o.id }}" data-ordine-tab="{{ o.tab }}" data-quantita="{{ o.quantita }}">
  <a href="{{ serbatoi_url(tab=o.tab,id=o.id,fase=o.fase,ubicazione=ubicazione_filtro) }}" class="serbatoi-phase-order {{ 'is-selected' if selected and tab == o.tab and selected.id == o.id and (not fase_filtro or fase_filtro == fase) }}" {% if o.scadenza %}data-scadenza="{{ o.scadenza.colore }}"{% endif %}>
   <span class="serbatoi-phase-order-head"><span>{{ o.titolo }}</span><strong>{{ o.quantita }} <small>pz</small></strong></span>
   <span class="serbatoi-phase-order-meta">{{ o.codice }} · {{ o.descrizione }}</span>
   {% if o.rettifica %}<span class="serbatoi-phase-order-meta">Rettifica visiva</span>{% endif %}
   {% if o.tab == 'storico' and o.info %}<span class="visually-hidden">{{ o.info }}</span>{% endif %}
   {% if o.scadenza %}<span class="visually-hidden">{{ o.scadenza.testo }}</span>{% endif %}
  </a>
 </li>{% else %}<li class="text-body-secondary small py-2">Nessun ordine</li>{% endfor %}
</ul>
{% endautoescape %}{% endmacro %}
{% macro field(name, label, type='text', value='', min='1', required=true) %}{% autoescape true %}
<div class="col-sm-6"><label class="form-label w-100">{{ label }}<input class="form-control mt-1" name="{{ name }}" type="{{ type }}" value="{{ value }}" {% if required %}required{% endif %} {% if type == 'number' %}min="{{ min }}" step="1"{% else %}maxlength="{{ 1000 if name == 'note' else 120 }}"{% endif %}></label></div>
{% endautoescape %}{% endmacro %}
{% block content %}{% autoescape true %}
<main class="container-fluid px-3 px-lg-4 py-3 serbatoi" id="serbatoi-app" aria-label="Serbatoi">
 {% for category, message in get_flashed_messages(with_categories=true) %}<div class="alert alert-{{ category }}" role="status">{{ message }}</div>{% endfor %}
 <div class="alert alert-warning d-none" id="serbatoi-avvisi" role="status"></div>
 {% if not articoli %}<div class="alert alert-info">Configura gli <a href="{{ serbatoi_url(tab='articoli') }}">articoli gestiti</a> per attivare il filtro degli ordini. Il magazzino Serbatoi è distinto da quello del gestionale.</div>{% endif %}
 <div class="d-flex align-items-center gap-2 mb-3">
  <nav class="nav nav-tabs flex-grow-1" aria-label="Sezioni Serbatoi" style="min-width: 0;">{% for key, label in tabs.items() %}<a class="nav-link {{ 'active' if key == tab }} {{ 'fw-semibold' if key == 'clienti' }}" {% if key == tab %}aria-current="page"{% endif %} href="{{ serbatoi_url(tab=key) }}">{{ label }}</a>{% endfor %}<a class="nav-link" href="{{ operator_url_for('main.serbatoi_qualita') }}">Controllo qualità</a></nav>
  <a class="btn btn-outline-secondary flex-shrink-0" href="{{ serbatoi_url(tab=tab, id=selected.id if selected else '') }}">Aggiorna</a>
 </div>
 {% if tab == 'barre' %}<div class="alert alert-{{ 'info' if parametri.codice_barre else 'warning' }}">Ordini barre: <strong>{{ forn_barre_label }}</strong> · <strong>{{ parametri.codice_barre or 'codice da configurare' }}</strong>. Sono acquisiti dal gestionale solo gli ordini di questo fornitore e codice. <a href="{{ serbatoi_url(tab='articoli') }}">Parametri</a></div>{% endif %}
 {% if tab == 'barre' and parametri.codice_barre %}
 <section class="card mb-3" aria-labelledby="serbatoi-prezzi-titolo">
  <div class="card-header"><h2 class="h5 mb-0" id="serbatoi-prezzi-titolo">Prezzi materia prima · €/kg</h2></div>
  <div class="card-body">
   <dl class="serbatoi-price-summary mb-3">
    <div><dt>Ultimo prezzo registrato</dt><dd>{% if serie_prezzi %}{{ servizio.formatta_centesimi(serie_prezzi[-1].centesimi) }} €/kg{% else %}Da registrare{% endif %}</dd></div>
    <div><dt>Riferimento attuale</dt><dd>{% if riferimento_prezzo %}{{ servizio.formatta_centesimi(riferimento_prezzo.centesimi_kg) }} €/kg <span class="small fw-normal">±{{ servizio.formatta_centesimi(riferimento_prezzo.soglia_centesimi_percento) }}%</span>{% else %}Da impostare{% endif %}</dd></div>
    {% if scostamento_ultimo %}<div><dt>Scostamento ultimo ordine</dt><dd class="{{ ('text-danger' if scostamento_ultimo.aumento else 'text-success') if scostamento_ultimo.soglia_raggiunta else '' }}">{{ scostamento_ultimo.percentuale }}%{% if scostamento_ultimo.soglia_raggiunta %} <span class="small fw-normal">Soglia raggiunta</span>{% endif %}</dd></div>{% endif %}
   </dl>
   <div class="serbatoi-price-chart"><canvas id="serbatoi-prezzi-grafico" role="img" aria-label="Prezzi delle barre e quotazione mensile LME in euro al chilogrammo"></canvas></div>
   <script type="application/json" id="serbatoi-prezzi-dati">{{ {'ordini': serie_prezzi, 'riferimento': riferimento_prezzo.centesimi_kg if riferimento_prezzo else none, 'soglia': riferimento_prezzo.soglia_centesimi_percento if riferimento_prezzo else none}|tojson }}</script>
   <p class="small mb-1 mt-2" id="serbatoi-mercato-stato" role="status" data-url="{{ operator_url_for('main.serbatoi_mercato_alluminio') }}">Caricamento della quotazione mensile dell’alluminio…</p>
   <p class="small text-body-secondary mb-0">Storico dell’alluminio primario del London Metal Exchange, convertito in €/kg con il cambio medio mensile. Il prezzo delle barre include anche la lavorazione e le condizioni del fornitore. La stima del mese in corso usa la tendenza mensile e l’ultimo cambio BCE disponibile. Il tratto tratteggiato indica una stima.
    <a href="https://www.worldbank.org/en/research/commodity-markets" target="_blank" rel="noopener">Banca Mondiale · Pink Sheet</a>,
    <a href="https://fred.stlouisfed.org/series/EXUSEU" target="_blank" rel="noopener">Federal Reserve · EXUSEU</a>,
    <a href="https://www.ecb.europa.eu/stats/policy_and_exchange_rates/euro_reference_exchange_rates/html/index.en.html" target="_blank" rel="noopener">BCE · cambio giornaliero</a>,
    <a href="https://www.lme.com/en/market-data/reports-and-data/lme-official-prices" target="_blank" rel="noopener">LME · ultima quotazione pubblicata</a>.
   </p>
   {% if serie_prezzi %}
   <details class="mt-3"><summary>Storico prezzi per ordine</summary>
    <div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th scope="col">Data</th><th scope="col">Ordine</th><th scope="col" class="text-end">€/kg</th></tr></thead><tbody>
     {% for p in serie_prezzi|reverse %}<tr><td>{{ p.data.split('-')|reverse|join('/') }}</td><td><a href="{{ serbatoi_url(tab='barre',id=p.id,q='') }}">{{ p.ordine }}</a></td><td class="text-end">{{ servizio.formatta_centesimi(p.centesimi) }}</td></tr>{% endfor %}
    </tbody></table></div>
   </details>
   {% else %}<p class="small text-body-secondary">Registra il prezzo nel dettaglio di un ordine per iniziare lo storico.</p>{% endif %}
   {% if can_acquisti %}
   <details class="mt-3"><summary class="fw-semibold">Imposta prezzo di riferimento e soglia</summary>
    <form class="row g-2 mt-1" method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">
     {{ hidden('riferimento_prezzo_barre') }}
     <input type="hidden" name="fornitore_tipo" value="{{ parametri.fornitore_barre_tipo }}"><input type="hidden" name="fornitore_codice" value="{{ parametri.fornitore_barre_codice }}"><input type="hidden" name="codice" value="{{ parametri.codice_barre }}">
     {{ field('prezzo_kg','Prezzo di riferimento (€/kg)',value=servizio.formatta_centesimi(riferimento_prezzo.centesimi_kg) if riferimento_prezzo else '') }}
     {{ field('soglia_percento','Soglia di scostamento (%)',value=servizio.formatta_centesimi(riferimento_prezzo.soglia_centesimi_percento) if riferimento_prezzo else '5,00') }}
     <p class="small text-body-secondary mb-0">Il riferimento serve al confronto. I prezzi registrati sugli ordini restano storici.</p>
     <div class="col-12"><button class="btn btn-outline-primary">Salva riferimento</button></div>
    </form>
   </details>{% endif %}
  </div>
 </section>
 {% endif %}
 {% if tab == 'articoli' %}
 <details class="card mb-3" id="serbatoi-parametri" {% if not parametri.codice_barre %}open{% endif %}><summary class="card-header fw-semibold">Parametri generali · fornitori, barre e spezzoni</summary>
 <form class="card-body row g-3" method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">{{ hidden('parametri') }}
  {% for kind,label in [('barre','Fornitore delle barre'),('spezzoni','Fornitore degli spezzoni')] %}<div class="col-md-6"><label class="form-label w-100">{{ label }}<select class="form-select mt-1" name="fornitore_{{ kind }}" required><option value="">Seleziona</option>{% for f in fornitori %}{% set chosen = (f.TipoAnagrafica == parametri['fornitore_' ~ kind ~ '_tipo'] and f.CodCliFor == parametri['fornitore_' ~ kind ~ '_codice']) %}<option value="{{ f.TipoAnagrafica }}|{{ f.CodCliFor }}" {{ 'selected' if chosen }}>{{ f.RagioneSociale }} · {{ f.CodCliFor }}</option>{% endfor %}</select></label></div>{% endfor %}
  {{ field('codice_barre','Codice unico delle barre','text',parametri.codice_barre) }}{{ field('unita_barre','Unità del gestionale per le barre','text',parametri.unita_barre) }}
  {{ field('lunghezza_barre_mm','Lunghezza barra (mm)','number',parametri.lunghezza_barre_mm) }}{{ field('sfrido_mm','Sfrido per taglio (mm)','number',parametri.sfrido_mm,'0') }}
  <div class="col-md-6"><label class="form-label w-100">Codici spezzoni selezionabili, uno per riga<textarea class="form-control mt-1" rows="4" maxlength="24000" name="codici_spezzoni" required>{{ parametri.codici_spezzoni|join('\n') }}</textarea></label></div>
  <div class="col-md-6 small text-body-secondary">Gli ordini ERP arrivano in metri: impostare M o MT. La lunghezza serve per convertirli in barre intere (24 m / 6 m = 4 barre), senza arrotondamenti. Le conversioni articolo e le relative fasi sono gestite nell’elenco sottostante. Il ciclo LCT usa la fase 1 per Fresatura e la fase 2 per Buratto.</div>
  <div class="col-12"><button class="btn btn-primary">Salva parametri</button></div>
 </form></details>
 <details class="card mb-3"><summary class="card-header fw-semibold">Tempistiche di consegna</summary>
  <form class="card-body row g-3" method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">{{ hidden('tempistiche') }}
   <p class="small text-body-secondary mb-0">Giorni solari. Prima di Gaser si contano due tratte da Bernardi. A Gaser si conta solo il rientro. I valori iniziali provengono dal programma precedente.</p>
   {% for key, (label, _) in campi_tempistiche.items() %}{{ field(key, label ~ ' (giorni)', 'number', tempistiche.giorni[key], '0') }}{% endfor %}
   {% if articoli %}<h3 class="h6 mb-0">Pezzi per lotto standard</h3>{% endif %}
   {% for a in articoli %}{{ field('lotto_' ~ a.id, a.codice_oss ~ ' · ' ~ a.descrizione, 'number', tempistiche.lotti.get(a.codice_oss, ''), required=false) }}{% endfor %}
   <div class="col-12"><button class="btn btn-primary">Salva tempistiche</button></div>
  </form>
 </details>
 {% endif %}
 {% if con_fasi %}
 <div class="serbatoi-flow-panel mb-3">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
   <h2 class="h6 mb-0">{{ 'Flusso di produzione LCT' if tab == 'produzione' else 'Flusso degli ordini cliente' if tab == 'clienti' else 'Spedizioni cliente' if tab == 'storico' else 'Flusso dei serbatoi' }} <span class="fw-normal text-body-secondary">· quantità per fase</span></h2>
   <div class="d-flex flex-wrap gap-3">
    {% if tab == 'clienti' %}<a class="{{ 'fw-bold' if fase_filtro == 'da_assegnare' }}" {% if fase_filtro == 'da_assegnare' %}aria-current="page"{% endif %} href="{{ serbatoi_url(tab=tab,fase='da_assegnare',id='') }}">Da assegnare: {{ da_assegnare }} pezzi</a>{% endif %}
    <a href="{{ serbatoi_url(tab=tab,fase='',ubicazione='',id='') }}">Tutte le fasi</a>
   </div>
  </div>
  {% if tab in ['clienti', 'produzione', 'magazzino'] %}<ul class="list-unstyled d-flex flex-wrap gap-3 small mb-2" aria-label="Legenda scadenze">{% for colore, label in colori_scadenza.items() %}<li><span class="serbatoi-scadenza-campione" data-scadenza="{{ colore }}" aria-hidden="true"></span> {{ label }}</li>{% endfor %}{% if tab != 'clienti' %}<li><span class="serbatoi-scadenza-campione" data-scadenza="blu" aria-hidden="true"></span> Stock interno</li>{% endif %}</ul>{% endif %}
  {% if tab in ['produzione', 'magazzino'] %}<p class="small text-body-secondary d-xl-none mb-2">Scorri le fasi per consultare tutti gli ordini.</p>{% endif %}
  <nav aria-label="{{ 'Fasi della spedizione' if tab == 'storico' else 'Fasi della produzione' }}" class="serbatoi-flow-scroll"><ol class="serbatoi-flow {{ 'serbatoi-flow--production' if tab == 'produzione' else 'serbatoi-flow--shipping' if tab == 'storico' else 'serbatoi-flow--customer' if tab == 'clienti' }}">
   {% for f in fasi %}<li><a class="serbatoi-flow-step {{ 'is-active' if fase_filtro == f.codice }}" data-fase="{{ f.codice }}" {% if fase_filtro == f.codice %}aria-current="page"{% endif %} href="{{ serbatoi_url(tab=tab,fase=f.codice,id='') }}">
    <span class="serbatoi-flow-index" aria-hidden="true">{{ loop.index }}</span><span class="serbatoi-flow-name">{{ f.nome }}</span>
    <span class="serbatoi-flow-place">{{ 'Produzione consuntivata' if f.codice == 'lavorati' else 'SCB / cliente' if f.codice == 'spedito' else 'Conto lavoro' if f.codice == 'gaser' else f.ubicazione }}</span>
    <span class="serbatoi-flow-qty">{{ totali_fasi[f.codice] }} <small>pezzi</small></span>
   </a><div class="serbatoi-phase-order-count">{{ ordini_per_fase[f.codice]|length }} {{ 'ordine' if ordini_per_fase[f.codice]|length == 1 else 'ordini' }}</div>{{ elenco_ordini(ordini_per_fase[f.codice],f.codice) }}</li>{% endfor %}
  </ol></nav>
  {% if tab == 'clienti' and ordini_per_fase.da_assegnare %}<div class="serbatoi-pending-orders"><h3 class="h6">Da assegnare</h3>{{ elenco_ordini(ordini_per_fase.da_assegnare,'da_assegnare') }}</div>{% endif %}
  {% if tab != 'produzione' %}<p class="small text-body-secondary mb-0 mt-2">{% if tab == 'storico' %}Seleziona un lotto per registrare il DDT di uscita, di rientro o di spedizione al cliente.{% else %}Seleziona un ordine per il dettaglio. Le quantità si riferiscono alla singola fase; gli ordini parziali compaiono in più elenchi. Avanzamenti interni automatici da LCT.{% endif %}</p>{% endif %}
 </div>
 {% endif %}
 <div class="row g-3 align-items-start">
 <section class="col-lg-5" aria-label="Elenco {{ tabs[tab] }}">
  <div class="card"><div class="card-header"><h2 class="h5 mb-0">{{ 'Articoli e conversioni' if tab == 'articoli' else tabs[tab] }}</h2></div><div class="card-body">
   <form method="get" class="d-flex flex-wrap gap-2 mb-3" role="search">
    <input type="hidden" name="tab" value="{{ tab }}">{% if request.args.get('tab_session') %}<input type="hidden" name="tab_session" value="{{ request.args.get('tab_session') }}">{% endif %}
    {% if con_fasi %}<div class="serbatoi-filters">
     <label class="form-label mb-0">Filtro per fase<select class="form-select mt-1" name="fase"><option value="">Tutte le fasi</option>{% if tab == 'clienti' %}<option value="da_assegnare" {{ 'selected' if fase_filtro == 'da_assegnare' }}>Da assegnare</option>{% endif %}{% for f in fasi %}<option value="{{ f.codice }}" {{ 'selected' if fase_filtro == f.codice }}>{{ f.nome }}</option>{% endfor %}</select></label>
     {% if tab != 'produzione' %}<label class="form-label mb-0">Filtro per ubicazione<select class="form-select mt-1" name="ubicazione"><option value="">Tutte le ubicazioni</option>{% for place in ['Bernardi','Gaser','Cliente'] %}<option value="{{ place }}" {{ 'selected' if ubicazione_filtro == place }}>{{ 'SCB / cliente' if place == 'Cliente' else place }}</option>{% endfor %}</select></label>{% endif %}
    </div>{% endif %}
    <input class="form-control" type="search" name="q" value="{{ request.args.get('q','') }}" placeholder="Cerca ordine, codice o stato" aria-label="Cerca nell’elenco"><button class="btn btn-outline-primary">{{ 'Applica filtri' if con_fasi else 'Cerca' }}</button>
   </form>
   <div class="table-responsive serbatoi-list"><table class="table table-hover align-middle mb-0"><thead><tr><th scope="col"><span class="d-none d-md-inline">Riferimento / codice</span><span class="d-md-none">Riferimento, stato e quantità</span></th><th scope="col" class="d-none d-md-table-cell">Stato</th><th scope="col" class="text-end d-none d-md-table-cell">{{ 'Coperti / richiesti' if tab == 'clienti' else 'Quantità' }}</th></tr></thead><tbody>
   {% for row in rows %}<tr class="{{ 'table-active' if selected and selected.id == row.id }}" {% if row.scadenza %}data-scadenza="{{ row.scadenza.colore }}"{% endif %} data-serbatoi-row tabindex="0" aria-label="Apri dettaglio {{ row.titolo }}">
    <td><a class="fw-semibold" href="{{ serbatoi_url(tab=row.tab_dettaglio,id=row.id_dettaglio,fase=row.fase_dettaglio) if row.tab_dettaglio else serbatoi_url(tab=tab,id=row.id) }}" {% if selected and selected.id == row.id %}aria-current="true"{% endif %}>{{ row.titolo }}</a><div>{{ row.codice }}</div><div class="small text-body-secondary">{{ row.descrizione }}</div><small class="text-body-secondary">{{ row.info }}</small>
    {% if tab == 'barre' and row.prezzo %}<div class="small fw-semibold">{{ servizio.formatta_centesimi(row.prezzo.centesimi_kg) }} €/kg</div>{% endif %}
    {% if row.scadenza %}<div class="small{% if tab != 'clienti' or row.scadenza.consegna %} mt-1{% endif %}"><span class="{{ 'visually-hidden' if tab == 'clienti' }}">{{ row.scadenza.testo }}</span>{% if row.scadenza.consegna %}{% if tab != 'clienti' %} · {% endif %}Consegna {{ row.scadenza.consegna.strftime('%d/%m/%Y') }}{% endif %}</div>{% endif %}
    <div class="d-md-none mt-2">{{ row.stato }}<div class="fw-semibold mt-1">{{ row.quantita }} {{ 'coperti / richiesti' if tab == 'clienti' else 'pezzi' }}</div></div></td>
    <td class="d-none d-md-table-cell">{% if row.stati is defined and row.stati %}{% for stato,q in row.stati.items() %}<div class="serbatoi-state-line"><span>{{ stato }}</span><strong>{{ q }}</strong></div>{% endfor %}{% else %}{{ row.stato }}{% endif %}</td><td class="text-end text-nowrap d-none d-md-table-cell">{{ row.quantita }}</td></tr>
   {% else %}<tr><td colspan="3" class="text-body-secondary py-4">Nessuna riga presente{% if request.args.get('q') or fase_filtro or ubicazione_filtro %} con questi filtri{% endif %}.</td></tr>{% endfor %}
   </tbody></table></div>
  </div></div>
  {% if tab == 'barre' and can_acquisti and parametri.codice_barre %}
  <details class="card mt-3"><summary class="card-header fw-semibold">Nuovo ordine barre</summary><form method="post" action="{{ operator_url_for('main.serbatoi_azione') }}" class="card-body row g-2">
   {{ hidden('barre') }}<input type="hidden" name="fornitore" value="{{ parametri.fornitore_barre_tipo }}|{{ parametri.fornitore_barre_codice }}"><input type="hidden" name="codice" value="{{ parametri.codice_barre }}"><input type="hidden" name="lunghezza_mm" value="{{ parametri.lunghezza_barre_mm }}">
   <p>{{ forn_barre_label }} · {{ parametri.codice_barre }} · {{ parametri.lunghezza_barre_mm }} mm</p>{{ field('riferimento','Numero ordine / riga') }}{{ field('quantita','Barre ordinate','number') }}
   {{ field('prezzo_kg','Prezzo effettivo (€/kg, facoltativo)',required=false) }}{{ field('data_prezzo','Data del prezzo','date',oggi.isoformat(),required=false) }}
   <div class="col-12"><button class="btn btn-primary">Registra ordine</button></div>
  </form></details>{% endif %}
  {% if tab == 'articoli' and can_produzione %}
  <details class="card mt-3"><summary class="card-header fw-semibold">Aggiungi articolo gestito</summary><form method="post" action="{{ operator_url_for('main.serbatoi_azione') }}" class="card-body row g-2">
   {{ hidden('articolo') }}{{ field('codice_oss','Codice ossidato') }}{{ field('codice_lav','Codice lavorato') }}{{ field('codice_spezzone','Codice spezzone') }}{{ field('descrizione','Descrizione') }}
   {{ field('fase_inizio','Prima fase LCT (opzionale)','number',required=false) }}{{ field('fase_fine','Ultima fase LCT (opzionale)','number',required=false) }}
   <p class="small text-body-secondary mb-0">Lasciando vuote le fasi si utilizzano la prima e l’ultima fase del ciclo ODP.</p><div class="col-12"><button class="btn btn-primary">Aggiungi al filtro</button></div>
  </form></details>
  <form class="mt-3" method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">{{ hidden('catalogo_precedente') }}<button class="btn btn-outline-secondary">Carica i 9 articoli di SerbatoiWIP</button><p class="small text-body-secondary mt-2">Conversioni dalla copia GitHub. Verifica i codici prima dell’utilizzo; non importa giacenze né ordini storici.</p></form>
  {% endif %}
 </section>
 <section class="col-lg-7" aria-label="Dettaglio selezionato"><div class="card serbatoi-detail"><div class="card-header"><h2 class="h5 mb-0">{{ selected.titolo if selected else 'Dettaglio' }}</h2></div><div class="card-body">
 {% if not detail %}<p class="text-body-secondary mb-0">Seleziona una riga dell’elenco per visualizzare il dettaglio e le operazioni disponibili.</p>
 {% elif tab == 'clienti' %}
  {% if cqc_presente %}<p><a class="btn btn-outline-primary btn-sm" href="{{ operator_url_for('main.serbatoi_cqc', cliente_id=detail.id) }}">Scarica CQC</a></p>{% endif %}
  {% if selected.scadenza %}
   {% set scadenza = selected.scadenza %}
   {% if scadenza.giorni is defined and scadenza.giorni is not none %}<p>{{ scadenza.giorni }} giorni solari residui stimati
   {% if scadenza.limite %}<br><span class="small">Data limite per la quota più critica: {{ scadenza.limite.strftime('%d/%m/%Y') }}</span>{% endif %}</p>{% endif %}
  {% endif %}
  <div class="d-flex flex-wrap justify-content-between gap-2 mb-3"><div><div>{{ selected.codice }} · {{ selected.descrizione }}</div><div>Consegna {{ detail.consegna or 'non indicata' }}</div></div><div>{{ selected.copertura }}<div class="fw-semibold">{{ selected.quantita }} pezzi</div></div></div>
