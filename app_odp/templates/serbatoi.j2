  {% if scostamento_prezzo %}<p class="small {{ ('text-danger' if scostamento_prezzo.aumento else 'text-success') if scostamento_prezzo.soglia_raggiunta else 'text-body-secondary' }}">Scostamento dal riferimento attuale ({{ servizio.formatta_centesimi(riferimento_dettaglio.centesimi_kg) }} €/kg) <strong>{{ scostamento_prezzo.percentuale }}%</strong>{% if scostamento_prezzo.soglia_raggiunta %} · Soglia raggiunta{% endif %}</p>{% endif %}
  {% if can_acquisti %}<details class="mb-3"><summary class="fw-semibold">{{ 'Modifica prezzo ordine' if selected.prezzo else 'Registra prezzo ordine' }}</summary>
   <form class="row g-2 mt-1" method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">
    {{ hidden('prezzo_barre') }}<input type="hidden" name="barre_id" value="{{ detail.id }}">
    {{ field('prezzo_kg','Prezzo effettivo (€/kg)',value=servizio.formatta_centesimi(selected.prezzo.centesimi_kg) if selected.prezzo else '') }}
    {{ field('data_prezzo','Data del prezzo','date',(selected.prezzo.data_prezzo if selected.prezzo else data_prezzo_proposta).isoformat()) }}
    <div class="col-12"><button class="btn btn-outline-primary">Salva prezzo</button></div>
   </form>
  </details>{% endif %}
  {% if can_acquisti %}{% if not selected.fuori_parametri %}<details class="mb-3"><summary class="fw-semibold">Registra ricezione barre</summary><form class="row g-2 mt-1" method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">{{ hidden('ricevi') }}<input type="hidden" name="barre_id" value="{{ detail.id }}">{{ field('quantita','Barre ricevute','number') }}{{ field('ddt','Numero DDT') }}<div class="col-12"><button class="btn btn-primary">Carica barre</button></div></form></details>{% endif %}
  <details><summary class="fw-semibold">Registra taglio e carico spezzoni</summary><form class="row g-2 mt-1" method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">{{ hidden('taglia') }}
   <div class="col-12"><label class="form-label w-100">Lotto barre ricevuto<select class="form-select mt-1" name="lotto_id" required><option value="">Seleziona</option>{% for l in disponibilita %}<option value="{{ l.id }}">{{ l.riferimento }} · {{ l.quantita }} barre disponibili</option>{% endfor %}</select></label></div>
   <p>Fornitore spezzoni: <strong>{{ forn_spezzoni_label }}</strong> · Sfrido per taglio: {{ parametri.sfrido_mm }} mm</p><input type="hidden" name="sfrido_mm" value="{{ parametri.sfrido_mm }}"><input type="hidden" name="fornitore_spezzoni" value="{{ parametri.fornitore_spezzoni_tipo }}|{{ parametri.fornitore_spezzoni_codice }}">
   {{ field('numero_barre','Barre intere consumate','number') }}<div class="col-sm-6"><label class="form-label w-100">Codice spezzone<select class="form-select mt-1" name="codice_spezzone" required><option value="">Seleziona</option>{% for code in parametri.codici_spezzoni %}<option value="{{ code }}">{{ code }} · {{ descrizioni.get(code,'Descrizione non disponibile') }}</option>{% endfor %}</select></label></div>
   {{ field('pezzi','Spezzoni ottenuti','number') }}{{ field('lunghezza_mm','Lunghezza spezzone (mm)','number') }}
   <p class="small text-body-secondary">Si registrano le barre intere effettivamente utilizzate. La lunghezza non trasformata viene conservata nel movimento; non viene caricata automaticamente come barra riutilizzabile.</p><div class="col-12"><button class="btn btn-primary">Scarica barre e carica spezzoni</button></div>
  </form></details>{% endif %}
 {% elif tab == 'articoli' %}
  <dl class="row"><dt class="col-sm-5">Ossidato</dt><dd class="col-sm-7">{{ detail.codice_oss }}</dd><dt class="col-sm-5">Lavorato</dt><dd class="col-sm-7">{{ detail.codice_lav }}</dd><dt class="col-sm-5">Spezzone</dt><dd class="col-sm-7">{{ detail.codice_spezzone }}</dd></dl>
  <p>{{ detail.descrizione }}</p><p>Fasi: {{ detail.fase_inizio or 'prima del ciclo' }} → {{ detail.fase_fine or 'ultima del ciclo' }}</p>
  {% if can_produzione %}<form method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">{{ hidden('attivo') }}<input type="hidden" name="articolo_id" value="{{ detail.id }}"><button class="btn btn-outline-secondary">{{ 'Escludi dalle nuove acquisizioni' if detail.attivo else 'Includi nelle acquisizioni' }}</button></form>{% endif %}
