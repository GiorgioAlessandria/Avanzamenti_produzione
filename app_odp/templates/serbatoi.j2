  {% set passaggi = {('Lavorato','Bernardi'):('gaser','Lavorato → Gaser','Numero DDT di uscita'), ('Lavorato','Gaser'):('rientro','Gaser → Ossidato','Numero DDT di rientro'), ('Ossidato','Bernardi'):('spedisci','Ossidato → SCB / cliente','Numero DDT di spedizione')} %}
  {% set passaggio = passaggi.get((detail.stato,detail.ubicazione)) %}
