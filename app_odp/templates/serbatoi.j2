{% extends 'base.j2' %}
{% block title %}Serbatoi{% endblock %}
{% block styles %}{{ super() }}
<link rel="stylesheet" href="{{ url_for('static', filename='assets/css/serbatoi.css') }}">
{% endblock %}
{% macro hidden(action) %}
<input type="hidden" name="azione" value="{{ action }}"><input type="hidden" name="csrf" value="{{ csrf }}">
<input type="hidden" name="richiesta" value="{{ request_id() }}"><input type="hidden" name="tab" value="{{ tab }}">
<input type="hidden" name="id" value="{{ selected.id if selected else '' }}">
{% endmacro %}
{% macro field(name, label, type='text', value='', min='1', required=true) %}
<div class="col-sm-6"><label class="form-label w-100">{{ label }}<input class="form-control mt-1" name="{{ name }}" type="{{ type }}" value="{{ value }}" {% if required %}required{% endif %} {% if type == 'number' %}min="{{ min }}" step="1"{% else %}maxlength="{{ 1000 if name == 'note' else 120 }}"{% endif %}></label></div>
{% endmacro %}
{% block content %}
<main class="container-fluid px-3 px-lg-4 py-3 serbatoi" id="serbatoi-app">
 <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
  <div><h1 class="h3 mb-1">Serbatoi</h1><p class="text-body-secondary mb-0">Ordini cliente, produzione e tracciabilità del materiale</p></div>
  <a class="btn btn-outline-secondary" href="{{ serbatoi_url(tab=tab, id=selected.id if selected else '') }}">Aggiorna</a>
 </div>
 {% for category, message in get_flashed_messages(with_categories=true) %}<div class="alert alert-{{ category }}" role="status">{{ message }}</div>{% endfor %}
 <div class="alert alert-warning d-none" id="serbatoi-avvisi" role="status"></div>
 {% if not articoli %}<div class="alert alert-info">Configura gli <a href="{{ serbatoi_url(tab='articoli') }}">articoli gestiti</a> per attivare il filtro degli ordini. Il magazzino Serbatoi è distinto da quello del gestionale.</div>{% endif %}
 <nav class="nav nav-tabs mb-3" aria-label="Sezioni Serbatoi">{% for key, label in tabs.items() %}<a class="nav-link {{ 'active' if key == tab }}" {% if key == tab %}aria-current="page"{% endif %} href="{{ serbatoi_url(tab=key) }}">{{ label }}</a>{% endfor %}</nav>
 <div class="row g-3 align-items-start">
 <section class="col-lg-5" aria-label="Elenco {{ tabs[tab] }}">
  <div class="card"><div class="card-header"><h2 class="h5 mb-0">{{ tabs[tab] }}</h2></div><div class="card-body">
   <form method="get" class="d-flex flex-wrap gap-2 mb-3" role="search">
    <input type="hidden" name="tab" value="{{ tab }}">{% if request.args.get('tab_session') %}<input type="hidden" name="tab_session" value="{{ request.args.get('tab_session') }}">{% endif %}
    {% if tab == 'barre' %}<select class="form-select" name="fornitore" aria-label="Filtra per fornitore"><option value="">Tutti i fornitori</option>{% for f in fornitori %}{% set key=f.TipoAnagrafica ~ '|' ~ f.CodCliFor %}<option value="{{ key }}" {{ 'selected' if request.args.get('fornitore') == key }}>{{ f.RagioneSociale }} · {{ f.CodCliFor }}</option>{% endfor %}</select>{% endif %}
    <input class="form-control" type="search" name="q" value="{{ request.args.get('q','') }}" placeholder="Cerca ordine, codice o stato" aria-label="Cerca nell’elenco"><button class="btn btn-outline-primary">Cerca</button>
   </form>
   <div class="table-responsive serbatoi-list"><table class="table table-hover align-middle mb-0"><thead><tr><th scope="col"><span class="d-none d-md-inline">Riferimento / codice</span><span class="d-md-none">Riferimento, stato e quantità</span></th><th scope="col" class="d-none d-md-table-cell">Stato</th><th scope="col" class="text-end d-none d-md-table-cell">{{ 'Coperti / richiesti' if tab == 'clienti' else 'Quantità' }}</th></tr></thead><tbody>
   {% for row in rows %}<tr class="{{ 'table-active' if selected and selected.id == row.id }}">
    <td><a class="fw-semibold" href="{{ serbatoi_url(tab=tab,id=row.id) }}" {% if selected and selected.id == row.id %}aria-current="true"{% endif %}>{{ row.titolo }}</a><div>{{ row.codice }}</div><small class="text-body-secondary">{{ row.info }}</small><div class="d-md-none mt-2">{{ row.stato }}<div class="fw-semibold mt-1">{{ row.quantita }} {{ 'coperti / richiesti' if tab == 'clienti' else 'pezzi' }}</div></div></td>
    <td class="d-none d-md-table-cell">{{ row.stato }}</td><td class="text-end text-nowrap d-none d-md-table-cell">{{ row.quantita }}</td></tr>
   {% else %}<tr><td colspan="3" class="text-body-secondary py-4">Nessuna riga presente{% if request.args.get('q') %} con questo filtro{% endif %}.</td></tr>{% endfor %}
   </tbody></table></div>
  </div></div>
  {% if tab == 'barre' and can_acquisti %}
  <details class="card mt-3"><summary class="card-header fw-semibold">Nuovo ordine barre</summary><form method="post" action="{{ operator_url_for('main.serbatoi_azione') }}" class="card-body row g-2">
   {{ hidden('barre') }}<div class="col-12"><label class="form-label w-100">Fornitore<select class="form-select mt-1" name="fornitore" required><option value="">Seleziona un fornitore</option>{% for f in fornitori %}<option value="{{ f.TipoAnagrafica }}|{{ f.CodCliFor }}">{{ f.RagioneSociale }} · {{ f.CodCliFor }}</option>{% endfor %}</select></label></div>
   {{ field('riferimento','Numero ordine / riga') }}{{ field('codice','Codice barra') }}{{ field('quantita','Barre ordinate','number') }}{{ field('lunghezza_mm','Lunghezza barra (mm)','number') }}
   <div class="col-12"><button class="btn btn-primary">Registra ordine</button></div>
  </form></details>{% endif %}
  {% if tab == 'articoli' and can_produzione %}
  <details class="card mt-3"><summary class="card-header fw-semibold">Aggiungi articolo gestito</summary><form method="post" action="{{ operator_url_for('main.serbatoi_azione') }}" class="card-body row g-2">
   {{ hidden('articolo') }}{{ field('codice_oss','Codice ossidato') }}{{ field('codice_lav','Codice lavorato') }}{{ field('codice_spezzone','Codice spezzone') }}{{ field('descrizione','Descrizione') }}
   {{ field('fase_inizio','Prima fase LCT (opzionale)','number',required=false) }}{{ field('fase_fine','Ultima fase LCT (opzionale)','number',required=false) }}
   <p class="small text-body-secondary mb-0">Lasciando vuote le fasi si utilizzano la prima e l’ultima fase del ciclo ODP.</p><div class="col-12"><button class="btn btn-primary">Aggiungi al filtro</button></div>
  </form></details>
  <form class="mt-3" method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">{{ hidden('catalogo_precedente') }}<button class="btn btn-outline-secondary">Carica i 9 articoli di SerbatoiWIP</button><p class="small text-body-secondary mt-2">Conversioni dalla copia GitHub. Verifica i codici prima dell’utilizzo; non importa giacenze né ordini storici.</p></form>
  {% endif %}
 </section>
 <section class="col-lg-7" aria-label="Dettaglio selezionato"><div class="card serbatoi-detail"><div class="card-header"><h2 class="h5 mb-0">{{ selected.titolo if selected else 'Dettaglio' }}</h2></div><div class="card-body">
 {% if not detail %}<p class="text-body-secondary mb-0">Seleziona una riga dell’elenco per visualizzare il dettaglio e le operazioni disponibili.</p>
 {% elif tab == 'clienti' %}
  <div class="d-flex flex-wrap justify-content-between gap-2 mb-3"><div><strong>{{ detail.cliente }}</strong><div>{{ selected.codice }} · Consegna {{ detail.consegna or 'non indicata' }}</div></div><div>{{ selected.copertura }}<div class="fw-semibold">{{ selected.quantita }} pezzi</div></div></div>
  {% if detail.anomalia %}<div class="alert alert-warning">{{ detail.anomalia }}</div>{% endif %}
  {% if detail.anomalia and can_produzione %}<details class="mb-3"><summary class="fw-semibold">Riconcilia fabbisogno cliente</summary><form class="row g-2 mt-1" method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">{{ hidden('riconcilia_cliente') }}<input type="hidden" name="cliente_id" value="{{ detail.id }}">{{ field('quantita','Quantità totale da gestire, incluse spedizioni locali','number',detail.quantita) }}{{ field('note','Esito della verifica') }}<div class="col-12"><button class="btn btn-outline-primary">Conferma fabbisogno verificato</button></div></form></details>{% endif %}
  <h3 class="h6">Avanzamento del materiale</h3><ul class="list-group mb-3">{% for stato,q in stati.items() %}<li class="list-group-item d-flex justify-content-between"><span>{{ stato }}</span><strong>{{ q }}</strong></li>{% else %}<li class="list-group-item text-body-secondary">Nessuna quantità ancora prodotta o assegnata da magazzino.</li>{% endfor %}</ul>
  <h3 class="h6">Produzioni collegate</h3><ul class="list-group mb-3">{% for i in impegni %}{% set p=servizio.record(servizio.Produzione,i.produzione_id) %}<li class="list-group-item"><a href="{{ serbatoi_url(tab='produzione',id=p.id) }}">{{ p.riferimento }}</a> · {{ i.quantita }} richiesti, {{ i.realizzata }} prodotti
   {% if can_produzione and i.quantita > i.realizzata %}<details class="mt-2"><summary>Libera quota non ancora prodotta</summary><form class="row g-2 mt-1" method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">{{ hidden('libera_impegno') }}<input type="hidden" name="impegno_id" value="{{ i.id }}">{{ field('quantita','Quantità da liberare','number') }}<div class="col-12"><button class="btn btn-outline-primary">Libera impegno</button></div></form></details>{% endif %}
  </li>{% else %}<li class="list-group-item text-body-secondary">Nessun ODP collegato. La copertura può provenire anche da magazzino.</li>{% endfor %}</ul>
  {% if can_produzione and servizio.copertura(detail) < detail.quantita %}<details class="mb-3"><summary class="fw-semibold">Collega un ordine di produzione</summary><form class="row g-2 mt-1" method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">{{ hidden('assegna_odp') }}<input type="hidden" name="cliente_id" value="{{ detail.id }}">
   <div class="col-sm-8"><label class="form-label w-100">ODP compatibile<select class="form-select mt-1" name="produzione_id" required><option value="">Seleziona</option>{% for p in produzioni if p.articolo_id == detail.articolo_id %}<option value="{{ p.id }}">{{ p.riferimento }} · {{ servizio.capacita_produzione(p)-servizio.quote_future(p).values()|sum }} liberi da produrre</option>{% endfor %}</select></label></div>{{ field('quantita','Quantità','number') }}<div class="col-12"><button class="btn btn-primary">Collega ODP</button></div></form></details>
  <details class="mb-3"><summary class="fw-semibold">Assegna componenti dal magazzino</summary><form class="row g-2 mt-1" method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">{{ hidden('assegna_magazzino') }}<input type="hidden" name="cliente_id" value="{{ detail.id }}">
   <div class="col-12"><label class="form-label w-100">Lotto libero compatibile<select class="form-select mt-1" name="lotto_id" required><option value="">Seleziona</option>{% for l in lotti if l.tipo == 'Materiale' and l.articolo_id == detail.articolo_id and not l.cliente_id and l.stato in ['Grezzo','Lavorato','Ossidato'] %}<option value="{{ l.id }}">{{ l.riferimento }} · {{ l.stato }} / {{ l.ubicazione }} · {{ l.quantita }} pezzi</option>{% endfor %}</select></label></div>{{ field('quantita','Quantità','number') }}<div class="col-12"><button class="btn btn-primary">Assegna dal magazzino</button></div></form></details>{% endif %}
  <h3 class="h6">Lotti assegnati e spedizioni</h3><ul class="list-group">{% for l in disponibilita %}<li class="list-group-item"><a href="{{ serbatoi_url(tab='storico' if l.stato == 'Spedito' else 'magazzino',id=l.id) }}">{{ l.riferimento }}</a> · {{ l.quantita }} · {{ l.stato }} / {{ l.ubicazione }}</li>{% else %}<li class="list-group-item text-body-secondary">Nessun lotto assegnato.</li>{% endfor %}</ul>
 {% elif tab == 'produzione' %}
  <p>{{ selected.codice }} · {{ detail.quantita }} pezzi<br><span class="text-body-secondary">{{ detail.riferimento_stock }}</span></p>
  <p>Fasi LCT collegate: {{ detail.fase_inizio }} → {{ detail.fase_fine }}. {{ selected.stato }}.</p>
  <p><strong>Stock lavorato disponibile:</strong> {{ servizio.lotti_produzione(detail,'Lavorato')|rejectattr('cliente_id')|map(attribute='quantita')|sum }} pezzi.<br><strong>Capacità futura non impegnata:</strong> {{ servizio.capacita_produzione(detail)-servizio.quote_future(detail).values()|sum }} pezzi.</p>
  <div class="alert alert-info">Le quantità senza cliente rimangono stock. Si fermano a Lavorato presso Bernardi e non possono essere inviate a Gaser o spedite.</div>
  {% if detail.anomalia %}<div class="alert alert-warning">{{ detail.anomalia }}</div>{% endif %}
  <h3 class="h6">Destinazioni cliente</h3><ul class="list-group mb-3">{% for i in impegni %}{% set c=servizio.record(servizio.Cliente,i.cliente_id) %}<li class="list-group-item"><a href="{{ serbatoi_url(tab='clienti',id=c.id) }}">{{ c.riferimento }} · {{ c.cliente }}</a> · {{ i.quantita }} richiesti, {{ i.realizzata }} prodotti</li>{% else %}<li class="list-group-item">Produzione per stock.</li>{% endfor %}</ul>
  <h3 class="h6">Spezzoni prelevati</h3><ul class="list-group mb-3">{% for c in disponibilita %}{% set l=servizio.record(servizio.Lotto,c.lotto_id) %}<li class="list-group-item">{{ l.codice }} · {{ c.quantita }} pezzi · {{ l.riferimento }}</li>{% else %}<li class="list-group-item text-body-secondary">Provenienza da completare prima dell’invio del materiale.</li>{% endfor %}</ul>
  {% if can_produzione %}<details class="mb-3"><summary class="fw-semibold">Registra prelievo spezzoni</summary><form class="row g-2 mt-1" method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">{{ hidden('consuma') }}<input type="hidden" name="produzione_id" value="{{ detail.id }}">
   <div class="col-12"><label class="form-label w-100">Lotto spezzoni<select class="form-select mt-1" name="lotto_id" required><option value="">Seleziona</option>{% for l in lotti if l.tipo == 'Spezzone' and l.stato == 'Disponibile' and l.codice == servizio.record(servizio.Articolo,detail.articolo_id).codice_spezzone %}<option value="{{ l.id }}">{{ l.riferimento }} · {{ l.quantita }} disponibili</option>{% endfor %}</select></label></div>{{ field('quantita','Quantità prelevata','number') }}<div class="col-12"><button class="btn btn-primary">Registra prelievo</button></div></form></details>
  {% if detail.anomalia %}<details><summary class="fw-semibold">Conferma riconciliazione delle quantità pregresse</summary><form class="row g-2 mt-1" method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">{{ hidden('riconcilia') }}<input type="hidden" name="produzione_id" value="{{ detail.id }}">{{ field('quantita','Quantità totale verificata','number',detail.quantita) }}{{ field('note','Esito della verifica') }}<p class="small">Conferma solo dopo aver verificato i movimenti pregressi. Questa operazione non ricostruisce produzioni o provenienze mancanti.</p><div class="col-12"><button class="btn btn-outline-primary">Conferma verifica</button></div></form></details>{% endif %}{% endif %}
 {% elif tab == 'barre' %}
  <p><strong>{{ detail.fornitore_nome }}</strong> · {{ detail.fornitore_codice }}<br>{{ detail.codice }} · {{ detail.lunghezza_mm }} mm per barra</p>
  <dl class="row"><dt class="col-8">Barre ordinate</dt><dd class="col-4">{{ detail.quantita }}</dd><dt class="col-8">Ricevute</dt><dd class="col-4">{{ selected.ricevute }}</dd><dt class="col-8">Consumate</dt><dd class="col-4">{{ selected.ricevute-selected.residue }}</dd><dt class="col-8">Disponibili</dt><dd class="col-4">{{ selected.residue }}</dd></dl>
  {% if can_acquisti %}<details class="mb-3"><summary class="fw-semibold">Registra ricezione barre</summary><form class="row g-2 mt-1" method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">{{ hidden('ricevi') }}<input type="hidden" name="barre_id" value="{{ detail.id }}">{{ field('quantita','Barre ricevute','number') }}{{ field('ddt','Numero DDT') }}<div class="col-12"><button class="btn btn-primary">Carica barre</button></div></form></details>
  <details><summary class="fw-semibold">Registra taglio e carico spezzoni</summary><form class="row g-2 mt-1" method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">{{ hidden('taglia') }}
   <div class="col-12"><label class="form-label w-100">Lotto barre ricevuto<select class="form-select mt-1" name="lotto_id" required><option value="">Seleziona</option>{% for l in disponibilita %}<option value="{{ l.id }}">{{ l.riferimento }} · {{ l.quantita }} barre disponibili</option>{% endfor %}</select></label></div>
   {{ field('numero_barre','Barre intere consumate','number') }}<div class="col-sm-6"><label class="form-label w-100">Codice spezzone<select class="form-select mt-1" name="codice_spezzone" required><option value="">Seleziona</option>{% for code in articoli|map(attribute='codice_spezzone')|unique %}<option>{{ code }}</option>{% endfor %}</select></label></div>
   {{ field('pezzi','Spezzoni ottenuti','number') }}{{ field('lunghezza_mm','Lunghezza spezzone (mm)','number') }}{{ field('sfrido_mm','Sfrido per taglio (mm)','number','0','0') }}
   <p class="small text-body-secondary">Si registrano le barre intere effettivamente utilizzate. La lunghezza non trasformata viene conservata nel movimento; non viene caricata automaticamente come barra riutilizzabile.</p><div class="col-12"><button class="btn btn-primary">Scarica barre e carica spezzoni</button></div>
  </form></details>{% endif %}
 {% elif tab == 'articoli' %}
  <dl class="row"><dt class="col-sm-5">Ossidato</dt><dd class="col-sm-7">{{ detail.codice_oss }}</dd><dt class="col-sm-5">Lavorato</dt><dd class="col-sm-7">{{ detail.codice_lav }}</dd><dt class="col-sm-5">Spezzone</dt><dd class="col-sm-7">{{ detail.codice_spezzone }}</dd></dl>
  <p>{{ detail.descrizione }}</p><p>Fasi: {{ detail.fase_inizio or 'prima del ciclo' }} → {{ detail.fase_fine or 'ultima del ciclo' }}</p>
  {% if can_produzione %}<form method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">{{ hidden('attivo') }}<input type="hidden" name="articolo_id" value="{{ detail.id }}"><button class="btn btn-outline-secondary">{{ 'Escludi dalle nuove acquisizioni' if detail.attivo else 'Includi nelle acquisizioni' }}</button></form>{% endif %}
  {% if can_produzione %}<details class="mt-3"><summary class="fw-semibold">Imposta le fasi per i nuovi ODP</summary><form class="row g-2 mt-1" method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">{{ hidden('fasi') }}<input type="hidden" name="articolo_id" value="{{ detail.id }}">{{ field('fase_inizio','Prima fase LCT','number',detail.fase_inizio or '',required=false) }}{{ field('fase_fine','Ultima fase LCT','number',detail.fase_fine or '',required=false) }}<p class="small text-body-secondary">Le produzioni già acquisite mantengono le fasi con cui sono state collegate. Se vuote, si usano prima e ultima fase del ciclo.</p><div class="col-12"><button class="btn btn-primary">Salva fasi</button></div></form></details>{% endif %}
 {% else %}
  <p><strong>{{ detail.codice }}</strong> · {{ detail.quantita }} pezzi<br>{{ detail.stato }} presso {{ detail.ubicazione }}</p>
  {% if detail.cliente_id %}{% set c=servizio.record(servizio.Cliente,detail.cliente_id) %}<p>Ordine cliente: <a href="{{ serbatoi_url(tab='clienti',id=c.id) }}">{{ c.riferimento }} · {{ c.cliente }}</a></p>{% else %}<p>Stock libero. Assegnalo da una riga cliente prima di proseguire verso Gaser o la spedizione.</p>{% endif %}
  {% if detail.produzione_id %}{% set p=servizio.record(servizio.Produzione,detail.produzione_id) %}<p>ODP: <a href="{{ serbatoi_url(tab='produzione',id=p.id) }}">{{ p.riferimento }}</a></p>{% endif %}
  {% if can_produzione and detail.cliente_id and detail.tipo == 'Materiale' and detail.stato == 'Lavorato' and detail.ubicazione == 'Bernardi' %}<details class="mb-3"><summary class="fw-semibold">Libera materiale per stock</summary><form class="row g-2 mt-1" method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">{{ hidden('libera_materiale') }}<input type="hidden" name="lotto_id" value="{{ detail.id }}">{{ field('quantita','Quantità da liberare','number') }}<div class="col-12"><button class="btn btn-outline-primary">Riporta a stock</button></div></form></details>{% endif %}
  {% if detail.tipo == 'Materiale' and not servizio.origine_completa(detail) %}<div class="alert alert-warning">Provenienza incompleta. Collega gli spezzoni alla produzione per poter inviare o spedire il materiale.</div>{% endif %}
  {% set passaggi = {('Lavorato','Bernardi'):('gaser','Invia a Gaser'), ('Lavorato','Gaser'):('rientro','Registra rientro ossidato'), ('Ossidato','Bernardi'):('spedisci','Spedisci al cliente')} %}
  {% set passaggio = passaggi.get((detail.stato,detail.ubicazione)) %}
  {% if passaggio and detail.cliente_id and (can_acquisti or can_produzione) %}
  <details class="mb-3"><summary class="fw-semibold">{{ passaggio[1] }}</summary><form class="row g-2 mt-1" method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">{{ hidden('avanza') }}<input type="hidden" name="lotto_id" value="{{ detail.id }}"><input type="hidden" name="passaggio" value="{{ passaggio[0] }}">{{ field('quantita','Quantità conforme','number') }}{{ field('scarti','Scarti','number','0','0') }}{{ field('ddt','Numero DDT') }}<div class="col-12"><button class="btn btn-primary">{{ passaggio[1] }}</button></div></form></details>{% endif %}
  <h3 class="h6">Provenienza del lotto</h3><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Passaggio</th><th>Origine</th></tr></thead><tbody>{% for l in trace %}<tr><td>{{ l.tipo }} · {{ l.codice }}<div class="small text-body-secondary">{{ l.riferimento }}</div></td><td>{{ l.stato }} · {{ l.ubicazione }}{% if l.barre_id %}{% set b=servizio.record(servizio.Barre,l.barre_id) %}<div><a href="{{ serbatoi_url(tab='barre',id=b.id) }}">Ordine barre {{ b.riferimento }}</a><br>{{ b.fornitore_nome }}</div>{% endif %}</td></tr>{% endfor %}</tbody></table></div>
  <h3 class="h6">Movimenti e documenti</h3><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Data / operatore</th><th>Operazione</th><th>Quantità</th><th>DDT</th></tr></thead><tbody>{% for m in docs %}<tr><td>{{ m.data[:16]|replace('T',' ') }}<br>{{ m.operatore }}</td><td>{{ m.tipo|replace('_',' ') }}{% if m.note %}<div class="small text-body-secondary">{{ m.note }}</div>{% endif %}</td><td>{{ m.quantita }}</td><td>{{ m.ddt or '—' }}</td></tr>{% endfor %}</tbody></table></div>
 {% endif %}
 </div></div>
 {% if tab == 'articoli' and esclusi %}<details class="card mt-3"><summary class="card-header">Codici cliente esclusi dal filtro ({{ esclusi|length }})</summary><div class="card-body serbatoi-excluded">{% for code in esclusi %}<span class="d-inline-block me-3 mb-2">{{ code or '(senza codice)' }}</span>{% endfor %}</div></details>{% endif %}
 </section></div>
 <form id="serbatoi-sync" class="d-none" method="post" action="{{ operator_url_for('main.serbatoi_azione') }}">{{ hidden('sync') }}</form>
</main>
{% endblock %}
{% block extra_js %}{{ super() }}<script src="{{ url_for('static',filename='assets/js/serbatoi.js') }}" defer></script>{% endblock %}
