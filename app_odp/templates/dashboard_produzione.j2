{% block extra_js %}
    {{ super() }}
    <script src="{{ url_for('static', filename='vendor/chartjs/chart.umd.min.js') }}"></script>

    <script>
        (() => {
            function updateFilterSelects(rootId, options) {
                const root = document.getElementById(rootId);
                if (!root || !options) return;

                root.querySelectorAll("select.js-dashboard-filter[data-filter-key]").forEach(select => {
                    const key = select.dataset.filterKey;
                    const selectedValue = select.value || "";
                    const rows = Array.isArray(options[key]) ? options[key] : [];
                    const seen = new Set([""]);
                    let html = `<option value="">Tutti</option>`;

                    rows.forEach(row => {
                        const value = String(row?.value ?? "").trim();
                        if (!value || seen.has(value)) return;

                        seen.add(value);

                        const label = String(row?.label || value);

                        html += `<option value="${escapeHtml(value)}">${escapeHtml(label)}</option>`;
                    });

                    if (selectedValue && !seen.has(selectedValue)) {
                        html += `<option value="${escapeHtml(selectedValue)}">${escapeHtml(selectedValue)}</option>`;
                    }

                    select.innerHTML = html;
                    select.value = selectedValue;
                });
            }


            function bindFilterAutoReload(rootId, loader) {
                const root = document.getElementById(rootId);
                if (!root) return;

                root.querySelectorAll("select.js-dashboard-filter").forEach(select => {
                    select.addEventListener("change", () => loader().catch(console.error));
                });
            }

            const tabSession = "{{ tab_session|default('', true)|e }}";
            const dashboardCharts = {};

            const COLORS = {
                blue: "rgba(13, 110, 253, 0.85)",
                green: "rgba(25, 135, 84, 0.85)",
                yellow: "rgba(255, 193, 7, 0.85)",
                orange: "rgba(253, 126, 20, 0.85)",
                red: "rgba(220, 53, 69, 0.85)",
                gray: "rgba(108, 117, 125, 0.55)",
                cyan: "rgba(13, 202, 240, 0.85)",
                purple: "rgba(111, 66, 193, 0.85)",
            };

            const BORDER_COLORS = {
                blue: "rgba(13, 110, 253, 1)",
                green: "rgba(25, 135, 84, 1)",
                yellow: "rgba(255, 193, 7, 1)",
                orange: "rgba(253, 126, 20, 1)",
                red: "rgba(220, 53, 69, 1)",
                gray: "rgba(108, 117, 125, 1)",
                cyan: "rgba(13, 202, 240, 1)",
                purple: "rgba(111, 66, 193, 1)",
            };

            function withTabSession(url) {
                if (!tabSession) return url;
                const parsed = new URL(url, window.location.origin);
                parsed.searchParams.set("tab_session", tabSession);
                return parsed.pathname + parsed.search;
            }

            function fetchOptions(extra = {}) {
                const headers = {...(extra.headers || {})};
                if (tabSession) headers["X-Tab-Session"] = tabSession;
                return {...extra, headers};
            }

            function buildUrlWithParams(url, params) {
                const parsed = new URL(withTabSession(url), window.location.origin);
                for (const [key, value] of Object.entries(params || {})) {
                    if (value !== undefined && value !== null && String(value).trim() !== "") {
                        parsed.searchParams.set(key, value);
                    }
                }
                return parsed.pathname + parsed.search;
            }

            function escapeHtml(value) {
                return String(value ?? "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            function formatHours(value) {
                const n = Number(value || 0);
                return `${n.toFixed(2)} h`;
            }

            function formatPercent(value) {
                const n = Number(value || 0);
                return `${n.toFixed(2)}%`;
            }

            function setCard(selectorName, name, value) {
                const el = document.querySelector(`[${selectorName}="${name}"]`);
                if (el) el.textContent = value;
            }

            function setEmpty(canvasId, visible, message = "Dati non disponibili.") {
                const empty = document.querySelector(`[data-empty-for="${canvasId}"]`);
                const canvas = document.getElementById(canvasId);
                if (empty) {
                    empty.textContent = message;
                    empty.classList.toggle("d-none", !visible);
                }
                if (canvas) canvas.classList.toggle("d-none", visible);
            }

            function destroyChart(key) {
                if (dashboardCharts[key]) {
                    dashboardCharts[key].destroy();
                    delete dashboardCharts[key];
                }
            }

            function renderChart(key, canvasId, config, hasData = true) {
                destroyChart(key);
                const canvas = document.getElementById(canvasId);
                if (!canvas) return;
                if (typeof Chart === "undefined") {
                    setEmpty(canvasId, true, "Chart.js non caricato.");
                    return;
                }
                if (!hasData) {
                    setEmpty(canvasId, true);
                    return;
                }
                setEmpty(canvasId, false);
                dashboardCharts[key] = new Chart(canvas, config);
            }

            function baseOptions(extra = {}) {
                return {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {position: "bottom"},
                        tooltip: {mode: "index", intersect: false},
                    },
                    ...extra,
                };
            }

            function colorByPercent(value) {
                const n = Number(value || 0);
                if (n > 100) return COLORS.red;
                if (n >= 80) return COLORS.orange;
                if (n >= 50) return COLORS.green;
                return COLORS.gray;
            }

            function renderCruscottoCarico(rows) {
                rows = rows || [];
                const labels = rows.map(x => x.label);
                const hasLoad = rows.some(x => Number(x.ore_totali || 0) > 0);

                renderChart("cruscotto_carico", "chart-cruscotto-carico", {
                    type: "bar",
                    data: {
                        labels,
                        datasets: [
                            {
                                label: "Arretrato",
                                data: rows.map(x => Number(x.ore_arretrate || 0)),
                                backgroundColor: COLORS.red,
                                stack: "carico"
                            },
                            {
                                label: "Senza scadenza",
                                data: rows.map(x => Number(x.ore_senza_scadenza || 0)),
                                backgroundColor: COLORS.gray,
                                stack: "carico"
                            },
                            {
                                label: "Attivo",
                                data: rows.map(x => Number(x.ore_attive || 0)),
                                backgroundColor: COLORS.green,
                                stack: "carico"
                            },
                            {
                                label: "Sospeso",
                                data: rows.map(x => Number(x.ore_sospese || 0)),
                                backgroundColor: COLORS.yellow,
                                stack: "carico"
                            },
                            {
                                label: "Pianificato",
                                data: rows.map(x => Number(x.ore_pianificate || 0)),
                                backgroundColor: COLORS.blue,
                                stack: "carico"
                            },
                            {
                                label: "Capacità",
                                type: "line",
                                data: rows.map(x => Number(x.capacita || 0)),
                                borderColor: BORDER_COLORS.red,
                                backgroundColor: COLORS.red,
                                tension: .25,
                                pointRadius: 2,
                                fill: false
                            },
                        ],
                    },
                    options: baseOptions({
                        scales: {
                            x: {stacked: true},
                            y: {beginAtZero: true, title: {display: true, text: "Ore"}}
                        }
                    }),
                }, hasLoad);
            }

            function renderCruscottoStati(rows) {
                renderChart("cruscotto_stati", "chart-cruscotto-stati", {
                    type: "doughnut",
                    data: {
                        labels: (rows || []).map(x => x.label),
                        datasets: [{
                            data: (rows || []).map(x => Number(x.value || 0)),
                            backgroundColor: [COLORS.blue, COLORS.green, COLORS.yellow],
                        }],
                    },
                    options: baseOptions(),
                }, rows?.some(x => Number(x.value || 0) > 0));
            }

            function renderCruscottoSaturazione(rows) {
                rows = rows || [];

                renderChart("cruscotto_saturazione", "chart-cruscotto-saturazione", {
                    type: "bar",
                    data: {
                        labels: rows.map(x => x.label),
                        datasets: [{
                            label: "Carico entro oggi / capacità odierna",
                            data: rows.map(x => Number(x.saturazione || 0)),
                            backgroundColor: rows.map(x => colorByPercent(x.saturazione)),
                        }],
                    },
                    options: baseOptions({
                        indexAxis: "y",
                        scales: {
                            x: {
                                beginAtZero: true,
                                title: {display: true, text: "% saturazione carico entro oggi"}
                            }
                        },
                        plugins: {
                            legend: {display: false},
                            tooltip: {
                                callbacks: {
                                    label: (context) => {
                                        const row = rows[context.dataIndex] || {};

                                        return [
                                            `Saturazione carico entro oggi: ${formatPercent(row.saturazione)}`,
                                            `Ore da assorbire entro oggi: ${formatHours(row.ore_totali)}`,
                                            `Ore disponibili oggi: ${formatHours(row.capacita)}`,
                                            `Scostamento oggi: ${formatHours(row.scostamento_ore)}`,
                                            `Operatori reparto: ${row.operatori_capacita ?? 0}`,
                                        ];
                                    }
                                }
                            }
                        },
                    }),
                }, rows.length > 0);
            }

            function renderCruscottoColliRisorsa(rows) {
                rows = rows || [];

                renderChart("cruscotto_colli_risorsa", "chart-cruscotto-colli-risorsa", {
                    type: "bar",
                    data: {
                        labels: rows.map(x => x.label),
                        datasets: [{
                            label: "Saturazione carico entro oggi",
                            data: rows.map(x => Number(x.saturazione || 0)),
                            backgroundColor: rows.map(x => colorByPercent(x.saturazione)),
                        }],
                    },
                    options: baseOptions({
                        indexAxis: "y",
                        scales: {
                            x: {
                                beginAtZero: true,
                                title: {display: true, text: "% saturazione"}
                            }
                        },
                        plugins: {
                            legend: {display: false},
                            tooltip: {
                                callbacks: {
                                    label: (context) => {
                                        const row = rows[context.dataIndex] || {};
                                        const capacita = row.senza_capacita
                                            ? "non configurata"
                                            : formatHours(row.capacita);

                                        return [
                                            `Saturazione: ${formatPercent(row.saturazione)}`,
                                            `Carico entro oggi: ${formatHours(row.ore_totali)}`,
                                            `Capacità odierna: ${capacita}`,
                                            `Operatori abilitati: ${row.operatori_capacita ?? 0}`,
                                        ];
                                    }
                                }
                            }
                        },
                    }),
                }, rows.length > 0);
            }

            function renderCruscottoReparti(rows) {
                renderChart("cruscotto_reparti", "chart-cruscotto-reparti", {
                    type: "bar",
                    data: {
                        labels: (rows || []).map(x => x.label),
                        datasets: [
                            {
                                label: "Attivo",
                                data: rows.map(x => Number(x.ore_attive || 0)),
                                backgroundColor: COLORS.green,
                                stack: "reparto"
                            },
                            {
                                label: "Sospeso",
                                data: rows.map(x => Number(x.ore_sospese || 0)),
                                backgroundColor: COLORS.yellow,
                                stack: "reparto"
                            },
                            {
                                label: "Pianificato",
                                data: rows.map(x => Number(x.ore_pianificate || 0)),
                                backgroundColor: COLORS.blue,
                                stack: "reparto"
                            },
                        ],
                    },
                    options: baseOptions({
                        scales: {
                            x: {stacked: true},
                            y: {stacked: true, beginAtZero: true, title: {display: true, text: "Ore"}}
                        }
                    }),
                }, rows?.length > 0);
            }

            function renderCruscottoRisorse(rows) {
                renderChart("cruscotto_risorse", "chart-cruscotto-risorse", {
                    type: "bar",
                    data: {
                        labels: (rows || []).map(x => x.label),
                        datasets: [
                            {
                                label: "Attivo",
                                data: rows.map(x => Number(x.ore_attive || 0)),
                                backgroundColor: COLORS.green,
                                stack: "risorsa"
                            },
                            {
                                label: "Sospeso",
                                data: rows.map(x => Number(x.ore_sospese || 0)),
                                backgroundColor: COLORS.yellow,
                                stack: "risorsa"
                            },
                            {
                                label: "Pianificato",
                                data: rows.map(x => Number(x.ore_pianificate || 0)),
                                backgroundColor: COLORS.blue,
                                stack: "risorsa"
                            },
                        ],
                    },
                    options: baseOptions({
                        indexAxis: "x",
                        scales: {
                            y: {stacked: true, beginAtZero: true, title: {display: true, text: "Ore"}},
                            x: {stacked: true}
                        }
                    }),
                }, rows?.length > 0);
            }

            function renderCruscottoOrdiniReparto(rows) {
                rows = rows || [];

                renderChart("cruscotto_ordini_reparto", "chart-cruscotto-ordini-reparto", {
                    type: "bar",
                    data: {
                        labels: rows.map(x => x.label),
                        datasets: [
                            {
                                label: "Attivi",
                                data: rows.map(x => Number(x.ordini_attivi || 0)),
                                backgroundColor: COLORS.green,
                                stack: "ordini"
                            },
                            {
                                label: "Sospesi",
                                data: rows.map(x => Number(x.ordini_sospesi || 0)),
                                backgroundColor: COLORS.yellow,
                                stack: "ordini"
                            },
                            {
                                label: "Pianificati",
                                data: rows.map(x => Number(x.ordini_pianificati || 0)),
                                backgroundColor: COLORS.blue,
                                stack: "ordini"
                            },
                        ],
                    },
                    options: baseOptions({
                        indexAxis: "y",
                        scales: {
                            x: {
                                stacked: true,
                                beginAtZero: true,
                                ticks: {
                                    precision: 0
                                },
                                title: {
                                    display: true,
                                    text: "Numero ODP"
                                }
                            },
                            y: {
                                stacked: true
                            }
                        }
                    }),
                }, rows.some(x => Number(x.ordini_totali || 0) > 0));
            }


            function renderCruscottoOrdiniRisorsa(rows) {
                rows = rows || [];

                renderChart("cruscotto_ordini_risorsa", "chart-cruscotto-ordini-risorsa", {
                    type: "bar",
                    data: {
                        labels: rows.map(x => x.label),
                        datasets: [
                            {
                                label: "Attivi",
                                data: rows.map(x => Number(x.ordini_attivi || 0)),
                                backgroundColor: COLORS.green,
                                stack: "ordini"
                            },
                            {
                                label: "Sospesi",
                                data: rows.map(x => Number(x.ordini_sospesi || 0)),
                                backgroundColor: COLORS.yellow,
                                stack: "ordini"
                            },
                            {
                                label: "Pianificati",
                                data: rows.map(x => Number(x.ordini_pianificati || 0)),
                                backgroundColor: COLORS.blue,
                                stack: "ordini"
                            },
                        ],
                    },
                    options: baseOptions({
                        indexAxis: "y",
                        scales: {
                            x: {
                                stacked: true,
                                beginAtZero: true,
                                ticks: {
                                    precision: 0
                                },
                                title: {
                                    display: true,
                                    text: "Numero ODP"
                                }
                            },
                            y: {
                                stacked: true
                            }
                        }
                    }),
                }, rows.some(x => Number(x.ordini_totali || 0) > 0));
            }

            function renderCriticitaList(rows) {
                const target = document.getElementById("dashboard-criticita-list");
                if (!target) return;
                if (!rows?.length) {
                    target.innerHTML = `<div class="text-muted">Nessuna criticità.</div>`;
                    return;
                }
                target.innerHTML = rows.slice(0, 15).map(row => `
                    <div class="dashboard-list-item">
                        <div class="d-flex justify-content-between gap-2">
                            <div>
                                <div class="fw-semibold">${escapeHtml(row.tipo)} · ${escapeHtml(row.ordine)}</div>
                                <div class="small text-muted">${escapeHtml(row.cod_art)} ${escapeHtml(row.descrizione)}</div>
                                <div class="small">${escapeHtml(row.reparto)} · ${escapeHtml(row.risorsa)} · ${escapeHtml(row.stato)}</div>
                            </div>
                            <div class="text-end small">
                                <div>${escapeHtml(row.data_fine_prevista || "-")}</div>
                                ${Number(row.ritardo_giorni || 0) > 0 ? `<span class="badge text-bg-danger">${escapeHtml(row.ritardo_giorni)}g</span>` : ""}
                            </div>
                        </div>
                    </div>
                `).join("");
            }

            function getCruscottoFilters() {
                return {
                    reparto: document.getElementById("cruscotto-reparto")?.value || "",
                    risorsa: document.getElementById("cruscotto-risorsa")?.value || "",
                    lavorazione: document.getElementById("cruscotto-lavorazione")?.value || "",
                    operatore: document.getElementById("cruscotto-operatore")?.value || "",
                    articolo: document.getElementById("cruscotto-articolo")?.value || "",
                    stato: document.getElementById("cruscotto-stato")?.value || "",
                };
            }

            function resetCruscottoFilters() {
                ["cruscotto-reparto", "cruscotto-risorsa", "cruscotto-lavorazione", "cruscotto-operatore", "cruscotto-articolo", "cruscotto-stato"].forEach(id => {
                    const el = document.getElementById(id);
                    if (el) el.value = "";
                });
            }

            function resetKpiFilters() {
                [
                    "kpi-reparto",
                    "kpi-risorsa",
                    "kpi-lavorazione",
                    "kpi-articolo",
                    "kpi-operatore",
                    "kpi-stato",
                ].forEach(id => {
                    const el = document.getElementById(id);
                    if (el) el.value = "";
                });

                const fromInput = document.getElementById("kpi-date-from");
                const toInput = document.getElementById("kpi-date-to");

                if (fromInput) fromInput.value = "";
                if (toInput) toInput.value = "";

                setDefaultKpiDates();
            }

            async function loadCruscotto() {
                const section = document.getElementById("dashboard-produzione-cruscotto");
                if (!section) return;

                const resp = await fetch(
                    buildUrlWithParams(section.dataset.apiUrl, getCruscottoFilters()),
                    fetchOptions()
                );

                const payload = await resp.json();

                if (!resp.ok || payload.ok === false) {
                    throw new Error(payload.error || `Errore HTTP ${resp.status}`);
                }

                const data = payload.data || {};

                updateFilterSelects(
                    "dashboard-produzione-cruscotto",
                    data.filter_options || {}
                );

                const cards = data.cards || {};
                setCard("data-dashboard-card", "ordini_totali", cards.ordini_totali ?? 0);
                setCard("data-dashboard-card", "ordini_attivi", cards.ordini_attivi ?? 0);
                setCard("data-dashboard-card", "ordini_sospesi", cards.ordini_sospesi ?? 0);
                setCard("data-dashboard-card", "ordini_pianificati", cards.ordini_pianificati ?? 0);

                setCard(
                    "data-dashboard-card",
                    "tempo_previsto_residuo",
                    formatHours(cards.tempo_previsto_residuo)
                );

                setCard(
                    "data-dashboard-card",
                    "ore_previste_produzione",
                    formatHours(cards.ore_previste_produzione)
                );

                setCard(
                    "data-dashboard-card",
                    "ore_disponibili_oggi",
                    formatHours(cards.ore_disponibili_oggi)
                );

                setCard(
                    "data-dashboard-card-sub",
                    "operatori_capacita",
                    `${cards.operatori_capacita ?? 0} operatori`
                );
                setCard(
                    "data-dashboard-card",
                    "saturazione_totale",
                    formatPercent(cards.saturazione_totale)
                );

                setCard(
                    "data-dashboard-card-sub",
                    "saturazione_totale_ore",
                    `${formatHours(cards.ore_previste_oggi)} / ${formatHours(cards.ore_disponibili_oggi)}`
                );
                setCard(
                    "data-dashboard-card",
                    "incidenza_sospensioni",
                    formatPercent(cards.incidenza_sospensioni)
                );
                setCard(
                    "data-dashboard-card-sub",
                    "incidenza_sospensioni",
                    `${cards.ordini_sospesi ?? 0} / ${cards.ordini_totali ?? 0} ODP`
                );
                setCard(
                    "data-dashboard-card",
                    "gap_capacita_7_giorni",
                    formatSignedHours(cards.gap_capacita_7_giorni)
                );
                setCard(
                    "data-dashboard-card-sub",
                    "gap_capacita_7_giorni",
                    `${formatHours(cards.carico_7_giorni)} / ${formatHours(cards.capacita_7_giorni)}`
                );
                setCard(
                    "data-dashboard-card",
                    "risorse_collo_bottiglia",
                    cards.risorse_collo_bottiglia ?? 0
                );

                setCard("data-dashboard-card", "ordini_critici", cards.ordini_critici ?? 0);
                setCard("data-dashboard-card", "risorse_sovraccariche", cards.risorse_sovraccariche ?? 0);

                renderCruscottoCarico(data.charts?.carico_prossimi_giorni || []);
                renderCruscottoStati(data.charts?.stati_ordine || []);
                renderCruscottoSaturazione(data.charts?.saturazione_risorse || []);
                renderCruscottoColliRisorsa(data.charts?.colli_bottiglia_risorse || []);
                renderCruscottoReparti(data.charts?.carico_per_reparto || []);
                renderCruscottoRisorse(data.charts?.carico_per_risorsa || []);
                renderCruscottoOrdiniReparto(data.charts?.ordini_per_reparto || []);
                renderCruscottoOrdiniRisorsa(data.charts?.ordini_per_risorsa || []);
                renderCriticitaList(data.criticita || []);
            }

            function setDefaultKpiDates() {
                const fromInput = document.getElementById("kpi-date-from");
                const toInput = document.getElementById("kpi-date-to");
                if (!fromInput || !toInput) return;
                const localDate = date => {
                    const offset = date.getTimezoneOffset() * 60_000;
                    return new Date(date.getTime() - offset).toISOString().slice(0, 10);
                };
                const today = new Date();
                const from = new Date(today);
                from.setFullYear(today.getFullYear() - 1);
                if (!fromInput.value) fromInput.value = localDate(from);
                if (!toInput.value) toInput.value = localDate(today);
            }

            function getKpiFilters() {
                return {
                    date_from: document.getElementById("kpi-date-from")?.value || "",
                    date_to: document.getElementById("kpi-date-to")?.value || "",
                    reparto: document.getElementById("kpi-reparto")?.value || "",
                    risorsa: document.getElementById("kpi-risorsa")?.value || "",
                    lavorazione: document.getElementById("kpi-lavorazione")?.value || "",
                    articolo: document.getElementById("kpi-articolo")?.value || "",
                    operatore: document.getElementById("kpi-operatore")?.value || "",
                    stato: document.getElementById("kpi-stato")?.value || "",
                };
            }

            function renderKpiTempoRealeVsPrevisto(rows) {
                renderChart("kpi_tempi", "chart-kpi-tempi", {
                    type: "bar",
                    data: {
                        labels: (rows || []).map(x => x.label),
                        datasets: [{
                            label: "Ore",
                            data: rows.map(x => Number(x.value || 0)),
                            backgroundColor: [COLORS.blue, COLORS.orange]
                        }],
                    },
                    options: baseOptions({
                        plugins: {legend: {display: false}},
                        scales: {y: {beginAtZero: true, title: {display: true, text: "Ore"}}}
                    }),
                }, rows?.some(x => Number(x.value || 0) > 0));
            }

            function renderKpiAffidabilita(rows) {
                renderChart("kpi_affidabilita", "chart-kpi-affidabilita", {
                    type: "doughnut",
                    data: {
                        labels: (rows || []).map(x => x.label),
                        datasets: [{
                            data: rows.map(x => Number(x.value || 0)),
                            backgroundColor: [COLORS.green, COLORS.red]
                        }],
                    },
                    options: baseOptions(),
                }, rows?.some(x => Number(x.value || 0) > 0));
            }

            function renderKpiHorizontalPercent(key, canvasId, rows, label) {
                renderChart(key, canvasId, {
                    type: "bar",
                    data: {
                        labels: (rows || []).map(x => x.label),
                        datasets: [{
                            label,
                            data: rows.map(x => Number(x.value || 0)),
                            backgroundColor: rows.map(x => Number(x.value || 0) > 25 ? COLORS.red : Number(x.value || 0) > 10 ? COLORS.orange : COLORS.yellow),
                        }],
                    },
                    options: baseOptions({
                        indexAxis: "y",
                        plugins: {legend: {display: false}},
                        scales: {x: {beginAtZero: true, title: {display: true, text: "%"}}}
                    }),
                }, rows?.length > 0);
            }

            function renderKpiRitardoReparto(rows) {
                renderChart("kpi_ritardo_reparto", "chart-kpi-ritardo-reparto", {
                    type: "bar",
                    data: {
                        labels: (rows || []).map(x => x.label),
                        datasets: [{
                            label: "Giorni",
                            data: rows.map(x => Number(x.value || 0)),
                            backgroundColor: COLORS.red
                        }],
                    },
                    options: baseOptions({
                        indexAxis: "y",
                        plugins: {legend: {display: false}},
                        scales: {x: {beginAtZero: true, title: {display: true, text: "Giorni"}}}
                    }),
                }, rows?.length > 0);
            }

            async function loadKpi() {
                const section = document.getElementById("dashboard-produzione-kpi");
                if (!section) return;

                const resp = await fetch(
                    buildUrlWithParams(section.dataset.apiUrl, getKpiFilters()),
                    fetchOptions()
                );

                const payload = await resp.json();

                if (!resp.ok || payload.ok === false) {
                    throw new Error(payload.error || `Errore HTTP ${resp.status}`);
                }

                const data = payload.data || {};

                updateFilterSelects(
                    "dashboard-produzione-kpi",
                    data.filter_options || {}
                );

                const cards = data.cards || {};

                setCard("data-kpi-card", "ordini_chiusi", cards.ordini_chiusi ?? 0);
                setCard("data-kpi-card", "percentuale_ritardo", formatPercent(cards.percentuale_ritardo));
                setCard("data-kpi-card", "giorni_medi_ritardo", `${Number(cards.giorni_medi_ritardo || 0).toFixed(2)} g`);
                setCard("data-kpi-card", "scostamento_percentuale", formatPercent(cards.scostamento_percentuale));
                setCard("data-kpi-card", "affidabilita_tempi", formatPercent(cards.affidabilita_tempi));
                setCard("data-kpi-card-sub", "ordini_in_ritardo", `${cards.ordini_in_ritardo ?? 0} ordini`);
                setCard("data-kpi-card-sub", "scostamento_totale", formatHours(cards.scostamento_totale));
                setCard("data-kpi-card", "macchine_prodotte", Number(cards.macchine_prodotte || 0).toFixed(0));
                setCard("data-kpi-card", "tasso_non_conformita", formatPercent(cards.tasso_non_conformita));
                setCard(
                    "data-kpi-card-sub",
                    "tasso_non_conformita",
                    `${Number(cards.quantita_non_conforme || 0).toFixed(0)} NC / ${Number(cards.quantita_consuntivata || 0).toFixed(0)} consuntivati`
                );
                setCard("data-kpi-card", "lead_time_medio_ore", formatHours(cards.lead_time_medio_ore));
                setCard(
                    "data-kpi-card-sub",
                    "lead_time",
                    `mediana ${formatHours(cards.lead_time_mediano_ore)} · ${cards.lead_time_copertura ?? 0} ODP`
                );
                setCard("data-kpi-card", "copertura_dati", formatPercent(cards.copertura_dati));
                setCard(
                    "data-kpi-card-sub",
                    "copertura_dati",
                    `${cards.fasi_dati_completi ?? 0} / ${cards.fasi_totali ?? 0} fasi complete`
                );

                renderKpiTempoRealeVsPrevisto(data.charts?.tempo_reale_vs_previsto || []);
                renderKpiAffidabilita(data.charts?.affidabilita_tempi || []);
                renderKpiRitardoReparto((data.charts?.ritardo_medio_reparto || []).slice(0, 8));
                renderKpiHorizontalPercent(
                    "kpi_risorse_scostamento",
                    "chart-kpi-risorse-scostamento",
                    data.charts?.top_risorse_scostamento || [],
                    "% scostamento"
                );
                renderKpiHorizontalPercent(
                    "kpi_lavorazioni_scostamento",
                    "chart-kpi-lavorazioni-scostamento",
                    data.charts?.top_lavorazioni_scostamento || [],
                    "% scostamento"
                );
            }

            function exportKpi() {
                const section = document.getElementById("dashboard-produzione-kpi");
                if (!section?.dataset.exportUrl) return;
                window.location.href = buildUrlWithParams(section.dataset.exportUrl, getKpiFilters());
            }

            function setSnapshotCard(name, value) {
                const el = document.querySelector(`[data-snapshot-card="${name}"]`);
                if (el) el.textContent = value;
            }

            function setSnapshotDelta(name, comparison, suffix = "", positiveIsGood = false) {
                const el = document.querySelector(`[data-snapshot-delta="${name}"]`);
                if (!el) return;
                if (!comparison) {
                    el.textContent = "";
                    return;
                }
                const delta = Number(comparison.delta || 0);
                const sign = delta > 0 ? "+" : "";
                el.textContent = `${sign}${delta.toFixed(2)}${suffix} vs precedente`;
                el.classList.toggle("text-danger", positiveIsGood ? delta < 0 : delta > 0);
                el.classList.toggle("text-success", positiveIsGood ? delta > 0 : delta < 0);
            }

            function renderSnapshotScopeOptions(scopes, selectedValue) {
                const select = document.getElementById("kpi-snapshot-scope");
                if (!select) return;
                const rows = scopes?.length ? scopes : [{scope_type: "global", scope_code: "*", label: "global: *"}];
                select.innerHTML = rows.map(row => {
                    const value = `${row.scope_type}|${row.scope_code}`;
                    return `<option value="${escapeHtml(value)}">${escapeHtml(row.label || value)}</option>`;
                }).join("");
                if (selectedValue) select.value = selectedValue;
            }

            function renderSnapshotCharts(rows) {
                rows = Array.isArray(rows) ? rows : [];

                const labels = rows.map(x => x.snapshot_month);
                const hasRows = rows.length > 0;

                renderChart("snapshot_ordini", "chart-snapshot-ordini", {
                    type: "line",
                    data: {
                        labels,
                        datasets: [
                            {
                                label: "Macchine prodotte",
                                data: rows.map(x => Number(x.macchine_prodotte || 0)),
                                borderColor: BORDER_COLORS.green,
                                backgroundColor: COLORS.green,
                                tension: .25
                            },
                            {
                                label: "Ordini completati",
                                data: rows.map(x => Number(x.ordini_chiusi || 0)),
                                borderColor: BORDER_COLORS.blue,
                                backgroundColor: COLORS.blue,
                                tension: .25
                            },
                            {
                                label: "Ordini in ritardo",
                                data: rows.map(x => Number(x.ordini_in_ritardo || 0)),
                                borderColor: BORDER_COLORS.red,
                                backgroundColor: COLORS.red,
                                tension: .25
                            },
                        ],
                    },
                    options: baseOptions({
                        scales: {
                            y: {
                                beginAtZero: true,
                                title: {
                                    display: true,
                                    text: "Quantità"
                                }
                            }
                        }
                    }),
                }, hasRows);

                const hasTempi = rows.some(row => {
                    return Number(row.tempo_previsto_totale || 0) !== 0
                        || Number(row.tempo_reale_totale || 0) !== 0
                        || Number(row.scostamento_totale || 0) !== 0;
                });

                renderChart("snapshot_tempi", "chart-snapshot-tempi", {
                    type: "line",
                    data: {
                        labels,
                        datasets: [
                            {
                                label: "Tempo previsto",
                                data: rows.map(x => Number(x.tempo_previsto_totale || 0)),
                                borderColor: BORDER_COLORS.blue,
                                backgroundColor: COLORS.blue,
                                tension: .25
                            },
                            {
                                label: "Tempo reale",
                                data: rows.map(x => Number(x.tempo_reale_totale || 0)),
                                borderColor: BORDER_COLORS.orange,
                                backgroundColor: COLORS.orange,
                                tension: .25
                            },
                            {
                                label: "Scostamento",
                                data: rows.map(x => Number(x.scostamento_totale || 0)),
                                borderColor: BORDER_COLORS.red,
                                backgroundColor: COLORS.red,
                                tension: .25
                            },
                        ],
                    },
                    options: baseOptions({
                        scales: {
                            y: {
                                beginAtZero: true,
                                title: {
                                    display: true,
                                    text: "Ore"
                                }
                            }
                        }
                    }),
                }, hasTempi);
            }

            function formatSignedHours(value) {
                const n = Number(value || 0);
                const sign = n > 0 ? "+" : "";
                return `${sign}${n.toFixed(2)} h`;
            }

            function renderSnapshotTempiTable(rows) {
                const tbody = document.getElementById("tbody-snapshot-tempi");
                if (!tbody) return;

                rows = Array.isArray(rows) ? rows : [];

                if (!rows.length) {
                    tbody.innerHTML = `
            <tr>
                <td colspan="6" class="text-center text-muted py-3">
                    Nessuno snapshot disponibile.
                </td>
            </tr>
        `;
                    return;
                }

                tbody.innerHTML = rows.map(row => {
                    const scostamento = Number(row.scostamento_totale || 0);
                    const scostamentoClass = scostamento > 0
                        ? "text-danger"
                        : scostamento < 0
                            ? "text-success"
                            : "";

                    return `
            <tr>
                <td>${escapeHtml(row.snapshot_month || "")}</td>
                <td class="text-end">${formatHours(row.tempo_previsto_totale)}</td>
                <td class="text-end">${formatHours(row.tempo_reale_totale)}</td>
                <td class="text-end ${scostamentoClass}">${formatSignedHours(scostamento)}</td>
                <td class="text-end ${scostamentoClass}">${formatPercent(row.scostamento_percentuale)}</td>
                <td class="text-end">${formatHours(row.tempo_medio_fase)}</td>
            </tr>
        `;
                }).join("");
            }

            async function loadSnapshots() {
                const section = document.getElementById("dashboard-produzione-kpi");
                if (!section?.dataset.snapshotUrl) return;
                const scopeSelect = document.getElementById("kpi-snapshot-scope");
                const monthsSelect = document.getElementById("kpi-snapshot-months");
                const [scope_type, scope_code] = String(scopeSelect?.value || "global|*").split("|");
                const params = {
                    scope_type: scope_type || "global",
                    scope_code: scope_code || "*",
                    months: monthsSelect?.value || "12"
                };
                const resp = await fetch(buildUrlWithParams(section.dataset.snapshotUrl, params), fetchOptions());
                const payload = await resp.json();
                if (!resp.ok || payload.ok === false) throw new Error(payload.error || `Errore HTTP ${resp.status}`);

                const data = payload.data || {};
                renderSnapshotScopeOptions(data.available_scopes || [], `${params.scope_type}|${params.scope_code}`);
                const rows = data.rows || [];
                const latest = rows.length ? rows[rows.length - 1] : null;

                setSnapshotCard("ordini_chiusi", latest?.ordini_chiusi ?? 0);

                setSnapshotCard("snapshot_month", latest?.snapshot_month || "-");

                setSnapshotCard(
                    "macchine_prodotte",
                    Number(latest?.macchine_prodotte || 0).toFixed(0)
                );

                setSnapshotCard("percentuale_ritardo", formatPercent(latest?.percentuale_ritardo));
                setSnapshotCard("scostamento_totale", formatHours(latest?.scostamento_totale));
                setSnapshotDelta("ordini_chiusi", data.comparison?.ordini_chiusi, "", true);
                setSnapshotDelta("macchine_prodotte", data.comparison?.macchine_prodotte, "", true);
                setSnapshotDelta("percentuale_ritardo", data.comparison?.percentuale_ritardo, "%");
                setSnapshotDelta("scostamento_totale", data.comparison?.scostamento_totale, " h");
                renderSnapshotCharts(rows);
                renderSnapshotTempiTable(rows);
            }

            bindFilterAutoReload("dashboard-produzione-cruscotto", loadCruscotto);
            bindFilterAutoReload("dashboard-produzione-kpi", loadKpi);
            document.getElementById("btn-kpi-reset")?.addEventListener("click", () => {
                resetKpiFilters();
                loadKpi().catch(console.error);
            });
            document.getElementById("btn-cruscotto-filtra")?.addEventListener("click", () => loadCruscotto().catch(console.error));
            document.getElementById("btn-cruscotto-reset")?.addEventListener("click", () => {
                resetCruscottoFilters();
                loadCruscotto().catch(console.error);
            });
            document.getElementById("btn-kpi-filtra")?.addEventListener("click", () => loadKpi().catch(console.error));
            document.getElementById("btn-kpi-export")?.addEventListener("click", exportKpi);
            document.getElementById("btn-kpi-snapshot-load")?.addEventListener("click", () => loadSnapshots().catch(console.error));
            document.getElementById("kpi-snapshot-scope")?.addEventListener("change", () => loadSnapshots().catch(console.error));
            document.getElementById("kpi-snapshot-months")?.addEventListener("change", () => loadSnapshots().catch(console.error));

            setDefaultKpiDates();
            loadCruscotto().catch(console.error);
            loadKpi().then(() => loadSnapshots()).catch(console.error);
        })();
    </script>
{% endblock %}
