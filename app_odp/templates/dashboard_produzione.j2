                if (!rows?.length) {
                    target.innerHTML = `
                <tr>
                    <td colspan="5" class="text-center text-muted py-3">
                        Nessun carico risorsa disponibile.
                    </td>
                </tr>
            `;
                    return;
                }

                target.innerHTML = rows.map(row => `
            <tr>
                <td>${escapeHtml(row.risorsa)}</td>
