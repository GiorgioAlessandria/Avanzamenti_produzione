            function renderCaricoProssimiGiorni(rows) {
                const target = document.getElementById("dashboard-chart-carico");
                if (!target) return;

                if (!rows?.length) {
                    target.innerHTML = `<div class="text-muted">Nessun dato carico disponibile.</div>`;
                    return;
                }

                target.innerHTML = `
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                    <tr>
                        <th>Giorno</th>
                        <th class="text-end">Attivo</th>
                        <th class="text-end">Sospeso</th>
                        <th class="text-end">Pianificato</th>
                        <th class="text-end">Totale</th>
                        <th class="text-end">Capacità</th>
                    </tr>
                    </thead>
                    <tbody>
                    ${rows.map(row => `
                        <tr class="${row.sovraccarico ? "table-danger" : ""}">
                            <td>${escapeHtml(row.label)}</td>
                            <td class="text-end">${formatHours(row.ore_attive)}</td>
                            <td class="text-end">${formatHours(row.ore_sospese)}</td>
                            <td class="text-end">${formatHours(row.ore_pianificate)}</td>
                            <td class="text-end fw-semibold">${formatHours(row.ore_totali)}</td>
                            <td class="text-end">${formatHours(row.capacita)}</td>
                        </tr>
                    `).join("")}
                    </tbody>
                </table>
            </div>
        `;
            }

            function renderStatiOrdine(rows) {
                const target = document.getElementById("dashboard-chart-stati");
                if (!target) return;

                if (!rows?.length) {
                    target.innerHTML = `<div class="text-muted">Nessun dato stati disponibile.</div>`;
                    return;
                }

                const total = rows.reduce((acc, row) => acc + Number(row.value || 0), 0);

                target.innerHTML = rows.map(row => {
                    const value = Number(row.value || 0);
                    const pct = total > 0 ? (value / total) * 100 : 0;

                    return `
                <div class="mb-2">
                    <div class="d-flex justify-content-between">
                        <span>${escapeHtml(row.label)}</span>
                        <strong>${value}</strong>
                    </div>
                    <div class="progress" style="height: 10px;">
                        <div class="progress-bar" style="width: ${pct.toFixed(2)}%;"></div>
                    </div>
                </div>
            `;
                }).join("");
            }

            async function loadCruscotto() {
                const section = document.getElementById("dashboard-produzione-cruscotto");
                if (!section) return;

                const apiUrl = section.dataset.apiUrl;
                const finalUrl = buildUrlWithParams(apiUrl, getCruscottoFilters());
                const resp = await fetch(finalUrl, fetchOptions());
                const payload = await resp.json();

                if (!resp.ok || payload.ok === false) {
                    throw new Error(payload.error || `Errore HTTP ${resp.status}`);
                }

                const data = payload.data || {};
                const cards = data.cards || {};

                setCard("ordini_attivi", cards.ordini_attivi ?? 0);
                setCard("ordini_sospesi", cards.ordini_sospesi ?? 0);
                setCard("ordini_pianificati", cards.ordini_pianificati ?? 0);
                setCard("tempo_previsto_residuo", formatHours(cards.tempo_previsto_residuo));
                setCard("operatori_impegnati", cards.operatori_impegnati ?? 0);

                renderCaricoProssimiGiorni(data.charts?.carico_prossimi_giorni || []);
                renderStatiOrdine(data.charts?.stati_ordine || []);
                renderCriticita(data.criticita || []);
                renderOperatori(data.operatori || []);
                renderCaricoRisorsa(data.carico_risorsa || []);
                renderDashboardDetails(data.details || []);
            }

            function setKpiCard(name, value) {
                const el = document.querySelector(`[data-kpi-card="${name}"]`);
                if (el) el.textContent = value;
            }

            function getKpiFilters() {
                return {
                    date_from: document.getElementById("kpi-date-from")?.value || "",
                    date_to: document.getElementById("kpi-date-to")?.value || "",
                    reparto: document.getElementById("kpi-reparto")?.value || "",
                    risorsa: document.getElementById("kpi-risorsa")?.value || "",
                    lavorazione: document.getElementById("kpi-lavorazione")?.value || "",
                    articolo: document.getElementById("kpi-articolo")?.value || "",
                    operatore: document.getElementById("kpi-operatore")?.value || "",
                    stato: document.getElementById("kpi-stato")?.value || "",
                };
            }

            function buildUrlWithParams(url, params) {
                const parsed = new URL(withTabSession(url), window.location.origin);

                for (const [key, value] of Object.entries(params || {})) {
                    if (value !== undefined && value !== null && String(value).trim() !== "") {
                        parsed.searchParams.set(key, value);
                    }
                }

                return parsed.pathname + parsed.search;
            }

            function renderKpiDetails(rows) {
                const tbody = document.getElementById("dashboard-kpi-detail-body");
                if (!tbody) return;

                if (!rows?.length) {
                    tbody.innerHTML = `
                <tr>
                    <td colspan="12" class="text-center text-muted py-3">
                        Nessun dato KPI disponibile.
                    </td>
                </tr>
            `;
                    return;
                }

                tbody.innerHTML = rows.map(row => `
            <tr>
                <td>${escapeHtml(row.data_chiusura)}</td>
                <td>${escapeHtml(row.ordine)}</td>
                <td>
                    <div class="fw-semibold">${escapeHtml(row.articolo)}</div>
                    <div class="small text-muted">${escapeHtml(row.descrizione)}</div>
                </td>
                <td>${escapeHtml(row.reparto)}</td>
                <td>${escapeHtml(row.risorsa)}</td>
                <td>${escapeHtml(row.lavorazione)}</td>
                <td>${escapeHtml(row.operatore)}</td>
                <td class="text-end">${formatHours(row.tempo_previsto_ore)}</td>
                <td class="text-end">${formatHours(row.tempo_reale_ore)}</td>
                <td class="text-end">${formatHours(row.scostamento_ore)}</td>
                <td class="text-end">${escapeHtml(row.ritardo_giorni || 0)}</td>
                <td>${row.is_collaudo ? '<span class="badge text-bg-info">Collaudo</span>' : ''}</td>
            </tr>
        `).join("");
            }

            function renderKpiAggregati(rows, targetId) {
                const target = document.getElementById(targetId);
                if (!target) return;

                if (!rows?.length) {
                    target.innerHTML = `<div class="text-muted">Nessun dato disponibile.</div>`;
                    return;
                }

                target.innerHTML = `
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                    <tr>
                        <th>Voce</th>
                        <th class="text-end">Ordini</th>
                        <th class="text-end">Reale</th>
                        <th class="text-end">Previsto</th>
                        <th class="text-end">Scost.</th>
                        <th class="text-end">Ritardo medio</th>
                    </tr>
                    </thead>
                    <tbody>
                    ${rows.map(row => `
                        <tr>
                            <td>${escapeHtml(row.key)}</td>
                            <td class="text-end">${escapeHtml(row.ordini)}</td>
                            <td class="text-end">${formatHours(row.tempo_reale)}</td>
                            <td class="text-end">${formatHours(row.tempo_previsto)}</td>
                            <td class="text-end">${formatHours(row.scostamento)}</td>
                            <td class="text-end">${escapeHtml(row.giorni_medi_ritardo)} g</td>
                        </tr>
                    `).join("")}
                    </tbody>
                </table>
            </div>
        `;
            }

            function renderKpiTempoRealeVsPrevisto(rows) {
                const target = document.getElementById("dashboard-kpi-chart-tempi");
                if (!target) return;

                if (!rows?.length) {
                    target.innerHTML = `<div class="text-muted">Nessun dato tempi disponibile.</div>`;
                    return;
                }

                const max = Math.max(...rows.map(x => Number(x.value || 0)), 1);

                target.innerHTML = rows.map(row => {
                    const value = Number(row.value || 0);
                    const pct = (value / max) * 100;

                    return `
                <div class="mb-2">
                    <div class="d-flex justify-content-between">
                        <span>${escapeHtml(row.label)}</span>
                        <strong>${formatHours(value)}</strong>
                    </div>
                    <div class="progress" style="height: 10px;">
                        <div class="progress-bar" style="width: ${pct.toFixed(2)}%;"></div>
                    </div>
                </div>
            `;
                }).join("");
            }

            setDefaultKpiDates();

            async function loadKpi() {
                const section = document.getElementById("dashboard-produzione-kpi");
                if (!section) return;

                const apiUrl = section.dataset.apiUrl;
                const finalUrl = buildUrlWithParams(apiUrl, getKpiFilters());

                const resp = await fetch(finalUrl, fetchOptions());
                const payload = await resp.json();

                if (!resp.ok || payload.ok === false) {
                    throw new Error(payload.error || `Errore HTTP ${resp.status}`);
                }

                const data = payload.data || {};
                const cards = data.cards || {};

                setKpiCard("ordini_chiusi", cards.ordini_chiusi ?? 0);
                setKpiCard("ordini_in_ritardo", cards.ordini_in_ritardo ?? 0);
                setKpiCard("percentuale_ritardo", `${Number(cards.percentuale_ritardo || 0).toFixed(2)}%`);
                setKpiCard("tempo_reale_vs_previsto", formatHours(cards.tempo_reale_vs_previsto));
                setKpiCard("scostamento_medio", formatHours(cards.scostamento_medio));
                setKpiCard("tempo_medio_fase", formatHours(cards.tempo_medio_fase));

                renderKpiTempoRealeVsPrevisto(data.charts?.tempo_reale_vs_previsto || []);
                renderKpiDetails(data.details || []);

                renderKpiAggregati(data.aggregati?.reparti || [], "dashboard-kpi-agg-reparti");
                renderKpiAggregati(data.aggregati?.risorse || [], "dashboard-kpi-agg-risorse");
                renderKpiAggregati(data.aggregati?.lavorazioni || [], "dashboard-kpi-agg-lavorazioni");
                renderKpiAggregati(data.aggregati?.operatori || [], "dashboard-kpi-agg-operatori");
                renderKpiAggregati(data.aggregati?.articoli || [], "dashboard-kpi-agg-articoli");
            }

            function exportKpi() {
                const section = document.getElementById("dashboard-produzione-kpi");
                if (!section) return;

                const exportUrl = section.dataset.exportUrl;
                if (!exportUrl) return;

                const finalUrl = buildUrlWithParams(exportUrl, getKpiFilters());
                window.location.href = finalUrl;
            }

            function setSnapshotCard(name, value) {
                const el = document.querySelector(`[data-snapshot-card="${name}"]`);
                if (el) el.textContent = value;
            }

            function setSnapshotDelta(name, change) {
                const el = document.querySelector(`[data-snapshot-delta="${name}"]`);
                if (!el) return;

                if (!change) {
                    el.textContent = "";
                    return;
                }

                const delta = Number(change.delta || 0);
                const pct = Number(change.delta_percent || 0);

                const sign = delta > 0 ? "+" : "";
                const tone = delta > 0 ? "text-danger" : delta < 0 ? "text-success" : "text-muted";

                el.className = `small ${tone}`;
                el.textContent = `${sign}${delta.toFixed(2)} (${sign}${pct.toFixed(2)}%) vs mese precedente`;
            }

            function renderSnapshotScopeOptions(scopes, selectedValue) {
                const select = document.getElementById("kpi-snapshot-scope");
                if (!select) return;

                const current = selectedValue || select.value || "global|*";
                const options = [`<option value="global|*">Globale</option>`];

                for (const row of scopes || []) {
                    const value = `${row.scope_type}|${row.scope_code}`;
                    if (value === "global|*") continue;
                    options.push(`<option value="${escapeHtml(value)}">${escapeHtml(row.label)}</option>`);
                }

                select.innerHTML = options.join("");

                if ([...select.options].some(opt => opt.value === current)) {
                    select.value = current;
                }
            }

            function renderSnapshotOrdiniChart(seriesOrdini, seriesRitardi) {
                const target = document.getElementById("kpi-snapshot-chart-ordini");
                if (!target) return;

                const rows = seriesOrdini || [];
                const ritardiByMonth = new Map((seriesRitardi || []).map(row => [row.month, row.value]));

                if (!rows.length) {
                    target.innerHTML = `<div class="text-muted">Nessuno snapshot disponibile.</div>`;
                    return;
                }

                const max = Math.max(
                    ...rows.map(row => Number(row.value || 0)),
                    ...[...ritardiByMonth.values()].map(v => Number(v || 0)),
                    1
                );

                target.innerHTML = rows.map(row => {
                    const chiusi = Number(row.value || 0);
                    const ritardi = Number(ritardiByMonth.get(row.month) || 0);
                    const pctChiusi = (chiusi / max) * 100;
                    const pctRitardi = (ritardi / max) * 100;

                    return `
                <div class="mb-2">
                    <div class="d-flex justify-content-between">
                        <span>${escapeHtml(row.month)}</span>
                        <span>${chiusi} chiusi / ${ritardi} ritardo</span>
                    </div>
                    <div class="progress mb-1" style="height: 8px;">
                        <div class="progress-bar" style="width: ${pctChiusi.toFixed(2)}%;"></div>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-warning" style="width: ${pctRitardi.toFixed(2)}%;"></div>
                    </div>
                </div>
            `;
                }).join("");
            }

            function renderSnapshotTempiChart(rows) {
                const target = document.getElementById("kpi-snapshot-chart-tempi");
                if (!target) return;

                if (!rows?.length) {
                    target.innerHTML = `<div class="text-muted">Nessuno snapshot disponibile.</div>`;
                    return;
                }

                const max = Math.max(
                    ...rows.map(row => Number(row.tempo_previsto || 0)),
                    ...rows.map(row => Number(row.tempo_reale || 0)),
                    1
                );

                target.innerHTML = rows.map(row => {
                    const previsto = Number(row.tempo_previsto || 0);
                    const reale = Number(row.tempo_reale || 0);
                    const pctPrevisto = (previsto / max) * 100;
                    const pctReale = (reale / max) * 100;

                    return `
                <div class="mb-2">
                    <div class="d-flex justify-content-between">
                        <span>${escapeHtml(row.month)}</span>
                        <span>${formatHours(reale)} / ${formatHours(previsto)}</span>
                    </div>
                    <div class="progress mb-1" style="height: 8px;">
                        <div class="progress-bar" style="width: ${pctPrevisto.toFixed(2)}%;"></div>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-success" style="width: ${pctReale.toFixed(2)}%;"></div>
                    </div>
                </div>
            `;
                }).join("");
            }

            function renderSnapshotTable(rows) {
                const tbody = document.getElementById("kpi-snapshot-body");
                if (!tbody) return;

                if (!rows?.length) {
                    tbody.innerHTML = `
                <tr>
                    <td colspan="9" class="text-center text-muted py-3">
                        Nessuno snapshot disponibile.
                    </td>
                </tr>
            `;
                    return;
                }

                tbody.innerHTML = rows.slice().reverse().map(row => `
            <tr>
                <td>${escapeHtml(row.snapshot_month)}</td>
                <td>${escapeHtml(row.scope_type)}: ${escapeHtml(row.scope_code)}</td>
                <td class="text-end">${escapeHtml(row.ordini_chiusi)}</td>
                <td class="text-end">${escapeHtml(row.ordini_in_ritardo)}</td>
                <td class="text-end">${Number(row.percentuale_ritardo || 0).toFixed(2)}%</td>
                <td class="text-end">${formatHours(row.tempo_previsto_totale)}</td>
                <td class="text-end">${formatHours(row.tempo_reale_totale)}</td>
                <td class="text-end">${formatHours(row.scostamento_totale)}</td>
                <td class="text-end">${formatHours(row.tempo_medio_ordine)}</td>
            </tr>
        `).join("");
            }

            function getSnapshotFilters() {
                const scopeValue = document.getElementById("kpi-snapshot-scope")?.value || "global|*";
                const [scopeType, scopeCode] = scopeValue.split("|");

                return {
                    scope_type: scopeType || "global",
                    scope_code: scopeCode || "*",
                    months: document.getElementById("kpi-snapshot-months")?.value || "12",
                };
            }

            async function loadSnapshots() {
                const section = document.getElementById("dashboard-produzione-kpi");
                if (!section) return;

                const snapshotUrl = section.dataset.snapshotUrl;
                if (!snapshotUrl) return;

                const filters = getSnapshotFilters();
                const finalUrl = buildUrlWithParams(snapshotUrl, filters);

                const resp = await fetch(finalUrl, fetchOptions());
                const payload = await resp.json();

                if (!resp.ok || payload.ok === false) {
                    throw new Error(payload.error || `Errore HTTP ${resp.status}`);
                }

                const data = payload.data || {};
                const latest = data.latest || {};
                const comparison = data.comparison || {};

                renderSnapshotScopeOptions(
                    data.available_scopes || [],
                    `${filters.scope_type}|${filters.scope_code}`
                );

                setSnapshotCard("ordini_chiusi", latest.ordini_chiusi ?? 0);
                setSnapshotCard("ordini_in_ritardo", latest.ordini_in_ritardo ?? 0);
                setSnapshotCard("percentuale_ritardo", `${Number(latest.percentuale_ritardo || 0).toFixed(2)}%`);
                setSnapshotCard("scostamento_totale", formatHours(latest.scostamento_totale));

                setSnapshotDelta("ordini_chiusi", comparison.ordini_chiusi);
                setSnapshotDelta("ordini_in_ritardo", comparison.ordini_in_ritardo);
                setSnapshotDelta("percentuale_ritardo", comparison.percentuale_ritardo);
                setSnapshotDelta("scostamento_totale", comparison.scostamento_totale);

                renderSnapshotOrdiniChart(
                    data.series?.ordini_chiusi || [],
                    data.series?.ordini_in_ritardo || []
                );

                renderSnapshotTempiChart(data.series?.tempo_previsto_reale || []);
                renderSnapshotTable(data.rows || []);
            }

            document.getElementById("btn-kpi-filtra")?.addEventListener("click", () => {
                loadKpi().catch(err => {
                    console.error(err);
                    const tbody = document.getElementById("dashboard-kpi-detail-body");
                    if (tbody) {
                        tbody.innerHTML = `
                    <tr>
                        <td colspan="12" class="text-danger text-center py-3">
                            ${escapeHtml(err.message)}
                        </td>
                    </tr>
                `;
                    }
                });
            });

            document.getElementById("btn-kpi-export")?.addEventListener("click", exportKpi);

            document.getElementById("btn-kpi-snapshot-load")?.addEventListener("click", () => {
                loadSnapshots().catch(console.error);
            });

            document.getElementById("kpi-snapshot-scope")?.addEventListener("change", () => {
                loadSnapshots().catch(console.error);
            });

            document.getElementById("kpi-snapshot-months")?.addEventListener("change", () => {
                loadSnapshots().catch(console.error);
            });

            loadCruscotto().catch(err => {
                console.error(err);
                const body = document.getElementById("dashboard-criticita-body");
                if (body) {
                    body.innerHTML = `
                <tr>
                    <td colspan="7" class="text-danger text-center py-3">
                        ${escapeHtml(err.message)}
                    </td>
                </tr>
            `;
                }
            });

            loadKpi().catch(err => {
                console.error(err);
                const tbody = document.getElementById("dashboard-kpi-detail-body");
                if (tbody) {
                    tbody.innerHTML = `
                <tr>
                    <td colspan="12" class="text-danger text-center py-3">
                        ${escapeHtml(err.message)}
                    </td>
                </tr>
            `;
                }
            });

            loadSnapshots().catch(err => {
                console.error(err);
                const tbody = document.getElementById("kpi-snapshot-body");
                if (tbody) {
                    tbody.innerHTML = `
                <tr>
                    <td colspan="9" class="text-danger text-center py-3">
                        ${escapeHtml(err.message)}
                    </td>
                </tr>
            `;
                }
            });
        })();
    </script>
{% endblock %}
