{% extends "base.j2" %}

{% block title %}Dashboard produzione{% endblock %}

{% block styles %}
    {{ super() }}
    <style>
        .kpi-card-value {
            font-size: 2rem;
            font-weight: 700;
            line-height: 1.1;
        }

        .kpi-card-subtitle {
            min-height: 1.25rem;
        }

        .dashboard-chart-box {
            position: relative;
            height: 330px;
            min-height: 330px;
        }

        .dashboard-chart-box-sm {
            position: relative;
            height: 260px;
            min-height: 260px;
        }

        .dashboard-empty {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--bs-secondary-color);
            text-align: center;
            padding: 1rem;
        }

        .dashboard-empty.d-none {
            display: none !important;
        }

        .dashboard-list {
            max-height: 390px;
            overflow-y: auto;
        }

        .dashboard-list-item {
            border-bottom: 1px solid var(--bs-border-color);
            padding: .75rem 0;
        }

        .dashboard-list-item:last-child {
            border-bottom: 0;
        }

        .dashboard-summary-card {
            min-height: 76px;
        }

        .dashboard-summary-card .kpi-card-value {
            font-size: 1.85rem;
            font-weight: 700;
            line-height: 1.1;
        }

        .dashboard-summary-card .small {
            line-height: 1.1;
        }
    </style>
{% endblock %}

{% block content %}
    {% macro dashboard_filter_select(id, key, label, options) %}
        <div class="col-12 col-md-2">
            <label class="form-label"
                   for="{{ id }}">{{ label }}</label>
            <select class="form-select js-dashboard-filter"
                    id="{{ id }}"
                    data-filter-key="{{ key }}">
                <option value="">Tutti</option>
                {% for item in options.get(key, []) %}
                    <option value="{{ item.value }}">{{ item.label }}</option>
                {% endfor %}
            </select>
        </div>
    {% endmacro %}
    <main class="container-fluid mt-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="mb-0">Dashboard produzione</h2>
                <div class="text-muted">Carico operativo e KPI produzione</div>
            </div>
        </div>

        <ul class="nav nav-tabs mb-3"
            role="tablist">
            {% if allowed_sections.cruscotto %}
                <li class="nav-item"
                    role="presentation">
                    <a class="nav-link {% if active_section == 'cruscotto' %}active{% endif %}"
                       href="{{ operator_url_for('main.dashboard_produzione', section='cruscotto') }}">
                        Cruscotto operativo
                    </a>
                </li>
            {% endif %}

            {% if allowed_sections.kpi %}
                <li class="nav-item"
                    role="presentation">
                    <a class="nav-link {% if active_section == 'kpi' %}active{% endif %}"
                       href="{{ operator_url_for('main.dashboard_produzione', section='kpi') }}">
                        KPI produzione
                    </a>
                </li>
            {% endif %}
        </ul>

        {% if active_section == 'cruscotto' %}
            <section id="dashboard-produzione-cruscotto"
                     data-api-url="{{ operator_url_for('main.api_dashboard_produzione_cruscotto') }}">
                {% set cruscotto_filter_options = dashboard_payload.cruscotto.filter_options|default({}) %}
                <div class="card shadow-sm mb-3">
                    <div class="card-header">Filtri cruscotto</div>
                    <div class="card-body">
                        <div class="row g-2">
                            {{ dashboard_filter_select("cruscotto-reparto", "reparto", "Reparto", cruscotto_filter_options) }}
                            {{ dashboard_filter_select("cruscotto-risorsa", "risorsa", "Risorsa", cruscotto_filter_options) }}
                            {{ dashboard_filter_select("cruscotto-lavorazione", "lavorazione", "Lavorazione", cruscotto_filter_options) }}
                            {{ dashboard_filter_select("cruscotto-operatore", "operatore", "Operatore", cruscotto_filter_options) }}
                            {{ dashboard_filter_select("cruscotto-articolo", "articolo", "Articolo", cruscotto_filter_options) }}
                            {{ dashboard_filter_select("cruscotto-stato", "stato", "Stato", cruscotto_filter_options) }}

                            <div class="col-12 col-md-2 d-flex align-items-end">
                                <button class="btn btn-primary w-100"
                                        type="button"
                                        id="btn-cruscotto-filtra">
                                    Applica filtri
                                </button>
                            </div>

                            <div class="col-12 col-md-2 d-flex align-items-end">
                                <button class="btn btn-outline-secondary w-100"
                                        type="button"
                                        id="btn-cruscotto-reset">
                                    Reset
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Sezione riepilogo sopra Carico prossimo mese + Stati ODP -->
                <div class="row g-3 mb-3">
                    <div class="col-12">
                        <div class="card shadow-sm">
                            <div class="card-header">Riepilogo carico produzione</div>

                            <div class="card-body">
                                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-6 g-2">

                                    <div class="col">
                                        <div class="dashboard-summary-card border rounded p-2 h-100 text-center d-flex flex-column justify-content-center align-items-center">
                                            <div class="text-muted small">ODP aperti</div>
                                            <div class="kpi-card-value"
                                                 data-dashboard-card="ordini_totali">0
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col">
                                        <div class="dashboard-summary-card border rounded p-2 h-100 text-center d-flex flex-column justify-content-center align-items-center">
                                            <div class="text-muted small">Attivi</div>
                                            <div class="kpi-card-value"
                                                 data-dashboard-card="ordini_attivi">0
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col">
                                        <div class="dashboard-summary-card border rounded p-2 h-100 text-center d-flex flex-column justify-content-center align-items-center">
                                            <div class="text-muted small">Sospesi</div>
                                            <div class="kpi-card-value"
                                                 data-dashboard-card="ordini_sospesi">0
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col">
                                        <div class="dashboard-summary-card border rounded p-2 h-100 text-center d-flex flex-column justify-content-center align-items-center">
                                            <div class="text-muted small">Ore aperte complessive</div>
                                            <div class="kpi-card-value"
                                                 data-dashboard-card="ore_previste_produzione">0 h
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col">
                                        <div class="dashboard-summary-card border rounded p-2 h-100 text-center d-flex flex-column justify-content-center align-items-center">
                                            <div class="text-muted small">Ore disponibili oggi</div>
                                            <div class="kpi-card-value"
                                                 data-dashboard-card="ore_disponibili_oggi">0 h
                                            </div>
                                            <div class="small text-muted"
                                                 data-dashboard-card-sub="operatori_capacita">
                                                0 operatori
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="dashboard-summary-card border rounded p-2 h-100 text-center d-flex flex-column justify-content-center align-items-center">
                                            <div class="text-muted small">Saturazione carico entro oggi</div>

                                            <div class="kpi-card-value"
                                                 data-dashboard-card="saturazione_totale">
                                                0%
                                            </div>
                                            <div class="small text-muted"
                                                 data-dashboard-card-sub="saturazione_totale_ore">
                                                0 h / 0 h
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col">
                                        <div class="dashboard-summary-card border rounded p-2 h-100 text-center d-flex flex-column justify-content-center align-items-center">
                                            <div class="text-muted small">Incidenza sospensioni</div>
                                            <div class="kpi-card-value"
                                                 data-dashboard-card="incidenza_sospensioni">
                                                0%
                                            </div>
                                            <div class="small text-muted"
                                                 data-dashboard-card-sub="incidenza_sospensioni">
                                                0 / 0 ODP
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col">
                                        <div class="dashboard-summary-card border rounded p-2 h-100 text-center d-flex flex-column justify-content-center align-items-center">
                                            <div class="text-muted small">Gap capacità 7 giorni</div>
                                            <div class="kpi-card-value"
                                                 data-dashboard-card="gap_capacita_7_giorni">
                                                0 h
                                            </div>
                                            <div class="small text-muted"
                                                 data-dashboard-card-sub="gap_capacita_7_giorni">
                                                0 h / 0 h
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col">
                                        <div class="dashboard-summary-card border rounded p-2 h-100 text-center d-flex flex-column justify-content-center align-items-center">
                                            <div class="text-muted small">Risorse collo di bottiglia</div>
                                            <div class="kpi-card-value"
                                                 data-dashboard-card="risorse_collo_bottiglia">
                                                0
                                            </div>
                                            <div class="small text-muted">
                                                carico entro oggi &gt; capacità
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Grafici Carico prossimo mese + Stati ODP -->
                <div class="row g-3 mb-3">
                    <div class="col-12 col-xl-10">
                        <div class="card shadow-sm h-100">
                            <div class="card-header">Carico prossimo mese</div>
                            <div class="card-body">
                                <div class="dashboard-chart-box">
                                    <canvas id="chart-cruscotto-carico"></canvas>
                                    <div class="dashboard-empty"
                                         data-empty-for="chart-cruscotto-carico">
                                        Dati non caricati.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-2">
                        <div class="card shadow-sm h-100">
                            <div class="card-header">Stati ODP</div>
                            <div class="card-body">
                                <div class="dashboard-chart-box">
                                    <canvas id="chart-cruscotto-stati"></canvas>
                                    <div class="dashboard-empty"
                                         data-empty-for="chart-cruscotto-stati">
                                        Dati non caricati.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-xl-6">
                        <div class="card shadow-sm h-100">
                            <div class="card-header">Carico per reparto</div>
                            <div class="card-body">
                                <div class="dashboard-chart-box">
                                    <canvas id="chart-cruscotto-reparti"></canvas>
                                    <div class="dashboard-empty"
                                         data-empty-for="chart-cruscotto-reparti">
                                        Dati non caricati.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-6">
                        <div class="card shadow-sm h-100">
                            <div class="card-header">ODP per reparto</div>
                            <div class="card-body">
                                <div class="dashboard-chart-box">
                                    <canvas id="chart-cruscotto-ordini-reparto"></canvas>
                                    <div class="dashboard-empty"
                                         data-empty-for="chart-cruscotto-ordini-reparto">
                                        Dati non caricati.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-xl-6">
                        <div class="card shadow-sm h-100">
                            <div class="card-header">Carico per risorsa</div>
                            <div class="card-body">
                                <div class="dashboard-chart-box">
                                    <canvas id="chart-cruscotto-risorse"></canvas>
                                    <div class="dashboard-empty"
                                         data-empty-for="chart-cruscotto-risorse">
                                        Dati non caricati.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-6">
                        <div class="card shadow-sm h-100">
                            <div class="card-header">ODP per risorsa</div>
                            <div class="card-body">
                                <div class="dashboard-chart-box">
                                    <canvas id="chart-cruscotto-ordini-risorsa"></canvas>
                                    <div class="dashboard-empty"
                                         data-empty-for="chart-cruscotto-ordini-risorsa">
                                        Dati non caricati.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-xl-6">
                        <div class="card shadow-sm h-100">
                            <div class="card-header">Saturazione reparti (carico entro oggi)</div>
                            <div class="card-body">
                                <div class="dashboard-chart-box">
                                    <canvas id="chart-cruscotto-saturazione"></canvas>
                                    <div class="dashboard-empty"
                                         data-empty-for="chart-cruscotto-saturazione">
                                        Dati non caricati.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-6">
                        <div class="card shadow-sm h-100">
                            <div class="card-header">Top criticità operative</div>
                            <div class="card-body">
                                <div id="dashboard-criticita-list"
                                     class="dashboard-list">
                                    <div class="text-muted">Dati non caricati.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-12">
                        <div class="card shadow-sm">
                            <div class="card-header">Risorse collo di bottiglia</div>
                            <div class="card-body">
                                <div class="dashboard-chart-box">
                                    <canvas id="chart-cruscotto-colli-risorsa"></canvas>
                                    <div class="dashboard-empty"
                                         data-empty-for="chart-cruscotto-colli-risorsa">
                                        Nessuna risorsa oltre capacità.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        {% endif %}

        {% if active_section == 'kpi' %}
            <section id="dashboard-produzione-kpi"
                     data-api-url="{{ operator_url_for('main.api_dashboard_produzione_kpi') }}"
                     data-export-url="{{ operator_url_for('main.api_dashboard_produzione_kpi_export') }}"
                     data-snapshot-url="{{ operator_url_for('main.api_dashboard_produzione_kpi_snapshots') }}">
                {% set kpi_filter_options = dashboard_payload.kpi.filter_options|default({}) %}
                <div class="card shadow-sm mb-3">
                    <div class="card-header">Filtri KPI</div>
                    <div class="card-body">
                        <div class="row g-2">
                            <div class="col-12 col-md-2">
                                <label class="form-label"
                                       for="kpi-date-from">Da</label>
                                <input class="form-control"
                                       type="date"
                                       id="kpi-date-from">
                            </div>

                            <div class="col-12 col-md-2">
                                <label class="form-label"
                                       for="kpi-date-to">A</label>
                                <input class="form-control"
                                       type="date"
                                       id="kpi-date-to">
                            </div>

                            {{ dashboard_filter_select("kpi-reparto", "reparto", "Reparto", kpi_filter_options) }}
                            {{ dashboard_filter_select("kpi-risorsa", "risorsa", "Risorsa", kpi_filter_options) }}
                            {{ dashboard_filter_select("kpi-lavorazione", "lavorazione", "Lavorazione", kpi_filter_options) }}
                            {{ dashboard_filter_select("kpi-articolo", "articolo", "Articolo", kpi_filter_options) }}
                            {{ dashboard_filter_select("kpi-operatore", "operatore", "Operatore", kpi_filter_options) }}
                            {{ dashboard_filter_select("kpi-stato", "stato", "Stato", kpi_filter_options) }}

                            <div class="col-12 col-md-2 d-flex align-items-end">
                                <button class="btn btn-primary w-100"
                                        type="button"
                                        id="btn-kpi-filtra">
                                    Applica filtri
                                </button>
                            </div>

                            <div class="col-12 col-md-2 d-flex align-items-end">
                                <button class="btn btn-outline-secondary w-100"
                                        type="button"
                                        id="btn-kpi-reset">
                                    Reset
                                </button>
                            </div>

                            {% if allowed_sections.export %}
                                <div class="col-12 col-md-2 d-flex align-items-end">
                                    <button class="btn btn-success w-100"
                                            type="button"
                                            id="btn-kpi-export">
                                        Esporta Excel
                                    </button>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-2">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <div class="text-muted small">Ordini completati</div>
                                <div class="kpi-card-value"
                                     data-kpi-card="ordini_chiusi">0
                                </div>
                                <div class="small text-muted kpi-card-subtitle">nel periodo</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-2">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <div class="text-muted small">% ritardo</div>
                                <div class="kpi-card-value"
                                     data-kpi-card="percentuale_ritardo">0%
                                </div>
                                <div class="small text-muted kpi-card-subtitle"
                                     data-kpi-card-sub="ordini_in_ritardo">0 ordini
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-2">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <div class="text-muted small">Ritardo medio</div>
                                <div class="kpi-card-value"
                                     data-kpi-card="giorni_medi_ritardo">0 g
                                </div>
                                <div class="small text-muted kpi-card-subtitle">solo ordini completati in ritardo, giorni solari</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-2">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <div class="text-muted small">Scostamento</div>
                                <div class="kpi-card-value"
                                     data-kpi-card="scostamento_percentuale">0%
                                </div>
                                <div class="small text-muted kpi-card-subtitle"
                                     data-kpi-card-sub="scostamento_totale">0 h
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-2">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <div class="text-muted small">Aderenza tempi</div>
                                <div class="kpi-card-value"
                                     data-kpi-card="affidabilita_tempi">0%
                                </div>
                                <div class="small text-muted kpi-card-subtitle">fasi entro ±10%</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-2">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <div class="text-muted small">Macchine prodotte</div>
                                <div class="kpi-card-value"
                                     data-kpi-card="macchine_prodotte">0
                                </div>
                                <div class="small text-muted kpi-card-subtitle">nel periodo</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <div class="text-muted small">Tasso non conformità</div>
                                <div class="kpi-card-value"
                                     data-kpi-card="tasso_non_conformita">0%
                                </div>
                                <div class="small text-muted kpi-card-subtitle"
                                     data-kpi-card-sub="tasso_non_conformita">
                                    0 NC / 0 consuntivati
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <div class="text-muted small">Lead time medio</div>
                                <div class="kpi-card-value"
                                     data-kpi-card="lead_time_medio_ore">0 h
                                </div>
                                <div class="small text-muted kpi-card-subtitle"
                                     data-kpi-card-sub="lead_time">
                                    mediana 0 h · 0 ODP
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <div class="text-muted small">Copertura dati KPI</div>
                                <div class="kpi-card-value"
                                     data-kpi-card="copertura_dati">0%
                                </div>
                                <div class="small text-muted kpi-card-subtitle"
                                     data-kpi-card-sub="copertura_dati">
                                    0 / 0 fasi complete
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-xl-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-header">Tempo fasi: reale vs previsto</div>
                            <div class="card-body">
                                <div class="dashboard-chart-box-sm">
                                    <canvas id="chart-kpi-tempi"></canvas>
                                    <div class="dashboard-empty"
                                         data-empty-for="chart-kpi-tempi">Dati non caricati.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-xl-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-header">Aderenza tempi delle fasi</div>
                            <div class="card-body">
                                <div class="dashboard-chart-box-sm">
                                    <canvas id="chart-kpi-affidabilita"></canvas>
                                    <div class="dashboard-empty"
                                         data-empty-for="chart-kpi-affidabilita">Dati non caricati.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-xl-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-header">Ritardo medio per reparto</div>
                            <div class="card-body">
                                <div class="dashboard-chart-box-sm">
                                    <canvas id="chart-kpi-ritardo-reparto"></canvas>
                                    <div class="dashboard-empty"
                                         data-empty-for="chart-kpi-ritardo-reparto">Dati non caricati.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-xl-6">
                        <div class="card shadow-sm h-100">
                            <div class="card-header">Top risorse per scostamento fasi</div>
                            <div class="card-body">
                                <div class="dashboard-chart-box">
                                    <canvas id="chart-kpi-risorse-scostamento"></canvas>
                                    <div class="dashboard-empty"
                                         data-empty-for="chart-kpi-risorse-scostamento">Dati non caricati.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-xl-6">
